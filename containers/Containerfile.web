ARG NODE_BUILDER="docker.io/library/node:22.18.0-bookworm-slim@sha256:752ea8a2f758c34002a0461bd9f1cee4f9a3c36d48494586f60ffce1fc708e0e"
ARG WEB_RUNTIME="docker.io/nginxinc/nginx-unprivileged:1.29.5-alpine@sha256:42a7d7f2ee23e9f5a1dcdf3647ba5c585bbd18f79e79cd817e70e8cd61c55779"

FROM ${NODE_BUILDER} AS builder
ARG PNPM_VERSION=9.15.4
ARG SOURCE_DATE_EPOCH
ARG SOURCE_COMMIT
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}
WORKDIR /src/web
RUN corepack enable && corepack prepare "pnpm@${PNPM_VERSION}" --activate
COPY web/package.json web/pnpm-lock.yaml ./
RUN --mount=type=cache,id=labweaver-pnpm,target=/root/.local/share/pnpm/store,sharing=locked \
    pnpm install --frozen-lockfile
COPY web/ ./
RUN --network=none test -n "${SOURCE_DATE_EPOCH}" && test -n "${SOURCE_COMMIT}" && pnpm build

FROM ${WEB_RUNTIME} AS runtime-base

# The local external-fixture build provider copies this image as its immutable
# source image. Keep it separate from the production Web image while matching
# the Environment Container seed and runtime security contract.
FROM runtime-base AS work-runtime-fixture
USER root
RUN apk add --no-cache coreutils util-linux \
    && mkdir -p /opt/labweaver/workspace-seed /workspace /tmp \
    && printf '%s' 'This workspace seed is provided by the explicit local integration fixture.' > /opt/labweaver/workspace-seed/README.md \
    && chmod -R a+rX /opt/labweaver/workspace-seed \
    && chmod 0777 /workspace \
    && chmod 1777 /tmp
USER 65534:65534
WORKDIR /workspace
EXPOSE 8080

FROM runtime-base AS runtime
ARG SOURCE_COMMIT
LABEL org.opencontainers.image.source="https://github.com/TeamMonad/LabWeaver" \
      org.opencontainers.image.revision="${SOURCE_COMMIT}" \
      org.opencontainers.image.title="web"
USER root
RUN rm -f /sbin/apk && rm -rf /etc/apk
COPY --chown=101:101 --chmod=0644 containers/nginx.conf /etc/nginx/nginx.conf
COPY --from=builder --chown=101:101 /src/web/dist /usr/share/nginx/html
USER 101:101
EXPOSE 8080
