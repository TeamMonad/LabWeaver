# syntax=docker/dockerfile:1.25.0@sha256:0adf442eae370b6087e08edc7c50b552d80ddf261576f4ebd6421006b2461f12
ARG NODE_BUILDER="docker.io/library/node:22.18.0-bookworm-slim@sha256:752ea8a2f758c34002a0461bd9f1cee4f9a3c36d48494586f60ffce1fc708e0e"
ARG WEB_RUNTIME="docker.io/nginxinc/nginx-unprivileged:1.29.1-alpine@sha256:27985295bdb22a1ef8f712863210bd5877c0f3006494a593e86b3fe0fa55467e"

FROM ${NODE_BUILDER} AS builder
ARG PNPM_VERSION=9.15.4
ARG SOURCE_DATE_EPOCH
ARG SOURCE_COMMIT
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}
WORKDIR /src/web
RUN corepack enable && corepack prepare "pnpm@${PNPM_VERSION}" --activate
COPY web/package.json web/pnpm-lock.yaml ./
RUN --mount=type=cache,id=labweaver-pnpm,target=/root/.local/share/pnpm/store,sharing=locked \
    pnpm install --frozen-lockfile
COPY web/ ./
RUN --network=none test -n "${SOURCE_DATE_EPOCH}" && test -n "${SOURCE_COMMIT}" && pnpm build

FROM ${WEB_RUNTIME} AS runtime
ARG SOURCE_COMMIT
LABEL org.opencontainers.image.source="https://github.com/TeamMonad/LabWeaver" \
      org.opencontainers.image.revision="${SOURCE_COMMIT}" \
      org.opencontainers.image.title="web"
USER root
RUN rm -f /sbin/apk && rm -rf /etc/apk
COPY containers/nginx.conf /etc/nginx/nginx.conf
COPY --from=builder --chown=101:101 /src/web/dist /usr/share/nginx/html
USER 101:101
EXPOSE 8080
