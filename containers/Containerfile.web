ARG WEB_RUNTIME="docker.io/nginxinc/nginx-unprivileged:1.29.5-alpine@sha256:42a7d7f2ee23e9f5a1dcdf3647ba5c585bbd18f79e79cd817e70e8cd61c55779"

# The web frontend is built on the packaging host (pnpm + vite against the
# checked-in lockfile; the cluster build network cannot reach any npm
# registry) and the output is vendored into the context as containers/web-dist.
# This image is therefore a plain static nginx runtime: no node toolchain.
FROM ${WEB_RUNTIME} AS runtime-base

# The local external-fixture build provider copies this image as its immutable
# source image. Keep it separate from the production Web image while matching
# the Environment Container seed and runtime security contract.
FROM runtime-base AS work-runtime-fixture
USER root
COPY containers/alpine-3.21-pkgs /vendor/alpine
RUN apk add --no-network --allow-untrusted /vendor/alpine/*.apk \
    && rm -rf /vendor/alpine \
    && mkdir -p /opt/labweaver/workspace-seed /workspace /tmp \
    && printf '%s' 'This workspace seed is provided by the explicit local integration fixture.' > /opt/labweaver/workspace-seed/README.md \
    && chmod -R a+rX /opt/labweaver/workspace-seed \
    && chmod 0777 /workspace \
    && chmod 1777 /tmp
USER 65534:65534
WORKDIR /workspace
EXPOSE 8080

FROM runtime-base AS runtime
ARG SOURCE_COMMIT
LABEL org.opencontainers.image.source="https://github.com/TeamMonad/LabWeaver" \
      org.opencontainers.image.revision="${SOURCE_COMMIT}" \
      org.opencontainers.image.title="web"
USER root
RUN rm -f /sbin/apk && rm -rf /etc/apk
COPY --chown=101:101 --chmod=0644 containers/nginx.conf /etc/nginx/nginx.conf
COPY --chown=101:101 containers/web-dist/ /usr/share/nginx/html
USER 101:101
EXPOSE 8080