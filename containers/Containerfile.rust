ARG RUST_BUILDER="docker.io/library/rust:1.97.1-bookworm@sha256:14bc9c5966e7b3a385794b3d5389a8765668342025fbcc7b2e3d2866ac4bd8c3"
ARG RUST_RUNTIME="gcr.io/distroless/cc-debian12:nonroot@sha256:66aa873a4a14fb164aa01296058efd8253744606d72715e45acface073359faa"
ARG NODE_BUILDER="docker.io/library/node:22.18.0-bookworm-slim@sha256:752ea8a2f758c34002a0461bd9f1cee4f9a3c36d48494586f60ffce1fc708e0e"
ARG BUILDKIT_IMAGE="docker.io/moby/buildkit@sha256:6b59b7df63a8cb9902736f9ddf7fcff8261613d3e7449b8ea8b7537fc399c03a"

FROM ${RUST_BUILDER} AS builder
ARG SERVICE
ARG RUST_TOOLCHAIN=1.97.1
ARG SOURCE_DATE_EPOCH
ARG SOURCE_COMMIT
ENV CARGO_INCREMENTAL=0 \
    CARGO_NET_GIT_FETCH_WITH_CLI=false \
    RUSTUP_TOOLCHAIN=${RUST_TOOLCHAIN} \
    SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY rust-toolchain.toml rustfmt.toml ./
COPY .cargo .cargo
COPY crates crates
COPY services services
COPY access-gateway access-gateway
COPY xtask xtask
COPY migrations migrations
COPY vendor vendor
RUN --mount=type=cache,id=labweaver-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=labweaver-cargo-git,target=/usr/local/cargo/git,sharing=locked \
    cargo fetch --locked
RUN --network=none \
    --mount=type=cache,id=labweaver-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=labweaver-cargo-git,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=labweaver-cargo-target,target=/src/target,sharing=locked \
    test -n "${SERVICE}" && test -n "${SOURCE_DATE_EPOCH}" && test -n "${SOURCE_COMMIT}" && \
    cargo build --release --locked --package "${SERVICE}" && \
    install -D -m 0555 "target/release/${SERVICE}" /out/labweaver-service

FROM ${BUILDKIT_IMAGE} AS buildkit-tools

FROM ${NODE_BUILDER} AS claude-tools
ARG CLAUDE_CODE_PACKAGE_PATH
ARG CLAUDE_CODE_LINUX_X64_SHA512
WORKDIR /tmp/claude-code
# The deployment proxy cannot reach the npm registry, so the pinned tarball is
# vendored into the build context and only checksum-verified here (same pin as
# deploy/versions.lock.yml).
COPY ${CLAUDE_CODE_PACKAGE_PATH} ./package.tgz
RUN test -n "${CLAUDE_CODE_PACKAGE_PATH}" && \
    printf '%s  %s\n' "${CLAUDE_CODE_LINUX_X64_SHA512}" "package.tgz" | sha512sum --check --strict && \
    tar --extract --gzip --file package.tgz && \
    test -x package/claude && \
    install -D -m 0555 package/claude /out/claude

# The local Kind stack is intentionally offline from Anthropic.  This stage is
# an explicit, disposable test boundary: it compiles the checked-in stream-json
# fixture and accepts only the pinned production version/hash inputs that the
# local builder already passes to the agent image build.  It is never reachable
# from the production `agent-runtime` target.
FROM ${RUST_BUILDER} AS claude-tools-fixture
ARG CLAUDE_CODE_VERSION
ARG CLAUDE_CODE_LINUX_X64_SHA512
WORKDIR /tmp/claude-fixture
COPY tools/claude-fixture/claude.c ./claude.c
RUN test "${CLAUDE_CODE_VERSION}" = "2.1.215" && \
    test "${CLAUDE_CODE_LINUX_X64_SHA512}" = "cf00de4e2b500f7bf4fc6c57de19753d3639e23ee2177fe103d40614cf79ca29ddf61064bcbcafe9a53d59d1fbd3cf6cdc02027c8ea167be00157b41469e9bcd" && \
    mkdir -p /out && \
    cc -std=c11 -O2 -Wall -Wextra -Werror claude.c -o /out/claude && \
    chmod 0555 /out/claude

FROM ${RUST_RUNTIME} AS runtime-base
ARG SERVICE
ARG SOURCE_COMMIT
LABEL org.opencontainers.image.source="https://github.com/TeamMonad/LabWeaver" \
      org.opencontainers.image.revision="${SOURCE_COMMIT}" \
      org.opencontainers.image.title="${SERVICE}"
COPY --from=builder --chown=65532:65532 /out/labweaver-service /usr/local/bin/labweaver-service
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/labweaver-service"]

FROM runtime-base AS agent-runtime
COPY --from=buildkit-tools /usr/bin/buildctl /usr/local/bin/buildctl
COPY --from=claude-tools --chown=65532:65532 /out/claude /usr/local/bin/claude

FROM runtime-base AS agent-runtime-fixture
COPY --from=buildkit-tools /usr/bin/buildctl /usr/local/bin/buildctl
COPY --from=claude-tools-fixture --chown=65532:65532 /out/claude /usr/local/bin/claude

FROM runtime-base AS runtime

# Shell-capable sandbox runtime for admitted authoring attempts.  Unlike
# agent-runtime this keeps a real userland (bash, python3, git, curl) because
# the pinned Claude Code CLI runs its local tools inside the attempt Job.
FROM ${NODE_BUILDER} AS authoring-sandbox
COPY --from=claude-tools --chown=65532:65532 /out/claude /usr/local/bin/claude
COPY --from=buildkit-tools /usr/bin/buildctl /usr/local/bin/buildctl
RUN apt-get update && \
    apt-get install --yes --no-install-recommends \
        bash ca-certificates coreutils curl git python3 && \
    rm -rf /var/lib/apt/lists/*
USER 65532:65532
CMD ["/bin/sh"]

FROM ${NODE_BUILDER} AS authoring-sandbox-fixture
COPY --from=claude-tools-fixture --chown=65532:65532 /out/claude /usr/local/bin/claude
COPY --from=buildkit-tools /usr/bin/buildctl /usr/local/bin/buildctl
RUN apt-get update && \
    apt-get install --yes --no-install-recommends \
        bash ca-certificates coreutils curl git python3 && \
    rm -rf /var/lib/apt/lists/*
USER 65532:65532
CMD ["/bin/sh"]
