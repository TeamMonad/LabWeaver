{
  "name": "labweaver-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && pnpm verify:production-bundle",
    "verify:production-bundle": "node scripts/verify-production-bundle.mjs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "contracts:generate": "openapi-ts",
    "contracts:check": "node scripts/contracts-check.mjs",
    "test:e2e:contract": "node --test e2e/tests/*.node.mjs",
    "test:e2e:sdk": "playwright test --config=playwright.sdk.config.mjs",
    "test:e2e:sleep": "node scripts/fixed-sleep-check.mjs",
    "test:e2e:verify": "node scripts/verify-config.mjs",
    "test:e2e:list": "playwright test --list --config=playwright.config.mjs",
    "test:e2e:gate": "node scripts/e2e-gate.mjs",
    "test:e2e": "node scripts/run-e2e.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "^5.2.10",
    "@fontsource-variable/roboto-flex": "^5.2.8",
    "@fontsource/roboto": "^5.2.10",
    "@hey-api/client-axios": "0.9.1",
    "axios": "^1.18.1",
    "material-symbols": "^0.45.7",
    "oidc-client-ts": "^3.5.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.31",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "^1.61.1",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@vitejs/plugin-vue": "^5.0.5",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.27.0",
    "jsdom": "^24.1.0",
    "tsx": "^4.23.0",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vitest": "^2.0.2",
    "vue-tsc": "^2.0.26"
  }
}
