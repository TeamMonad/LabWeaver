# LabWeaver Web 环境变量模板
# 复制为 .env.development 或 .env.production 后填入实际值

# API 网关地址（开发时通过 Vite proxy 转发）
VITE_API_BASE_URL=/api/v1

# OIDC / Keycloak 配置
VITE_OIDC_AUTHORITY=https://keycloak.labweaver.local/realms/labweaver
VITE_OIDC_CLIENT_ID=labweaver-web
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/

# 平台名称
VITE_APP_TITLE=LabWeaver 智织实验云

# 前端 Fixture。仅用于明确的本地演示；默认关闭，绝不可作为生产数据来源。
VITE_FIXTURE_MODE=false
