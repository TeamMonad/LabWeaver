---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: buildkit
  namespace: {{ sprint2_buildkit_namespace }}
automountServiceAccountToken: false
---
apiVersion: v1
kind: Service
metadata:
  name: buildkit
  namespace: {{ sprint2_buildkit_namespace }}
  labels: {app.kubernetes.io/name: buildkit, app.kubernetes.io/part-of: labweaver-infrastructure}
spec:
  selector: {app.kubernetes.io/name: buildkit}
  ports: [{name: grpc, port: 1234, targetPort: grpc}]
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: buildkit
  namespace: {{ sprint2_buildkit_namespace }}
spec:
  replicas: 1
  strategy: {type: Recreate}
  selector: {matchLabels: {app.kubernetes.io/name: buildkit}}
  template:
    metadata:
      labels: {app.kubernetes.io/name: buildkit, app.kubernetes.io/part-of: labweaver-infrastructure}
      annotations:
        labweaver.io/configuration-sha256: {{ sprint2_buildkit_bundle_sha256 }}
    spec:
      serviceAccountName: buildkit
      automountServiceAccountToken: false
      hostNetwork: false
      hostAliases:
        - ip: {{ sprint2_buildkit_harbor_service_ip }}
          hostnames: [harbor.lab.lan]
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        runAsGroup: 1000
        fsGroup: 1000
        seccompProfile: {type: Unconfined}
      containers:
        - name: buildkit
          image: {{ sprint2_buildkit_lock.sprint2_foundation.buildkit_rootless }}
          args: [--config, /etc/buildkit/buildkitd.toml, --oci-worker-no-process-sandbox]
          env:
            - {name: XDG_RUNTIME_DIR, value: /run/user/1000}
            - {name: TMPDIR, value: /tmp}
          ports: [{name: grpc, containerPort: 1234}]
          readinessProbe:
            exec:
              command:
                - buildctl
                - --addr
                - tcp://127.0.0.1:1234
                - --tlsservername
                - buildkit
                - --tlscacert
                - /etc/buildkit/tls/ca.crt
                - --tlscert
                - /etc/buildkit/tls/health.crt
                - --tlskey
                - /etc/buildkit/tls/health.key
                - debug
                - workers
            periodSeconds: 5
            timeoutSeconds: 3
          securityContext:
            privileged: false
            # RootlessKit's reviewed newuidmap/newgidmap helpers require their
            # setuid transition to create the subordinate user namespace. The
            # exception remains bounded to these two capabilities and this
            # dedicated, tokenless workload.
            allowPrivilegeEscalation: true
            readOnlyRootFilesystem: true
            capabilities: {drop: [ALL], add: [SETUID, SETGID]}
            seccompProfile: {type: Unconfined}
            appArmorProfile: {type: Unconfined}
          resources:
            requests: {cpu: 500m, memory: 1Gi}
            limits: {cpu: "4", memory: 4Gi}
          volumeMounts:
            - {name: data, mountPath: /home/user/.local/share/buildkit}
            - {name: runtime, mountPath: /run/user/1000}
            - {name: tmp, mountPath: /tmp}
            - {name: rootless-tmp, mountPath: /home/user/.local/tmp}
            - {name: config, mountPath: /etc/buildkit/buildkitd.toml, subPath: buildkitd.toml, readOnly: true}
            - {name: secrets, mountPath: /etc/buildkit/tls, readOnly: true}
      volumes:
        - {name: runtime, emptyDir: {sizeLimit: 64Mi}}
        - {name: tmp, emptyDir: {sizeLimit: 1Gi}}
        - {name: rootless-tmp, emptyDir: {sizeLimit: 64Mi}}
        - {name: config, configMap: {name: buildkit-config}}
        - {name: secrets, secret: {secretName: buildkit-server-secrets, defaultMode: 0400}}
        - name: data
          persistentVolumeClaim: {claimName: buildkit-data}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: buildkit-data
  namespace: {{ sprint2_buildkit_namespace }}
spec:
  accessModes: [ReadWriteOnce]
  storageClassName: {{ sprint2_buildkit_storage_class }}
  resources: {requests: {storage: {{ sprint2_buildkit_storage }}}}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata: {name: default-deny, namespace: {{ sprint2_buildkit_namespace }}}
spec:
  podSelector: {}
  policyTypes: [Ingress, Egress]
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata: {name: buildkit, namespace: {{ sprint2_buildkit_namespace }}}
spec:
  podSelector: {matchLabels: {app.kubernetes.io/name: buildkit}}
  policyTypes: [Ingress, Egress]
  ingress:
    - from:
        - namespaceSelector:
            matchLabels: {kubernetes.io/metadata.name: labweaver-system}
          podSelector:
            matchLabels: {app.kubernetes.io/name: build-executor}
      ports: [{protocol: TCP, port: 1234}]
  egress:
    - to:
        - namespaceSelector:
            matchLabels: {kubernetes.io/metadata.name: kube-system}
          podSelector:
            matchLabels: {k8s-app: kube-dns}
      ports: [{protocol: UDP, port: 53}, {protocol: TCP, port: 53}]
    - to:
        - ipBlock: {cidr: {{ sprint2_buildkit_registry_cidr }}}
      ports: [{protocol: TCP, port: 443}]
    - to:
        - namespaceSelector:
            matchLabels: {kubernetes.io/metadata.name: harbor}
          podSelector:
            matchLabels: {app.kubernetes.io/component: nginx, app.kubernetes.io/instance: harbor}
      ports: [{protocol: TCP, port: 8443}]
---
apiVersion: cilium.io/v2
kind: CiliumNetworkPolicy
metadata:
  name: buildkit-dependency-egress
  namespace: {{ sprint2_buildkit_namespace }}
spec:
  endpointSelector:
    matchLabels: {app.kubernetes.io/name: buildkit}
  egress:
    - toFQDNs:
        - {matchName: index.crates.io}
        - {matchName: static.crates.io}
        - {matchName: registry.npmjs.org}
        - {matchName: dl-cdn.alpinelinux.org}
      toPorts:
        - ports: [{port: "443", protocol: TCP}]
