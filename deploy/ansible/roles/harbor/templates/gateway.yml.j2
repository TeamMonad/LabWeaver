---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: harbor-internal-ca
  namespace: {{ harbor_namespace }}
  labels:
    app.kubernetes.io/part-of: labweaver-infrastructure
spec:
  isCA: true
  commonName: labweaver-harbor-internal-ca
  secretName: {{ harbor_ca_secret_name }}
  privateKey:
    algorithm: ECDSA
    size: 256
  issuerRef:
    name: dev-selfsigned
    kind: ClusterIssuer
---
apiVersion: cert-manager.io/v1
kind: Issuer
metadata:
  name: harbor-internal-ca
  namespace: {{ harbor_namespace }}
spec:
  ca:
    secretName: {{ harbor_ca_secret_name }}
---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: harbor-gateway-tls
  namespace: {{ harbor_namespace }}
spec:
  secretName: {{ harbor_gateway_tls_secret_name }}
  dnsNames:
    - {{ harbor_hostname }}
  issuerRef:
    name: harbor-internal-ca
    kind: Issuer
---
apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: {{ harbor_gateway_name }}
  namespace: {{ harbor_namespace }}
  labels:
    app.kubernetes.io/part-of: labweaver-infrastructure
{% if harbor_local_kind | default(false) | bool %}
  annotations:
    service.cilium.io/type: NodePort
{% endif %}
spec:
  gatewayClassName: {{ harbor_gateway_class if harbor_local_kind | default(false) | bool else 'cilium' }}
{% if not harbor_local_kind | default(false) | bool %}
  infrastructure:
    annotations:
      metallb.io/loadBalancerIPs: {{ harbor_gateway_vip }}
{% endif %}
  listeners:
    - name: https
      protocol: HTTPS
      port: 443
      hostname: {{ harbor_hostname }}
      tls:
        mode: Terminate
        certificateRefs:
          - kind: Secret
            name: {{ harbor_gateway_tls_secret_name }}
      allowedRoutes:
        namespaces:
          from: Same
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: harbor
  namespace: {{ harbor_namespace }}
  labels:
    app.kubernetes.io/part-of: labweaver-infrastructure
spec:
  parentRefs:
    - name: {{ harbor_gateway_name }}
      sectionName: https
  hostnames:
    - {{ harbor_hostname }}
  rules:
    - backendRefs:
        # Harbor's nginx service owns the complete external routing contract.
        # Routing /v2 directly to core bypasses registry authentication and
        # breaks the HEAD requests required by BuildKit.
        - name: {{ harbor_release_name }}
          port: 80
