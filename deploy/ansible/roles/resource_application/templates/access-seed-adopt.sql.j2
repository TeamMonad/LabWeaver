\set ON_ERROR_STOP on
BEGIN;
{% for membership in resource_application_access_seed.courseMemberships %}
DO $resource_seed$
DECLARE
    existing_actor access.actors%ROWTYPE;
BEGIN
    SELECT * INTO existing_actor
    FROM access.actors
    WHERE actor_id = '{{ membership.actorId }}'::uuid
    FOR UPDATE;

    IF FOUND AND (existing_actor.issuer <> '{{ membership.issuer }}'
        OR existing_actor.subject_sha256 <> '{{ membership.subjectSha256 }}') THEN
        RAISE EXCEPTION 'LW_RESOURCE_ACCEPTANCE_PROFILE_ACCESS_SEED_CONFLICT';
    END IF;

    INSERT INTO access.actors (actor_id, issuer, subject_sha256)
    VALUES ('{{ membership.actorId }}'::uuid, '{{ membership.issuer }}', '{{ membership.subjectSha256 }}')
    ON CONFLICT (actor_id) DO NOTHING;

    IF EXISTS (
        SELECT 1 FROM access.course_memberships
        WHERE course_id = '{{ membership.courseId }}'::uuid
          AND actor_id = '{{ membership.actorId }}'::uuid
          AND role <> '{{ membership.role }}'
    ) THEN
        RAISE EXCEPTION 'LW_RESOURCE_ACCEPTANCE_PROFILE_ACCESS_ROLE_CONFLICT';
    END IF;

    INSERT INTO access.course_memberships (course_id, actor_id, role, state, revision)
    VALUES ('{{ membership.courseId }}'::uuid, '{{ membership.actorId }}'::uuid,
            '{{ membership.role }}', 'active', 1)
    ON CONFLICT (course_id, actor_id, role) DO NOTHING;

    IF NOT EXISTS (
        SELECT 1 FROM access.actors
        WHERE actor_id = '{{ membership.actorId }}'::uuid
          AND issuer = '{{ membership.issuer }}'
          AND subject_sha256 = '{{ membership.subjectSha256 }}'
    ) OR NOT EXISTS (
        SELECT 1 FROM access.course_memberships
        WHERE course_id = '{{ membership.courseId }}'::uuid
          AND actor_id = '{{ membership.actorId }}'::uuid
          AND role = '{{ membership.role }}'
          AND state = 'active'
          AND revision = 1
    ) THEN
        RAISE EXCEPTION 'LW_RESOURCE_ACCEPTANCE_PROFILE_ACCESS_SEED_VERIFY_FAILED';
    END IF;
END
$resource_seed$;
{% endfor %}
DO $resource_seed_exact$
BEGIN
    IF (
        SELECT count(*)
        FROM access.course_memberships
        WHERE course_id = '{{ resource_application_access_seed.courseMemberships[0].courseId }}'::uuid
    ) <> {{ resource_application_access_seed.courseMemberships | length }} THEN
        RAISE EXCEPTION 'LW_RESOURCE_ACCEPTANCE_PROFILE_ACCESS_MEMBERSHIP_CONFLICT';
    END IF;
END
$resource_seed_exact$;
COMMIT;
