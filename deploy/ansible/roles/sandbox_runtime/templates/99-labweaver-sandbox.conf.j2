# The gVisor handler the sandbox `RuntimeClass` selects.
#
# `runtime_path` is the reviewed wrapper rather than `runsc` itself: CRI-O
# annotates containers with `io.kubernetes.cri-o.*` while gVisor reads the
# CRI-standard `io.kubernetes.cri.*` names, so the wrapper translates the bundle
# before `runsc` runs (see `labweaver-sandbox-runtime.j2`).
[crio.runtime.runtimes.{{ sandbox_runtime_name }}]
runtime_path = "{{ sandbox_runtime_handler_path }}"
runtime_type = "{{ sandbox_runtime_runtime_type }}"
monitor_path = "{{ sandbox_runtime_conmon_path }}"
