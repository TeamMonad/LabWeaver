{% for route in public_ingress_routes %}
{% if not loop.first %}---
{% endif %}
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: {{ route.name }}
  namespace: {{ route.namespace }}
  labels:
    app.kubernetes.io/part-of: labweaver-infrastructure
spec:
  parentRefs:
    - name: {{ public_ingress_gateway_name }}
      namespace: {{ public_ingress_namespace }}
  hostnames:
{% for hostname in route.hostnames %}
    - {{ hostname }}
{% endfor %}
  rules:
{% if route.redirect is defined %}
    - filters:
        - type: RequestRedirect
          requestRedirect:
            scheme: {{ route.redirect.scheme }}
            hostname: {{ route.redirect.hostname }}
            statusCode: {{ route.redirect.status_code }}
{% else %}
{% for rule in route.rules %}
    - matches:
{% for path in rule.paths %}
        - path:
            type: PathPrefix
            value: {{ path }}
{% endfor %}
      backendRefs:
        - name: {{ rule.service }}
          port: {{ rule.port }}
{% endfor %}
{% endif %}
{% endfor %}
