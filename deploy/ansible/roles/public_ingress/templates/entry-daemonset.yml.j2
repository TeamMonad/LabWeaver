apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: {{ public_ingress_entry_name }}
  namespace: {{ public_ingress_namespace }}
  labels:
    app.kubernetes.io/part-of: labweaver-infrastructure
spec:
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ public_ingress_entry_name }}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ public_ingress_entry_name }}
        app.kubernetes.io/part-of: labweaver-infrastructure
    spec:
      hostNetwork: true
      dnsPolicy: ClusterFirstWithHostNet
      nodeSelector:
{% for key, value in public_ingress_entry_node_selector.items() %}
        {{ key }}: "{{ value }}"
{% endfor %}
      tolerations:
        - operator: Exists
      containers:
        - name: haproxy
          image: {{ public_ingress_entry_image }}
          args:
            - -f
            - /usr/local/etc/haproxy/haproxy.cfg
          ports:
            - containerPort: 80
              protocol: TCP
            - containerPort: 443
              protocol: TCP
          securityContext:
            runAsUser: 0
            capabilities:
              add: [NET_BIND_SERVICE]
          volumeMounts:
            - name: config
              mountPath: /usr/local/etc/haproxy
          resources:
            requests:
              cpu: 10m
              memory: 32Mi
            limits:
              cpu: 200m
              memory: 128Mi
      volumes:
        - name: config
          configMap:
            name: {{ public_ingress_entry_name }}
