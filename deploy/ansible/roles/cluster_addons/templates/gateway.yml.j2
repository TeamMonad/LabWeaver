{% for namespace in labweaver_namespaces %}
apiVersion: v1
kind: Namespace
metadata: { name: {{ namespace }} }
---
{% endfor %}
apiVersion: v1
kind: ResourceQuota
metadata:
  name: labweaver-demo-quota
  namespace: labweaver-demo
spec:
  hard:
    requests.cpu: '8'
    requests.memory: 16Gi
    limits.cpu: '16'
    limits.memory: 32Gi
    requests.storage: 200Gi
    persistentvolumeclaims: '30'
    pods: '100'
---
apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: public-gateway
  namespace: labweaver-demo
spec:
  gatewayClassName: cilium
  infrastructure:
    annotations:
      metallb.io/loadBalancerIPs: {{ gateway_vip | quote }}
  listeners:
    - name: http
      protocol: HTTP
      port: 80
      allowedRoutes:
        namespaces: { from: Same }
