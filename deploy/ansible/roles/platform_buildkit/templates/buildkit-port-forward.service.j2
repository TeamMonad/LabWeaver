[Unit]
Description=LabWeaver Sprint 2 BuildKit controller tunnel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/kubectl --kubeconfig {{ platform_buildkit_controller_kubeconfig }} --server {{ platform_buildkit_controller_api_server }} --namespace {{ platform_buildkit_namespace }} port-forward --address 127.0.0.1 service/buildkit {{ platform_buildkit_controller_port }}:1234
Restart=on-failure
RestartSec=2s
User=root
Group=root
RuntimeDirectory=labweaver-buildkit-port-forward
RuntimeDirectoryMode=0700
Environment=HOME=/run/labweaver-buildkit-port-forward
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
