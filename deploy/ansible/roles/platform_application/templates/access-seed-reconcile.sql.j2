\set ON_ERROR_STOP on
BEGIN;
SET ROLE lw_access_owner;
INSERT INTO access.service_identities (
    service_identity_id, san_uri, service_name, state, revision
) VALUES
    ('00000000-0000-7000-8000-000000000101', 'spiffe://labweaver/control-service', 'control-service', 'active', 1),
    ('00000000-0000-7000-8000-000000000102', 'spiffe://labweaver/openssh-gateway', 'openssh-gateway', 'active', 1)
ON CONFLICT (service_identity_id) DO NOTHING;
{% for membership in platform_application_access_seed.courseMemberships %}
INSERT INTO access.actors (actor_id, issuer, subject_sha256)
VALUES ('{{ membership.actorId }}', '{{ membership.issuer }}', '{{ membership.subjectSha256 }}')
ON CONFLICT (actor_id) DO UPDATE
SET issuer = EXCLUDED.issuer, subject_sha256 = EXCLUDED.subject_sha256;
SET ROLE lw_control_owner;
INSERT INTO control.course_memberships (
    course_id, actor_id, role, object_role, state, revision
) VALUES (
    '{{ membership.courseId }}', '{{ membership.actorId }}', '{{ membership.role }}',
    CASE '{{ membership.role }}' WHEN 'teacher' THEN 'instructor' ELSE 'participant' END,
    'active', 1
)
ON CONFLICT (course_id, actor_id) DO UPDATE
SET role = EXCLUDED.role,
    object_role = EXCLUDED.object_role,
    state = 'active',
    revision = control.course_memberships.revision + 1,
    updated_at = now();
SET ROLE lw_access_owner;
{% endfor %}
DO $verify_seed$
BEGIN
SET ROLE lw_access_owner;
{% for membership in platform_application_access_seed.courseMemberships %}
IF NOT EXISTS (SELECT 1 FROM access.actors
    WHERE actor_id = '{{ membership.actorId }}'
      AND issuer = '{{ membership.issuer }}'
      AND subject_sha256 = '{{ membership.subjectSha256 }}') THEN
    RAISE EXCEPTION 'PLATFORM_ACCESS_SEED_CONFLICT';
END IF;
SET ROLE lw_control_owner;
IF NOT EXISTS (SELECT 1 FROM control.course_memberships
    WHERE course_id = '{{ membership.courseId }}'
      AND actor_id = '{{ membership.actorId }}'
      AND role = '{{ membership.role }}'
      AND object_role = CASE '{{ membership.role }}' WHEN 'teacher' THEN 'instructor' ELSE 'participant' END
      AND state = 'active') THEN
    RAISE EXCEPTION 'PLATFORM_CONTROL_SEED_CONFLICT';
END IF;
SET ROLE lw_access_owner;
{% endfor %}
END
$verify_seed$;
COMMIT;
