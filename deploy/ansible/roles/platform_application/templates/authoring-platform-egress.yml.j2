apiVersion: cilium.io/v2
kind: CiliumNetworkPolicy
metadata:
  name: authoring-platform-egress
  namespace: {{ platform_application_authoring_namespace }}
  labels:
    app.kubernetes.io/part-of: labweaver
    app.kubernetes.io/managed-by: ansible
spec:
  endpointSelector: {}
  egress:
    # The only model destination is the Agent's in-cluster gateway Service. No host,
    # FQDN or external provider allowance is permitted from the sandbox namespace.
    - toEndpoints:
        - matchLabels:
            k8s:io.kubernetes.pod.namespace: {{ platform_application_model_namespace }}
            k8s:app.kubernetes.io/name: {{ platform_application_model_service_name }}
      toPorts:
        - ports:
            - port: "{{ platform_application_model_service_port | string }}"
              protocol: TCP
    # A CIDR allowance never matches an in-cluster pod destination, so the
    # object store is admitted as an endpoint of the data namespace.
    - toEndpoints:
        - matchLabels:
            k8s:io.kubernetes.pod.namespace: {{ platform_application_data_namespace }}
      toPorts:
        - ports:
            - port: "{{ platform_application_object_store_service_port | string }}"
              protocol: TCP
