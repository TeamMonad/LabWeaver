fulcio:
  forceNamespace: {{ private_sigstore_namespace }}
  namespace: {create: false, name: {{ private_sigstore_namespace }}}
  config:
    format: json
    contents:
      OIDCIssuers:
        {{ private_sigstore_oidc_issuer | to_json }}:
          IssuerURL: {{ private_sigstore_oidc_issuer | to_json }}
          ClientID: {{ private_sigstore_oidc_audience | to_json }}
          Type: username
          SubjectDomain: {{ private_sigstore_oidc_subject_domain | to_json }}
          ChallengeClaim: sub
  createcerts: {enabled: false}
  server:
    replicaCount: {{ private_sigstore_replicas }}
    secret: {{ private_sigstore_fulcio_secret_name }}
    ingress: {http: {enabled: false}, grpc: {enabled: false}}
    service: {type: ClusterIP}
    logging: {production: true}
    resources: {{ private_sigstore_resources | to_json }}
    securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, runAsNonRoot: true, runAsUser: 65533, capabilities: {drop: [ALL]}, seccompProfile: {type: RuntimeDefault}}
ctlog:
  forceNamespace: {{ private_sigstore_namespace }}
  namespace: {create: false, name: {{ private_sigstore_namespace }}}
  createtree: {enabled: false}
  createctconfig:
    enabled: true
    privateSecret: {{ private_sigstore_ctlog_secret_name }}
    pubkeysecret: {{ private_sigstore_ctlog_secret_name }}
  trillian:
    namespace: {{ private_sigstore_namespace }}
    logServer: {name: trillian-logserver, portRPC: 8091}
  server:
    replicaCount: {{ private_sigstore_replicas }}
    config: {key: treeID, treeID: {{ private_sigstore_ctlog_tree_id | to_json }}}
    ingress: {enabled: false}
    service: {type: ClusterIP}
    resources: {{ private_sigstore_resources | to_json }}
    securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, runAsNonRoot: true, runAsUser: 65533, capabilities: {drop: [ALL]}, seccompProfile: {type: RuntimeDefault}}
rekor:
  forceNamespace: {{ private_sigstore_namespace }}
  namespace: {create: false, name: {{ private_sigstore_namespace }}}
  createtree: {enabled: false}
  server:
    replicaCount: {{ private_sigstore_replicas }}
    config: {key: treeID, treeID: {{ private_sigstore_rekor_tree_id | to_json }}}
    signer: file:///var/run/rekor-signer/private-key.pem
    signerFileSecretOptions:
      secretName: {{ private_sigstore_rekor_secret_name }}
      privateKeySecretKey: private
      secretMountPath: /var/run/rekor-signer
      secretMountSubPath: private-key.pem
    ingress: {enabled: false}
    service: {type: ClusterIP}
    resources: {{ private_sigstore_resources | to_json }}
    securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, runAsNonRoot: true, runAsUser: 65533, capabilities: {drop: [ALL]}, seccompProfile: {type: RuntimeDefault}}
  redis:
    persistence: {enabled: true, storageClass: {{ private_sigstore_storage_class }}, size: 5Gi}
    resources: {{ private_sigstore_resources | to_json }}
  trillian:
    enabled: false
    forceNamespace: {{ private_sigstore_namespace }}
    logServer: {name: trillian-logserver, portRPC: 8091}
trillian:
  forceNamespace: {{ private_sigstore_namespace }}
  namespace: {create: false, name: {{ private_sigstore_namespace }}}
  mysql:
    auth: {existingSecret: {{ private_sigstore_trillian_mysql_secret_name }}}
    persistence: {enabled: true, storageClass: {{ private_sigstore_storage_class }}, size: 20Gi}
tuf:
  enabled: true
  forceNamespace: {{ private_sigstore_namespace }}
  namespace: {create: false, name: {{ private_sigstore_namespace }}}
  ingress: {create: false}
  deployment:
    replicas: {{ private_sigstore_replicas }}
    resources: {{ private_sigstore_resources | to_json }}
    containerSecurityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, runAsNonRoot: true, capabilities: {drop: [ALL]}}
    securityContext: {seccompProfile: {type: RuntimeDefault}}
  secrets:
    rekor: {create: false, enabled: true, name: {{ private_sigstore_rekor_secret_name }}, key: public, path: rekor.pub}
    fulcio: {create: false, enabled: true, name: {{ private_sigstore_fulcio_secret_name }}, key: cert, path: fulcio_v1.crt.pem}
    ctlog: {create: false, enabled: true, name: {{ private_sigstore_ctlog_secret_name }}, key: public, path: ctfe.pub}
    tsa: {create: false, enabled: false}
copySecretJob: {enabled: false}
tsa: {enabled: false}
