{
  "schema_version": "private-sigstore-deployment-manifest.v1",
  "run_id": {{ sigstore_run_id | to_json }},
  "commit_sha": {{ sigstore_commit_sha | to_json }},
  "cluster_uid": {{ sigstore_cluster_uid.stdout | to_json }},
  "inventory_hash": {{ sigstore_inventory_hash | to_json }},
  "base_deployment_manifest_hash": {{ sigstore_deployment_manifest_hash | to_json }},
  "component_lock_hash": {{ sigstore_component_lock_hash | to_json }},
  "chart": {
    "version": {{ private_sigstore_chart_version | to_json }},
    "archive_sha256": {{ sigstore_lock.scaffold_chart_archive_sha256 | to_json }}
  },
  "tuf_root_hash": {{ private_sigstore_expected_tuf_root_sha256 | to_json }},
  "workload_identity_policy_hash": {{ {
    'issuer': private_sigstore_oidc_issuer,
    'audience': private_sigstore_oidc_audience,
    'client_id': private_sigstore_oidc_client_id,
    'allowed_subjects': private_sigstore_allowed_subjects
  } | to_json | hash('sha256') | to_json }},
  "network": {
    "public_endpoint": false,
    "tls_required": true,
    "default_deny": true
  }
}
