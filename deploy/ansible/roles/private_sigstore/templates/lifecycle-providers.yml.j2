apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: private-sigstore-lifecycle
  namespace: {{ private_sigstore_namespace }}
  labels:
    app.kubernetes.io/name: private-sigstore-lifecycle
    app.kubernetes.io/part-of: private-sigstore
spec:
  accessModes: [ReadWriteMany]
  storageClassName: {{ private_sigstore_lifecycle_storage_class }}
  resources:
    requests:
      storage: {{ private_sigstore_lifecycle_storage_size }}
{% for provider in [
  {'name': private_sigstore_backup_provider, 'action': 'backup', 'schedule': '0 2 * * *'},
  {'name': private_sigstore_verify_provider, 'action': 'verify', 'schedule': '30 3 * * *'},
  {'name': private_sigstore_restore_provider, 'action': 'restore', 'schedule': '0 4 * * 0'},
  {'name': private_sigstore_rotation_provider, 'action': 'rotate', 'schedule': '0 5 * * *'},
  {'name': private_sigstore_dr_provider, 'action': 'disaster-recovery', 'schedule': '0 6 1 */3 *'}
] %}
---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: {{ provider.name }}
  namespace: {{ private_sigstore_namespace }}
  labels:
    app.kubernetes.io/name: private-sigstore-lifecycle
    app.kubernetes.io/part-of: private-sigstore
    labweaver.io/private-sigstore-provider: {{ provider.action }}
spec:
  schedule: {{ provider.schedule | to_json }}
  timeZone: Etc/UTC
  suspend: true
  concurrencyPolicy: Forbid
  startingDeadlineSeconds: 3600
  successfulJobsHistoryLimit: 3
  failedJobsHistoryLimit: 5
  jobTemplate:
    spec:
      backoffLimit: 1
      activeDeadlineSeconds: 1200
      ttlSecondsAfterFinished: 86400
      template:
        metadata:
          labels:
            app.kubernetes.io/name: private-sigstore-lifecycle
            app.kubernetes.io/part-of: private-sigstore
        spec:
          restartPolicy: Never
          automountServiceAccountToken: false
          securityContext:
            runAsNonRoot: true
            runAsUser: 65532
            runAsGroup: 65532
            fsGroup: 65532
            seccompProfile: {type: RuntimeDefault}
          containers:
            - name: lifecycle
              image: {{ sigstore_lock.images.database }}
              imagePullPolicy: IfNotPresent
              command: [/bin/sh, /opt/labweaver/run.sh]
              env:
                - {name: LABWEAVER_ACTION, value: {{ provider.action | to_json }}}
                - {name: MYSQL_HOST, value: trillian-mysql}
                - {name: MYSQL_USER, value: root}
                - name: MYSQL_PASSWORD
                  valueFrom: {secretKeyRef: {name: {{ private_sigstore_trillian_mysql_secret_name }}, key: mysql-root-password}}
                - name: MYSQL_DATABASE
                  valueFrom: {secretKeyRef: {name: {{ private_sigstore_trillian_mysql_secret_name }}, key: mysql-database}}
              resources:
                requests: {cpu: 100m, memory: 128Mi}
                limits: {cpu: 1, memory: 1Gi}
              securityContext:
                allowPrivilegeEscalation: false
                capabilities: {drop: [ALL]}
                readOnlyRootFilesystem: true
              volumeMounts:
                - {name: lifecycle, mountPath: /data}
                - {name: runtime, mountPath: /tmp}
                - {name: script, mountPath: /opt/labweaver, readOnly: true}
                - {name: tuf, mountPath: /authority/tuf, readOnly: true}
                - {name: trees, mountPath: /authority/trees, readOnly: true}
          volumes:
            - name: lifecycle
              persistentVolumeClaim: {claimName: private-sigstore-lifecycle}
            - name: runtime
              emptyDir: {sizeLimit: 256Mi}
            - name: script
              configMap: {name: private-sigstore-lifecycle-script, defaultMode: 365}
            - name: tuf
              configMap: {name: {{ private_sigstore_tuf_metadata_configmap_name }}}
            - name: trees
              configMap: {name: {{ private_sigstore_tree_authority_configmap_name }}}
{% endfor %}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: private-sigstore-lifecycle-script
  namespace: {{ private_sigstore_namespace }}
  labels:
    app.kubernetes.io/name: private-sigstore-lifecycle
    app.kubernetes.io/part-of: private-sigstore
immutable: true
data:
  run.sh: |
    #!/bin/sh
    set -eu
    umask 077
    required='LABWEAVER_ACTION LABWEAVER_RUN_ID LABWEAVER_COMMIT_SHA LABWEAVER_CONTROLLER_ID LABWEAVER_CLUSTER_UID LABWEAVER_INVENTORY_HASH LABWEAVER_COMPONENT_LOCK_HASH LABWEAVER_DEPLOYMENT_MANIFEST_HASH LABWEAVER_CHART_ARCHIVE_HASH LABWEAVER_TRUST_BUNDLE_HASH LABWEAVER_TUF_ROOT_VERSION LABWEAVER_TUF_ROOT_HASH LABWEAVER_WORKLOAD_POLICY_HASH LABWEAVER_IMAGE_DIGESTS_JSON'
    for name in $required; do
      eval "value=\${$name:-}"
      [ -n "$value" ] || { echo "SIGSTORE_LIFECYCLE_RUNTIME_IDENTITY_MISSING:$name" >&2; exit 2; }
    done
    run_dir="/data/runs/$LABWEAVER_RUN_ID"
    mkdir -p "$run_dir"
    backup_json=null
    check_name="$LABWEAVER_ACTION"
    case "$LABWEAVER_ACTION" in
      backup)
        dump="$run_dir/trillian.sql"
        MYSQL_PWD="$MYSQL_PASSWORD" mysqldump --host="$MYSQL_HOST" --user="$MYSQL_USER" --single-transaction --quick --lock-tables=false "$MYSQL_DATABASE" > "$dump"
        test -s "$dump"
        cp /authority/tuf/1.root.json "$run_dir/1.root.json"
        cp /authority/trees/rekorTreeId "$run_dir/rekorTreeId"
        cp /authority/trees/ctTreeId "$run_dir/ctTreeId"
        tar -C "$run_dir" -czf "$run_dir/private-sigstore-backup.tar.gz" trillian.sql 1.root.json rekorTreeId ctTreeId
        artifact="sha256:$(sha256sum "$run_dir/private-sigstore-backup.tar.gz" | cut -d' ' -f1)"
        printf '%s\n' "$artifact" > "$run_dir/artifact.sha256"
        backup_json="{\"schema_version\":\"private-sigstore-backup.v1\",\"run_id\":\"$LABWEAVER_RUN_ID\",\"commit_sha\":\"$LABWEAVER_COMMIT_SHA\",\"cluster_uid\":\"$LABWEAVER_CLUSTER_UID\",\"inventory_sha256\":\"$LABWEAVER_INVENTORY_HASH\",\"deployment_manifest_sha256\":\"$LABWEAVER_DEPLOYMENT_MANIFEST_HASH\",\"component_lock_sha256\":\"$LABWEAVER_COMPONENT_LOCK_HASH\",\"tuf_root_sha256\":\"$LABWEAVER_TUF_ROOT_HASH\",\"trust_bundle_sha256\":\"$LABWEAVER_TRUST_BUNDLE_HASH\",\"artifact_sha256\":\"$artifact\",\"generated_at\":\"$(date -u +%Y-%m-%dT%H:%M:%S.000Z)\"}"
        printf '%s\n' "$backup_json" > "$run_dir/backup-manifest.json"
        ;;
      verify)
        test -s "$run_dir/private-sigstore-backup.tar.gz"
        expected="$(cat "$run_dir/artifact.sha256")"
        actual="sha256:$(sha256sum "$run_dir/private-sigstore-backup.tar.gz" | cut -d' ' -f1)"
        [ "$actual" = "$expected" ]
        curl --fail --silent --show-error --max-time 20 http://tuf-server/root.json >/dev/null
        curl --fail --silent --show-error --max-time 20 http://rekor-server/api/v1/log >/dev/null
        curl --fail --silent --show-error --max-time 20 http://fulcio-server/api/v1/rootCert >/dev/null
        ;;
      restore|disaster-recovery)
        test -s "$run_dir/trillian.sql"
        suffix="$(printf '%s' "$LABWEAVER_RUN_ID-$LABWEAVER_ACTION" | sha256sum | cut -c1-12)"
        drill_db="labweaver_drill_$suffix"
        trap 'MYSQL_PWD="$MYSQL_PASSWORD" mysql --host="$MYSQL_HOST" --user="$MYSQL_USER" -e "DROP DATABASE IF EXISTS \\`$drill_db\\`" >/dev/null 2>&1 || true' EXIT
        MYSQL_PWD="$MYSQL_PASSWORD" mysql --host="$MYSQL_HOST" --user="$MYSQL_USER" -e "CREATE DATABASE \\`$drill_db\\`"
        MYSQL_PWD="$MYSQL_PASSWORD" mysql --host="$MYSQL_HOST" --user="$MYSQL_USER" "$drill_db" < "$run_dir/trillian.sql"
        tables="$(MYSQL_PWD="$MYSQL_PASSWORD" mysql --batch --skip-column-names --host="$MYSQL_HOST" --user="$MYSQL_USER" -e "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='$drill_db'")"
        [ "$tables" -gt 0 ]
        MYSQL_PWD="$MYSQL_PASSWORD" mysql --host="$MYSQL_HOST" --user="$MYSQL_USER" -e "DROP DATABASE \\`$drill_db\\`"
        trap - EXIT
        ;;
      rotate)
        test -s /authority/tuf/1.root.json
        test -s /authority/trees/rekorTreeId
        test -s /authority/trees/ctTreeId
        check_name=rotation-plan-only
        ;;
      *) echo SIGSTORE_LIFECYCLE_ACTION_FORBIDDEN >&2; exit 2 ;;
    esac
    generated_at="$(date -u +%Y-%m-%dT%H:%M:%S.000Z)"
    report="{\"schema_version\":\"private-sigstore-lifecycle-report.v1\",\"action\":\"$LABWEAVER_ACTION\",\"status\":\"passed\",\"run_id\":\"$LABWEAVER_RUN_ID\",\"commit_sha\":\"$LABWEAVER_COMMIT_SHA\",\"controller_id\":\"$LABWEAVER_CONTROLLER_ID\",\"cluster_uid\":\"$LABWEAVER_CLUSTER_UID\",\"inventory_sha256\":\"$LABWEAVER_INVENTORY_HASH\",\"deployment_manifest_sha256\":\"$LABWEAVER_DEPLOYMENT_MANIFEST_HASH\",\"component_lock_sha256\":\"$LABWEAVER_COMPONENT_LOCK_HASH\",\"chart_archive_sha256\":\"$LABWEAVER_CHART_ARCHIVE_HASH\",\"image_digests\":$LABWEAVER_IMAGE_DIGESTS_JSON,\"trust_bundle_sha256\":\"$LABWEAVER_TRUST_BUNDLE_HASH\",\"tuf_root_version\":$LABWEAVER_TUF_ROOT_VERSION,\"tuf_root_sha256\":\"$LABWEAVER_TUF_ROOT_HASH\",\"workload_identity_policy_sha256\":\"$LABWEAVER_WORKLOAD_POLICY_HASH\",\"backup\":$backup_json,\"checks\":[{\"name\":\"$check_name\",\"status\":\"passed\",\"diagnosticCode\":null}],\"blocked_items\":[],\"unblock_owner\":null,\"exit_condition\":null,\"generated_at\":\"$generated_at\"}"
    printf 'LABWEAVER_REPORT_B64=%s\n' "$(printf '%s' "$report" | base64 | tr -d '\n')"
    if [ "$LABWEAVER_ACTION" = backup ]; then
      printf 'LABWEAVER_BACKUP_B64=%s\n' "$(printf '%s' "$backup_json" | base64 | tr -d '\n')"
    fi
