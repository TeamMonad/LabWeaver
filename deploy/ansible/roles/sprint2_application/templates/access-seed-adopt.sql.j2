\set ON_ERROR_STOP on
BEGIN;
INSERT INTO access.service_identities (
    service_identity_id, san_uri, service_name, state, revision
) VALUES
    ('00000000-0000-7000-8000-000000000101', 'spiffe://labweaver/control-service', 'control-service', 'active', 1),
    ('00000000-0000-7000-8000-000000000102', 'spiffe://labweaver/openssh-gateway', 'openssh-gateway', 'active', 1)
ON CONFLICT (service_identity_id) DO NOTHING;
{% for membership in sprint2_application_access_seed.courseMemberships %}
INSERT INTO access.actors (actor_id, issuer, subject_sha256)
VALUES ('{{ membership.actorId }}', '{{ membership.issuer }}', '{{ membership.subjectSha256 }}')
ON CONFLICT (actor_id) DO NOTHING;
INSERT INTO access.course_memberships (
    course_id, actor_id, role, state, revision
) VALUES (
    '{{ membership.courseId }}', '{{ membership.actorId }}', '{{ membership.role }}', 'active', 1
)
ON CONFLICT (course_id, actor_id, role) DO NOTHING;
{% endfor %}
DO $verify_seed$
BEGIN
    IF (SELECT count(*) FROM access.service_identities
        WHERE (service_identity_id, san_uri, service_name, state, revision) IN (
          ('00000000-0000-7000-8000-000000000101'::uuid, 'spiffe://labweaver/control-service', 'control-service', 'active', 1),
          ('00000000-0000-7000-8000-000000000102'::uuid, 'spiffe://labweaver/openssh-gateway', 'openssh-gateway', 'active', 1)
        )) <> 2 THEN
        RAISE EXCEPTION 'SPRINT2_SERVICE_IDENTITY_CONFLICT';
    END IF;
{% for membership in sprint2_application_access_seed.courseMemberships %}
    IF NOT EXISTS (SELECT 1 FROM access.actors
        WHERE actor_id = '{{ membership.actorId }}'
          AND issuer = '{{ membership.issuer }}'
          AND subject_sha256 = '{{ membership.subjectSha256 }}') OR
       NOT EXISTS (SELECT 1 FROM access.course_memberships
        WHERE course_id = '{{ membership.courseId }}'
          AND actor_id = '{{ membership.actorId }}'
          AND role = '{{ membership.role }}' AND state = 'active' AND revision = 1) THEN
        RAISE EXCEPTION 'SPRINT2_ACCESS_SEED_CONFLICT';
    END IF;
{% endfor %}
END
$verify_seed$;
COMMIT;
