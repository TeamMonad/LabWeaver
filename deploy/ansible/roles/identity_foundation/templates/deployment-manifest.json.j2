{
  "schema_version": "identity-foundation-deployment.v1",
  "run_id": {{ identity_run_id | to_json }},
  "cluster_uid": {{ identity_cluster_uid.stdout | to_json }},
  "secret_locator_sha256": {{ identity_secret_locator_sha256 | to_json }},
  "issuer": {{ ('https://' ~ identity_hostname ~ '/realms/' ~ identity_realm) | to_json }},
  "clients": [
    {% for client in identity_service_clients %}
    {"client_id": {{ client.client_id | to_json }}, "audience": {{ client.audience | to_json }}, "secret_name": {{ client.secret_name | to_json }}}{% if not loop.last %},{% endif %}
    {% endfor %}
  ],
  "role_assignments": {{ identity_service_role_assignments | to_json }},
  "gateway_vip": {{ identity_gateway_vip | to_json }},
  "keycloak_image": {{ identity_lock.images.keycloak | to_json }},
  "postgres_image": {{ identity_lock.images.postgres | to_json }}
}
