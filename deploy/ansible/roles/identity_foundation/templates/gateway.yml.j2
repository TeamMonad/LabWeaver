apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata: {name: identity-gateway, namespace: {{ identity_namespace }}}
spec:
  gatewayClassName: {{ identity_gateway_class }}
  infrastructure:
    annotations:
      metallb.io/loadBalancerIPs: {{ identity_gateway_vip }}
  listeners:
    - name: https
      protocol: HTTPS
      port: 443
      hostname: {{ identity_hostname }}
      tls: {mode: Terminate, certificateRefs: [{kind: Secret, name: {{ identity_tls_secret_name }}}]}
      allowedRoutes: {namespaces: {from: Same}}
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata: {name: keycloak, namespace: {{ identity_namespace }}}
spec:
  parentRefs: [{name: identity-gateway}]
  hostnames: [{{ identity_hostname }}]
  rules: [{backendRefs: [{name: {{ identity_name }}-http, port: 8080}]}]
