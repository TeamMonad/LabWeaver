apiVersion: batch/v1
kind: Job
metadata:
  name: identity-provision-{{ identity_run_suffix }}
  namespace: {{ identity_namespace }}
  labels: {labweaver.io/run-id: {{ identity_run_id }}, app.kubernetes.io/part-of: labweaver-identity}
spec:
  backoffLimit: 1
  activeDeadlineSeconds: 300
  ttlSecondsAfterFinished: 600
  template:
    metadata: {labels: {labweaver.io/run-id: {{ identity_run_id }}, app.kubernetes.io/part-of: labweaver-identity}}
    spec:
      restartPolicy: Never
      automountServiceAccountToken: false
      securityContext: {runAsNonRoot: true, runAsUser: 1000, seccompProfile: {type: RuntimeDefault}}
      containers:
        - name: provision
          image: {{ identity_lock.images.keycloak }}
          command: [/bin/bash, -ec]
          args:
            - |
              set -o pipefail
              kcadm=(/opt/keycloak/bin/kcadm.sh)
              "${kcadm[@]}" config credentials --server "http://{{ identity_name }}-http:8080" --realm master --user "$ADMIN_USERNAME" --password "$ADMIN_PASSWORD"
              if ! "${kcadm[@]}" get "realms/{{ identity_realm }}" >/dev/null 2>&1; then
                "${kcadm[@]}" create realms \
                  -s realm="{{ identity_realm }}" -s enabled=true -s sslRequired=external \
                  -s registrationAllowed=false -s resetPasswordAllowed=false \
                  -s loginWithEmailAllowed=false -s bruteForceProtected=true
              fi
              {% for client in identity_service_clients %}
              client_id="$("${kcadm[@]}" get clients -r "{{ identity_realm }}" -q clientId="{{ client.client_id }}" --fields id --format csv --noquotes | sed '/^[[:space:]]*$/d')"
              if [ -n "$client_id" ]; then
                test "$(printf '%s\n' "$client_id" | wc -l)" -eq 1
              else
                "${kcadm[@]}" create clients -r "{{ identity_realm }}" -s clientId="{{ client.client_id }}" -s enabled=true -s publicClient=false -s serviceAccountsEnabled=true -s standardFlowEnabled=false -s directAccessGrantsEnabled=false -s fullScopeAllowed=false
                client_id="$("${kcadm[@]}" get clients -r "{{ identity_realm }}" -q clientId="{{ client.client_id }}" --fields id --format csv --noquotes | sed '/^[[:space:]]*$/d')"
                test "$(printf '%s\n' "$client_id" | wc -l)" -eq 1
              fi
              test -n "$client_id"
              "${kcadm[@]}" update "clients/$client_id" -r "{{ identity_realm }}" \
                -s enabled=true -s publicClient=false -s serviceAccountsEnabled=true \
                -s standardFlowEnabled=false -s directAccessGrantsEnabled=false \
                -s fullScopeAllowed=false -s secret="$CLIENT_SECRET_{{ client.client_id | upper | replace('-', '_') }}"
              mapper_id=""
              while IFS=, read -r candidate_id candidate_name; do
                if [ "$candidate_name" = "labweaver-audience-{{ client.client_id }}" ]; then
                  mapper_id="$candidate_id"
                fi
              done < <("${kcadm[@]}" get "clients/$client_id/protocol-mappers/models" -r "{{ identity_realm }}" --fields id,name --format csv --noquotes)
              if [ -z "$mapper_id" ]; then
                "${kcadm[@]}" create "clients/$client_id/protocol-mappers/models" -r "{{ identity_realm }}" \
                  -s name=labweaver-audience-{{ client.client_id }} -s protocol=openid-connect \
                  -s protocolMapper=oidc-audience-resolve-mapper \
                  -s 'config."access.token.claim"=true' -s 'config."id.token.claim"=false' \
                  >/dev/null
                mapper_id=""
                while IFS=, read -r candidate_id candidate_name; do
                  if [ "$candidate_name" = "labweaver-audience-{{ client.client_id }}" ]; then
                    mapper_id="$candidate_id"
                  fi
                done < <("${kcadm[@]}" get "clients/$client_id/protocol-mappers/models" -r "{{ identity_realm }}" --fields id,name --format csv --noquotes)
              fi
              test -n "$mapper_id"
              "${kcadm[@]}" update "clients/$client_id/protocol-mappers/models/$mapper_id" -r "{{ identity_realm }}" \
                -s name=labweaver-audience-{{ client.client_id }} -s protocol=openid-connect \
                -s protocolMapper=oidc-audience-resolve-mapper \
                -s 'config."access.token.claim"=true' -s 'config."id.token.claim"=false'
              {% for self_target in identity_service_role_assignments if self_target.caller == client.client_id and self_target.target == client.client_id %}
              self_mapper_id=""
              while IFS=, read -r candidate_id candidate_name; do
                if [ "$candidate_name" = "labweaver-self-audience-{{ client.client_id }}" ]; then
                  self_mapper_id="$candidate_id"
                fi
              done < <("${kcadm[@]}" get "clients/$client_id/protocol-mappers/models" -r "{{ identity_realm }}" --fields id,name --format csv --noquotes)
              if [ -z "$self_mapper_id" ]; then
                "${kcadm[@]}" create "clients/$client_id/protocol-mappers/models" -r "{{ identity_realm }}" \
                  -s name=labweaver-self-audience-{{ client.client_id }} -s protocol=openid-connect \
                  -s protocolMapper=oidc-audience-mapper \
                  -s 'config."included.custom.audience"={{ client.audience }}' \
                  -s 'config."access.token.claim"=true' -s 'config."id.token.claim"=false' \
                  >/dev/null
                self_mapper_id=""
                while IFS=, read -r candidate_id candidate_name; do
                  if [ "$candidate_name" = "labweaver-self-audience-{{ client.client_id }}" ]; then
                    self_mapper_id="$candidate_id"
                  fi
                done < <("${kcadm[@]}" get "clients/$client_id/protocol-mappers/models" -r "{{ identity_realm }}" --fields id,name --format csv --noquotes)
              fi
              test -n "$self_mapper_id"
              "${kcadm[@]}" update "clients/$client_id/protocol-mappers/models/$self_mapper_id" -r "{{ identity_realm }}" \
                -s name=labweaver-self-audience-{{ client.client_id }} -s protocol=openid-connect \
                -s protocolMapper=oidc-audience-mapper \
                -s 'config."included.custom.audience"={{ client.audience }}' \
                -s 'config."access.token.claim"=true' -s 'config."id.token.claim"=false'
              {% endfor %}
              {% endfor %}
              {% for assignment in identity_service_role_assignments %}
              target_id="$("${kcadm[@]}" get clients -r "{{ identity_realm }}" -q clientId="{{ assignment.target }}" --fields id --format csv --noquotes | sed '/^[[:space:]]*$/d')"
              test "$(printf '%s\n' "$target_id" | wc -l)" -eq 1
              test -n "$target_id"
              {% for role in assignment.roles %}
              caller_id="$("${kcadm[@]}" get clients -r "{{ identity_realm }}" -q clientId="{{ assignment.caller }}" --fields id --format csv --noquotes | sed '/^[[:space:]]*$/d')"
              test "$(printf '%s\n' "$caller_id" | wc -l)" -eq 1
              test -n "$caller_id"
              if ! "${kcadm[@]}" get "clients/$target_id/roles/{{ role }}" -r "{{ identity_realm }}" >/dev/null 2>&1; then
                "${kcadm[@]}" create "clients/$target_id/roles" -r "{{ identity_realm }}" -s name={{ role }} -s clientRole=true -s composite=false
              fi
              role_id="$("${kcadm[@]}" get "clients/$target_id/roles/{{ role }}" -r "{{ identity_realm }}" --fields id --format csv --noquotes | sed '/^[[:space:]]*$/d')"
              test "$(printf '%s\n' "$role_id" | wc -l)" -eq 1
              test -n "$role_id"
              "${kcadm[@]}" add-roles -r "{{ identity_realm }}" --uusername "service-account-{{ assignment.caller }}" --cclientid "{{ assignment.target }}" --rolename "{{ role }}"
              scope_roles="$("${kcadm[@]}" get "clients/$caller_id/scope-mappings/clients/$target_id" -r "{{ identity_realm }}" --fields name --format csv --noquotes)"
              if ! printf '%s\n' "$scope_roles" | grep -Fx -- "{{ role }}" >/dev/null; then
                printf '[{"id":"%s","name":"%s","clientRole":true}]\n' "$role_id" "{{ role }}" |
                  "${kcadm[@]}" create "clients/$caller_id/scope-mappings/clients/$target_id" -r "{{ identity_realm }}" -f -
              fi
              scope_roles_after="$("${kcadm[@]}" get "clients/$caller_id/scope-mappings/clients/$target_id" -r "{{ identity_realm }}" --fields name --format csv --noquotes)"
              if ! printf '%s\n' "$scope_roles_after" | grep -Fx -- "{{ role }}" >/dev/null; then
                echo "IDENTITY_SERVICE_SCOPE_MAPPING_MISSING: {{ assignment.caller }} -> {{ assignment.target }} -> {{ role }}" >&2
                exit 1
              fi
              {% endfor %}
              {% endfor %}
          env:
            - name: ADMIN_USERNAME
              valueFrom: {secretKeyRef: {name: {{ identity_bootstrap_secret_name }}, key: username}}
            - name: ADMIN_PASSWORD
              valueFrom: {secretKeyRef: {name: {{ identity_bootstrap_secret_name }}, key: password}}
            {% for client in identity_service_clients %}
            - name: CLIENT_SECRET_{{ client.client_id | upper | replace('-', '_') }}
              valueFrom: {secretKeyRef: {name: {{ client.secret_name }}, key: client-secret}}
            {% endfor %}
          resources: {requests: {cpu: 50m, memory: 128Mi}, limits: {cpu: 500m, memory: 512Mi}}
          securityContext: {allowPrivilegeEscalation: false, capabilities: {drop: [ALL]}}
