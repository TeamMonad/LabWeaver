apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata: {name: identity-default-deny, namespace: {{ identity_namespace }}}
spec: {podSelector: {}, policyTypes: [Ingress, Egress]}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata: {name: identity-allow, namespace: {{ identity_namespace }}}
spec:
  podSelector: {matchLabels: {app.kubernetes.io/part-of: labweaver-identity}}
  policyTypes: [Ingress, Egress]
  ingress:
    - from:
        - namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: {{ identity_namespace }}}}
        - namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: sigstore-system}}
        - ipBlock: {cidr: 10.20.0.0/16}
  egress:
    - to: [{namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: {{ identity_namespace }}}}]
    - to: [{namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: kube-system}}}]
      ports: [{protocol: UDP, port: 53}, {protocol: TCP, port: 53}]
---
apiVersion: cilium.io/v2
kind: CiliumNetworkPolicy
metadata: {name: identity-gateway-ingress, namespace: {{ identity_namespace }}}
spec:
  endpointSelector: {matchLabels: {app.kubernetes.io/name: {{ identity_name }}}}
  ingress:
    - fromEntities: [ingress]
      toPorts:
        - ports: [{port: "8080", protocol: TCP}]
