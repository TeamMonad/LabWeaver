pid /tmp/nginx.pid;

events {}

http {
  client_body_temp_path /tmp/client_temp;
  proxy_temp_path /tmp/proxy_temp_path;
  fastcgi_temp_path /tmp/fastcgi_temp;
  uwsgi_temp_path /tmp/uwsgi_temp;
  scgi_temp_path /tmp/scgi_temp;
  access_log /dev/stdout;
  error_log /dev/stderr warn;

  server {
    listen 8443 ssl;
    server_name _;

    ssl_certificate /etc/nginx/tls/webserver.crt;
    ssl_certificate_key /etc/nginx/tls/webserver.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    # The guest-facing API is limited to the protocol paths required by the
    # NVIDIA client. Administrative /-/ endpoints, including client-token,
    # fall through to the 404 handler and remain reachable only through the
    # backend loopback socket for an operator using kubectl exec.
    location ^~ /auth/v1/ {
      proxy_set_header Host $http_host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto https;
      proxy_pass http://127.0.0.1:8080;
    }

    location ^~ /leasing/v1/ {
      proxy_set_header Host $http_host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto https;
      proxy_pass http://127.0.0.1:8080;
    }

    location / {
      return 404;
    }
  }
}
