---
apiVersion: v1
kind: Service
metadata:
  name: postgres
  namespace: {{ sprint2_foundation_namespace }}
  labels: {app.kubernetes.io/name: postgres, app.kubernetes.io/part-of: labweaver-infrastructure}
spec:
  clusterIP: None
  selector: {app.kubernetes.io/name: postgres}
  ports: [{name: postgres, port: 5432, targetPort: postgres}]
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: postgres
  namespace: {{ sprint2_foundation_namespace }}
spec:
  serviceName: postgres
  replicas: 1
  selector: {matchLabels: {app.kubernetes.io/name: postgres}}
  template:
    metadata:
      labels: {app.kubernetes.io/name: postgres, app.kubernetes.io/part-of: labweaver-infrastructure}
      annotations:
        labweaver.io/configuration-sha256: {{ sprint2_foundation_bundle_sha256 }}
    spec:
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 70
        runAsGroup: 70
        fsGroup: 70
        seccompProfile: {type: RuntimeDefault}
      containers:
        - name: postgres
          image: {{ sprint2_foundation_lock.postgresql.image }}
          args:
            - -c
            - ssl=on
            - -c
            - ssl_cert_file=/etc/postgres/tls/tls.crt
            - -c
            - ssl_key_file=/etc/postgres/tls/tls.key
            - -c
            - ssl_ca_file=/etc/postgres/tls/ca.crt
          env:
            - {name: POSTGRES_DB, value: labweaver}
            - {name: POSTGRES_USER, value: postgres}
            - {name: POSTGRES_PASSWORD_FILE, value: /etc/postgres/tls/postgres-password}
            - {name: PGDATA, value: /var/lib/postgresql/data/pgdata}
          ports: [{name: postgres, containerPort: 5432}]
          readinessProbe:
            exec: {command: [pg_isready, -U, postgres, -d, labweaver]}
            periodSeconds: 5
            timeoutSeconds: 2
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: {drop: [ALL]}
          resources:
            requests: {cpu: 250m, memory: 512Mi}
            limits: {cpu: "2", memory: 2Gi}
          volumeMounts:
            - {name: data, mountPath: /var/lib/postgresql/data}
            - {name: runtime, mountPath: /var/run/postgresql}
            - {name: tmp, mountPath: /tmp}
            - {name: secrets, mountPath: /etc/postgres/tls, readOnly: true}
      volumes:
        - {name: runtime, emptyDir: {sizeLimit: 16Mi}}
        - {name: tmp, emptyDir: {sizeLimit: 64Mi}}
        - name: secrets
          secret: {secretName: postgres-secrets, defaultMode: 0400}
  volumeClaimTemplates:
    - metadata: {name: data}
      spec:
        accessModes: [ReadWriteOnce]
        storageClassName: {{ sprint2_foundation_storage_class }}
        resources: {requests: {storage: {{ sprint2_foundation_postgres_storage }}}}
---
apiVersion: v1
kind: Service
metadata:
  name: nats
  namespace: {{ sprint2_foundation_namespace }}
  labels: {app.kubernetes.io/name: nats, app.kubernetes.io/part-of: labweaver-infrastructure}
spec:
  clusterIP: None
  selector: {app.kubernetes.io/name: nats}
  ports:
    - {name: client, port: 4222, targetPort: client}
    - {name: monitor, port: 8222, targetPort: monitor}
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: nats
  namespace: {{ sprint2_foundation_namespace }}
spec:
  serviceName: nats
  replicas: 1
  selector: {matchLabels: {app.kubernetes.io/name: nats}}
  template:
    metadata:
      labels: {app.kubernetes.io/name: nats, app.kubernetes.io/part-of: labweaver-infrastructure}
      annotations:
        labweaver.io/configuration-sha256: {{ sprint2_foundation_bundle_sha256 }}
    spec:
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        runAsGroup: 1000
        fsGroup: 1000
        seccompProfile: {type: RuntimeDefault}
      containers:
        - name: nats
          image: {{ sprint2_foundation_lock.sprint2_foundation.nats }}
          args: [-c, /etc/nats/nats-server.conf]
          ports:
            - {name: client, containerPort: 4222}
            - {name: monitor, containerPort: 8222}
          readinessProbe:
            httpGet: {path: /healthz, port: monitor}
            periodSeconds: 5
            timeoutSeconds: 2
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: {drop: [ALL]}
          resources:
            requests: {cpu: 100m, memory: 128Mi}
            limits: {cpu: "1", memory: 512Mi}
          volumeMounts:
            - {name: data, mountPath: /data}
            - {name: config, mountPath: /etc/nats/nats-server.conf, subPath: nats-server.conf, readOnly: true}
            - {name: secrets, mountPath: /etc/nats/tls, readOnly: true}
      volumes:
        - {name: config, configMap: {name: nats-config}}
        - {name: secrets, secret: {secretName: nats-server-secrets, defaultMode: 0400}}
  volumeClaimTemplates:
    - metadata: {name: data}
      spec:
        accessModes: [ReadWriteOnce]
        storageClassName: {{ sprint2_foundation_storage_class }}
        resources: {requests: {storage: {{ sprint2_foundation_nats_storage }}}}
---
apiVersion: v1
kind: Service
metadata:
  name: minio
  namespace: {{ sprint2_foundation_namespace }}
  labels: {app.kubernetes.io/name: minio, app.kubernetes.io/part-of: labweaver-infrastructure}
spec:
  clusterIP: None
  selector: {app.kubernetes.io/name: minio}
  ports:
    - {name: api, port: 9000, targetPort: api}
    - {name: console, port: 9001, targetPort: console}
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: minio
  namespace: {{ sprint2_foundation_namespace }}
spec:
  serviceName: minio
  replicas: 1
  selector: {matchLabels: {app.kubernetes.io/name: minio}}
  template:
    metadata:
      labels: {app.kubernetes.io/name: minio, app.kubernetes.io/part-of: labweaver-infrastructure}
      annotations:
        labweaver.io/configuration-sha256: {{ sprint2_foundation_bundle_sha256 }}
    spec:
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        # The root-squashed NFS provisioner creates each dynamic subdirectory
        # as nobody:nobody. Bind MinIO to that non-root identity rather than
        # attempting a privileged chown that the export correctly rejects.
        runAsUser: 65534
        runAsGroup: 65534
        fsGroup: 65534
        seccompProfile: {type: RuntimeDefault}
      containers:
        - name: minio
          image: {{ sprint2_foundation_lock.sprint2_foundation.minio }}
          args: [server, /data, --certs-dir, /etc/minio/certs, --console-address, ":9001"]
          env:
            - name: MINIO_ROOT_USER
              valueFrom: {secretKeyRef: {name: minio-secrets, key: root-user}}
            - name: MINIO_ROOT_PASSWORD
              valueFrom: {secretKeyRef: {name: minio-secrets, key: root-password}}
          ports:
            - {name: api, containerPort: 9000}
            - {name: console, containerPort: 9001}
          readinessProbe:
            httpGet: {path: /minio/health/ready, port: api, scheme: HTTPS}
            periodSeconds: 5
            timeoutSeconds: 2
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: {drop: [ALL]}
          resources:
            requests: {cpu: 250m, memory: 512Mi}
            limits: {cpu: "2", memory: 2Gi}
          volumeMounts:
            - {name: data, mountPath: /data}
            - {name: tmp, mountPath: /tmp}
            - {name: secrets, mountPath: /etc/minio/certs, readOnly: true}
      volumes:
        - {name: tmp, emptyDir: {sizeLimit: 64Mi}}
        - name: secrets
          secret:
            secretName: minio-secrets
            defaultMode: 0400
            items:
              - {key: public.crt, path: public.crt}
              - {key: private.key, path: private.key}
              - {key: ca.crt, path: CAs/ca.crt}
  volumeClaimTemplates:
    - metadata: {name: data}
      spec:
        accessModes: [ReadWriteOnce]
        storageClassName: {{ sprint2_foundation_minio_storage_class }}
        resources: {requests: {storage: {{ sprint2_foundation_minio_storage }}}}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata: {name: default-deny, namespace: {{ sprint2_foundation_namespace }}}
spec:
  podSelector: {}
  policyTypes: [Ingress, Egress]
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata: {name: owner-services, namespace: {{ sprint2_foundation_namespace }}}
spec:
  podSelector:
    matchExpressions:
      - {key: app.kubernetes.io/name, operator: In, values: [postgres, nats, minio]}
  policyTypes: [Ingress, Egress]
  ingress:
    - from:
        - podSelector: {}
        - namespaceSelector:
            matchLabels: {kubernetes.io/metadata.name: labweaver-system}
        # Freeze workers run in per-environment namespaces and need the same
        # owner-service read path as the evaluation owner. The worker Job
        # remains bound to one immutable submission and has no write credentials.
        - namespaceSelector:
            matchLabels: {labweaver.io/environment: "true"}
  egress:
    - to:
        - podSelector: {}
    - to:
        - namespaceSelector:
            matchLabels: {kubernetes.io/metadata.name: kube-system}
          podSelector:
            matchLabels: {k8s-app: kube-dns}
      ports: [{protocol: UDP, port: 53}, {protocol: TCP, port: 53}]
---
apiVersion: cilium.io/v2
kind: CiliumNetworkPolicy
metadata: {name: admin-probes, namespace: {{ sprint2_foundation_namespace }}}
spec:
  endpointSelector:
    matchExpressions:
      - {key: app.kubernetes.io/name, operator: In, values: [postgres, nats, minio]}
  # Cilium represents traffic originating from any cluster node by reserved identities rather
  # than its node IP. This admits only those trusted identities on the three TLS administration
  # ports; it does not admit Pod, LAN or public source identities.
  ingress:
    - fromEntities: [host, remote-node]
      toPorts:
        - ports:
            - {port: "5432", protocol: TCP}
            - {port: "4222", protocol: TCP}
            - {port: "9000", protocol: TCP}
