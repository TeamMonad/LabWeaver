apiVersion: cilium.io/v2
kind: CiliumClusterwideNetworkPolicy
metadata:
  name: labweaver-host-firewall
  labels:
    app.kubernetes.io/part-of: labweaver-infrastructure
spec:
  description: >-
    Node firewall for the LabWeaver cluster, enforced by Cilium Host Firewall
    in place of firewalld. Cluster node-to-node and health traffic is allowed
    wholesale; the management SSH, the public entry (80/443), the WireGuard
    management mesh (51820/udp) and ICMP echo are allowed from outside.
  nodeSelector:
    matchLabels: {}
  ingress:
    - fromEntities:
        - cluster
        - health
        - remote-node
    - fromCIDR:
        - 0.0.0.0/0
      toPorts:
        - ports:
            - port: "22"
              protocol: TCP
            - port: "80"
              protocol: TCP
            - port: "443"
              protocol: TCP
            - port: "51820"
              protocol: UDP
    - icmps:
        - fields:
            - type: EchoRequest
              family: IPv4
