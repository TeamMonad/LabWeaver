# Non-secret Agent authority and durable worker configuration for Issue #48.
database_url_file: "secrets/agent-runtime-url"
database_max_connections: 20
control_mtls:
  bind_addr: "127.0.0.1:9445"
  server_certificate_file: "secrets/agent-server-cert.pem"
  server_key_file: "secrets/agent-server-key.pem"
  client_ca_file: "secrets/internal-client-ca.pem"
  allowed_san_uris: ["spiffe://labweaver/control-service"]
  required_eku: "clientAuth"
object_store:
  binding: "problem-package-minio-v1"
  endpoint: "https://minio.internal:9000/"
  bucket: "labweaver-problem-packages"
  region: "labweaver-internal-1"
  objectPrefix: "problem-packages"
  uploadTtlSeconds: 900
  maxObjectBytes: 67108864
  forcePathStyle: true
object_store_access_key_file: "secrets/minio-access-key"
object_store_secret_key_file: "secrets/minio-secret-key"
object_store_session_token_file: null
classifier_binding: "labweaver-dlp-v1"
classifier_revision: 1
worker_id: "agent-worker-01"
dispatch_lease_seconds: 120
track_lease_seconds: 120
poll_interval_milliseconds: 500
# Values are read from mounted files and passed into an env-cleared Claude Code process.
worker_environment_files:
  ANTHROPIC_API_KEY: "secrets/anthropic-api-key"
build:
  # Served by the deployment-owned executor binding immutable ArtifactRef inputs
  # to restricted BuildKit, private Harbor/Trivy, and Private Sigstore.
  provider_subject: "labweaver.provider.container_build.execute.v2"
  builder_binding: "buildkit-primary-v1"
  scanner_binding: "trivy-primary-v1"
  signer_binding: "sigstore-private-v1"
  registry_binding: "harbor-primary-v1"
  policy_id: "00000000-0000-7000-8000-000000000002"
  policy_revision: 1
  scanner_name: "trivy"
  scanner_version: "0.72.0"
  scanner_database_sha256: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  trust_bundle_sha256: "d58414fc98a5de1ad8c269290835b407ff258b3f567dab3399fbc2911454a981"
  expected_fulcio_issuer: "https://keycloak.internal/realms/workloads"
  expected_certificate_subject: "spiffe://labweaver/image-builder"
  registry_robot_name: "runtime-puller"
  evidence_ttl_milliseconds: 3600000
  stage_timeout_milliseconds: 120000
  worker_lease_seconds: 180
  retry_delay_milliseconds: 2000
  max_attempts: 3
nats:
  server: "tls://nats.internal:4222"
  ca_file: "secrets/nats-ca.pem"
  client_certificate_file: "secrets/agent-nats-client-cert.pem"
  client_private_key_file: "secrets/agent-nats-client-key.pem"
  credentials_file: "secrets/agent-nats.creds"
  # Deployment-owned durable consumer filter: labweaver.control.agent_build.requested.v2
  build_command_stream_name: "LABWEAVER_CONTROL_COMMANDS"
  build_command_consumer_name: "agent-build-command-v2"
  build_command_quarantine_subject: "labweaver.agent.quarantine.build_command.v2"
  publish_timeout_milliseconds: 5000
  outbox_poll_milliseconds: 250
