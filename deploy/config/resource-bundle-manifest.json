{
  "apiVersion": "deploy.labweaver.io/resource-bundle-manifest/v1",
  "namespace": "labweaver-system",
  "configMaps": {
    "resource-service-config": ["capacity.json", "http.yaml"]
  },
  "secrets": {
    "resource-service-secrets": [
      "database-url",
      "nats-server",
      "nats-ca.pem",
      "nats-client.crt",
      "nats-client.key",
      "nats.creds",
      "mtls-ca.pem",
      "oidc-ca.pem",
      "service-client-secret",
      "tls.crt",
      "tls.key",
      "resource-delegation-key"
    ]
  }
}
