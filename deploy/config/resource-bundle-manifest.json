{
  "apiVersion": "deploy.labweaver.io/resource-bundle-manifest/v1",
  "namespace": "labweaver-system",
  "configMaps": {
    "resource-service-config": [
      "capacity.json",
      "http.yaml"
    ]
  },
  "secrets": {
    "resource-service-secrets": [
      "database-url",
      "nats-server",
      "nats-ca.pem",
      "nats-client.crt",
