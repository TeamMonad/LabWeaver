# Non-secret Issue #48 Control deployment contract. Every credential value is a mounted
# file locator; no ambient credential chain, proxy, endpoint, or fallback is consulted.
database_url_file: "secrets/control-runtime-url"
database_max_connections: 20
gateway_mtls:
  bind_addr: "127.0.0.1:9444"
  server_certificate_file: "secrets/control-server-cert.pem"
  server_key_file: "secrets/control-server-key.pem"
  client_ca_file: "secrets/internal-client-ca.pem"
  allowed_san_uris: ["spiffe://labweaver/gateway"]
  required_eku: "clientAuth"
access_service:
  base_url: "https://access-service.internal:9443/"
  ca_certificate_file: "secrets/internal-server-ca.pem"
  client_certificate_file: "secrets/control-client-cert.pem"
  client_private_key_file: "secrets/control-client-key.pem"
  timeout_milliseconds: 2000
agent_service:
  base_url: "https://agent-service.internal:9445/"
  ca_certificate_file: "secrets/internal-server-ca.pem"
  client_certificate_file: "secrets/control-client-cert.pem"
  client_private_key_file: "secrets/control-client-key.pem"
  timeout_milliseconds: 5000
object_store:
  binding: "problem-package-minio-v1"
  endpoint: "https://minio.internal:9000/"
  bucket: "labweaver-problem-packages"
  region: "labweaver-internal-1"
  objectPrefix: "problem-packages"
  uploadTtlSeconds: 900
  maxObjectBytes: 67108864
  forcePathStyle: true
object_store_access_key_file: "secrets/minio-access-key"
object_store_secret_key_file: "secrets/minio-secret-key"
object_store_session_token_file: null
control:
  packageObjectPrefix: "problem-packages"
  uploadTtlSeconds: 900
  completionLeaseSeconds: 300
  maxPackageFiles: 1000
  maxPackageBytes: 268435456
  retentionPolicyId: "00000000-0000-7000-8000-000000000001"
  retentionSeconds: 31536000
  sseRetentionSeconds: 604800
  trustRevision: 1
  imagePolicyId: "00000000-0000-7000-8000-000000000002"
  imagePolicyRevision: 1
  trustBundleSha256: "d58414fc98a5de1ad8c269290835b407ff258b3f567dab3399fbc2911454a981"
  fulcioIssuer: "https://keycloak.internal/realms/labweaver"
  certificateSubject: "spiffe://labweaver/image-builder"
  environmentSchemaSha256: "5fda6cc49df3bca2f1d52160b73da608319795b387848c2aa8c0c801b02620a5"
  evaluationSchemaSha256: "09b03648f13a463250030cd38f928a8528c5818b627e3cb7d65ee5c9f80fc6d7"
cleanup_interval_seconds: 30
nats:
  server: "tls://nats.internal:4222"
  ca_file: "secrets/nats-ca.pem"
  client_certificate_file: "secrets/control-nats-client-cert.pem"
  client_private_key_file: "secrets/control-nats-client-key.pem"
  credentials_file: "secrets/control-nats.creds"
  stream_name: "LABWEAVER_AGENT_EVENTS"
  consumer_name: "control-agent-run-projection-v1"
  quarantine_subject: "labweaver.control.quarantine.agent_run.v1"
