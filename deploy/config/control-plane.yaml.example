# Non-secret Issue #48 Control deployment contract. Every credential value is a mounted
# file locator; no ambient credential chain, proxy, endpoint, or fallback is consulted.
database_url_file: "/etc/labweaver/secrets/database-url"
database_max_connections: 20
gateway_mtls:
  bind_addr: "0.0.0.0:9444"
  server_certificate_file: "/etc/labweaver/secrets/tls.crt"
  server_key_file: "/etc/labweaver/secrets/tls.key"
  client_ca_file: "/etc/labweaver/secrets/mtls-ca.pem"
  allowed_san_uris: ["spiffe://labweaver/access-service"]
  required_eku: "clientAuth"
access_service:
  base_url: "https://access-service:9443/"
  ca_certificate_file: "/etc/labweaver/secrets/mtls-ca.pem"
  client_certificate_file: "/etc/labweaver/secrets/tls.crt"
  client_private_key_file: "/etc/labweaver/secrets/tls.key"
  timeout_milliseconds: 2000
agent_service:
  base_url: "https://agent-service:9445/"
  ca_certificate_file: "/etc/labweaver/secrets/mtls-ca.pem"
  client_certificate_file: "/etc/labweaver/secrets/tls.crt"
  client_private_key_file: "/etc/labweaver/secrets/tls.key"
  timeout_milliseconds: 5000
evaluation_service:
  base_url: "https://evaluation-service:9447/"
  ca_certificate_file: "/etc/labweaver/secrets/mtls-ca.pem"
  client_certificate_file: "/etc/labweaver/secrets/tls.crt"
  client_private_key_file: "/etc/labweaver/secrets/tls.key"
  timeout_milliseconds: 5000
object_store:
  binding: "problem-package-minio-v1"
  # The Control endpoint is also the authority embedded in browser upload
  # signatures. It must be the reviewed same-origin Gateway endpoint whose
  # /<bucket> route preserves both Host and path when forwarding to MinIO.
  endpoint: "https://demo.lab.example/"
  bucket: "labweaver-artifacts"
  region: "labweaver-internal-1"
  objectPrefix: "problem-packages"
  uploadTtlSeconds: 900
  maxObjectBytes: 67108864
  forcePathStyle: true
object_store_access_key_file: "/etc/labweaver/secrets/minio-access-key"
object_store_secret_key_file: "/etc/labweaver/secrets/minio-secret-key"
object_store_session_token_file: null
control:
  packageObjectPrefix: "problem-packages"
  uploadTtlSeconds: 900
  completionLeaseSeconds: 300
  maxPackageFiles: 1000
  maxPackageBytes: 268435456
  retentionPolicyId: "00000000-0000-7000-8000-000000000001"
  retentionSeconds: 31536000
  sseRetentionSeconds: 604800
  trustRevision: 1
  imagePolicyId: "00000000-0000-7000-8000-000000000002"
  imagePolicyRevision: 1
  environmentSchemaSha256: "54533e71dbd3a3c2914b2f49fab87a491c73085e7722aebe416a4452a6044b31"
  evaluationSchemaSha256: "e6ccd10b1c34d8aa3024e29ec0884488f07a9be0df9f6b2c47605a1279d62cc7"
  containerBuild:
    builderBinding: "buildkit-primary-v1"
    # Harbor registry and project scope used by the fixed build executor.
    outputRepositoryPrefix: "harbor.example.invalid/labweaver-system"
    dockerfilePath: "Dockerfile"
    network:
      mode: "restricted"
      allowed_registries: ["harbor.example.invalid"]
    maxDurationMilliseconds: 600000
    maxCpuMillicores: 2000
    maxMemoryBytes: 2147483648
  virtualMachineBase:
    providerBinding: "kubevirt-primary-v1"
    storageClassBinding: "vm-rwo-primary-v1"
    artifactId: "00000000-0000-7000-8000-000000000003"
    baseDisk:
      binding: "ubuntu-24.04-v1"
      sourceRegistryDigest: "docker://quay.io/containerdisks/ubuntu@sha256:d28194a16351320fa9a093e18233033508a745566eb8ba3b309c32924bf155a5"
      diskSha256: "ffe6203da54deeb6db5d2a98a83f9ec8e55f149d3f7ba622e1abe5fa966ee3d6"
      capacityBytes: 10737418240
    format: "qcow2"
  evaluationRuntime:
    sourceSha256: "1111111111111111111111111111111111111111111111111111111111111111"
    providerBinding: "evaluation-kubernetes-primary-v1"
    configurationSha256: "2222222222222222222222222222222222222222222222222222222222222222"
    migrationCatalogSha256: "3333333333333333333333333333333333333333333333333333333333333333"
    runnerImage: "harbor.example.invalid/labweaver/evaluation-runner@sha256:4444444444444444444444444444444444444444444444444444444444444444"
    runtimeArtifactSha256: "5555555555555555555555555555555555555555555555555555555555555555"
cleanup_interval_seconds: 30
nats:
  server: "tls://nats.labweaver-data.svc:4222"
  ca_file: "/etc/labweaver/secrets/nats-ca.pem"
  client_certificate_file: "/etc/labweaver/secrets/nats-client.crt"
  client_private_key_file: "/etc/labweaver/secrets/nats-client.key"
  credentials_file: "/etc/labweaver/secrets/nats.creds"
  stream_name: "LABWEAVER_AGENT_EVENTS"
  consumer_name: "control-agent-run-projection-v1"
  quarantine_subject: "labweaver.agent.quarantine.control_agent_run.v1"
  # Deployment-owned durable consumer filter_subjects:
  # - labweaver.agent.build.completed.v1
  # - labweaver.agent.build.failed.v1
  build_consumer_name: "control-agent-build-projection-v1"
  build_quarantine_subject: "labweaver.agent.quarantine.control_agent_build.v1"
  publish_timeout_milliseconds: 5000
  outbox_poll_milliseconds: 250
