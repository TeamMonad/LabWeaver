{
  "apiVersion": "deploy.labweaver.io/sprint2-bundle-manifest/v1",
  "namespace": "labweaver-data",
  "configMaps": {
    "nats-config": ["nats-server.conf"]
  },
  "secrets": {
    "minio-secrets": ["ca.crt", "private.key", "public.crt", "root-password", "root-user"],
    "nats-server-secrets": ["ca.crt", "tls.crt", "tls.key"],
    "postgres-secrets": ["ca.crt", "client.crt", "client.key", "postgres-password", "tls.crt", "tls.key"]
  }
}
