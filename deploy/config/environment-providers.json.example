[
  {
    "binding": "container-primary-v1",
    "subject": "labweaver.provider.kubernetes.container.v1",
    "providerKind": "container",
    "accessNamespace": "labweaver-system",
    "accessPodLabel": "access-service",
    "imageRepositoryPrefix": "harbor.internal/labweaver-system",
    "imagePullSecretName": "harbor-course-pull",
    "workspaceStorageClassName": "nfs-rwx",
    "activeImagePolicyId": "00000000-0000-7000-8000-000000000002",
    "activeImagePolicyRevision": 1,
    "activeTrustRevision": 1
  },
  {
    "binding": "kubevirt-primary-v1",
    "subject": "labweaver.provider.kubevirt.vm.v1",
    "providerKind": "kubevirt",
    "gatewayNamespace": "access-system",
    "gatewayPodLabel": "openssh-gateway",
    "collectorNamespace": "labweaver-evaluation",
    "collectorPodLabel": "evaluation-freeze-worker",
    "storageClassBinding": "vm-rwo-primary-v1",
    "storageClassName": "local-path",
    "dataSourceNamespace": "labweaver-system",
    "dataSourceName": "ubuntu-lab-base-v1",
    "guestUser": "lab",
    "collectorWorkspaceRoot": "/home/lab/workspace",
    "sshUserCaPublicKey": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDIhz2GK/XCUj4i6Q5yQJNL1MKDXETe1aM1lHYMGt2SQ",
    "sshUserCaPrivateKeyPath": "/etc/labweaver/secrets/collector-ssh-user-ca-key",
    "vmiMemoryOverheadBytes": 536870912,
    "cdiImporterCpuRequestMillicores": 1000,
    "cdiImporterCpuLimitMillicores": 4000,
    "cdiImporterMemoryRequestBytes": 262144000,
    "cdiImporterMemoryLimitBytes": 1073741824,
    "cdiScratchStorageBytes": 10737418240,
    "activeTrustRevision": 1
  }
]
