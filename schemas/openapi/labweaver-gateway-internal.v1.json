      "Problem": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        },
        "description": "RFC 9457 problem detail"
      }
    },
    "schemas": {
      "OperationAccepted": {
        "additionalProperties": false,
        "properties": {
          "operationId": {
            "format": "uuid",
            "type": "string"
          },
          "revision": {
            "minimum": 1,
            "type": "integer"
          },
          "statusUrl": {
            "format": "uri-reference",
            "type": "string"
          }
        },
        "required": [
          "operationId",
          "revision",
          "statusUrl"
        ],
        "type": "object"
      },
      "ProblemDetails": {
        "properties": {
          "detail": {
            "type": "string"
          },
          "diagnosticCode": {
            "pattern": "^LW_[A-Z0-9_]+$",
            "type": "string"
          },
          "instance": {
            "format": "uri-reference",
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "status": {
            "maximum": 599,
            "minimum": 400,
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "traceId": {
            "type": "string"
          },
          "type": {
            "format": "uri-reference",
            "type": "string"
          },
          "violations": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "code": {
                  "pattern": "^LW_[A-Z0-9_]+$",
                  "type": "string"
                },
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "field",
                "code",
                "message"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "diagnosticCode",
          "requestId",
          "retryable"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "serviceMtls": {
        "description": "Deployment-controlled service identity; never exposed to browser clients.",
        "type": "mutualTLS"
      }
    }
  },
