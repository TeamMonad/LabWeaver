{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.labweaver.io/results/platform-image-package-manifest.v2.schema.json",
  "title": "PlatformImagePackageManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "run_id",
    "release_id",
    "source_commit",
    "source_date_epoch",
    "component_lock_hash",
    "platform",
    "registry",
    "builder",
    "images"
  ],
  "properties": {
    "schema_version": { "const": "platform-image-package-manifest.v2" },
    "profile": { "enum": ["platform", "resource"] },
    "run_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "release_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "source_date_epoch": { "type": "integer", "minimum": 1 },
    "component_lock_hash": { "$ref": "#/$defs/sha256" },
    "platform": { "const": "linux/amd64" },
    "registry": { "type": "string", "minLength": 1, "maxLength": 253 },
    "builder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["buildkit", "buildx"],
      "properties": {
        "buildkit": { "type": "string", "minLength": 1 },
        "buildx": { "type": "string", "minLength": 1 }
      }
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/image" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "profile": { "const": "resource" } }, "required": ["profile"] },
      "then": {
        "properties": {
          "images": {
            "contains": { "properties": { "component": { "const": "resource-service" } }, "required": ["component"] }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "reference", "digest"],
      "properties": {
        "component": {
          "enum": [
            "access-service",
            "agent-service",
            "control-service",
            "environment-service",
            "evaluation-service",
            "openssh-gateway",
            "resource-service",
            "web"
          ]
        },
        "reference": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
