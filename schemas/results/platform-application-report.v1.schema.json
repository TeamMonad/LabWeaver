{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.labweaver.io/results/platform-application-report.v1.schema.json",
  "title": "PlatformApplicationReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "source_commit", "cluster_uid", "package_manifest_sha256", "migration_catalog_sha256", "configuration_manifest_sha256", "configuration_bundle_sha256", "destructive_reset", "retained", "adopted", "deployment"],
  "properties": {
    "schema_version": {"const": "labweaver.platform-application-report.v1"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,62}$"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "cluster_uid": {"type": "string", "minLength": 1},
    "package_manifest_sha256": {"$ref": "#/$defs/digest"},
    "migration_catalog_sha256": {"$ref": "#/$defs/digest"},
    "configuration_manifest_sha256": {"$ref": "#/$defs/digest"},
    "configuration_bundle_sha256": {"$ref": "#/$defs/digest"},
    "destructive_reset": {"const": false},
    "retained": {"type": "array", "minItems": 9, "uniqueItems": true, "items": {"type": "string"}},
    "adopted": {
      "type": "object", "additionalProperties": false,
      "required": ["postgres_domains", "nats_streams", "minio_bucket", "harbor_project", "keycloak_realm"],
      "properties": {
        "postgres_domains": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"enum": ["control", "access", "environment", "agent", "evaluation", "resource"]}},
        "nats_streams": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"type": "string"}},
        "minio_bucket": {"type": "string", "minLength": 1},
        "harbor_project": {"type": "string", "minLength": 1},
        "keycloak_realm": {"type": "string", "minLength": 1}
      }
    },
    "deployment": {
      "type": "object", "additionalProperties": false,
      "required": ["release", "namespace", "helm_revision", "workloads", "images"],
      "properties": {
        "release": {"const": "labweaver"},
        "namespace": {"const": "labweaver-system"},
        "helm_revision": {"type": "integer", "minimum": 1},
        "workloads": {"type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true, "items": {"type": "string"}},
        "images": {"type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": {"type": "string", "pattern": "^.+@sha256:[0-9a-f]{64}$"}}
      }
    }
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
