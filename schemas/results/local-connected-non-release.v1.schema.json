{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labweaver.invalid/schemas/results/local-connected-non-release.v1.schema.json",
  "title": "LabWeaver Local Connected Non-Release Preflight",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mode", "releaseEligible", "sourceCommit", "runId", "dockerContext", "kubernetesContext", "nodeCount", "readyNodeCount", "storageClasses", "capabilities", "blockers"],
  "properties": {
    "schemaVersion": {"const": "local-connected-non-release.v1"},
    "mode": {"const": "local-hostpath"},
    "releaseEligible": {"const": false},
    "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "runId": {"type": "string", "format": "uuid"},
    "dockerContext": {"type": "string"},
    "kubernetesContext": {"type": "string"},
    "nodeCount": {"type": ["integer", "null"], "minimum": 0},
    "readyNodeCount": {"type": ["integer", "null"], "minimum": 0},
    "storageClasses": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["singleReadyNode", "hostpath", "nfsRwx", "kubevirt", "cdi", "ecnuApiKey"],
      "properties": {
        "singleReadyNode": {"type": "boolean"},
        "hostpath": {"type": "boolean"},
        "nfsRwx": {"type": "boolean"},
        "kubevirt": {"type": "boolean"},
        "cdi": {"type": "boolean"},
        "ecnuApiKey": {"type": "boolean"}
      }
    },
    "blockers": {"type": "array", "items": {"type": "string", "pattern": "^LW_[A-Z0-9_]+$"}, "uniqueItems": true}
  }
}
