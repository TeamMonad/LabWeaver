{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labweaver.invalid/schemas/results/release-gate-report.v2.schema.json",
  "title": "Sprint2ReleaseGateReportV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "sourceCommit", "runId", "deploymentManifest", "resourceDeploymentManifest", "migrationCatalog", "platformImages", "resourceImages", "runtimeArtifacts", "checks"],
  "properties": {
    "schemaVersion": {"const": "sprint2-release-gate-report.v2"}, "status": {"const": "passed"}, "sourceCommit": {"$ref": "#/$defs/commit"}, "runId": {"$ref": "#/$defs/uuid"},
    "deploymentManifest": {"$ref": "#/$defs/evidence"}, "resourceDeploymentManifest": {"$ref": "#/$defs/evidence"}, "migrationCatalog": {"$ref": "#/$defs/evidence"},
    "platformImages": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/image"}}, "resourceImages": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/image"}},
    "runtimeArtifacts": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/artifact"}}, "checks": {"type": "array", "minItems": 11, "maxItems": 11, "items": {"$ref": "#/$defs/check"}}
  },
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "uuid": {"type": "string", "format": "uuid"},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/digest"}}},
    "image": {"type": "object", "additionalProperties": false, "required": ["component", "reference"], "properties": {"component": {"type": "string", "minLength": 1}, "reference": {"type": "string", "pattern": "@sha256:[0-9a-f]{64}$"}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["name", "digest"], "properties": {"name": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}}},
    "check": {"type": "object", "additionalProperties": false, "required": ["name", "status", "mode", "sourceCommit", "runId", "evidence"], "properties": {"name": {"type": "string", "minLength": 1}, "status": {"const": "passed"}, "mode": {"const": "connected"}, "sourceCommit": {"$ref": "#/$defs/commit"}, "runId": {"$ref": "#/$defs/uuid"}, "evidence": {"$ref": "#/$defs/evidence"}}}
  }
}
