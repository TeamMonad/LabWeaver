{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labweaver.dev/schemas/results/sprint3-acceptance-assets.v1.schema.json",
  "title": "Sprint 3 acceptance assets",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "evidenceBoundary", "scenarios", "samples", "negativeCases", "frontendAcceptance", "mockBoundary", "featureComplete"],
  "properties": {
    "schemaVersion": {"const": "sprint3-acceptance-assets.v1"},
    "evidenceBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currentEvidenceLevel", "allowedExecutionModes", "connected", "liveRuntime", "productionIdentity", "claim"],
      "properties": {
        "currentEvidenceLevel": {"const": "E1"},
        "allowedExecutionModes": {"const": ["planned", "fixture", "local"]},
        "connected": {"const": false},
        "liveRuntime": {"const": false},
        "productionIdentity": {"const": false},
        "claim": {"const": "acceptance-assets-only"}
      }
    },
    "scenarios": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/scenario"}},
    "samples": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/sample"}},
    "negativeCases": {"type": "array", "minItems": 81, "maxItems": 81, "items": {"$ref": "#/$defs/negativeCase"}},
    "frontendAcceptance": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/frontend"}},
    "mockBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedFor", "cannotSatisfy"],
      "properties": {
        "allowedFor": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "cannotSatisfy": {"type": "array", "minItems": 11, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "featureComplete": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiresIssue64", "requiresRealE4", "fixtureMaySatisfy", "sameIdentityFields", "validatorCommand"],
      "properties": {
        "requiresIssue64": {"const": true},
        "requiresRealE4": {"const": ["oj-real-e4", "container-linux-clone-real-e4", "kubevirt-linux-clone-real-e4"]},
        "fixtureMaySatisfy": {"const": false},
        "sameIdentityFields": {"const": ["sourceCommit", "buildIdentity", "deploymentIdentity", "environmentIdentity"]},
        "validatorCommand": {"const": "cargo xtask acceptance-assets validate-feature-complete --report <path>"}
      }
    }
  },
  "$defs": {
    "stringList": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "userValue", "currentEvidenceLevel", "executionMode", "providerMode", "isFixture", "isMock", "futureLiveE4Required", "productEntrypoint", "actor", "tenantCourseIdentity", "authenticationIdentity", "authorizationIdentity", "submissionIdentity", "labReleaseIdentity", "evaluationReleaseIdentity", "environmentTemplateReleaseIdentity", "imageDigest", "specHash", "artifactHash", "runId", "stepRunId", "attemptId", "resourceIdentity", "accessIdentity", "traceId", "preconditions", "actions", "expectedTransitions", "expectedDiagnostics", "expectedEvidence", "failureEvidence", "cleanup", "rollback", "e4SuccessConditions"],
      "properties": {
        "id": {"enum": ["oj-real-e4", "container-linux-clone-real-e4", "kubevirt-linux-clone-real-e4"]},
        "userValue": {"type": "string", "minLength": 1},
        "currentEvidenceLevel": {"const": "E1"},
        "executionMode": {"const": "fixture"},
        "providerMode": {"const": "mock"},
        "isFixture": {"const": true},
        "isMock": {"const": true},
        "futureLiveE4Required": {"const": true},
        "productEntrypoint": {"type": "string", "minLength": 1},
        "actor": {"type": "string", "minLength": 1},
        "tenantCourseIdentity": {"type": "string", "minLength": 1},
        "authenticationIdentity": {"type": "string", "minLength": 1},
        "authorizationIdentity": {"type": "string", "minLength": 1},
        "submissionIdentity": {"type": "string", "minLength": 1},
        "labReleaseIdentity": {"type": "string", "minLength": 1},
        "evaluationReleaseIdentity": {"type": "string", "minLength": 1},
        "environmentTemplateReleaseIdentity": {"type": "string", "minLength": 1},
        "imageDigest": {"const": "required-at-live-e4"},
        "specHash": {"const": "required-at-live-e4"},
        "artifactHash": {"const": "required-at-live-e4"},
        "runId": {"const": "required-at-live-e4"},
        "stepRunId": {"const": "required-at-live-e4"},
        "attemptId": {"const": "required-at-live-e4"},
        "resourceIdentity": {"const": "required-at-live-e4"},
        "accessIdentity": {"const": "required-at-live-e4"},
        "traceId": {"const": "required-at-live-e4"},
        "preconditions": {"$ref": "#/$defs/stringList"},
        "actions": {"$ref": "#/$defs/stringList"},
        "expectedTransitions": {"$ref": "#/$defs/stringList"},
        "expectedDiagnostics": {"$ref": "#/$defs/stringList"},
        "expectedEvidence": {"$ref": "#/$defs/stringList"},
        "failureEvidence": {"$ref": "#/$defs/stringList"},
        "cleanup": {"$ref": "#/$defs/stringList"},
        "rollback": {"$ref": "#/$defs/stringList"},
        "e4SuccessConditions": {"$ref": "#/$defs/stringList"}
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path", "sha256", "language", "expectedTerminalState", "expectedDiagnostic", "staticValidationOnly", "deterministic", "networkAllowed", "filesystemAllowed", "safeToExecuteOnHost", "limits", "evidenceBoundary"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "kind": {"enum": ["correct", "compile-error", "wrong-answer", "time-limit", "memory-limit", "output-limit"]},
        "path": {"type": "string", "pattern": "^[a-z0-9_./-]+\\.cpp$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "language": {"const": "c++17"},
        "expectedTerminalState": {"type": "string", "minLength": 1},
        "expectedDiagnostic": {"type": ["string", "null"]},
        "inputPath": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
        "inputSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "expectedOutputPath": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
        "expectedOutputSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "actualOutputPath": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
        "actualOutputSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "staticValidationOnly": {"const": true},
        "deterministic": {"const": true},
        "networkAllowed": {"const": false},
        "filesystemAllowed": {"const": false},
        "safeToExecuteOnHost": {"const": false},
        "limits": {
          "type": "object", "additionalProperties": false,
          "required": ["compileWallMs", "runWallMs", "cpuMs", "memoryBytes", "outputBytes"],
          "properties": {
            "compileWallMs": {"type": "integer", "minimum": 1}, "runWallMs": {"type": "integer", "minimum": 1},
            "cpuMs": {"type": "integer", "minimum": 1}, "memoryBytes": {"type": "integer", "minimum": 1},
            "outputBytes": {"type": "integer", "minimum": 1}
          }
        },
        "evidenceBoundary": {"const": "static-asset-only-not-executed"}
      }
    },
    "negativeCase": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "category", "vector", "stage", "syntheticInput", "expectedResult", "expectedDiagnostic", "safeStaticFixture", "performsNetworkRequest", "persistsState", "futureLiveEvidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "category": {"enum": ["ssrf", "vulnerability", "secret", "malicious-file", "license", "signature", "invalid-evaluator-output", "cross-tenant-access"]},
        "vector": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "stage": {"type": "string", "minLength": 1},
        "syntheticInput": {"type": "string", "minLength": 1, "maxLength": 200},
        "expectedResult": {"const": "rejected"},
        "expectedDiagnostic": {"type": "string", "pattern": "^LW_[A-Z0-9_]+$"},
        "safeStaticFixture": {"const": true},
        "performsNetworkRequest": {"const": false},
        "persistsState": {"const": false},
        "futureLiveEvidence": {"type": "string", "minLength": 1},
        "objectExistenceDisclosed": {"type": "boolean"},
        "createsIdempotencyFact": {"type": "boolean"},
        "createsOutbox": {"type": "boolean"}
      }
    },
    "frontend": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "scenarioId", "actor", "route", "action", "observableOutcome", "failureDiagnostic", "currentStatus", "futureEvidenceLevel", "fixtureMaySatisfy", "requiresAuthentication", "requiresAuthorization", "requiresBackendReadback", "requiresCleanup"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "scenarioId": {"enum": ["oj-real-e4", "container-linux-clone-real-e4", "kubevirt-linux-clone-real-e4"]},
        "actor": {"enum": ["teacher", "student", "admin"]},
        "route": {"type": "string", "pattern": "^/"},
        "action": {"type": "string", "minLength": 1},
        "observableOutcome": {"type": "string", "minLength": 1},
        "failureDiagnostic": {"type": "string", "pattern": "^LW_[A-Z0-9_]+$"},
        "currentStatus": {"const": "planned"},
        "futureEvidenceLevel": {"const": "E4"},
        "fixtureMaySatisfy": {"const": false},
        "requiresAuthentication": {"const": true},
        "requiresAuthorization": {"const": true},
        "requiresBackendReadback": {"const": true},
        "requiresCleanup": {"const": true}
      }
    }
  }
}
