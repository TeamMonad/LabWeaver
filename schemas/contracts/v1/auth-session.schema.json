{
  "$defs": {
    "ActorId": {
      "description": "Strongly typed UUIDv7 identifier for `ActorId`.",
      "type": "string"
    },
    "AuthenticatedActor": {
      "additionalProperties": false,
      "description": "Safe actor identity derived from a verified OIDC token.",
      "properties": {
        "actorId": {
          "$ref": "#/$defs/ActorId",
          "description": "Local durable actor identity."
        },
        "expiresAt": {
          "$ref": "#/$defs/UtcTimestamp",
          "description": "Verified identity expiration."
        },
        "roles": {
          "description": "Verified base roles.",
          "items": {
            "$ref": "#/$defs/PlatformRole"
          },
          "type": "array"
        }
      },
      "required": [
        "actorId",
        "roles",
        "expiresAt"
      ],
      "type": "object"
    },
    "AuthorizationScope": {
      "description": "Resource scope evaluated by the authorization boundary.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Platform-wide endpoint with no course resource.",
          "properties": {
            "kind": {
              "const": "global",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Course-scoped endpoint.",
          "properties": {
            "course_id": {
              "$ref": "#/$defs/CourseId"
            },
            "kind": {
              "const": "course",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "course_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Project-scoped endpoint.",
          "properties": {
            "course_id": {
              "$ref": "#/$defs/CourseId"
            },
            "kind": {
              "const": "project",
              "type": "string"
            },
            "project_id": {
              "$ref": "#/$defs/ProjectId"
            }
          },
          "required": [
            "kind",
            "course_id",
            "project_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Environment owner resolution is supplied by the owning service.",
          "properties": {
            "course_id": {
              "$ref": "#/$defs/CourseId"
            },
            "environment_id": {
              "$ref": "#/$defs/EnvironmentId"
            },
            "environment_revision": {
              "$ref": "#/$defs/Revision",
              "description": "Exact Environment-authoritative revision resolved for this request."
            },
            "kind": {
              "const": "environment",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "course_id",
            "environment_id",
            "environment_revision"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Internal service endpoint authenticated by mTLS.",
          "properties": {
            "kind": {
              "const": "service",
              "type": "string"
            },
            "service_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "service_id"
          ],
          "type": "object"
        }
      ]
    },
    "CourseId": {
      "description": "Strongly typed UUIDv7 identifier for `CourseId`.",
      "type": "string"
    },
    "EnvironmentId": {
      "description": "Strongly typed UUIDv7 identifier for `EnvironmentId`.",
      "type": "string"
    },
    "PlatformRole": {
      "description": "Base role asserted by the configured OIDC issuer.",
      "oneOf": [
        {
          "const": "teacher",
          "description": "Course teacher with an active course membership.",
          "type": "string"
        },
        {
          "const": "student",
          "description": "Course student with an active course membership.",
          "type": "string"
        },
        {
          "const": "platform_admin",
          "description": "Platform operator; course scope is still required for course data.",
          "type": "string"
        }
      ]
    },
    "ProjectId": {
      "description": "Strongly typed UUIDv7 identifier for `ProjectId`.",
      "type": "string"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "UtcTimestamp": {
      "description": "UTC timestamp serialized with a literal `Z` and millisecond precision.",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Safe browser-session representation. OIDC subjects, tokens, and provider\nsession identifiers are intentionally excluded from this public DTO.",
  "properties": {
    "actor": {
      "$ref": "#/$defs/AuthenticatedActor",
      "description": "Authenticated durable actor."
    },
    "authorizationRevision": {
      "$ref": "#/$defs/Revision",
      "description": "Current authorization revision for the returned effective scopes."
    },
    "expiresAt": {
      "$ref": "#/$defs/UtcTimestamp",
      "description": "Earliest expiry that invalidates this session representation."
    },
    "scopes": {
      "description": "Effective scopes known by the Access authority at response time.",
      "items": {
        "$ref": "#/$defs/AuthorizationScope"
      },
      "type": "array"
    }
  },
  "required": [
    "actor",
    "authorizationRevision",
    "scopes",
    "expiresAt"
  ],
  "title": "AuthSession",
  "type": "object"
}
