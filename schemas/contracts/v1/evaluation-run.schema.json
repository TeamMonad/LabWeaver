{
  "$defs": {
    "ActorId": {
      "description": "Strongly typed UUIDv7 identifier for `ActorId`.",
      "type": "string"
    },
    "CourseId": {
      "description": "Strongly typed UUIDv7 identifier for `CourseId`.",
      "type": "string"
    },
    "DiagnosticCode": {
      "description": "Stable machine-readable diagnostic code.\n\nConsumers must treat an unknown `LW_*` code as blocking. The newtype is intentionally open so\nadditive diagnostics do not force a wire-version change.",
      "type": "string"
    },
    "EvaluationReleaseId": {
      "description": "Strongly typed UUIDv7 identifier for `EvaluationReleaseId`.",
      "type": "string"
    },
    "EvaluationRunId": {
      "description": "Strongly typed UUIDv7 identifier for `EvaluationRunId`.",
      "type": "string"
    },
    "EvaluationRunIdentity": {
      "additionalProperties": false,
      "description": "Immutable run identity joining release, frozen submission and trace evidence.",
      "properties": {
        "runtimeIdentity": {
          "$ref": "#/$defs/EvaluationRuntimeIdentity"
        },
        "traceId": {
          "type": "string"
        }
      },
      "required": [
        "runtimeIdentity",
        "traceId"
      ],
      "type": "object"
    },
    "EvaluationRunState": {
      "description": "Public run lifecycle.",
      "enum": [
        "queued",
        "running",
        "cancelling",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "EvaluationRuntimeIdentity": {
      "additionalProperties": false,
      "description": "Immutable build and deployment identity that must match every run using the release.",
      "properties": {
        "providerBinding": {
          "description": "Explicit runtime provider binding chosen by Control and enforced by Evaluation.",
          "type": "string"
        },
        "runnerImage": {
          "description": "Digest-pinned runner image reference.",
          "type": "string"
        }
      },
      "required": [
        "providerBinding",
        "runnerImage"
      ],
      "type": "object"
    },
    "EvaluationStepFailurePolicy": {
      "description": "Stable failure behavior copied from the immutable `EvaluationSpec` step.",
      "enum": [
        "stop",
        "continue",
        "continue_advisory"
      ],
      "type": "string"
    },
    "EvaluationStepRole": {
      "description": "Stable role copied from the immutable `EvaluationSpec` step.",
      "enum": [
        "gate",
        "score",
        "advisory"
      ],
      "type": "string"
    },
    "EvaluationStepRun": {
      "additionalProperties": false,
      "description": "PostgreSQL-authoritative state for one declared evaluation step.",
      "properties": {
        "awardedScore": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "cleanupVerified": {
          "type": "boolean"
        },
        "completedAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtcTimestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "currentAttempt": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "dependsOn": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "diagnosticCode": {
          "anyOf": [
            {
              "$ref": "#/$defs/DiagnosticCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "failurePolicy": {
          "$ref": "#/$defs/EvaluationStepFailurePolicy"
        },
        "id": {
          "$ref": "#/$defs/EvaluationStepRunId"
        },
        "maxScore": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "position": {
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "review": {
          "anyOf": [
            {
              "$ref": "#/$defs/GoalReview"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional advisory review. Only a successful Advisory step may carry a review.\n\nThe review is an informational projection and never contributes to `awarded_score`."
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "role": {
          "$ref": "#/$defs/EvaluationStepRole"
        },
        "runId": {
          "$ref": "#/$defs/EvaluationRunId"
        },
        "startedAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtcTimestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "$ref": "#/$defs/EvaluationStepRunState"
        },
        "stepId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "runId",
        "stepId",
        "position",
        "role",
        "failurePolicy",
        "dependsOn",
        "state",
        "revision",
        "currentAttempt",
        "maxScore",
        "cleanupVerified"
      ],
      "type": "object"
    },
    "EvaluationStepRunId": {
      "description": "Strongly typed UUIDv7 identifier for `EvaluationStepRunId`.",
      "type": "string"
    },
    "EvaluationStepRunState": {
      "description": "Public step lifecycle.",
      "enum": [
        "pending",
        "running",
        "retryable",
        "succeeded",
        "failed",
        "cancelled",
        "skipped"
      ],
      "type": "string"
    },
    "EvidenceLocation": {
      "additionalProperties": false,
      "description": "Bounded source location cited by an advisory finding.",
      "properties": {
        "end_line": {
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "type": "string"
        },
        "start_line": {
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "start_line",
        "end_line"
      ],
      "type": "object"
    },
    "FindingResult": {
      "description": "Advisory result for one rubric criterion.",
      "oneOf": [
        {
          "const": "met",
          "description": "The criterion is met.",
          "type": "string"
        },
        {
          "const": "partial",
          "description": "The criterion is partially met.",
          "type": "string"
        },
        {
          "const": "missing",
          "description": "Required evidence or work is missing.",
          "type": "string"
        },
        {
          "const": "unclear",
          "description": "Available evidence is unclear.",
          "type": "string"
        }
      ]
    },
    "FrozenSubmissionId": {
      "description": "Strongly typed UUIDv7 identifier for `FrozenSubmissionId`.",
      "type": "string"
    },
    "GoalAssessment": {
      "description": "Overall advisory assessment of a submitted goal.",
      "oneOf": [
        {
          "const": "met",
          "description": "The goal is fully met according to the advisory rubric.",
          "type": "string"
        },
        {
          "const": "partially_met",
          "description": "The goal is only partially met.",
          "type": "string"
        },
        {
          "const": "not_met",
          "description": "The goal is not met.",
          "type": "string"
        },
        {
          "const": "insufficient_evidence",
          "description": "Evidence is insufficient for an advisory assessment.",
          "type": "string"
        }
      ]
    },
    "GoalFinding": {
      "additionalProperties": false,
      "description": "One advisory finding with bounded evidence locations.",
      "properties": {
        "criterion": {
          "maxLength": 1024,
          "minLength": 1,
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceLocation"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array"
        },
        "result": {
          "$ref": "#/$defs/FindingResult"
        },
        "suggestion": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "criterion",
        "result",
        "evidence",
        "suggestion"
      ],
      "type": "object"
    },
    "GoalReview": {
      "additionalProperties": false,
      "description": "Advisory-only review produced by an LLM backend.\n\nThis contract deliberately has no score or verdict field. Unknown fields are rejected during\ndeserialization so an LLM cannot smuggle protected scoring data into the review channel.",
      "properties": {
        "assessment": {
          "$ref": "#/$defs/GoalAssessment"
        },
        "confidence": {
          "format": "double",
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/GoalFinding"
          },
          "maxItems": 64,
          "type": "array"
        },
        "requires_teacher_attention": {
          "type": "boolean"
        },
        "schema_version": {
          "$ref": "#/$defs/GoalReviewSchemaVersion"
        }
      },
      "required": [
        "schema_version",
        "assessment",
        "confidence",
        "findings",
        "requires_teacher_attention"
      ],
      "type": "object"
    },
    "GoalReviewSchemaVersion": {
      "enum": [
        "goal-review/v1"
      ],
      "type": "string"
    },
    "ProjectId": {
      "description": "Strongly typed UUIDv7 identifier for `ProjectId`.",
      "type": "string"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "UtcTimestamp": {
      "description": "UTC timestamp serialized with a literal `Z` and millisecond precision.",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "PostgreSQL-authoritative state for one evaluation run.",
  "properties": {
    "actorId": {
      "$ref": "#/$defs/ActorId"
    },
    "awardedScore": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "cancellationRequested": {
      "type": "boolean"
    },
    "cleanupVerified": {
      "type": "boolean"
    },
    "completedAt": {
      "anyOf": [
        {
          "$ref": "#/$defs/UtcTimestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "courseId": {
      "anyOf": [
        {
          "$ref": "#/$defs/CourseId"
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAt": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "diagnosticCode": {
      "anyOf": [
        {
          "$ref": "#/$defs/DiagnosticCode"
        },
        {
          "type": "null"
        }
      ]
    },
    "frozenSubmissionId": {
      "$ref": "#/$defs/FrozenSubmissionId"
    },
    "id": {
      "$ref": "#/$defs/EvaluationRunId"
    },
    "identity": {
      "$ref": "#/$defs/EvaluationRunIdentity"
    },
    "maxScore": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "projectId": {
      "$ref": "#/$defs/ProjectId"
    },
    "releaseId": {
      "$ref": "#/$defs/EvaluationReleaseId"
    },
    "releaseRevision": {
      "$ref": "#/$defs/Revision"
    },
    "revision": {
      "$ref": "#/$defs/Revision"
    },
    "schemaVersion": {
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/EvaluationRunState"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/EvaluationStepRun"
      },
      "type": "array"
    },
    "updatedAt": {
      "$ref": "#/$defs/UtcTimestamp"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "projectId",
    "releaseId",
    "releaseRevision",
    "frozenSubmissionId",
    "actorId",
    "state",
    "revision",
    "identity",
    "maxScore",
    "awardedScore",
    "steps",
    "cancellationRequested",
    "cleanupVerified",
    "createdAt",
    "updatedAt"
  ],
  "title": "EvaluationRun",
  "type": "object"
}
