{
  "$defs": {
    "AccessGrantId": {
      "description": "Strongly typed UUIDv7 identifier for `AccessGrantId`.",
      "type": "string"
    },
    "ConsoleSessionChanged": {
      "additionalProperties": false,
      "description": "Metadata-only console lifecycle event. Terminal bytes and credentials are never event data.",
      "properties": {
        "accessGrantId": {
          "$ref": "#/$defs/AccessGrantId"
        },
        "accessGrantRevision": {
          "$ref": "#/$defs/Revision"
        },
        "consoleSessionId": {
          "$ref": "#/$defs/ConsoleSessionId"
        },
        "diagnosticCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "effectiveAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "environmentId": {
          "$ref": "#/$defs/EnvironmentId"
        },
        "environmentRevision": {
          "$ref": "#/$defs/Revision"
        },
        "state": {
          "$ref": "#/$defs/ConsoleSessionState"
        },
        "terminateBy": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtcTimestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "consoleSessionId",
        "accessGrantId",
        "accessGrantRevision",
        "environmentId",
        "environmentRevision",
        "state",
        "effectiveAt"
      ],
      "type": "object"
    },
    "ConsoleSessionId": {
      "description": "Strongly typed UUIDv7 identifier for `ConsoleSessionId`.",
      "type": "string"
    },
    "ConsoleSessionState": {
      "description": "Safe console-session lifecycle persisted by Access Service.",
      "enum": [
        "opening",
        "active",
        "terminating",
        "termination_overdue",
        "closed"
      ],
      "type": "string"
    },
    "CourseId": {
      "description": "Strongly typed UUIDv7 identifier for `CourseId`.",
      "type": "string"
    },
    "EnvironmentId": {
      "description": "Strongly typed UUIDv7 identifier for `EnvironmentId`.",
      "type": "string"
    },
    "EventId": {
      "description": "Strongly typed UUIDv7 identifier for `EventId`.",
      "type": "string"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "Sequence": {
      "description": "Aggregate-local ordering sequence. This value is not an SSE resume cursor.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "UtcTimestamp": {
      "description": "UTC timestamp serialized with a literal `Z` and millisecond precision.",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Strict CloudEvents 1.0 envelope carried as structured JSON.",
  "properties": {
    "aggregateRevision": {
      "$ref": "#/$defs/Revision"
    },
    "aggregateSequence": {
      "$ref": "#/$defs/Sequence"
    },
    "courseId": {
      "$ref": "#/$defs/CourseId"
    },
    "data": {
      "$ref": "#/$defs/ConsoleSessionChanged"
    },
    "datacontenttype": {
      "type": "string"
    },
    "dataschema": {
      "type": "string"
    },
    "id": {
      "$ref": "#/$defs/EventId"
    },
    "source": {
      "type": "string"
    },
    "specversion": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "time": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "traceId": {
      "type": "string"
    },
    "type": {
      "type": "string"
    }
  },
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "subject",
    "time",
    "datacontenttype",
    "dataschema",
    "courseId",
    "aggregateRevision",
    "aggregateSequence",
    "traceId",
    "data"
  ],
  "title": "CloudEvent",
  "type": "object"
}
