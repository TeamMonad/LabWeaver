{
  "$defs": {
    "ActorId": {
      "description": "Strongly typed UUIDv7 identifier for `ActorId`.",
      "type": "string"
    },
    "CapacityClaimId": {
      "description": "Strongly typed UUIDv7 identifier for `CapacityClaimId`.",
      "type": "string"
    },
    "CourseId": {
      "description": "Strongly typed UUIDv7 identifier for `CourseId`.",
      "type": "string"
    },
    "EnvironmentId": {
      "description": "Strongly typed UUIDv7 identifier for `EnvironmentId`.",
      "type": "string"
    },
    "EventId": {
      "description": "Strongly typed UUIDv7 identifier for `EventId`.",
      "type": "string"
    },
    "GpuRequest": {
      "additionalProperties": false,
      "description": "A policy-catalogued GPU class. It intentionally does not expose Kubernetes resource names.",
      "properties": {
        "class": {
          "type": "string"
        },
        "count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "class",
        "count"
      ],
      "type": "object"
    },
    "LeaseId": {
      "description": "Strongly typed UUIDv7 identifier for `LeaseId`.",
      "type": "string"
    },
    "ProjectId": {
      "description": "Strongly typed UUIDv7 identifier for `ProjectId`.",
      "type": "string"
    },
    "ReleaseId": {
      "description": "Strongly typed UUIDv7 identifier for `ReleaseId`.",
      "type": "string"
    },
    "ResourceLease": {
      "additionalProperties": false,
      "description": "PostgreSQL-authoritative Lease projection. Its authorization is valid only while Active.",
      "properties": {
        "activeFrom": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtcTimestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "claimId": {
          "$ref": "#/$defs/CapacityClaimId"
        },
        "createdAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "expiresAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtcTimestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "$ref": "#/$defs/LeaseId"
        },
        "requestId": {
          "$ref": "#/$defs/ResourceRequestId"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "revokeReasonCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/ResourceLeaseState"
        },
        "updatedAt": {
          "$ref": "#/$defs/UtcTimestamp"
        }
      },
      "required": [
        "id",
        "requestId",
        "claimId",
        "state",
        "revision",
        "createdAt",
        "updatedAt"
      ],
      "type": "object"
    },
    "ResourceLeaseChanged": {
      "additionalProperties": false,
      "description": "Resource-owned Lease lifecycle fact. The request is included so downstream\nconsumers can authorize and project the transition without a cross-domain\nread race. Both snapshots were read and written in the same SQL transaction.",
      "properties": {
        "lease": {
          "$ref": "#/$defs/ResourceLease"
        },
        "request": {
          "$ref": "#/$defs/ResourceRequest"
        }
      },
      "required": [
        "lease",
        "request"
      ],
      "type": "object"
    },
    "ResourceLeaseState": {
      "description": "Closed Lease state consumed by other service boundaries.",
      "enum": [
        "allocating",
        "active",
        "expiring",
        "expired",
        "revoked"
      ],
      "type": "string"
    },
    "ResourceRequest": {
      "additionalProperties": false,
      "description": "PostgreSQL-authoritative request projection without provider internals.",
      "properties": {
        "courseId": {
          "$ref": "#/$defs/CourseId"
        },
        "createdAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "diagnosticCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "generation": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/ResourceRequestId"
        },
        "projectId": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProjectId"
            },
            {
              "type": "null"
            }
          ]
        },
        "requestKey": {
          "type": "string"
        },
        "requestedDurationSeconds": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "requestedResources": {
          "$ref": "#/$defs/WorkloadResources"
        },
        "requesterId": {
          "$ref": "#/$defs/ActorId"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "state": {
          "$ref": "#/$defs/ResourceRequestState"
        },
        "target": {
          "$ref": "#/$defs/ResourceTarget"
        },
        "updatedAt": {
          "$ref": "#/$defs/UtcTimestamp"
        }
      },
      "required": [
        "id",
        "generation",
        "requestKey",
        "requesterId",
        "courseId",
        "target",
        "requestedResources",
        "requestedDurationSeconds",
        "state",
        "revision",
        "createdAt",
        "updatedAt"
      ],
      "type": "object"
    },
    "ResourceRequestId": {
      "description": "Strongly typed UUIDv7 identifier for `ResourceRequestId`.",
      "type": "string"
    },
    "ResourceRequestState": {
      "description": "Request lifecycle owned by Resource Service.",
      "enum": [
        "reviewing",
        "allocating",
        "active",
        "expiring",
        "expired",
        "rejected",
        "cancelled"
      ],
      "type": "string"
    },
    "ResourceTarget": {
      "additionalProperties": false,
      "description": "Immutable identity of a Resource request's target Work environment.",
      "properties": {
        "environmentId": {
          "$ref": "#/$defs/EnvironmentId"
        },
        "releaseId": {
          "$ref": "#/$defs/ReleaseId"
        },
        "releaseSha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "releaseVersion": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "environmentId",
        "releaseId",
        "releaseVersion",
        "releaseSha256"
      ],
      "type": "object"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "Sequence": {
      "description": "Aggregate-local ordering sequence. This value is not an SSE resume cursor.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "Sha256Digest": {
      "description": "Canonical lowercase SHA-256 digest.",
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "UtcTimestamp": {
      "description": "UTC timestamp serialized with a literal `Z` and millisecond precision.",
      "type": "string"
    },
    "WorkloadResources": {
      "additionalProperties": false,
      "description": "Requested or approved workload resources, independent of Kubernetes quantity syntax.",
      "properties": {
        "cpuMillicores": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "gpu": {
          "anyOf": [
            {
              "$ref": "#/$defs/GpuRequest"
            },
            {
              "type": "null"
            }
          ]
        },
        "memoryBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "storageBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "cpuMillicores",
        "memoryBytes",
        "storageBytes"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Strict CloudEvents 1.0 envelope carried as structured JSON.",
  "properties": {
    "aggregateRevision": {
      "$ref": "#/$defs/Revision"
    },
    "aggregateSequence": {
      "$ref": "#/$defs/Sequence"
    },
    "courseId": {
      "$ref": "#/$defs/CourseId"
    },
    "data": {
      "$ref": "#/$defs/ResourceLeaseChanged"
    },
    "datacontenttype": {
      "type": "string"
    },
    "dataschema": {
      "type": "string"
    },
    "id": {
      "$ref": "#/$defs/EventId"
    },
    "source": {
      "type": "string"
    },
    "specversion": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "time": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "traceId": {
      "type": "string"
    },
    "type": {
      "type": "string"
    }
  },
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "subject",
    "time",
    "datacontenttype",
    "dataschema",
    "courseId",
    "aggregateRevision",
    "aggregateSequence",
    "traceId",
    "data"
  ],
  "title": "CloudEvent",
  "type": "object"
}
