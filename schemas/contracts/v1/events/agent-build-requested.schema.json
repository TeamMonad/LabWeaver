{
  "$defs": {
    "ActorId": {
      "description": "Strongly typed UUIDv7 identifier for `ActorId`.",
      "type": "string"
    },
    "AgentBuildRequested": {
      "additionalProperties": false,
      "description": "Complete, approved, immutable command consumed by the Agent build executor.",
      "properties": {
        "approval": {
          "$ref": "#/$defs/CandidateApproval"
        },
        "idempotencyKey": {
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/BuildRequest"
        }
      },
      "required": [
        "request",
        "approval",
        "idempotencyKey"
      ],
      "type": "object"
    },
    "ApprovalId": {
      "description": "Strongly typed UUIDv7 identifier for `ApprovalId`.",
      "type": "string"
    },
    "ArtifactId": {
      "description": "Strongly typed UUIDv7 identifier for `ArtifactId`.",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Immutable object-store identity without a machine-local path or credential.",
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/ArtifactId",
          "description": "Stable metadata identity resolved by the owning service."
        },
        "mediaType": {
          "description": "Registered media type.",
          "type": "string"
        },
        "objectVersion": {
          "description": "Immutable backend object version.",
          "type": "string"
        },
        "sizeBytes": {
          "description": "Raw object length.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "storeBinding": {
          "description": "Explicit object-store binding from deployment configuration.",
          "type": "string"
        }
      },
      "required": [
        "artifactId",
        "storeBinding",
        "objectVersion",
        "sizeBytes",
        "mediaType"
      ],
      "type": "object"
    },
    "BuildNetworkPolicy": {
      "description": "Explicit BuildKit network posture.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "deny_all",
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "allowed_registries": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "mode": {
              "const": "restricted",
              "type": "string"
            }
          },
          "required": [
            "mode",
            "allowed_registries"
          ],
          "type": "object"
        }
      ]
    },
    "BuildRequest": {
      "additionalProperties": false,
      "description": "Approved, immutable build request.",
      "properties": {
        "approvalId": {
          "$ref": "#/$defs/ApprovalId"
        },
        "baseImageDigest": {
          "type": "string"
        },
        "builderBinding": {
          "type": "string"
        },
        "candidateId": {
          "$ref": "#/$defs/CandidateId"
        },
        "candidateRevision": {
          "$ref": "#/$defs/Revision"
        },
        "context": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "contextObjectKey": {
          "description": "Object-store key resolved by Control and bound to the immutable context reference.",
          "type": "string"
        },
        "courseId": {
          "$ref": "#/$defs/CourseId"
        },
        "createdAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "dockerfilePath": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/BuildRequestId"
        },
        "maxCpuMillicores": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "maxDurationMilliseconds": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "maxMemoryBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "network": {
          "$ref": "#/$defs/BuildNetworkPolicy"
        },
        "outputRepository": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "courseId",
        "candidateId",
        "candidateRevision",
        "approvalId",
        "builderBinding",
        "context",
        "contextObjectKey",
        "dockerfilePath",
        "baseImageDigest",
        "outputRepository",
        "network",
        "maxDurationMilliseconds",
        "maxCpuMillicores",
        "maxMemoryBytes",
        "createdAt"
      ],
      "type": "object"
    },
    "BuildRequestId": {
      "description": "Strongly typed UUIDv7 identifier for `BuildRequestId`.",
      "type": "string"
    },
    "CandidateApproval": {
      "additionalProperties": false,
      "description": "Human decision bound to an exact candidate and dependency identity.",
      "properties": {
        "actorId": {
          "$ref": "#/$defs/ActorId"
        },
        "candidateId": {
          "$ref": "#/$defs/CandidateId"
        },
        "candidateRevision": {
          "$ref": "#/$defs/Revision"
        },
        "decidedAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "decision": {
          "$ref": "#/$defs/CandidateDecision"
        },
        "id": {
          "$ref": "#/$defs/ApprovalId"
        },
        "policyRevision": {
          "$ref": "#/$defs/Revision"
        },
        "reason": {
          "type": "string"
        },
        "trustRevision": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "id",
        "candidateId",
        "candidateRevision",
        "policyRevision",
        "trustRevision",
        "actorId",
        "decision",
        "reason",
        "decidedAt"
      ],
      "type": "object"
    },
    "CandidateDecision": {
      "description": "Append-only candidate decision.",
      "enum": [
        "approved",
        "rejected",
        "withdrawn"
      ],
      "type": "string"
    },
    "CandidateId": {
      "description": "Strongly typed UUIDv7 identifier for `CandidateId`.",
      "type": "string"
    },
    "CourseId": {
      "description": "Strongly typed UUIDv7 identifier for `CourseId`.",
      "type": "string"
    },
    "EventId": {
      "description": "Strongly typed UUIDv7 identifier for `EventId`.",
      "type": "string"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "Sequence": {
      "description": "Aggregate-local ordering sequence. This value is not an SSE resume cursor.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "UtcTimestamp": {
      "description": "UTC timestamp serialized with a literal `Z` and millisecond precision.",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Strict CloudEvents 1.0 envelope carried as structured JSON.",
  "properties": {
    "aggregateRevision": {
      "$ref": "#/$defs/Revision"
    },
    "aggregateSequence": {
      "$ref": "#/$defs/Sequence"
    },
    "courseId": {
      "$ref": "#/$defs/CourseId"
    },
    "data": {
      "$ref": "#/$defs/AgentBuildRequested"
    },
    "datacontenttype": {
      "type": "string"
    },
    "dataschema": {
      "type": "string"
    },
    "id": {
      "$ref": "#/$defs/EventId"
    },
    "source": {
      "type": "string"
    },
    "specversion": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "time": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "traceId": {
      "type": "string"
    },
    "type": {
      "type": "string"
    }
  },
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "subject",
    "time",
    "datacontenttype",
    "dataschema",
    "courseId",
    "aggregateRevision",
    "aggregateSequence",
    "traceId",
    "data"
  ],
  "title": "CloudEvent",
  "type": "object"
}
