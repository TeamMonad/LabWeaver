{
  "$defs": {
    "AgentBuildRequested": {
      "additionalProperties": false,
      "description": "Complete, approved, immutable command consumed by the Agent build executor.",
      "properties": {
        "idempotencyKey": {
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/BuildRequest"
        }
      },
      "required": [
        "request",
        "idempotencyKey"
      ],
      "type": "object"
    },
    "ArtifactId": {
      "description": "Strongly typed UUIDv7 identifier for `ArtifactId`.",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Immutable object-store identity without a machine-local path or credential.",
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/ArtifactId",
          "description": "Stable metadata identity resolved by the owning service."
        },
        "mediaType": {
          "description": "Registered media type.",
          "type": "string"
        },
        "objectVersion": {
          "description": "Immutable backend object version.",
          "type": "string"
        },
        "sizeBytes": {
          "description": "Raw object length.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "storeBinding": {
          "description": "Explicit object-store binding from deployment configuration.",
          "type": "string"
        }
      },
      "required": [
        "artifactId",
        "storeBinding",
        "objectVersion",
        "sizeBytes",
        "mediaType"
      ],
      "type": "object"
    },
    "BuildNetworkPolicy": {
      "description": "Explicit BuildKit network posture.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "deny_all",
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "allowed_registries": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "mode": {
              "const": "restricted",
              "type": "string"
            }
          },
          "required": [
            "mode",
            "allowed_registries"
          ],
          "type": "object"
        }
      ]
    },
    "BuildRequest": {
      "additionalProperties": false,
      "description": "Approved, immutable build request.",
      "properties": {
        "builderBinding": {
          "type": "string"
        },
        "candidateId": {
          "$ref": "#/$defs/CandidateId"
        },
        "candidateRevision": {
          "$ref": "#/$defs/Revision"
        },
        "courseId": {
          "anyOf": [
            {
              "$ref": "#/$defs/CourseId"
            },
            {
              "type": "null"
            }
          ]
        },
        "createdAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "id": {
          "$ref": "#/$defs/BuildRequestId"
        },
        "maxCpuMillicores": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "maxDurationMilliseconds": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "maxMemoryBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "network": {
          "$ref": "#/$defs/BuildNetworkPolicy"
        },
        "outputRepository": {
          "type": "string"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectId"
        },
        "source": {
          "$ref": "#/$defs/BuildSource"
        }
      },
      "required": [
        "id",
        "projectId",
        "candidateId",
        "candidateRevision",
        "builderBinding",
        "source",
        "outputRepository",
        "network",
        "maxDurationMilliseconds",
        "maxCpuMillicores",
        "maxMemoryBytes",
        "createdAt"
      ],
      "type": "object"
    },
    "BuildRequestId": {
      "description": "Strongly typed UUIDv7 identifier for `BuildRequestId`.",
      "type": "string"
    },
    "BuildSource": {
      "description": "Approved, immutable build input source.\n\n`Dockerfile` is the deployment-owned `BuildKit` path. `ExportedOci` names an OCI\nlayout/tar archive produced by an admitted sandbox attempt: the build executor\nverifies every entry and content digest before publishing the exact image by\ndigest, so the sandbox itself never holds registry push credentials.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "context": {
              "$ref": "#/$defs/ArtifactRef"
            },
            "contextObjectKey": {
              "description": "Object-store key resolved by Control and bound to the immutable context reference.",
              "type": "string"
            },
            "dockerfilePath": {
              "type": "string"
            },
            "kind": {
              "const": "dockerfile",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "context",
            "contextObjectKey",
            "dockerfilePath"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "image": {
              "$ref": "#/$defs/ExportedOciImage"
            },
            "kind": {
              "const": "exported_oci",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "image"
          ],
          "type": "object"
        }
      ]
    },
    "CandidateId": {
      "description": "Strongly typed UUIDv7 identifier for `CandidateId`.",
      "type": "string"
    },
    "CourseId": {
      "description": "Strongly typed UUIDv7 identifier for `CourseId`.",
      "type": "string"
    },
    "EventId": {
      "description": "Strongly typed UUIDv7 identifier for `EventId`.",
      "type": "string"
    },
    "ExportedOciImage": {
      "additionalProperties": false,
      "description": "Frozen sandbox-exported OCI layout archive.\n\nThe agent freezes and hashes the exact uploaded version before Control may bind it into a\nbuild request, so the executor re-reads that immutable version instead of a current key.",
      "properties": {
        "layout": {
          "$ref": "#/$defs/ArtifactRef",
          "description": "Immutable object-store identity of the layout archive."
        },
        "layoutObjectKey": {
          "description": "Object-store key of the layout archive.",
          "type": "string"
        }
      },
      "required": [
        "layout",
        "layoutObjectKey"
      ],
      "type": "object"
    },
    "ProjectId": {
      "description": "Strongly typed UUIDv7 identifier for `ProjectId`.",
      "type": "string"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "Sequence": {
      "description": "Aggregate-local ordering sequence. This value is not an SSE resume cursor.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "UtcTimestamp": {
      "description": "UTC timestamp serialized with a literal `Z` and millisecond precision.",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Strict CloudEvents 1.0 envelope carried as structured JSON.",
  "properties": {
    "aggregateRevision": {
      "$ref": "#/$defs/Revision"
    },
    "aggregateSequence": {
      "$ref": "#/$defs/Sequence"
    },
    "courseId": {
      "anyOf": [
        {
          "$ref": "#/$defs/CourseId"
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional teaching association. Independent projects omit this field."
    },
    "data": {
      "$ref": "#/$defs/AgentBuildRequested"
    },
    "datacontenttype": {
      "type": "string"
    },
    "dataschema": {
      "type": "string"
    },
    "id": {
      "$ref": "#/$defs/EventId"
    },
    "projectId": {
      "$ref": "#/$defs/ProjectId",
      "description": "Required project scope for every platform event, including independent Work events."
    },
    "source": {
      "type": "string"
    },
    "specversion": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "time": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "traceId": {
      "type": "string"
    },
    "type": {
      "type": "string"
    }
  },
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "subject",
    "time",
    "datacontenttype",
    "dataschema",
    "projectId",
    "aggregateRevision",
    "aggregateSequence",
    "traceId",
    "data"
  ],
  "title": "CloudEvent",
  "type": "object"
}
