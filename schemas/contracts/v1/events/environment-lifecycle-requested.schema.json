{
  "$defs": {
    "ActorId": {
      "description": "Strongly typed UUIDv7 identifier for `ActorId`.",
      "type": "string"
    },
    "ArtifactId": {
      "description": "Strongly typed UUIDv7 identifier for `ArtifactId`.",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Immutable object-store identity without a machine-local path or credential.",
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/ArtifactId",
          "description": "Stable metadata identity resolved by the owning service."
        },
        "mediaType": {
          "description": "Registered media type.",
          "type": "string"
        },
        "objectVersion": {
          "description": "Immutable backend object version.",
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Digest",
          "description": "Exact content digest."
        },
        "sizeBytes": {
          "description": "Raw object length.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "storeBinding": {
          "description": "Explicit object-store binding from deployment configuration.",
          "type": "string"
        }
      },
      "required": [
        "artifactId",
        "storeBinding",
        "objectVersion",
        "sha256",
        "sizeBytes",
        "mediaType"
      ],
      "type": "object"
    },
    "CourseId": {
      "description": "Strongly typed UUIDv7 identifier for `CourseId`.",
      "type": "string"
    },
    "EnvironmentClass": {
      "description": "Environment business class retained from the v2.1 architecture.",
      "enum": [
        "experiment",
        "work"
      ],
      "type": "string"
    },
    "EnvironmentCreateSpec": {
      "additionalProperties": false,
      "description": "Authoritative fields required to create the first Environment aggregate.",
      "properties": {
        "capacityBinding": {
          "type": [
            "string",
            "null"
          ]
        },
        "class": {
          "$ref": "#/$defs/EnvironmentClass"
        },
        "courseId": {
          "$ref": "#/$defs/CourseId"
        },
        "displayLabel": {
          "type": "string"
        },
        "eligibilityExpiresAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "leaseId": {
          "anyOf": [
            {
              "$ref": "#/$defs/LeaseId"
            },
            {
              "type": "null"
            }
          ]
        },
        "ownerActorId": {
          "$ref": "#/$defs/ActorId"
        },
        "providerBinding": {
          "type": "string"
        },
        "releaseId": {
          "$ref": "#/$defs/ReleaseId"
        },
        "releaseVersion": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "runtimeKind": {
          "$ref": "#/$defs/RuntimeKind"
        }
      },
      "required": [
        "courseId",
        "ownerActorId",
        "displayLabel",
        "class",
        "runtimeKind",
        "releaseId",
        "releaseVersion",
        "providerBinding",
        "eligibilityExpiresAt"
      ],
      "type": "object"
    },
    "EnvironmentId": {
      "description": "Strongly typed UUIDv7 identifier for `EnvironmentId`.",
      "type": "string"
    },
    "EnvironmentLifecycleCommand": {
      "additionalProperties": false,
      "description": "Revision-checked lifecycle intent consumed by the Environment state owner.",
      "properties": {
        "acceptedAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "accessRevocationRevision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Revision"
            },
            {
              "type": "null"
            }
          ]
        },
        "actorId": {
          "$ref": "#/$defs/ActorId"
        },
        "deadlineAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "environmentId": {
          "$ref": "#/$defs/EnvironmentId"
        },
        "expectedRevision": {
          "$ref": "#/$defs/Revision"
        },
        "kind": {
          "$ref": "#/$defs/EnvironmentOperationKind"
        },
        "maxAttempts": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "preserveMutableDisk": {
          "type": "boolean"
        },
        "resetTarget": {
          "anyOf": [
            {
              "$ref": "#/$defs/EnvironmentResetTarget"
            },
            {
              "type": "null"
            }
          ]
        },
        "traceId": {
          "type": "string"
        }
      },
      "required": [
        "environmentId",
        "kind",
        "expectedRevision",
        "actorId",
        "traceId",
        "acceptedAt",
        "deadlineAt",
        "preserveMutableDisk",
        "maxAttempts"
      ],
      "type": "object"
    },
    "EnvironmentLifecycleCommandData": {
      "additionalProperties": false,
      "description": "Command-specific data carried inside the catalogued lifecycle CloudEvent.",
      "properties": {
        "command": {
          "$ref": "#/$defs/EnvironmentLifecycleCommand"
        },
        "create": {
          "anyOf": [
            {
              "$ref": "#/$defs/EnvironmentCreateSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "idempotencyKey": {
          "type": "string"
        }
      },
      "required": [
        "idempotencyKey",
        "command"
      ],
      "type": "object"
    },
    "EnvironmentOperationKind": {
      "description": "Explicit operation kind; restart and destructive reset are never aliases.",
      "enum": [
        "create",
        "start",
        "stop",
        "restart",
        "reset",
        "retry",
        "cancel",
        "recover",
        "expire",
        "delete",
        "cleanup",
        "freeze"
      ],
      "type": "string"
    },
    "EnvironmentResetTarget": {
      "description": "Explicit immutable target selected for one reset operation.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "experiment_baseline",
              "type": "string"
            },
            "releaseId": {
              "$ref": "#/$defs/ReleaseId"
            },
            "releaseVersion": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "releaseId",
            "releaseVersion"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "authorizationRevision": {
              "$ref": "#/$defs/Revision"
            },
            "kind": {
              "const": "work_snapshot",
              "type": "string"
            },
            "snapshot": {
              "$ref": "#/$defs/ArtifactRef"
            }
          },
          "required": [
            "kind",
            "snapshot",
            "authorizationRevision"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "authorizationRevision": {
              "$ref": "#/$defs/Revision"
            },
            "configurationRevision": {
              "$ref": "#/$defs/Revision"
            },
            "kind": {
              "const": "work_configuration",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "configurationRevision",
            "authorizationRevision"
          ],
          "type": "object"
        }
      ]
    },
    "EventId": {
      "description": "Strongly typed UUIDv7 identifier for `EventId`.",
      "type": "string"
    },
    "LeaseId": {
      "description": "Strongly typed UUIDv7 identifier for `LeaseId`.",
      "type": "string"
    },
    "ReleaseId": {
      "description": "Strongly typed UUIDv7 identifier for `ReleaseId`.",
      "type": "string"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "RuntimeKind": {
      "description": "Runtime kind shared by candidates, releases, and instances.",
      "enum": [
        "container",
        "virtual_machine"
      ],
      "type": "string"
    },
    "Sequence": {
      "description": "Aggregate-local ordering sequence. This value is not an SSE resume cursor.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "Sha256Digest": {
      "description": "Canonical lowercase SHA-256 digest.",
      "type": "string"
    },
    "UtcTimestamp": {
      "description": "UTC timestamp serialized with a literal `Z` and millisecond precision.",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Strict CloudEvents 1.0 envelope carried as structured JSON.",
  "properties": {
    "aggregateRevision": {
      "$ref": "#/$defs/Revision"
    },
    "aggregateSequence": {
      "$ref": "#/$defs/Sequence"
    },
    "courseId": {
      "$ref": "#/$defs/CourseId"
    },
    "data": {
      "$ref": "#/$defs/EnvironmentLifecycleCommandData"
    },
    "datacontenttype": {
      "type": "string"
    },
    "dataschema": {
      "type": "string"
    },
    "id": {
      "$ref": "#/$defs/EventId"
    },
    "source": {
      "type": "string"
    },
    "specversion": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "time": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "traceId": {
      "type": "string"
    },
    "type": {
      "type": "string"
    }
  },
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "subject",
    "time",
    "datacontenttype",
    "dataschema",
    "courseId",
    "aggregateRevision",
    "aggregateSequence",
    "traceId",
    "data"
  ],
  "title": "CloudEvent",
  "type": "object"
}
