{
  "$defs": {
    "ActorId": {
      "description": "Strongly typed UUIDv7 identifier for `ActorId`.",
      "type": "string"
    },
    "CourseId": {
      "description": "Strongly typed UUIDv7 identifier for `CourseId`.",
      "type": "string"
    },
    "EnvironmentId": {
      "description": "Strongly typed UUIDv7 identifier for `EnvironmentId`.",
      "type": "string"
    },
    "EnvironmentLifecycleCommand": {
      "additionalProperties": false,
      "description": "Revision-checked lifecycle intent consumed by the Environment state owner.",
      "properties": {
        "acceptedAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "accessRevocationRevision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Revision"
            },
            {
              "type": "null"
            }
          ]
        },
        "actorId": {
          "$ref": "#/$defs/ActorId"
        },
        "deadlineAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "environmentId": {
          "$ref": "#/$defs/EnvironmentId"
        },
        "expectedRevision": {
          "$ref": "#/$defs/Revision"
        },
        "kind": {
          "$ref": "#/$defs/EnvironmentOperationKind"
        },
        "maxAttempts": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "preserveMutableDisk": {
          "type": "boolean"
        },
        "traceId": {
          "type": "string"
        }
      },
      "required": [
        "environmentId",
        "kind",
        "expectedRevision",
        "actorId",
        "traceId",
        "acceptedAt",
        "deadlineAt",
        "preserveMutableDisk",
        "maxAttempts"
      ],
      "type": "object"
    },
    "EnvironmentLifecycleCommandData": {
      "additionalProperties": false,
      "description": "Command-specific data carried inside the catalogued lifecycle CloudEvent.",
      "properties": {
        "command": {
          "$ref": "#/$defs/EnvironmentLifecycleCommand"
        },
        "idempotencyKey": {
          "type": "string"
        }
      },
      "required": [
        "idempotencyKey",
        "command"
      ],
      "type": "object"
    },
    "EnvironmentOperationKind": {
      "description": "Explicit operation kind; restart and destructive reset are never aliases.",
      "enum": [
        "create",
        "start",
        "stop",
        "restart",
        "reset",
        "retry",
        "cancel",
        "recover",
        "expire",
        "delete",
        "cleanup",
        "freeze"
      ],
      "type": "string"
    },
    "EventId": {
      "description": "Strongly typed UUIDv7 identifier for `EventId`.",
      "type": "string"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "Sequence": {
      "description": "Aggregate-local sequence or SSE cursor.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "UtcTimestamp": {
      "description": "UTC timestamp serialized with a literal `Z` and millisecond precision.",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Strict CloudEvents 1.0 envelope carried as structured JSON.",
  "properties": {
    "aggregateRevision": {
      "$ref": "#/$defs/Revision"
    },
    "aggregateSequence": {
      "$ref": "#/$defs/Sequence"
    },
    "courseId": {
      "$ref": "#/$defs/CourseId"
    },
    "data": {
      "$ref": "#/$defs/EnvironmentLifecycleCommandData"
    },
    "datacontenttype": {
      "type": "string"
    },
    "dataschema": {
      "type": "string"
    },
    "id": {
      "$ref": "#/$defs/EventId"
    },
    "source": {
      "type": "string"
    },
    "specversion": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "time": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "traceId": {
      "type": "string"
    },
    "type": {
      "type": "string"
    }
  },
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "subject",
    "time",
    "datacontenttype",
    "dataschema",
    "courseId",
    "aggregateRevision",
    "aggregateSequence",
    "traceId",
    "data"
  ],
  "title": "CloudEvent",
  "type": "object"
}
