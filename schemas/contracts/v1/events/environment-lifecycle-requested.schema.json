{
  "$defs": {
    "ActorId": {
      "description": "Strongly typed UUIDv7 identifier for `ActorId`.",
      "type": "string"
    },
    "ArtifactId": {
      "description": "Strongly typed UUIDv7 identifier for `ArtifactId`.",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Immutable object-store identity without a machine-local path or credential.",
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/ArtifactId",
          "description": "Stable metadata identity resolved by the owning service."
        },
        "mediaType": {
          "description": "Registered media type.",
          "type": "string"
        },
        "objectVersion": {
          "description": "Immutable backend object version.",
          "type": "string"
        },
        "sizeBytes": {
          "description": "Raw object length.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "storeBinding": {
          "description": "Explicit object-store binding from deployment configuration.",
          "type": "string"
        }
      },
      "required": [
        "artifactId",
        "storeBinding",
        "objectVersion",
        "sizeBytes",
        "mediaType"
      ],
      "type": "object"
    },
    "CourseId": {
      "description": "Strongly typed UUIDv7 identifier for `CourseId`.",
      "type": "string"
    },
    "EnvironmentClass": {
      "description": "Environment business class retained from the v2.1 architecture.",
      "enum": [
        "experiment",
        "work"
      ],
      "type": "string"
    },
    "EnvironmentCreateSpec": {
      "additionalProperties": false,
      "description": "Authoritative fields required to create the first Environment aggregate.",
      "properties": {
        "approvedResources": {
          "$ref": "#/$defs/WorkloadResources",
          "description": "Resources approved by the immutable ReleaseProjection or Work lease.\nEnvironment owns the lifecycle; Resource receives this snapshot only\nthrough the trusted Environment resource reservation handoff."
        },
        "capacityBinding": {
          "type": [
            "string",
            "null"
          ]
        },
        "class": {
          "$ref": "#/$defs/EnvironmentClass"
        },
        "courseId": {
          "anyOf": [
            {
              "$ref": "#/$defs/CourseId"
            },
            {
              "type": "null"
            }
          ]
        },
        "displayLabel": {
          "type": "string"
        },
        "eligibilityExpiresAt": {
          "description": "Material eligibility deadline. `None` is the explicit permanent CourseMaterial form;\nWork instances are later bounded by their Resource lease fence.",
          "type": [
            "string",
            "null"
          ]
        },
        "gpuAllocation": {
          "anyOf": [
            {
              "$ref": "#/$defs/GpuAllocation"
            },
            {
              "type": "null"
            }
          ],
          "description": "Resource-resolved Experiment GPU allocation held for this environment instance when the\napproved resource snapshot includes GPU capacity.\n\nExperiment creation resolves this through Resource before the aggregate is accepted; Work\nenvironments keep their allocation on the Lease authorization instead and leave this absent."
        },
        "leaseId": {
          "anyOf": [
            {
              "$ref": "#/$defs/LeaseId"
            },
            {
              "type": "null"
            }
          ]
        },
        "ownerActorId": {
          "$ref": "#/$defs/ActorId"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectId"
        },
        "providerBinding": {
          "type": "string"
        },
        "releaseId": {
          "$ref": "#/$defs/ReleaseId"
        },
        "releaseVersion": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "retention": {
          "$ref": "#/$defs/RetentionSnapshot",
          "description": "Immutable material retention decision that authorizes the eligibility boundary below."
        },
        "runtimeKind": {
          "$ref": "#/$defs/RuntimeKind"
        }
      },
      "required": [
        "projectId",
        "ownerActorId",
        "displayLabel",
        "class",
        "runtimeKind",
        "releaseId",
        "releaseVersion",
        "providerBinding",
        "approvedResources",
        "retention",
        "eligibilityExpiresAt"
      ],
      "type": "object"
    },
    "EnvironmentId": {
      "description": "Strongly typed UUIDv7 identifier for `EnvironmentId`.",
      "type": "string"
    },
    "EnvironmentLifecycleCommand": {
      "additionalProperties": false,
      "description": "Revision-checked lifecycle intent consumed by the Environment state owner.",
      "properties": {
        "acceptedAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "accessRevocationRevision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Revision"
            },
            {
              "type": "null"
            }
          ]
        },
        "actorId": {
          "$ref": "#/$defs/ActorId"
        },
        "deadlineAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "environmentId": {
          "$ref": "#/$defs/EnvironmentId"
        },
        "expectedRevision": {
          "$ref": "#/$defs/Revision"
        },
        "kind": {
          "$ref": "#/$defs/EnvironmentOperationKind"
        },
        "maxAttempts": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "preserveMutableDisk": {
          "type": "boolean"
        },
        "resetTarget": {
          "anyOf": [
            {
              "$ref": "#/$defs/EnvironmentResetTarget"
            },
            {
              "type": "null"
            }
          ]
        },
        "traceId": {
          "type": "string"
        }
      },
      "required": [
        "environmentId",
        "kind",
        "expectedRevision",
        "actorId",
        "traceId",
        "acceptedAt",
        "deadlineAt",
        "preserveMutableDisk",
        "maxAttempts"
      ],
      "type": "object"
    },
    "EnvironmentLifecycleCommandData": {
      "additionalProperties": false,
      "description": "Command-specific data carried inside the catalogued lifecycle CloudEvent.",
      "properties": {
        "command": {
          "$ref": "#/$defs/EnvironmentLifecycleCommand"
        },
        "create": {
          "anyOf": [
            {
              "$ref": "#/$defs/EnvironmentCreateSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "idempotencyKey": {
          "type": "string"
        }
      },
      "required": [
        "idempotencyKey",
        "command"
      ],
      "type": "object"
    },
    "EnvironmentOperationKind": {
      "description": "Explicit operation kind; restart and destructive reset are never aliases.",
      "enum": [
        "create",
        "start",
        "stop",
        "restart",
        "reset",
        "retry",
        "cancel",
        "recover",
        "expire",
        "delete",
        "cleanup",
        "freeze"
      ],
      "type": "string"
    },
    "EnvironmentResetTarget": {
      "description": "Explicit immutable target selected for one reset operation.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "experiment_baseline",
              "type": "string"
            },
            "releaseId": {
              "$ref": "#/$defs/ReleaseId"
            },
            "releaseVersion": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "releaseId",
            "releaseVersion"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "authorizationRevision": {
              "$ref": "#/$defs/Revision"
            },
            "kind": {
              "const": "work_snapshot",
              "type": "string"
            },
            "snapshot": {
              "$ref": "#/$defs/ArtifactRef"
            }
          },
          "required": [
            "kind",
            "snapshot",
            "authorizationRevision"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "authorizationRevision": {
              "$ref": "#/$defs/Revision"
            },
            "configurationRevision": {
              "$ref": "#/$defs/Revision"
            },
            "kind": {
              "const": "work_configuration",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "configurationRevision",
            "authorizationRevision"
          ],
          "type": "object"
        }
      ]
    },
    "EventId": {
      "description": "Strongly typed UUIDv7 identifier for `EventId`.",
      "type": "string"
    },
    "GpuAllocation": {
      "additionalProperties": false,
      "description": "The catalog resolution captured on an approved capacity claim.",
      "properties": {
        "allocationBinding": {
          "type": "string"
        },
        "catalogRevision": {
          "$ref": "#/$defs/Revision"
        },
        "class": {
          "type": "string"
        },
        "count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "entryId": {
          "$ref": "#/$defs/GpuCatalogEntryId",
          "description": "Exact catalog row used to resolve this allocation."
        },
        "mode": {
          "$ref": "#/$defs/GpuAllocationMode"
        },
        "providerBinding": {
          "type": "string"
        }
      },
      "required": [
        "entryId",
        "class",
        "count",
        "mode",
        "providerBinding",
        "allocationBinding",
        "catalogRevision"
      ],
      "type": "object"
    },
    "GpuAllocationMode": {
      "description": "Allocation mode selected by the Resource GPU catalog.\n\nCallers submit only a catalog class and count. The mode is resolved from the\nactive catalog entry and is never accepted as an untrusted request override.",
      "enum": [
        "exclusive",
        "container_time_slice",
        "vm_vgpu"
      ],
      "type": "string"
    },
    "GpuCatalogEntryId": {
      "description": "Strongly typed UUIDv7 identifier for `GpuCatalogEntryId`.",
      "type": "string"
    },
    "GpuRequest": {
      "additionalProperties": false,
      "description": "A policy-catalogued GPU class. It intentionally does not expose Kubernetes resource names.",
      "properties": {
        "class": {
          "type": "string"
        },
        "count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "class",
        "count"
      ],
      "type": "object"
    },
    "LeaseId": {
      "description": "Strongly typed UUIDv7 identifier for `LeaseId`.",
      "type": "string"
    },
    "PolicyId": {
      "description": "Strongly typed UUIDv7 identifier for `PolicyId`.",
      "type": "string"
    },
    "ProjectId": {
      "description": "Strongly typed UUIDv7 identifier for `ProjectId`.",
      "type": "string"
    },
    "ReleaseId": {
      "description": "Strongly typed UUIDv7 identifier for `ReleaseId`.",
      "type": "string"
    },
    "RetentionClass": {
      "description": "Retention classes with distinct privacy and recovery requirements.",
      "enum": [
        "course_material",
        "build_evidence",
        "run_evidence",
        "student_submission",
        "security_audit"
      ],
      "type": "string"
    },
    "RetentionDisposition": {
      "description": "Required action after retention expires.",
      "enum": [
        "delete",
        "purge_after_export",
        "retain_sanitized_receipt",
        "retain_until_revoked"
      ],
      "type": "string"
    },
    "RetentionSnapshot": {
      "additionalProperties": false,
      "description": "Frozen data-retention decision for an immutable resource.",
      "properties": {
        "class": {
          "$ref": "#/$defs/RetentionClass",
          "description": "Stable retention class."
        },
        "disposition": {
          "$ref": "#/$defs/RetentionDisposition",
          "description": "Required terminal disposition."
        },
        "policyId": {
          "$ref": "#/$defs/PolicyId",
          "description": "Policy identity."
        },
        "policyRevision": {
          "$ref": "#/$defs/Revision",
          "description": "Exact policy revision used at creation."
        },
        "retainUntil": {
          "description": "Absolute retention boundary. `None` is valid only for an explicitly permanent course\nmaterial decision whose disposition is `RetainUntilRevoked`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "policyId",
        "policyRevision",
        "class",
        "retainUntil",
        "disposition"
      ],
      "type": "object"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "RuntimeKind": {
      "description": "Runtime kind shared by candidates, releases, and instances.",
      "enum": [
        "container",
        "virtual_machine"
      ],
      "type": "string"
    },
    "Sequence": {
      "description": "Aggregate-local ordering sequence. This value is not an SSE resume cursor.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "UtcTimestamp": {
      "description": "UTC timestamp serialized with a literal `Z` and millisecond precision.",
      "type": "string"
    },
    "WorkloadResources": {
      "additionalProperties": false,
      "description": "Requested or approved workload resources, independent of Kubernetes quantity syntax.",
      "properties": {
        "cpuMillicores": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "gpu": {
          "anyOf": [
            {
              "$ref": "#/$defs/GpuRequest"
            },
            {
              "type": "null"
            }
          ]
        },
        "memoryBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "storageBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "cpuMillicores",
        "memoryBytes",
        "storageBytes"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Strict CloudEvents 1.0 envelope carried as structured JSON.",
  "properties": {
    "aggregateRevision": {
      "$ref": "#/$defs/Revision"
    },
    "aggregateSequence": {
      "$ref": "#/$defs/Sequence"
    },
    "courseId": {
      "anyOf": [
        {
          "$ref": "#/$defs/CourseId"
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional teaching association. Independent projects omit this field."
    },
    "data": {
      "$ref": "#/$defs/EnvironmentLifecycleCommandData"
    },
    "datacontenttype": {
      "type": "string"
    },
    "dataschema": {
      "type": "string"
    },
    "id": {
      "$ref": "#/$defs/EventId"
    },
    "projectId": {
      "$ref": "#/$defs/ProjectId",
      "description": "Required project scope for every platform event, including independent Work events."
    },
    "source": {
      "type": "string"
    },
    "specversion": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "time": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "traceId": {
      "type": "string"
    },
    "type": {
      "type": "string"
    }
  },
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "subject",
    "time",
    "datacontenttype",
    "dataschema",
    "projectId",
    "aggregateRevision",
    "aggregateSequence",
    "traceId",
    "data"
  ],
  "title": "CloudEvent",
  "type": "object"
}
