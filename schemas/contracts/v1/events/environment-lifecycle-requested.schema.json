{
  "$defs": {
    "ActorId": {
      "description": "Strongly typed UUIDv7 identifier for `ActorId`.",
      "type": "string"
    },
    "ApprovalId": {
      "description": "Strongly typed UUIDv7 identifier for `ApprovalId`.",
      "type": "string"
    },
    "ArtifactId": {
      "description": "Strongly typed UUIDv7 identifier for `ArtifactId`.",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Immutable object-store identity without a machine-local path or credential.",
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/ArtifactId",
          "description": "Stable metadata identity resolved by the owning service."
        },
        "mediaType": {
          "description": "Registered media type.",
          "type": "string"
        },
        "objectVersion": {
          "description": "Immutable backend object version.",
          "type": "string"
        },
        "sizeBytes": {
          "description": "Raw object length.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "storeBinding": {
          "description": "Explicit object-store binding from deployment configuration.",
          "type": "string"
        }
      },
      "required": [
        "artifactId",
        "storeBinding",
        "objectVersion",
        "sizeBytes",
        "mediaType"
      ],
      "type": "object"
    },
    "CandidateId": {
      "description": "Strongly typed UUIDv7 identifier for `CandidateId`.",
      "type": "string"
    },
    "CourseId": {
      "description": "Strongly typed UUIDv7 identifier for `CourseId`.",
      "type": "string"
    },
    "CourseTeacherApprovalScope": {
      "additionalProperties": false,
      "description": "Captured by Control while the verified teacher and current course instructor are checked.",
      "properties": {
        "actorId": {
          "$ref": "#/$defs/ActorId"
        },
        "courseId": {
          "$ref": "#/$defs/CourseId"
        },
        "membershipRevision": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "actorId",
        "courseId",
        "membershipRevision"
      ],
      "type": "object"
    },
    "EnvironmentClass": {
      "description": "Environment business class retained from the v2.1 architecture.",
      "enum": [
        "experiment",
        "work"
      ],
      "type": "string"
    },
    "EnvironmentCreateSpec": {
      "additionalProperties": false,
      "description": "Authoritative fields required to create the first Environment aggregate.",
      "properties": {
        "approvedResources": {
          "$ref": "#/$defs/WorkloadResources",
          "description": "Resources approved by the immutable ReleaseProjection or Work lease.\nEnvironment owns the lifecycle; Resource receives this snapshot only\nthrough the trusted Environment resource reservation handoff."
        },
        "capacityBinding": {
          "type": [
            "string",
            "null"
          ]
        },
        "class": {
          "$ref": "#/$defs/EnvironmentClass"
        },
        "courseId": {
          "anyOf": [
            {
              "$ref": "#/$defs/CourseId"
            },
            {
              "type": "null"
            }
          ]
        },
        "displayLabel": {
          "type": "string"
        },
        "eligibilityExpiresAt": {
          "description": "Material eligibility deadline. `None` is the explicit permanent CourseMaterial form;\nWork instances are later bounded by their Resource lease fence.",
          "type": [
            "string",
            "null"
          ]
        },
        "gpuAllocation": {
          "anyOf": [
            {
              "$ref": "#/$defs/GpuAllocation"
            },
            {
              "type": "null"
            }
          ],
          "description": "Resource-resolved Experiment GPU allocation held for this environment instance when the\napproved resource snapshot includes GPU capacity.\n\nExperiment creation resolves this through Resource before the aggregate is accepted; Work\nenvironments keep their allocation on the Lease authorization instead and leave this absent."
        },
        "leaseId": {
          "anyOf": [
            {
              "$ref": "#/$defs/LeaseId"
            },
            {
              "type": "null"
            }
          ]
        },
        "ownerActorId": {
          "$ref": "#/$defs/ActorId"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectId"
        },
        "providerBinding": {
          "type": "string"
        },
        "releaseId": {
          "$ref": "#/$defs/ReleaseId"
        },
        "releaseVersion": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "retention": {
          "$ref": "#/$defs/RetentionSnapshot",
          "description": "Immutable material retention decision that authorizes the eligibility boundary below."
        },
        "runtimeAuthorization": {
          "anyOf": [
            {
              "$ref": "#/$defs/EnvironmentRuntimeAuthorizationResolution"
            },
            {
              "type": "null"
            }
          ]
        },
        "runtimeKind": {
          "$ref": "#/$defs/RuntimeKind"
        }
      },
      "required": [
        "projectId",
        "ownerActorId",
        "displayLabel",
        "class",
        "runtimeKind",
        "releaseId",
        "releaseVersion",
        "providerBinding",
        "approvedResources",
        "retention",
        "eligibilityExpiresAt"
      ],
      "type": "object"
    },
    "EnvironmentId": {
      "description": "Strongly typed UUIDv7 identifier for `EnvironmentId`.",
      "type": "string"
    },
    "EnvironmentLeaseAuthorization": {
      "additionalProperties": false,
      "description": "Resource-authoritative Active Lease snapshot retained with the accepted operation.\nPrivate single-university deployment simplifies this to a TTL/PVC binding:\n`capacity_binding` maps directly to the Work PVC name and `expires_at` is\nthe authoritative TTL; no separate capacity-shell hash is required.",
      "properties": {
        "activeFrom": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "approvedResources": {
          "$ref": "#/$defs/WorkloadResources",
          "description": "The exact Resource-approved limits Environment must apply to its workload."
        },
        "capacityBinding": {
          "type": "string"
        },
        "courseId": {
          "anyOf": [
            {
              "$ref": "#/$defs/CourseId"
            },
            {
              "type": "null"
            }
          ]
        },
        "environmentId": {
          "$ref": "#/$defs/EnvironmentId"
        },
        "expiresAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "gpuAllocation": {
          "anyOf": [
            {
              "$ref": "#/$defs/GpuAllocation"
            },
            {
              "type": "null"
            }
          ],
          "description": "Catalog resolution captured by Resource when a GPU was approved."
        },
        "leaseId": {
          "$ref": "#/$defs/LeaseId"
        },
        "leaseRevision": {
          "$ref": "#/$defs/Revision"
        },
        "ownerActorId": {
          "$ref": "#/$defs/ActorId"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectId"
        },
        "resourceRequestId": {
          "$ref": "#/$defs/ResourceRequestId",
          "description": "The Resource request that owns this lease. Environment meters use this\nidentity when delivering usage back to Resource."
        }
      },
      "required": [
        "resourceRequestId",
        "leaseId",
        "leaseRevision",
        "environmentId",
        "projectId",
        "ownerActorId",
        "capacityBinding",
        "approvedResources",
        "activeFrom",
        "expiresAt"
      ],
      "type": "object"
    },
    "EnvironmentLifecycleCommand": {
      "additionalProperties": false,
      "description": "Revision-checked lifecycle intent consumed by the Environment state owner.",
      "properties": {
        "acceptedAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "accessRevocationRevision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Revision"
            },
            {
              "type": "null"
            }
          ]
        },
        "actorId": {
          "$ref": "#/$defs/ActorId"
        },
        "deadlineAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "environmentId": {
          "$ref": "#/$defs/EnvironmentId"
        },
        "expectedRevision": {
          "$ref": "#/$defs/Revision"
        },
        "kind": {
          "$ref": "#/$defs/EnvironmentOperationKind"
        },
        "maxAttempts": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "preserveMutableDisk": {
          "type": "boolean"
        },
        "resetTarget": {
          "anyOf": [
            {
              "$ref": "#/$defs/EnvironmentResetTarget"
            },
            {
              "type": "null"
            }
          ]
        },
        "traceId": {
          "type": "string"
        }
      },
      "required": [
        "environmentId",
        "kind",
        "expectedRevision",
        "actorId",
        "traceId",
        "acceptedAt",
        "deadlineAt",
        "preserveMutableDisk",
        "maxAttempts"
      ],
      "type": "object"
    },
    "EnvironmentLifecycleCommandData": {
      "additionalProperties": false,
      "description": "Command-specific data carried inside the catalogued lifecycle CloudEvent.",
      "properties": {
        "command": {
          "$ref": "#/$defs/EnvironmentLifecycleCommand"
        },
        "create": {
          "anyOf": [
            {
              "$ref": "#/$defs/EnvironmentCreateSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "idempotencyKey": {
          "type": "string"
        }
      },
      "required": [
        "idempotencyKey",
        "command"
      ],
      "type": "object"
    },
    "EnvironmentOperationKind": {
      "description": "Explicit operation kind; restart and destructive reset are never aliases.",
      "enum": [
        "create",
        "start",
        "stop",
        "restart",
        "reset",
        "retry",
        "cancel",
        "recover",
        "expire",
        "delete",
        "cleanup",
        "freeze"
      ],
      "type": "string"
    },
    "EnvironmentResetTarget": {
      "description": "Explicit immutable target selected for one reset operation.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "experiment_baseline",
              "type": "string"
            },
            "releaseId": {
              "$ref": "#/$defs/ReleaseId"
            },
            "releaseVersion": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "releaseId",
            "releaseVersion"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "authorizationRevision": {
              "$ref": "#/$defs/Revision"
            },
            "kind": {
              "const": "work_snapshot",
              "type": "string"
            },
            "snapshot": {
              "$ref": "#/$defs/ArtifactRef"
            }
          },
          "required": [
            "kind",
            "snapshot",
            "authorizationRevision"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "authorizationRevision": {
              "$ref": "#/$defs/Revision"
            },
            "configurationRevision": {
              "$ref": "#/$defs/Revision"
            },
            "kind": {
              "const": "work_configuration",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "configurationRevision",
            "authorizationRevision"
          ],
          "type": "object"
        }
      ]
    },
    "EnvironmentRuntimeAuthorizationResolution": {
      "additionalProperties": false,
      "description": "A transport receipt of the original approval and its verified platform execution values.\nThis is not a second grant, approval lifecycle, or client-supplied permission source.",
      "properties": {
        "authorization": {
          "$ref": "#/$defs/RuntimeAuthorizationBinding"
        },
        "defaultContainerUid": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "leaseAuthorization": {
          "$ref": "#/$defs/EnvironmentLeaseAuthorization"
        },
        "ownerActorId": {
          "$ref": "#/$defs/ActorId"
        },
        "privilegedExecutionLocation": {
          "anyOf": [
            {
              "$ref": "#/$defs/PrivilegedExecutionLocation"
            },
            {
              "type": "null"
            }
          ]
        },
        "providerBinding": {
          "type": "string"
        },
        "validUntil": {
          "$ref": "#/$defs/UtcTimestamp"
        }
      },
      "required": [
        "providerBinding",
        "validUntil",
        "leaseAuthorization",
        "authorization",
        "ownerActorId",
        "defaultContainerUid"
      ],
      "type": "object"
    },
    "EventId": {
      "description": "Strongly typed UUIDv7 identifier for `EventId`.",
      "type": "string"
    },
    "GpuAllocation": {
      "additionalProperties": false,
      "description": "The catalog resolution captured on an approved capacity claim.",
      "properties": {
        "allocationBinding": {
          "type": "string"
        },
        "catalogRevision": {
          "$ref": "#/$defs/Revision"
        },
        "class": {
          "type": "string"
        },
        "count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "entryId": {
          "$ref": "#/$defs/GpuCatalogEntryId",
          "description": "Exact catalog row used to resolve this allocation."
        },
        "mode": {
          "$ref": "#/$defs/GpuAllocationMode"
        },
        "providerBinding": {
          "type": "string"
        }
      },
      "required": [
        "entryId",
        "class",
        "count",
        "mode",
        "providerBinding",
        "allocationBinding",
        "catalogRevision"
      ],
      "type": "object"
    },
    "GpuAllocationMode": {
      "description": "Allocation mode selected by the Resource GPU catalog.\n\nCallers submit only a catalog class and count. The mode is resolved from the\nactive catalog entry and is never accepted as an untrusted request override.",
      "enum": [
        "exclusive",
        "container_time_slice",
        "vm_vgpu"
      ],
      "type": "string"
    },
    "GpuCatalogEntryId": {
      "description": "Strongly typed UUIDv7 identifier for `GpuCatalogEntryId`.",
      "type": "string"
    },
    "GpuRequest": {
      "additionalProperties": false,
      "description": "A policy-catalogued GPU class. It intentionally does not expose Kubernetes resource names.",
      "properties": {
        "class": {
          "type": "string"
        },
        "count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "class",
        "count"
      ],
      "type": "object"
    },
    "LeaseId": {
      "description": "Strongly typed UUIDv7 identifier for `LeaseId`.",
      "type": "string"
    },
    "LinuxCapability": {
      "description": "Linux capability names from the kernel UAPI. `ALL` is never an addition.",
      "enum": [
        "CHOWN",
        "DAC_OVERRIDE",
        "DAC_READ_SEARCH",
        "FOWNER",
        "FSETID",
        "KILL",
        "SETGID",
        "SETUID",
        "SETPCAP",
        "LINUX_IMMUTABLE",
        "NET_BIND_SERVICE",
        "NET_BROADCAST",
        "NET_ADMIN",
        "NET_RAW",
        "IPC_LOCK",
        "IPC_OWNER",
        "SYS_MODULE",
        "SYS_RAWIO",
        "SYS_CHROOT",
        "SYS_PTRACE",
        "SYS_PACCT",
        "SYS_ADMIN",
        "SYS_BOOT",
        "SYS_NICE",
        "SYS_RESOURCE",
        "SYS_TIME",
        "SYS_TTY_CONFIG",
        "MKNOD",
        "LEASE",
        "AUDIT_WRITE",
        "AUDIT_CONTROL",
        "SETFCAP",
        "MAC_OVERRIDE",
        "MAC_ADMIN",
        "SYSLOG",
        "WAKE_ALARM",
        "BLOCK_SUSPEND",
        "AUDIT_READ",
        "PERFMON",
        "BPF",
        "CHECKPOINT_RESTORE"
      ],
      "type": "string"
    },
    "PolicyId": {
      "description": "Strongly typed UUIDv7 identifier for `PolicyId`.",
      "type": "string"
    },
    "PrivilegedExecutionLocation": {
      "description": "An execution boundary declaration. The Environment consumer must prove exclusivity.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "dedicated_node_pool",
              "type": "string"
            },
            "nodeSelector": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "taintKey": {
              "type": "string"
            },
            "taintValue": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "nodeSelector",
            "taintKey",
            "taintValue"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "virtual_machine_guest",
              "type": "string"
            },
            "providerBinding": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "providerBinding"
          ],
          "type": "object"
        }
      ]
    },
    "ProjectId": {
      "description": "Strongly typed UUIDv7 identifier for `ProjectId`.",
      "type": "string"
    },
    "ReleaseId": {
      "description": "Strongly typed UUIDv7 identifier for `ReleaseId`.",
      "type": "string"
    },
    "ResourceRequestId": {
      "description": "Strongly typed UUIDv7 identifier for `ResourceRequestId`.",
      "type": "string"
    },
    "ResourceTarget": {
      "description": "Immutable identity of a Resource request's target.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Capacity for a long-lived Environment/Work aggregate that already owns its identity.",
          "properties": {
            "environmentId": {
              "$ref": "#/$defs/EnvironmentId"
            },
            "kind": {
              "const": "environment",
              "type": "string"
            },
            "releaseId": {
              "$ref": "#/$defs/ReleaseId"
            },
            "releaseVersion": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "environmentId",
            "releaseId",
            "releaseVersion"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Capacity for a one-shot task. Resource does not create a fake Environment row.",
          "properties": {
            "kind": {
              "const": "task",
              "type": "string"
            },
            "taskRunId": {
              "$ref": "#/$defs/TaskRunId"
            }
          },
          "required": [
            "kind",
            "taskRunId"
          ],
          "type": "object"
        }
      ]
    },
    "RetentionClass": {
      "description": "Retention classes with distinct privacy and recovery requirements.",
      "enum": [
        "course_material",
        "build_evidence",
        "run_evidence",
        "student_submission",
        "security_audit"
      ],
      "type": "string"
    },
    "RetentionDisposition": {
      "description": "Required action after retention expires.",
      "enum": [
        "delete",
        "purge_after_export",
        "retain_sanitized_receipt",
        "retain_until_revoked"
      ],
      "type": "string"
    },
    "RetentionSnapshot": {
      "additionalProperties": false,
      "description": "Frozen data-retention decision for an immutable resource.",
      "properties": {
        "class": {
          "$ref": "#/$defs/RetentionClass",
          "description": "Stable retention class."
        },
        "disposition": {
          "$ref": "#/$defs/RetentionDisposition",
          "description": "Required terminal disposition."
        },
        "policyId": {
          "$ref": "#/$defs/PolicyId",
          "description": "Policy identity."
        },
        "policyRevision": {
          "$ref": "#/$defs/Revision",
          "description": "Exact policy revision used at creation."
        },
        "retainUntil": {
          "description": "Absolute retention boundary. `None` is valid only for an explicitly permanent course\nmaterial decision whose disposition is `RetainUntilRevoked`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "policyId",
        "policyRevision",
        "class",
        "retainUntil",
        "disposition"
      ],
      "type": "object"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "RuntimeAdmissionBasis": {
      "enum": [
        "restricted_baseline",
        "project_preauthorization",
        "course_preauthorization"
      ],
      "type": "string"
    },
    "RuntimeAuthorizationBinding": {
      "additionalProperties": false,
      "description": "Part of the existing immutable ResourceApproval, with no independent approval lifecycle.",
      "properties": {
        "basis": {
          "$ref": "#/$defs/RuntimeAdmissionBasis"
        },
        "configuration": {
          "$ref": "#/$defs/RuntimeConfigurationIdentity"
        },
        "courseId": {
          "anyOf": [
            {
              "$ref": "#/$defs/CourseId"
            },
            {
              "type": "null"
            }
          ]
        },
        "permissions": {
          "$ref": "#/$defs/RuntimePreauthorization"
        },
        "platformConfigurationRevision": {
          "$ref": "#/$defs/Revision",
          "description": "This is the verified applied platform version, never the candidate's LLM policy revision."
        },
        "platformConfigurationSha256": {
          "type": "string"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectId"
        },
        "requestGeneration": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "requestId": {
          "$ref": "#/$defs/ResourceRequestId"
        },
        "target": {
          "$ref": "#/$defs/ResourceTarget"
        }
      },
      "required": [
        "requestId",
        "projectId",
        "requestGeneration",
        "target",
        "configuration",
        "platformConfigurationRevision",
        "platformConfigurationSha256",
        "permissions",
        "basis"
      ],
      "type": "object"
    },
    "RuntimeConfigurationIdentity": {
      "additionalProperties": false,
      "description": "Control-owned immutable configuration identity. Clients cannot supply a replacement digest.",
      "properties": {
        "authoringApprovalId": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApprovalId"
            },
            {
              "type": "null"
            }
          ]
        },
        "authoringProjectId": {
          "$ref": "#/$defs/ProjectId"
        },
        "candidateId": {
          "$ref": "#/$defs/CandidateId"
        },
        "candidateRevision": {
          "$ref": "#/$defs/Revision"
        },
        "configurationSha256": {
          "type": "string"
        },
        "courseId": {
          "anyOf": [
            {
              "$ref": "#/$defs/CourseId"
            },
            {
              "type": "null"
            }
          ]
        },
        "teacherScope": {
          "anyOf": [
            {
              "$ref": "#/$defs/CourseTeacherApprovalScope"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "authoringProjectId",
        "candidateId",
        "candidateRevision",
        "configurationSha256"
      ],
      "type": "object"
    },
    "RuntimeKind": {
      "description": "Runtime kind shared by candidates, releases, and instances.",
      "enum": [
        "container",
        "virtual_machine"
      ],
      "type": "string"
    },
    "RuntimePreauthorization": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "items": {
            "$ref": "#/$defs/LinuxCapability"
          },
          "type": "array",
          "uniqueItems": true
        },
        "privileged": {
          "type": "boolean"
        },
        "scope": {
          "$ref": "#/$defs/RuntimePreauthorizationScope"
        }
      },
      "required": [
        "scope",
        "capabilities",
        "privileged"
      ],
      "type": "object"
    },
    "RuntimePreauthorizationScope": {
      "description": "Object scope for a runtime preauthorization, never a builder authorization.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "project",
              "type": "string"
            },
            "projectId": {
              "$ref": "#/$defs/ProjectId"
            }
          },
          "required": [
            "kind",
