{
  "$defs": {
    "ActorId": {
      "description": "Strongly typed UUIDv7 identifier for `ActorId`.",
      "type": "string"
    },
    "ApprovalId": {
      "description": "Strongly typed UUIDv7 identifier for `ApprovalId`.",
      "type": "string"
    },
    "AuthoringApproval": {
      "additionalProperties": false,
      "description": "One teacher decision that binds a complete immutable authoring package.\n\nThe decision carries only stable identities and the resolved runtime artifact. Control writes\nit once after validating the package, both candidates, and the authoritative build projection;\nEnvironment and Evaluation consume this same binding instead of composing independent\ncandidate approvals.",
      "properties": {
        "actorId": {
          "$ref": "#/$defs/ActorId"
        },
        "approvedAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "courseId": {
          "anyOf": [
            {
              "$ref": "#/$defs/CourseId"
            },
            {
              "type": "null"
            }
          ]
        },
        "environmentCandidateId": {
          "$ref": "#/$defs/CandidateId"
        },
        "environmentCandidateRevision": {
          "$ref": "#/$defs/Revision"
        },
        "evaluationCandidateId": {
          "$ref": "#/$defs/CandidateId"
        },
        "evaluationCandidateRevision": {
          "$ref": "#/$defs/Revision"
        },
        "evaluationRuntimeIdentity": {
          "$ref": "#/$defs/EvaluationRuntimeIdentity",
          "description": "Exact Evaluation execution identity frozen when this approval is completed."
        },
        "id": {
          "$ref": "#/$defs/ApprovalId"
        },
        "imageArtifact": {
          "$ref": "#/$defs/ImageArtifact"
        },
        "packageId": {
          "$ref": "#/$defs/ProblemPackageId"
        },
        "packageRevision": {
          "$ref": "#/$defs/Revision"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectId"
        },
        "reason": {
          "type": "string"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "id",
        "projectId",
        "revision",
        "packageId",
        "packageRevision",
        "environmentCandidateId",
        "environmentCandidateRevision",
        "evaluationCandidateId",
        "evaluationCandidateRevision",
        "evaluationRuntimeIdentity",
        "imageArtifact",
        "actorId",
        "reason",
        "approvedAt"
      ],
      "type": "object"
    },
    "AuthoringApprovalCompleted": {
      "additionalProperties": false,
      "description": "Control-owned terminal fact for one complete authoring approval.",
      "properties": {
        "approval": {
          "$ref": "#/$defs/AuthoringApproval"
        }
      },
      "required": [
        "approval"
      ],
      "type": "object"
    },
    "BuildRequestId": {
      "description": "Strongly typed UUIDv7 identifier for `BuildRequestId`.",
      "type": "string"
    },
    "CandidateId": {
      "description": "Strongly typed UUIDv7 identifier for `CandidateId`.",
      "type": "string"
    },
    "CourseId": {
      "description": "Strongly typed UUIDv7 identifier for `CourseId`.",
      "type": "string"
    },
    "EvaluationRuntimeIdentity": {
      "additionalProperties": false,
      "description": "Immutable build and deployment identity that must match every run using the release.",
      "properties": {
        "providerBinding": {
          "description": "Explicit runtime provider binding chosen by Control and enforced by Evaluation.",
          "type": "string"
        },
        "runnerImage": {
          "description": "Digest-pinned runner image reference.",
          "type": "string"
        }
      },
      "required": [
        "providerBinding",
        "runnerImage"
      ],
      "type": "object"
    },
    "EventId": {
      "description": "Strongly typed UUIDv7 identifier for `EventId`.",
      "type": "string"
    },
    "ImageArtifact": {
      "description": "Complete immutable runtime artifact identity.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "build_request_id": {
              "$ref": "#/$defs/BuildRequestId"
            },
            "digest": {
              "type": "string"
            },
            "id": {
              "$ref": "#/$defs/ImageArtifactId"
            },
            "kind": {
              "const": "container",
              "type": "string"
            },
            "repository": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id",
            "build_request_id",
            "repository",
            "digest"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "base_disk": {
              "$ref": "#/$defs/VirtualMachineBaseDisk"
            },
            "format": {
              "$ref": "#/$defs/VirtualMachineDiskFormat"
            },
            "id": {
              "$ref": "#/$defs/ImageArtifactId"
            },
            "kind": {
              "const": "virtual_machine",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id",
            "base_disk",
            "format"
          ],
          "type": "object"
        }
      ]
    },
    "ImageArtifactId": {
      "description": "Strongly typed UUIDv7 identifier for `ImageArtifactId`.",
      "type": "string"
    },
    "ProblemPackageId": {
      "description": "Strongly typed UUIDv7 identifier for `ProblemPackageId`.",
      "type": "string"
    },
    "ProjectId": {
      "description": "Strongly typed UUIDv7 identifier for `ProjectId`.",
      "type": "string"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "Sequence": {
      "description": "Aggregate-local ordering sequence. This value is not an SSE resume cursor.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "UtcTimestamp": {
      "description": "UTC timestamp serialized with a literal `Z` and millisecond precision.",
      "type": "string"
    },
    "VirtualMachineBaseDisk": {
      "additionalProperties": false,
      "description": "Deployment-owned immutable KubeVirt base-disk identity.\n\nUnlike an object-store `ArtifactRef`, this identifies a CDI source image and its imported\ndisk content. `capacity_bytes` is the reviewed PVC capacity, not a fabricated object length.",
      "properties": {
        "binding": {
          "type": "string"
        },
        "capacityBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "sourceRegistryDigest": {
          "type": "string"
        }
      },
      "required": [
        "binding",
        "sourceRegistryDigest",
        "capacityBytes"
      ],
      "type": "object"
    },
    "VirtualMachineDiskFormat": {
      "description": "Supported VM base-disk encodings.",
      "enum": [
        "qcow2",
        "raw"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Strict CloudEvents 1.0 envelope carried as structured JSON.",
  "properties": {
    "aggregateRevision": {
      "$ref": "#/$defs/Revision"
    },
    "aggregateSequence": {
      "$ref": "#/$defs/Sequence"
    },
    "courseId": {
      "anyOf": [
        {
          "$ref": "#/$defs/CourseId"
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional teaching association. Independent projects omit this field."
    },
    "data": {
      "$ref": "#/$defs/AuthoringApprovalCompleted"
    },
    "datacontenttype": {
      "type": "string"
    },
    "dataschema": {
      "type": "string"
    },
    "id": {
      "$ref": "#/$defs/EventId"
    },
    "projectId": {
      "$ref": "#/$defs/ProjectId",
      "description": "Required project scope for every platform event, including independent Work events."
    },
    "source": {
      "type": "string"
    },
    "specversion": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "time": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "traceId": {
      "type": "string"
    },
    "type": {
      "type": "string"
    }
  },
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "subject",
    "time",
    "datacontenttype",
    "dataschema",
    "projectId",
    "aggregateRevision",
    "aggregateSequence",
    "traceId",
    "data"
  ],
  "title": "CloudEvent",
  "type": "object"
}
