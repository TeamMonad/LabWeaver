{
  "$defs": {
    "ActorId": {
      "description": "Strongly typed UUIDv7 identifier for `ActorId`.",
      "type": "string"
    },
    "CourseExperiment": {
      "additionalProperties": false,
      "properties": {
        "courseId": {
          "$ref": "#/$defs/CourseId"
        },
        "createdAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "id": {
          "$ref": "#/$defs/CourseExperimentId"
        },
        "policy": {
          "$ref": "#/$defs/ExperimentPolicy"
        },
        "releaseId": {
          "$ref": "#/$defs/ReleaseId"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "id",
        "courseId",
        "releaseId",
        "policy",
        "revision",
        "createdAt"
      ],
      "type": "object"
    },
    "CourseExperimentId": {
      "description": "Strongly typed UUIDv7 identifier for `CourseExperimentId`.",
      "type": "string"
    },
    "CourseId": {
      "description": "Strongly typed UUIDv7 identifier for `CourseId`.",
      "type": "string"
    },
    "ExperimentGroup": {
      "additionalProperties": false,
      "properties": {
        "createdAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "experimentId": {
          "$ref": "#/$defs/CourseExperimentId"
        },
        "id": {
          "$ref": "#/$defs/ExperimentGroupId"
        },
        "memberActorIds": {
          "items": {
            "$ref": "#/$defs/ActorId"
          },
          "type": "array"
        },
        "payerActorId": {
          "$ref": "#/$defs/ActorId"
        },
        "payerConsent": {
          "type": "boolean"
        },
        "payerProjectId": {
          "$ref": "#/$defs/ProjectId"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "id",
        "experimentId",
        "payerProjectId",
        "payerActorId",
        "memberActorIds",
        "payerConsent",
        "revision",
        "createdAt"
      ],
      "type": "object"
    },
    "ExperimentGroupId": {
      "description": "Strongly typed UUIDv7 identifier for `ExperimentGroupId`.",
      "type": "string"
    },
    "ExperimentPolicy": {
      "enum": [
        "individual",
        "group"
      ],
      "type": "string"
    },
    "ProjectId": {
      "description": "Strongly typed UUIDv7 identifier for `ProjectId`.",
      "type": "string"
    },
    "ReleaseId": {
      "description": "Strongly typed UUIDv7 identifier for `ReleaseId`.",
      "type": "string"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "UtcTimestamp": {
      "description": "UTC timestamp serialized with a literal `Z` and millisecond precision.",
      "type": "string"
    }
