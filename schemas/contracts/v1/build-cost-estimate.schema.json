{
  "$defs": {
    "BuildCostEstimateRequest": {
      "additionalProperties": false,
      "properties": {
        "builderBinding": {
          "type": "string"
        },
        "from": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "maxDurationMilliseconds": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "builderBinding",
        "maxDurationMilliseconds",
        "from"
      ],
      "type": "object"
    },
    "FixedDecimal": {
      "description": "Canonical signed decimal with exactly six fractional digits.\n\nDecimal values cross the API as strings so JavaScript clients and SQL\ndrivers cannot round monetary values through binary floating point. The\ninternal scaled representation is available to Resource arithmetic without\nintroducing a database-specific decimal dependency into the contracts crate.",
      "format": "fixed-decimal-6",
      "pattern": "^-?(0|[1-9][0-9]*)[.][0-9]{6}$",
      "type": "string"
    },
    "Money": {
      "additionalProperties": false,
      "description": "A fixed-precision amount with an explicit ISO-4217-like currency code.",
      "properties": {
        "amount": {
          "$ref": "#/$defs/FixedDecimal"
        },
        "currency": {
          "type": "string"
        }
      },
      "required": [
        "currency",
        "amount"
      ],
      "type": "object"
    },
    "ProjectId": {
      "description": "Strongly typed UUIDv7 identifier for `ProjectId`.",
      "type": "string"
    },
    "RateId": {
      "description": "Strongly typed UUIDv7 identifier for `RateId`.",
      "type": "string"
    },
    "ResourceBillingUnit": {
      "description": "Resource dimension used by a versioned rate card.",
      "enum": [
        "cpu_millicore_second",
        "memory_byte_second",
        "storage_byte_second",
        "gpu_unit_second",
        "build_second"
      ],
      "type": "string"
    },
    "ResourceChargeLine": {
      "additionalProperties": false,
      "description": "One immutable line in a calculated charge.",
      "properties": {
        "amount": {
          "$ref": "#/$defs/Money"
        },
        "quantity": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "quantityDivisor": {
          "default": 1,
          "enum": [
            1,
            1000
          ],
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "rateId": {
          "$ref": "#/$defs/RateId"
        },
        "rateRevision": {
          "$ref": "#/$defs/Revision"
        },
        "unit": {
          "$ref": "#/$defs/ResourceBillingUnit"
        },
        "unitPrice": {
          "$ref": "#/$defs/Money"
        },
        "unitQuantity": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "rateId",
        "rateRevision",
        "unit",
        "quantity",
        "unitQuantity",
        "unitPrice",
        "amount"
      ],
      "type": "object"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "UtcTimestamp": {
      "description": "UTC timestamp serialized with a literal `Z` and millisecond precision.",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "input": {
      "$ref": "#/$defs/BuildCostEstimateRequest"
    },
    "lines": {
      "items": {
        "$ref": "#/$defs/ResourceChargeLine"
      },
      "type": "array"
    },
    "projectId": {
      "$ref": "#/$defs/ProjectId"
    },
    "total": {
      "$ref": "#/$defs/Money"
    },
    "until": {
      "$ref": "#/$defs/UtcTimestamp"
    }
  },
  "required": [
    "projectId",
    "input",
    "until",
    "lines",
    "total"
  ],
  "title": "BuildCostEstimate",
  "type": "object"
}
