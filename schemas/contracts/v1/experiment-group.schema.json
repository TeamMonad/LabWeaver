{
  "$defs": {
    "ActorId": {
      "description": "Strongly typed UUIDv7 identifier for `ActorId`.",
      "type": "string"
    },
    "CourseExperimentId": {
      "description": "Strongly typed UUIDv7 identifier for `CourseExperimentId`.",
      "type": "string"
    },
    "ExperimentGroupId": {
      "description": "Strongly typed UUIDv7 identifier for `ExperimentGroupId`.",
      "type": "string"
    },
    "ProjectId": {
      "description": "Strongly typed UUIDv7 identifier for `ProjectId`.",
      "type": "string"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "UtcTimestamp": {
      "description": "UTC timestamp serialized with a literal `Z` and millisecond precision.",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "createdAt": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "experimentId": {
      "$ref": "#/$defs/CourseExperimentId"
    },
    "id": {
      "$ref": "#/$defs/ExperimentGroupId"
    },
    "memberActorIds": {
      "items": {
        "$ref": "#/$defs/ActorId"
      },
      "type": "array"
    },
    "payerActorId": {
      "$ref": "#/$defs/ActorId"
    },
    "payerConsent": {
      "type": "boolean"
    },
    "payerProjectId": {
      "$ref": "#/$defs/ProjectId"
    },
    "revision": {
      "$ref": "#/$defs/Revision"
    }
  },
  "required": [
    "id",
    "experimentId",
    "payerProjectId",
    "payerActorId",
    "memberActorIds",
    "payerConsent",
    "revision",
    "createdAt"
  ],
  "title": "ExperimentGroup",
  "type": "object"
}
