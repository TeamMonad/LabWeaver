{
  "$defs": {
    "ArtifactId": {
      "description": "Strongly typed UUIDv7 identifier for `ArtifactId`.",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Immutable object-store identity without a machine-local path or credential.",
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/ArtifactId",
          "description": "Stable metadata identity resolved by the owning service."
        },
        "mediaType": {
          "description": "Registered media type.",
          "type": "string"
        },
        "objectVersion": {
          "description": "Immutable backend object version.",
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Digest",
          "description": "Exact content digest."
        },
        "sizeBytes": {
          "description": "Raw object length.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "storeBinding": {
          "description": "Explicit object-store binding from deployment configuration.",
          "type": "string"
        }
      },
      "required": [
        "artifactId",
        "storeBinding",
        "objectVersion",
        "sha256",
        "sizeBytes",
        "mediaType"
      ],
      "type": "object"
    },
    "ReleaseId": {
      "description": "Strongly typed UUIDv7 identifier for `ReleaseId`.",
      "type": "string"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "Sha256Digest": {
      "description": "Canonical lowercase SHA-256 digest.",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Explicit immutable target selected for one reset operation.",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "experiment_baseline",
          "type": "string"
        },
        "releaseId": {
          "$ref": "#/$defs/ReleaseId"
        },
        "releaseVersion": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "releaseId",
        "releaseVersion"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "authorizationRevision": {
          "$ref": "#/$defs/Revision"
        },
        "kind": {
          "const": "work_snapshot",
          "type": "string"
        },
        "snapshot": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "kind",
        "snapshot",
        "authorizationRevision"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "authorizationRevision": {
          "$ref": "#/$defs/Revision"
        },
        "configurationRevision": {
          "$ref": "#/$defs/Revision"
        },
        "kind": {
          "const": "work_configuration",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "configurationRevision",
        "authorizationRevision"
      ],
      "type": "object"
    }
  ],
  "title": "EnvironmentResetTarget"
}
