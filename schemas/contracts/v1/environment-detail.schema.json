{
  "$defs": {
    "ActorId": {
      "description": "Strongly typed UUIDv7 identifier for `ActorId`.",
      "type": "string"
    },
    "ApprovalId": {
      "description": "Strongly typed UUIDv7 identifier for `ApprovalId`.",
      "type": "string"
    },
    "ArtifactId": {
      "description": "Strongly typed UUIDv7 identifier for `ArtifactId`.",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Immutable object-store identity without a machine-local path or credential.",
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/ArtifactId",
          "description": "Stable metadata identity resolved by the owning service."
        },
        "mediaType": {
          "description": "Registered media type.",
          "type": "string"
        },
        "objectVersion": {
          "description": "Immutable backend object version.",
          "type": "string"
        },
        "sizeBytes": {
          "description": "Raw object length.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "storeBinding": {
          "description": "Explicit object-store binding from deployment configuration.",
          "type": "string"
        }
      },
      "required": [
        "artifactId",
        "storeBinding",
        "objectVersion",
        "sizeBytes",
        "mediaType"
      ],
      "type": "object"
    },
    "CourseId": {
      "description": "Strongly typed UUIDv7 identifier for `CourseId`.",
      "type": "string"
    },
    "CourseTeacherApprovalScope": {
      "additionalProperties": false,
      "description": "Captured by Control while the verified teacher and current course instructor are checked.",
      "properties": {
        "actorId": {
          "$ref": "#/$defs/ActorId"
        },
        "courseId": {
          "$ref": "#/$defs/CourseId"
        },
        "membershipRevision": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "actorId",
        "courseId",
        "membershipRevision"
      ],
      "type": "object"
    },
    "DesiredEnvironmentState": {
      "description": "Requested steady state.",
      "enum": [
        "running",
        "stopped",
        "deleted"
      ],
      "type": "string"
    },
    "EndpointHealth": {
      "description": "Endpoint health gates new AccessGrants.",
      "oneOf": [
        {
          "enum": [
            "pending",
            "healthy",
            "unhealthy",
            "removed"
          ],
          "type": "string"
        },
        {
          "const": "unknown",
          "description": "The runtime exists, but no successful connection probe has been observed.",
          "type": "string"
        }
      ]
    },
    "EndpointId": {
      "description": "Strongly typed UUIDv7 identifier for `EndpointId`.",
      "type": "string"
    },
    "EndpointProtocol": {
      "description": "Supported controlled protocols.",
      "enum": [
        "http",
        "https",
        "ssh"
      ],
      "type": "string"
    },
    "EnvironmentClass": {
      "description": "Environment business class retained from the v2.1 architecture.",
      "enum": [
        "experiment",
        "work"
      ],
      "type": "string"
    },
    "EnvironmentConnectionReadiness": {
      "additionalProperties": false,
      "properties": {
        "guestInstructions": {
          "description": "Non-secret instructions. Platform authentication does not imply a guest OS login.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "instanceReady": {
          "type": "boolean"
        },
        "observedAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtcTimestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "reasonCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/EnvironmentConnectionState"
        }
      },
      "required": [
        "instanceReady",
        "state",
        "guestInstructions"
      ],
      "type": "object"
    },
    "EnvironmentConnectionState": {
      "description": "Connection preparation is distinct from the runtime instance's lifecycle state.",
      "enum": [
        "preparing",
        "ready",
        "unknown",
        "unavailable"
      ],
      "type": "string"
    },
    "EnvironmentEndpoint": {
      "additionalProperties": false,
      "description": "Sanitized Environment-owned endpoint metadata.",
      "properties": {
        "health": {
          "$ref": "#/$defs/EndpointHealth"
        },
        "id": {
          "$ref": "#/$defs/EndpointId"
        },
        "observedAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "protocol": {
          "$ref": "#/$defs/EndpointProtocol"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "id",
        "protocol",
        "revision",
        "health",
        "observedAt"
      ],
      "type": "object"
    },
    "EnvironmentId": {
      "description": "Strongly typed UUIDv7 identifier for `EnvironmentId`.",
      "type": "string"
    },
    "EnvironmentLeaseAuthorization": {
      "additionalProperties": false,
      "description": "Resource-authoritative Active Lease snapshot retained with the accepted operation.\nPrivate single-university deployment simplifies this to a TTL/PVC binding:\n`capacity_binding` maps directly to the Work PVC name and `expires_at` is\nthe authoritative TTL; no separate capacity-shell hash is required.",
      "properties": {
        "activeFrom": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "approvedResources": {
          "$ref": "#/$defs/WorkloadResources",
          "description": "The exact Resource-approved limits Environment must apply to its workload."
        },
        "capacityBinding": {
          "type": "string"
        },
        "courseId": {
          "anyOf": [
            {
              "$ref": "#/$defs/CourseId"
            },
            {
              "type": "null"
            }
          ]
        },
        "environmentId": {
          "$ref": "#/$defs/EnvironmentId"
        },
        "expiresAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "gpuAllocation": {
          "anyOf": [
            {
              "$ref": "#/$defs/GpuAllocation"
            },
            {
              "type": "null"
            }
          ],
          "description": "Catalog resolution captured by Resource when a GPU was approved."
        },
        "leaseId": {
          "$ref": "#/$defs/LeaseId"
        },
        "leaseRevision": {
          "$ref": "#/$defs/Revision"
        },
        "ownerActorId": {
          "$ref": "#/$defs/ActorId"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectId"
        },
        "resourceRequestId": {
          "$ref": "#/$defs/ResourceRequestId",
          "description": "The Resource request that owns this lease. Environment meters use this\nidentity when delivering usage back to Resource."
        }
      },
      "required": [
        "resourceRequestId",
        "leaseId",
        "leaseRevision",
        "environmentId",
        "projectId",
        "ownerActorId",
        "capacityBinding",
        "approvedResources",
        "activeFrom",
        "expiresAt"
      ],
      "type": "object"
    },
    "EnvironmentOperation": {
      "additionalProperties": false,
      "description": "Idempotent accepted environment operation.",
      "properties": {
        "acceptedAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "acceptedRevision": {
          "$ref": "#/$defs/Revision"
        },
        "accessRevocationRevision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Revision"
            },
            {
              "type": "null"
            }
          ]
        },
        "actorId": {
          "$ref": "#/$defs/ActorId"
        },
        "attempt": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "cleanupStartedAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtcTimestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "deadlineAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "diagnosticCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "$ref": "#/$defs/OperationId"
        },
        "kind": {
          "$ref": "#/$defs/EnvironmentOperationKind"
        },
        "leaseAuthorization": {
          "anyOf": [
            {
              "$ref": "#/$defs/EnvironmentLeaseAuthorization"
            },
            {
              "type": "null"
            }
          ]
        },
        "maxAttempts": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "nextAttemptAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "preserveMutableDisk": {
          "type": "boolean"
        },
        "providerStep": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "resetTarget": {
          "anyOf": [
            {
              "$ref": "#/$defs/EnvironmentResetTarget"
            },
            {
              "type": "null"
            }
          ]
        },
        "retryFromPhase": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObservedEnvironmentState"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "$ref": "#/$defs/OperationState"
        },
        "templateUpgrade": {
          "anyOf": [
            {
              "$ref": "#/$defs/EnvironmentTemplateUpgrade"
            },
            {
              "type": "null"
            }
          ]
        },
        "traceId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "state",
        "acceptedRevision",
        "attempt",
        "providerStep",
        "maxAttempts",
        "nextAttemptAt",
        "actorId",
        "traceId",
        "acceptedAt",
        "deadlineAt",
        "preserveMutableDisk"
      ],
      "type": "object"
    },
    "EnvironmentOperationKind": {
      "description": "Explicit operation kind; restart and destructive reset are never aliases.",
      "enum": [
        "create",
        "start",
        "stop",
        "restart",
        "reset",
        "retry",
        "cancel",
        "recover",
        "expire",
        "delete",
        "cleanup",
        "freeze"
      ],
      "type": "string"
    },
    "EnvironmentResetTarget": {
      "description": "Explicit immutable target selected for one reset operation.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "experiment_baseline",
              "type": "string"
            },
            "releaseId": {
              "$ref": "#/$defs/ReleaseId"
            },
            "releaseVersion": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "releaseId",
            "releaseVersion"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "authorizationRevision": {
              "$ref": "#/$defs/Revision"
            },
            "kind": {
              "const": "work_snapshot",
              "type": "string"
            },
            "snapshot": {
              "$ref": "#/$defs/ArtifactRef"
            }
          },
          "required": [
            "kind",
            "snapshot",
            "authorizationRevision"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "authorizationRevision": {
              "$ref": "#/$defs/Revision"
            },
            "configurationRevision": {
              "$ref": "#/$defs/Revision"
            },
            "kind": {
              "const": "work_configuration",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "configurationRevision",
            "authorizationRevision"
          ],
          "type": "object"
        }
      ]
    },
    "EnvironmentRuntimeAuthorizationResolution": {
      "additionalProperties": false,
      "description": "A read-only transport receipt; Resource remains the single approval authority.",
      "properties": {
        "authorization": {
          "$ref": "#/$defs/RuntimeAuthorizationBinding"
        },
        "leaseAuthorization": {
          "$ref": "#/$defs/EnvironmentLeaseAuthorization"
        },
        "ownerActorId": {
          "$ref": "#/$defs/ActorId"
        },
        "providerBinding": {
          "type": "string"
        },
        "validUntil": {
          "$ref": "#/$defs/UtcTimestamp"
        }
      },
      "required": [
        "providerBinding",
        "validUntil",
        "leaseAuthorization",
        "authorization",
        "ownerActorId"
      ],
      "type": "object"
    },
    "EnvironmentTemplateUpgrade": {
      "additionalProperties": false,
      "description": "Accepted container Work cutover. The release is desired until the operation succeeds.",
      "properties": {
        "dataPolicy": {
          "$ref": "#/$defs/WorkTemplateUpgradeDataPolicy"
        },
        "sourceReleaseId": {
          "$ref": "#/$defs/ReleaseId"
        },
        "sourceReleaseVersion": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "targetReleaseId": {
          "$ref": "#/$defs/ReleaseId"
        },
        "targetReleaseVersion": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "sourceReleaseId",
        "sourceReleaseVersion",
        "targetReleaseId",
        "targetReleaseVersion",
        "dataPolicy"
      ],
      "type": "object"
    },
    "GpuAllocation": {
      "additionalProperties": false,
      "description": "The catalog resolution captured on an approved capacity claim.",
      "properties": {
        "allocationBinding": {
          "type": "string"
        },
        "catalogRevision": {
          "$ref": "#/$defs/Revision"
        },
        "class": {
          "type": "string"
        },
        "count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "entryId": {
          "$ref": "#/$defs/GpuCatalogEntryId",
          "description": "Exact catalog row used to resolve this allocation."
        },
        "mode": {
          "$ref": "#/$defs/GpuAllocationMode"
        },
        "providerBinding": {
          "type": "string"
        }
      },
      "required": [
        "entryId",
        "class",
        "count",
        "mode",
        "providerBinding",
        "allocationBinding",
        "catalogRevision"
      ],
      "type": "object"
    },
    "GpuAllocationMode": {
      "description": "Allocation mode selected by the Resource GPU catalog.\n\nCallers submit only a catalog class and count. The mode is resolved from the\nactive catalog entry and is never accepted as an untrusted request override.",
      "enum": [
        "exclusive",
        "container_time_slice",
        "vm_vgpu"
      ],
      "type": "string"
    },
    "GpuCatalogEntryId": {
      "description": "Strongly typed UUIDv7 identifier for `GpuCatalogEntryId`.",
      "type": "string"
    },
    "GpuRequest": {
      "additionalProperties": false,
      "description": "A policy-catalogued GPU class. It intentionally does not expose Kubernetes resource names.",
      "properties": {
        "class": {
          "type": "string"
        },
        "count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "class",
        "count"
      ],
      "type": "object"
    },
    "LeaseId": {
      "description": "Strongly typed UUIDv7 identifier for `LeaseId`.",
      "type": "string"
    },
    "LinuxCapability": {
      "description": "Linux capability names from the kernel UAPI. `ALL` is never an addition.",
      "enum": [
        "CHOWN",
        "DAC_OVERRIDE",
        "DAC_READ_SEARCH",
        "FOWNER",
        "FSETID",
        "KILL",
        "SETGID",
        "SETUID",
        "SETPCAP",
        "LINUX_IMMUTABLE",
        "NET_BIND_SERVICE",
        "NET_BROADCAST",
        "NET_ADMIN",
        "NET_RAW",
        "IPC_LOCK",
        "IPC_OWNER",
        "SYS_MODULE",
        "SYS_RAWIO",
        "SYS_CHROOT",
        "SYS_PTRACE",
        "SYS_PACCT",
        "SYS_ADMIN",
        "SYS_BOOT",
        "SYS_NICE",
        "SYS_RESOURCE",
        "SYS_TIME",
        "SYS_TTY_CONFIG",
        "MKNOD",
        "LEASE",
        "AUDIT_WRITE",
        "AUDIT_CONTROL",
        "SETFCAP",
        "MAC_OVERRIDE",
        "MAC_ADMIN",
        "SYSLOG",
        "WAKE_ALARM",
        "BLOCK_SUSPEND",
        "AUDIT_READ",
        "PERFMON",
        "BPF",
        "CHECKPOINT_RESTORE"
      ],
      "type": "string"
    },
    "ObservedEnvironmentState": {
      "description": "Authoritative observed lifecycle state.",
      "enum": [
        "requested",
        "validating",
        "building",
        "provisioning",
        "ready",
        "stopping",
        "stopped",
        "updating",
        "expiring",
        "deleting",
        "deleted",
        "failed"
      ],
      "type": "string"
    },
    "OperationId": {
      "description": "Strongly typed UUIDv7 identifier for `OperationId`.",
      "type": "string"
    },
    "OperationState": {
      "description": "Persistent operation state.",
      "enum": [
        "accepted",
        "running",
        "cancelling",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "ProjectId": {
      "description": "Strongly typed UUIDv7 identifier for `ProjectId`.",
      "type": "string"
    },
    "ReleaseId": {
      "description": "Strongly typed UUIDv7 identifier for `ReleaseId`.",
      "type": "string"
    },
    "ResourceRequestId": {
      "description": "Strongly typed UUIDv7 identifier for `ResourceRequestId`.",
      "type": "string"
    },
    "ResourceTarget": {
      "description": "Immutable identity of a Resource request's target.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Capacity for a long-lived Environment/Work aggregate that already owns its identity.",
          "properties": {
            "environmentId": {
              "$ref": "#/$defs/EnvironmentId"
            },
            "kind": {
              "const": "environment",
              "type": "string"
            },
            "releaseId": {
              "$ref": "#/$defs/ReleaseId"
            },
            "releaseVersion": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "environmentId",
            "releaseId",
            "releaseVersion"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Capacity for a one-shot task. Resource does not create a fake Environment row.",
          "properties": {
            "kind": {
              "const": "task",
              "type": "string"
            },
            "taskRunId": {
              "$ref": "#/$defs/TaskRunId"
            }
          },
          "required": [
            "kind",
            "taskRunId"
          ],
          "type": "object"
        }
      ]
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "RuntimeAdmissionBasis": {
      "enum": [
        "restricted_baseline",
        "project_preauthorization",
        "course_preauthorization"
      ],
      "type": "string"
    },
    "RuntimeAuthorizationBinding": {
      "additionalProperties": false,
      "description": "Part of the existing immutable ResourceApproval, with no independent approval lifecycle.",
      "properties": {
        "basis": {
          "$ref": "#/$defs/RuntimeAdmissionBasis"
        },
        "configuration": {
          "$ref": "#/$defs/RuntimeConfigurationIdentity"
        },
        "courseId": {
          "anyOf": [
            {
              "$ref": "#/$defs/CourseId"
            },
            {
              "type": "null"
            }
          ]
        },
        "permissions": {
          "$ref": "#/$defs/RuntimePreauthorization"
        },
        "platformConfigurationRevision": {
          "$ref": "#/$defs/Revision",
          "description": "This is the verified applied platform version, never the candidate's LLM policy revision."
        },
        "platformConfigurationSha256": {
          "type": "string"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectId"
        },
        "requestGeneration": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "requestId": {
          "$ref": "#/$defs/ResourceRequestId"
        },
        "target": {
          "$ref": "#/$defs/ResourceTarget"
        }
      },
      "required": [
        "requestId",
        "projectId",
        "requestGeneration",
        "target",
        "configuration",
        "platformConfigurationRevision",
        "platformConfigurationSha256",
        "permissions",
        "basis"
      ],
      "type": "object"
    },
    "RuntimeConfigurationIdentity": {
      "additionalProperties": false,
      "description": "Control-owned immutable configuration identity. Clients cannot supply a replacement digest.",
      "properties": {
        "authoringApprovalId": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApprovalId"
            },
            {
              "type": "null"
            }
          ]
        },
        "authoringProjectId": {
          "$ref": "#/$defs/ProjectId"
        },
        "configurationSha256": {
          "type": "string"
        },
        "courseId": {
          "anyOf": [
            {
              "$ref": "#/$defs/CourseId"
            },
            {
              "type": "null"
            }
          ]
        },
        "releaseId": {
          "$ref": "#/$defs/ReleaseId"
        },
        "releaseVersion": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "teacherScope": {
          "anyOf": [
            {
              "$ref": "#/$defs/CourseTeacherApprovalScope"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "authoringProjectId",
        "releaseId",
        "releaseVersion",
        "configurationSha256"
      ],
      "type": "object"
    },
    "RuntimeKind": {
      "description": "Runtime kind shared by candidates, releases, and instances.",
      "enum": [
        "container",
        "virtual_machine"
      ],
      "type": "string"
    },
    "RuntimePreauthorization": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "items": {
            "$ref": "#/$defs/LinuxCapability"
          },
          "type": "array",
          "uniqueItems": true
        },
        "privileged": {
          "type": "boolean"
        },
        "scope": {
          "$ref": "#/$defs/RuntimePreauthorizationScope"
        }
      },
      "required": [
        "scope",
        "capabilities",
        "privileged"
      ],
      "type": "object"
    },
    "RuntimePreauthorizationScope": {
      "description": "Object scope for a runtime preauthorization, never a builder authorization.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "project",
              "type": "string"
            },
            "projectId": {
              "$ref": "#/$defs/ProjectId"
            }
          },
          "required": [
            "kind",
            "projectId"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "courseId": {
              "$ref": "#/$defs/CourseId"
            },
            "kind": {
              "const": "course",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "courseId"
          ],
          "type": "object"
        }
      ]
    },
    "TaskRunId": {
      "description": "Strongly typed UUIDv7 identifier for `TaskRunId`.",
      "type": "string"
    },
    "UtcTimestamp": {
      "description": "UTC timestamp serialized with a literal `Z` and millisecond precision.",
      "type": "string"
    },
    "WorkTemplateUpgradeDataPolicy": {
      "oneOf": [
        {
          "const": "preserve_workspace",
          "description": "Preserve the existing /workspace PVC; restart discards ephemeral container rootfs data.",
          "type": "string"
        }
      ]
    },
    "WorkloadResources": {
      "additionalProperties": false,
      "description": "Requested or approved workload resources, independent of Kubernetes quantity syntax.",
