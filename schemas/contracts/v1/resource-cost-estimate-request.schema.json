{
  "$defs": {
    "GpuRequest": {
      "additionalProperties": false,
      "description": "A policy-catalogued GPU class. It intentionally does not expose Kubernetes resource names.",
      "properties": {
        "class": {
          "type": "string"
        },
        "count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "class",
        "count"
      ],
      "type": "object"
    },
    "UtcTimestamp": {
      "description": "UTC timestamp serialized with a literal `Z` and millisecond precision.",
      "type": "string"
    },
    "WorkloadResources": {
      "additionalProperties": false,
      "description": "Requested or approved workload resources, independent of Kubernetes quantity syntax.",
      "properties": {
        "cpuMillicores": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "gpu": {
          "anyOf": [
            {
              "$ref": "#/$defs/GpuRequest"
            },
            {
              "type": "null"
            }
          ]
        },
        "memoryBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "storageBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "cpuMillicores",
        "memoryBytes",
        "storageBytes"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Half-open compute and storage intervals are independent, even when they overlap.",
  "properties": {
    "computeFrom": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "computeUntil": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "resources": {
      "$ref": "#/$defs/WorkloadResources"
    },
    "storageFrom": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "storageUntil": {
      "$ref": "#/$defs/UtcTimestamp"
    }
  },
  "required": [
    "resources",
    "computeFrom",
    "computeUntil",
    "storageFrom",
    "storageUntil"
  ],
  "title": "ResourceCostEstimateRequest",
  "type": "object"
}
