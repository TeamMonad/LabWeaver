{
  "$defs": {
    "AccessGrantId": {
      "description": "Strongly typed UUIDv7 identifier for `AccessGrantId`.",
      "type": "string"
    },
    "EndpointGrantId": {
      "description": "Strongly typed UUIDv7 identifier for `EndpointGrantId`.",
      "type": "string"
    },
    "GatewaySessionId": {
      "description": "Strongly typed UUIDv7 identifier for `GatewaySessionId`.",
      "type": "string"
    },
    "GatewaySessionState": {
      "description": "Gateway session lifecycle.",
      "enum": [
        "active",
        "terminating",
        "closed"
      ],
      "type": "string"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "UtcTimestamp": {
      "description": "UTC timestamp serialized with a literal `Z` and millisecond precision.",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Auditable session metadata; terminal content is never recorded.",
  "properties": {
    "accessGrantId": {
      "$ref": "#/$defs/AccessGrantId"
    },
    "accessGrantRevision": {
      "$ref": "#/$defs/Revision"
    },
    "closeReasonCode": {
      "type": [
        "string",
        "null"
      ]
    },
    "closedAt": {
      "anyOf": [
        {
          "$ref": "#/$defs/UtcTimestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "connectionId": {
      "type": "string"
    },
    "endpointGrantId": {
      "$ref": "#/$defs/EndpointGrantId"
    },
    "gatewayIdentity": {
      "type": "string"
    },
    "id": {
      "$ref": "#/$defs/GatewaySessionId"
    },
    "lastHeartbeatAt": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "openedAt": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "state": {
      "$ref": "#/$defs/GatewaySessionState"
    },
    "terminateBy": {
      "anyOf": [
        {
          "$ref": "#/$defs/UtcTimestamp"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "accessGrantId",
    "accessGrantRevision",
    "endpointGrantId",
    "gatewayIdentity",
    "connectionId",
    "state",
    "openedAt",
    "lastHeartbeatAt"
  ],
  "title": "GatewaySession",
  "type": "object"
}
