{
  "$defs": {
    "AccessGrantId": {
      "description": "Strongly typed UUIDv7 identifier for `AccessGrantId`.",
      "type": "string"
    },
    "EndpointGrantId": {
      "description": "Strongly typed UUIDv7 identifier for `EndpointGrantId`.",
      "type": "string"
    },
    "GatewaySessionId": {
      "description": "Strongly typed UUIDv7 identifier for `GatewaySessionId`.",
      "type": "string"
    },
    "GatewaySessionState": {
      "description": "Gateway session lifecycle.",
      "enum": [
        "active",
        "terminating",
        "termination_overdue",
        "closed"
      ],
      "type": "string"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "Sha256Digest": {
      "description": "Canonical lowercase SHA-256 digest.",
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "SshPublicKeyId": {
      "description": "Strongly typed UUIDv7 identifier for `SshPublicKeyId`.",
      "type": "string"
    },
    "UtcTimestamp": {
      "description": "UTC timestamp serialized with a literal `Z` and millisecond precision.",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Auditable session metadata; terminal content is never recorded.",
  "properties": {
    "accessGrantId": {
      "$ref": "#/$defs/AccessGrantId"
    },
    "accessGrantRevision": {
      "$ref": "#/$defs/Revision"
    },
    "closeReasonCode": {
      "type": [
        "string",
        "null"
      ]
    },
    "closedAt": {
      "anyOf": [
        {
          "$ref": "#/$defs/UtcTimestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "connectionId": {
      "type": "string"
    },
    "endpointGrantId": {
      "$ref": "#/$defs/EndpointGrantId"
    },
    "gatewayIdentity": {
      "type": "string"
    },
    "id": {
      "$ref": "#/$defs/GatewaySessionId"
    },
    "lastHeartbeatAt": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "openedAt": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "revision": {
      "$ref": "#/$defs/Revision"
    },
    "sshPublicKeyId": {
      "$ref": "#/$defs/SshPublicKeyId"
    },
    "state": {
      "$ref": "#/$defs/GatewaySessionState"
    },
    "targetAlias": {
      "description": "Server-generated DNS alias selected by the fixed `connect` command.",
      "type": "string"
    },
    "targetHost": {
      "description": "Environment-owned in-cluster SSH Service DNS name. This is returned only\nto the mTLS-authenticated Gateway and never to the browser grant model.",
      "type": "string"
    },
    "targetSshHostKeyIdentitySha256": {
      "$ref": "#/$defs/Sha256Digest",
      "description": "Environment-authoritative digest of the exact OpenSSH host-key\nfingerprint expected from the selected target."
    },
    "terminateBy": {
      "anyOf": [
        {
          "$ref": "#/$defs/UtcTimestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "terminationRequestedAt": {
      "anyOf": [
        {
          "$ref": "#/$defs/UtcTimestamp"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "accessGrantId",
    "accessGrantRevision",
    "endpointGrantId",
    "sshPublicKeyId",
    "targetAlias",
    "targetHost",
    "targetSshHostKeyIdentitySha256",
    "gatewayIdentity",
    "connectionId",
    "revision",
    "state",
    "openedAt",
    "lastHeartbeatAt"
  ],
  "title": "GatewaySession",
  "type": "object"
}
