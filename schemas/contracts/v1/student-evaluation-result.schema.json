{
  "$defs": {
    "CourseId": {
      "description": "Strongly typed UUIDv7 identifier for `CourseId`.",
      "type": "string"
    },
    "DiagnosticCode": {
      "description": "Stable machine-readable diagnostic code.\n\nConsumers must treat an unknown `LW_*` code as blocking. The newtype is intentionally open so\nadditive diagnostics do not force a wire-version change.",
      "type": "string"
    },
    "EvaluationReleaseId": {
      "description": "Strongly typed UUIDv7 identifier for `EvaluationReleaseId`.",
      "type": "string"
    },
    "EvaluationRunId": {
      "description": "Strongly typed UUIDv7 identifier for `EvaluationRunId`.",
      "type": "string"
    },
    "EvaluationStepRole": {
      "description": "Stable role copied from the immutable `EvaluationSpec` step.",
      "enum": [
        "gate",
        "score",
        "advisory"
      ],
      "type": "string"
    },
    "EvaluationStepRunState": {
      "description": "Public step lifecycle.",
      "enum": [
        "pending",
        "running",
        "retryable",
        "succeeded",
        "failed",
        "cancelled",
        "skipped"
      ],
      "type": "string"
    },
    "FrozenSubmissionId": {
      "description": "Strongly typed UUIDv7 identifier for `FrozenSubmissionId`.",
      "type": "string"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "StudentEvaluationResultState": {
      "description": "Terminal-only lifecycle exposed by the student result projection.",
      "enum": [
        "succeeded",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "StudentEvaluationStepResult": {
      "additionalProperties": false,
      "description": "Bounded step projection that deliberately omits private step identifiers and evidence.",
      "properties": {
        "awardedScore": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "diagnosticCode": {
          "anyOf": [
            {
              "$ref": "#/$defs/DiagnosticCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "maxScore": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "position": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "role": {
          "$ref": "#/$defs/EvaluationStepRole"
        },
        "state": {
          "$ref": "#/$defs/EvaluationStepRunState"
        }
      },
      "required": [
        "position",
        "role",
        "state",
        "maxScore"
      ],
      "type": "object"
    },
    "UtcTimestamp": {
      "description": "UTC timestamp serialized with a literal `Z` and millisecond precision.",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Privacy-preserving terminal result exposed to the owning student.",
  "properties": {
    "awardedScore": {
      "format": "uint32",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "completedAt": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "courseId": {
      "$ref": "#/$defs/CourseId"
    },
    "createdAt": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "diagnosticCode": {
      "anyOf": [
        {
          "$ref": "#/$defs/DiagnosticCode"
        },
        {
          "type": "null"
        }
      ]
    },
    "frozenSubmissionId": {
      "$ref": "#/$defs/FrozenSubmissionId"
    },
    "maxScore": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "releaseId": {
      "$ref": "#/$defs/EvaluationReleaseId"
    },
    "revision": {
      "$ref": "#/$defs/Revision"
    },
    "runId": {
      "$ref": "#/$defs/EvaluationRunId"
    },
    "state": {
      "$ref": "#/$defs/StudentEvaluationResultState"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/StudentEvaluationStepResult"
      },
      "type": "array"
    },
    "updatedAt": {
      "$ref": "#/$defs/UtcTimestamp"
    }
  },
  "required": [
    "runId",
    "courseId",
    "releaseId",
    "frozenSubmissionId",
    "state",
    "revision",
    "maxScore",
    "steps",
    "createdAt",
    "updatedAt",
    "completedAt"
  ],
  "title": "StudentEvaluationResult",
  "type": "object"
}
