{
  "$defs": {
    "BuildRequestId": {
      "description": "Strongly typed UUIDv7 identifier for `BuildRequestId`.",
      "type": "string"
    },
    "CreditHold": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "$ref": "#/$defs/FixedDecimal"
        },
        "buildAttempt": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "buildRequestId": {
          "anyOf": [
            {
              "$ref": "#/$defs/BuildRequestId"
            },
            {
              "type": "null"
            }
          ]
        },
        "businessKey": {
          "type": "string"
        },
        "createdAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "expiredUnknownAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtcTimestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "measurementUnknown": {
          "type": "boolean"
        },
        "modelCallId": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "modelRateSnapshot": {
          "items": {
            "$ref": "#/$defs/ModelRateSnapshot"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "ownerClientId": {
          "type": "string"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectId"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "reconciliationDueAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtcTimestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "remaining": {
          "$ref": "#/$defs/FixedDecimal"
        },
        "requestId": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceRequestId"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "$ref": "#/$defs/CreditHoldState"
        },
        "unknownSince": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtcTimestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "projectId",
        "businessKey",
        "ownerClientId",
        "amount",
        "remaining",
        "state",
        "measurementUnknown",
        "createdAt"
      ],
      "type": "object"
    },
    "CreditHoldState": {
      "enum": [
        "pending",
        "unknown",
        "settled",
        "released"
      ],
      "type": "string"
    },
    "FixedDecimal": {
      "description": "Canonical signed decimal with exactly six fractional digits.\n\nDecimal values cross the API as strings so JavaScript clients and SQL\ndrivers cannot round monetary values through binary floating point. The\ninternal scaled representation is available to Resource arithmetic without\nintroducing a database-specific decimal dependency into the contracts crate.",
      "format": "fixed-decimal-6",
      "pattern": "^-?(0|[1-9][0-9]*)[.][0-9]{6}$",
      "type": "string"
    },
    "ModelCostEstimate": {
      "additionalProperties": false,
      "properties": {
        "callId": {
          "format": "uuid",
          "type": "string"
        },
        "lines": {
          "items": {
            "$ref": "#/$defs/ResourceChargeLine"
          },
          "type": "array"
        },
        "maxPreauthorization": {
          "$ref": "#/$defs/FixedDecimal"
        },
        "modelBinding": {
          "type": "string"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectId"
        },
        "total": {
          "$ref": "#/$defs/Money"
        }
      },
      "required": [
        "callId",
        "projectId",
        "modelBinding",
        "lines",
        "total",
        "maxPreauthorization"
      ],
      "type": "object"
    },
    "ModelRateSnapshot": {
      "additionalProperties": false,
      "properties": {
        "rateId": {
          "$ref": "#/$defs/RateId"
        },
        "rateRevision": {
          "$ref": "#/$defs/Revision"
        },
        "unit": {
          "$ref": "#/$defs/ResourceBillingUnit"
        }
      },
      "required": [
        "unit",
        "rateId",
        "rateRevision"
      ],
      "type": "object"
    },
    "Money": {
      "additionalProperties": false,
      "description": "A fixed-precision amount with an explicit ISO-4217-like currency code.",
      "properties": {
        "amount": {
          "$ref": "#/$defs/FixedDecimal"
        },
        "currency": {
          "type": "string"
        }
      },
      "required": [
        "currency",
        "amount"
      ],
      "type": "object"
    },
    "ProjectId": {
      "description": "Strongly typed UUIDv7 identifier for `ProjectId`.",
      "type": "string"
    },
    "RateId": {
      "description": "Strongly typed UUIDv7 identifier for `RateId`.",
      "type": "string"
    },
    "ResourceBillingUnit": {
      "description": "Resource dimension used by a versioned rate card.",
      "enum": [
        "cpu_millicore_second",
        "memory_byte_second",
        "storage_byte_second",
        "gpu_unit_second",
        "build_second",
        "llm_input_token",
        "llm_output_token",
        "llm_cache_read_token",
        "llm_cache_write_token"
      ],
      "type": "string"
    },
    "ResourceChargeLine": {
      "additionalProperties": false,
      "description": "One immutable line in a calculated charge.",
      "properties": {
        "amount": {
          "$ref": "#/$defs/Money"
        },
        "quantity": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "quantityDivisor": {
          "default": 1,
          "enum": [
            1,
            1000
          ],
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "rateId": {
          "$ref": "#/$defs/RateId"
        },
        "rateRevision": {
          "$ref": "#/$defs/Revision"
        },
        "unit": {
          "$ref": "#/$defs/ResourceBillingUnit"
        },
        "unitPrice": {
          "$ref": "#/$defs/Money"
        },
        "unitQuantity": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "rateId",
        "rateRevision",
        "unit",
        "quantity",
        "unitQuantity",
        "unitPrice",
        "amount"
      ],
      "type": "object"
    },
    "ResourceRequestId": {
      "description": "Strongly typed UUIDv7 identifier for `ResourceRequestId`.",
      "type": "string"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "UtcTimestamp": {
      "description": "UTC timestamp serialized with a literal `Z` and millisecond precision.",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "estimate": {
      "$ref": "#/$defs/ModelCostEstimate"
    },
    "hold": {
      "$ref": "#/$defs/CreditHold"
    }
  },
  "required": [
    "hold",
    "estimate"
  ],
  "title": "ModelCostAdmission",
  "type": "object"
}
