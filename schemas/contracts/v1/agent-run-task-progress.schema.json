{
  "$defs": {
    "AgentRunId": {
      "description": "Strongly typed UUIDv7 identifier for `AgentRunId`.",
      "type": "string"
    },
    "AgentRunState": {
      "description": "Aggregate AgentRun state derived from both tracks.",
      "enum": [
        "requested",
        "running",
        "partially_succeeded",
        "succeeded",
        "awaiting_approval",
        "failed",
        "cancelling",
        "cancelled"
      ],
      "type": "string"
    },
    "AgentTrackKind": {
      "description": "Independent Agent track.",
      "enum": [
        "environment",
        "evaluation",
        "work_configuration"
      ],
      "type": "string"
    },
    "AgentTrackTaskProgress": {
      "additionalProperties": false,
      "description": "An Agent track's business identity and its actual execution progress.",
      "properties": {
        "progress": {
          "$ref": "#/$defs/TaskAttemptProgress"
        },
        "track": {
          "$ref": "#/$defs/AgentTrackKind"
        }
      },
      "required": [
        "track",
        "progress"
      ],
      "type": "object"
    },
    "ProjectId": {
      "description": "Strongly typed UUIDv7 identifier for `ProjectId`.",
      "type": "string"
    },
    "ResourceRequestId": {
      "description": "Strongly typed UUIDv7 identifier for `ResourceRequestId`.",
      "type": "string"
    },
    "ResourceRequestState": {
      "description": "Request lifecycle owned by Resource Service.",
      "enum": [
        "reviewing",
        "allocating",
        "active",
        "expiring",
        "expired",
        "rejected",
        "cancelled"
      ],
      "type": "string"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "TaskAttemptPhase": {
      "description": "Display phase derived from an owner's attempt and Resource facts.\nThis projection has no independent transitions or persistent authority.",
      "enum": [
        "queued",
        "preparing",
        "waiting_resource_approval",
        "allocating",
        "executing",
        "awaiting_review",
        "cleanup_pending",
        "succeeded",
        "failed",
        "cancelled",
        "blocked"
      ],
      "type": "string"
    },
    "TaskAttemptProgress": {
      "additionalProperties": false,
      "description": "Payload-free read projection of one real attempt.",
      "properties": {
        "attempt": {
          "description": "Native attempt number. Evaluation uses zero until the step is first claimed.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "diagnosticCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "executionGeneration": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "nextSteps": {
          "description": "Existing operation IDs appropriate to the phase, without granting authorization.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "phase": {
          "$ref": "#/$defs/TaskAttemptPhase"
        },
        "resourceRequestId": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceRequestId"
            },
            {
              "type": "null"
            }
          ]
        },
        "resourceState": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceRequestState"
            },
            {
              "type": "null"
            }
          ]
        },
        "taskRunId": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskRunId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "attempt",
        "phase",
        "nextSteps"
      ],
      "type": "object"
    },
    "TaskRunId": {
      "description": "Strongly typed UUIDv7 identifier for `TaskRunId`.",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Agent-owned task read model with the current attempt separate from history.",
  "properties": {
    "current": {
      "items": {
        "$ref": "#/$defs/AgentTrackTaskProgress"
      },
      "type": "array"
    },
    "history": {
      "items": {
        "$ref": "#/$defs/AgentTrackTaskProgress"
      },
      "type": "array"
    },
    "nextCursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "projectId": {
      "$ref": "#/$defs/ProjectId"
    },
    "revision": {
      "$ref": "#/$defs/Revision"
    },
    "runId": {
      "$ref": "#/$defs/AgentRunId"
    },
    "state": {
      "$ref": "#/$defs/AgentRunState"
    }
  },
  "required": [
    "runId",
    "projectId",
    "revision",
    "state",
    "current",
    "history"
  ],
  "title": "AgentRunTaskProgress",
  "type": "object"
}
