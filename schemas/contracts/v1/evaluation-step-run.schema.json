{
  "$defs": {
    "DiagnosticCode": {
      "description": "Stable machine-readable diagnostic code.\n\nConsumers must treat an unknown `LW_*` code as blocking. The newtype is intentionally open so\nadditive diagnostics do not force a wire-version change.",
      "type": "string"
    },
    "EvaluationRunId": {
      "description": "Strongly typed UUIDv7 identifier for `EvaluationRunId`.",
      "type": "string"
    },
    "EvaluationStepFailurePolicy": {
      "description": "Stable failure behavior copied from the immutable `EvaluationSpec` step.",
      "enum": [
        "stop",
        "continue",
        "continue_advisory"
      ],
      "type": "string"
    },
    "EvaluationStepRole": {
      "description": "Stable role copied from the immutable `EvaluationSpec` step.",
      "enum": [
        "gate",
        "score",
        "advisory"
      ],
      "type": "string"
    },
    "EvaluationStepRunId": {
      "description": "Strongly typed UUIDv7 identifier for `EvaluationStepRunId`.",
      "type": "string"
    },
    "EvaluationStepRunState": {
      "description": "Public step lifecycle.",
      "enum": [
        "pending",
        "running",
        "retryable",
        "succeeded",
        "failed",
        "cancelled",
        "skipped"
      ],
      "type": "string"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "Sha256Digest": {
      "description": "Canonical lowercase SHA-256 digest.",
      "type": "string"
    },
    "UtcTimestamp": {
      "description": "UTC timestamp serialized with a literal `Z` and millisecond precision.",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "PostgreSQL-authoritative state for one declared evaluation step.",
  "properties": {
    "awardedScore": {
      "format": "uint32",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "cleanupVerified": {
      "type": "boolean"
    },
    "completedAt": {
      "anyOf": [
        {
          "$ref": "#/$defs/UtcTimestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "currentAttempt": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "dependsOn": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "diagnosticCode": {
      "anyOf": [
        {
          "$ref": "#/$defs/DiagnosticCode"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidenceSha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/Sha256Digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "failurePolicy": {
      "$ref": "#/$defs/EvaluationStepFailurePolicy"
    },
    "id": {
      "$ref": "#/$defs/EvaluationStepRunId"
    },
    "maxScore": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "position": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "revision": {
      "$ref": "#/$defs/Revision"
    },
    "role": {
      "$ref": "#/$defs/EvaluationStepRole"
    },
    "runId": {
      "$ref": "#/$defs/EvaluationRunId"
    },
    "startedAt": {
      "anyOf": [
        {
          "$ref": "#/$defs/UtcTimestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "$ref": "#/$defs/EvaluationStepRunState"
    },
    "stepId": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "runId",
    "stepId",
    "position",
    "role",
    "failurePolicy",
    "dependsOn",
    "state",
    "revision",
    "currentAttempt",
    "maxScore",
    "cleanupVerified"
  ],
  "title": "EvaluationStepRun",
  "type": "object"
}
