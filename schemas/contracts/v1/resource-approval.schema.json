{
  "$defs": {
    "ActorId": {
      "description": "Strongly typed UUIDv7 identifier for `ActorId`.",
      "type": "string"
    },
    "GpuRequest": {
      "additionalProperties": false,
      "description": "A policy-catalogued GPU class. It intentionally does not expose Kubernetes resource names.",
      "properties": {
        "class": {
          "type": "string"
        },
        "count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "class",
        "count"
      ],
      "type": "object"
    },
    "ResourceApprovalId": {
      "description": "Strongly typed UUIDv7 identifier for `ResourceApprovalId`.",
      "type": "string"
    },
    "ResourceRequestId": {
      "description": "Strongly typed UUIDv7 identifier for `ResourceRequestId`.",
      "type": "string"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "Sha256Digest": {
      "description": "Canonical lowercase SHA-256 digest.",
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "UtcTimestamp": {
      "description": "UTC timestamp serialized with a literal `Z` and millisecond precision.",
      "type": "string"
    },
    "WorkloadResources": {
      "additionalProperties": false,
      "description": "Requested or approved workload resources, independent of Kubernetes quantity syntax.",
      "properties": {
        "cpuMillicores": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "gpu": {
          "anyOf": [
            {
              "$ref": "#/$defs/GpuRequest"
            },
            {
              "type": "null"
            }
          ]
        },
        "memoryBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "storageBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "cpuMillicores",
        "memoryBytes",
        "storageBytes"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Append-only administrator decision bound to one request revision and policy snapshot.",
  "properties": {
    "approvedDurationSeconds": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "approvedResources": {
      "$ref": "#/$defs/WorkloadResources"
    },
    "approverId": {
      "$ref": "#/$defs/ActorId"
    },
    "createdAt": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "id": {
      "$ref": "#/$defs/ResourceApprovalId"
    },
    "policySha256": {
      "$ref": "#/$defs/Sha256Digest"
    },
    "providerBinding": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "requestId": {
      "$ref": "#/$defs/ResourceRequestId"
    },
    "requestRevision": {
      "$ref": "#/$defs/Revision"
    },
    "validUntil": {
      "$ref": "#/$defs/UtcTimestamp"
    }
  },
  "required": [
    "id",
    "requestId",
    "requestRevision",
    "approverId",
    "providerBinding",
    "policySha256",
    "approvedResources",
    "approvedDurationSeconds",
    "reason",
    "validUntil",
    "createdAt"
  ],
  "title": "ResourceApproval",
  "type": "object"
}
