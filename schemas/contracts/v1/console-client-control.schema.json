{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Browser-to-proxy control frames. Terminal input is always a binary frame.",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "cols": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "rows": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "resize",
          "type": "string"
        }
      },
      "required": [
        "type",
        "cols",
        "rows"
      ],
      "type": "object"
    }
  ],
  "title": "ConsoleClientControl"
}
