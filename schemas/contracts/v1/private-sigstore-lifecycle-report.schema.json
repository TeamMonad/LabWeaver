{
  "$defs": {
    "PrivateSigstoreBackupIdentity": {
      "additionalProperties": false,
      "properties": {
        "artifact_sha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "cluster_uid": {
          "type": "string"
        },
        "commit_sha": {
          "type": "string"
        },
        "component_lock_sha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "deployment_manifest_sha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "generated_at": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "inventory_sha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "run_id": {
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        },
        "trust_bundle_sha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "tuf_root_sha256": {
          "$ref": "#/$defs/Sha256Digest"
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "commit_sha",
        "cluster_uid",
        "inventory_sha256",
        "deployment_manifest_sha256",
        "component_lock_sha256",
        "tuf_root_sha256",
        "trust_bundle_sha256",
        "artifact_sha256",
        "generated_at"
      ],
      "type": "object"
    },
    "PrivateSigstoreLifecycleAction": {
      "enum": [
        "backup",
        "restore",
        "rotate",
        "verify",
        "cleanup",
        "disaster-recovery"
      ],
      "type": "string"
    },
    "Sha256Digest": {
      "description": "Canonical lowercase SHA-256 digest.",
      "type": "string"
    },
    "TestFlightCheck": {
      "additionalProperties": false,
      "properties": {
        "diagnosticCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/TestFlightStatus"
        }
      },
      "required": [
        "name",
        "status"
      ],
      "type": "object"
    },
    "TestFlightStatus": {
      "enum": [
        "passed",
        "failed",
        "blocked",
        "not_run"
      ],
      "type": "string"
    },
    "UtcTimestamp": {
      "description": "UTC timestamp serialized with a literal `Z` and millisecond precision.",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "$ref": "#/$defs/PrivateSigstoreLifecycleAction"
    },
    "backup": {
      "anyOf": [
        {
          "$ref": "#/$defs/PrivateSigstoreBackupIdentity"
        },
        {
          "type": "null"
        }
      ]
    },
    "blocked_items": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "chart_archive_sha256": {
      "$ref": "#/$defs/Sha256Digest"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/TestFlightCheck"
      },
      "type": "array"
    },
    "cluster_uid": {
      "type": "string"
    },
    "commit_sha": {
      "type": "string"
    },
    "component_lock_sha256": {
      "$ref": "#/$defs/Sha256Digest"
    },
    "controller_id": {
      "type": "string"
    },
    "deployment_manifest_sha256": {
      "$ref": "#/$defs/Sha256Digest"
    },
    "exit_condition": {
      "type": [
        "string",
        "null"
      ]
    },
    "generated_at": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "image_digests": {
      "additionalProperties": {
        "$ref": "#/$defs/Sha256Digest"
      },
      "type": "object"
    },
    "inventory_sha256": {
      "$ref": "#/$defs/Sha256Digest"
    },
    "run_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/TestFlightStatus"
    },
    "trust_bundle_sha256": {
      "$ref": "#/$defs/Sha256Digest"
    },
    "tuf_root_sha256": {
      "$ref": "#/$defs/Sha256Digest"
    },
    "tuf_root_version": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "unblock_owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "workload_identity_policy_sha256": {
      "$ref": "#/$defs/Sha256Digest"
    }
  },
  "required": [
    "schema_version",
    "action",
    "status",
    "run_id",
    "commit_sha",
    "controller_id",
    "cluster_uid",
    "inventory_sha256",
    "deployment_manifest_sha256",
    "component_lock_sha256",
    "chart_archive_sha256",
    "image_digests",
    "trust_bundle_sha256",
    "tuf_root_version",
    "tuf_root_sha256",
    "workload_identity_policy_sha256",
    "checks",
    "blocked_items",
    "generated_at"
  ],
  "title": "PrivateSigstoreLifecycleReport",
  "type": "object"
}
