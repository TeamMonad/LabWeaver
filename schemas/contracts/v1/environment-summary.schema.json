{
  "$defs": {
    "CourseId": {
      "description": "Strongly typed UUIDv7 identifier for `CourseId`.",
      "type": "string"
    },
    "DesiredEnvironmentState": {
      "description": "Requested steady state.",
      "enum": [
        "running",
        "stopped",
        "deleted"
      ],
      "type": "string"
    },
    "DiagnosticCode": {
      "description": "Stable machine-readable diagnostic code.\n\nConsumers must treat an unknown `LW_*` code as blocking. The newtype is intentionally open so\nadditive diagnostics do not force a wire-version change.",
      "type": "string"
    },
    "EnvironmentAccessEligibilityState": {
      "description": "Access readiness projected without endpoint routes, credentials, or policy material.",
      "enum": [
        "eligible",
        "ineligible",
        "active_grant"
      ],
      "type": "string"
    },
    "EnvironmentAccessEligibilitySummary": {
      "additionalProperties": false,
      "properties": {
        "activeGrantCount": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "healthyEndpointCount": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "reasonCode": {
          "anyOf": [
            {
              "$ref": "#/$defs/DiagnosticCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "$ref": "#/$defs/EnvironmentAccessEligibilityState"
        }
      },
      "required": [
        "state",
        "healthyEndpointCount",
        "activeGrantCount"
      ],
      "type": "object"
    },
    "EnvironmentClass": {
      "description": "Environment business class retained from the v2.1 architecture.",
      "enum": [
        "experiment",
        "work"
      ],
      "type": "string"
    },
    "EnvironmentId": {
      "description": "Strongly typed UUIDv7 identifier for `EnvironmentId`.",
      "type": "string"
    },
    "EnvironmentOperationKind": {
      "description": "Explicit operation kind; restart and destructive reset are never aliases.",
      "enum": [
        "create",
        "start",
        "stop",
        "restart",
        "reset",
        "retry",
        "cancel",
        "recover",
        "expire",
        "delete",
        "cleanup",
        "freeze"
      ],
      "type": "string"
    },
    "EnvironmentOperationSnapshot": {
      "additionalProperties": false,
      "description": "Safe operation representation for Public REST and SSE consumers.",
      "properties": {
        "acceptedAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "acceptedRevision": {
          "$ref": "#/$defs/Revision"
        },
        "attempt": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "cancelEligible": {
          "type": "boolean"
        },
        "cleanupStartedAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtcTimestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "deadlineAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "diagnosticCode": {
          "anyOf": [
            {
              "$ref": "#/$defs/DiagnosticCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "environmentId": {
          "$ref": "#/$defs/EnvironmentId"
        },
        "kind": {
          "$ref": "#/$defs/EnvironmentOperationKind"
        },
        "maxAttempts": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "operationId": {
          "$ref": "#/$defs/OperationId"
        },
        "retryEligible": {
          "type": "boolean"
        },
        "state": {
          "$ref": "#/$defs/OperationState"
        },
        "terminalAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtcTimestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "traceId": {
          "type": "string"
        }
      },
      "required": [
        "environmentId",
        "operationId",
        "kind",
        "state",
        "acceptedRevision",
        "acceptedAt",
        "deadlineAt",
        "attempt",
        "maxAttempts",
        "retryEligible",
        "cancelEligible",
        "traceId"
      ],
      "type": "object"
    },
    "EnvironmentOwnerRelation": {
      "description": "Actor-safe relationship to the Environment owner.",
      "enum": [
        "self_owned",
        "managed"
      ],
      "type": "string"
    },
    "EnvironmentOwnerSummary": {
      "additionalProperties": false,
      "description": "Actor-safe owner label. It deliberately carries no globally enumerable ActorId.",
      "properties": {
        "displayLabel": {
          "type": [
            "string",
            "null"
          ]
        },
        "relation": {
          "$ref": "#/$defs/EnvironmentOwnerRelation"
        }
      },
      "required": [
        "relation"
      ],
      "type": "object"
    },
    "ObservedEnvironmentState": {
      "description": "Authoritative observed lifecycle state.",
      "enum": [
        "requested",
        "validating",
        "building",
        "provisioning",
        "ready",
        "stopping",
        "stopped",
        "updating",
        "expiring",
        "deleting",
        "deleted",
        "failed"
      ],
      "type": "string"
    },
    "OperationId": {
      "description": "Strongly typed UUIDv7 identifier for `OperationId`.",
      "type": "string"
    },
    "OperationState": {
      "description": "Persistent operation state.",
      "enum": [
        "accepted",
        "running",
        "cancelling",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "ProjectId": {
      "description": "Strongly typed UUIDv7 identifier for `ProjectId`.",
      "type": "string"
    },
    "ReleaseId": {
      "description": "Strongly typed UUIDv7 identifier for `ReleaseId`.",
      "type": "string"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "RuntimeKind": {
      "description": "Runtime kind shared by candidates, releases, and instances.",
      "enum": [
        "container",
        "virtual_machine"
      ],
      "type": "string"
    },
    "StreamSequence": {
      "format": "uint64-decimal",
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])$",
      "type": "string"
    },
    "UtcTimestamp": {
      "description": "UTC timestamp serialized with a literal `Z` and millisecond precision.",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Minimal Environment inventory item suitable for a GCP-style resource console.",
  "properties": {
    "access": {
      "$ref": "#/$defs/EnvironmentAccessEligibilitySummary"
    },
    "class": {
      "$ref": "#/$defs/EnvironmentClass"
    },
    "courseId": {
      "anyOf": [
        {
          "$ref": "#/$defs/CourseId"
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAt": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "currentOperation": {
      "anyOf": [
        {
          "$ref": "#/$defs/EnvironmentOperationSnapshot"
        },
        {
          "type": "null"
        }
      ]
    },
    "desiredState": {
      "$ref": "#/$defs/DesiredEnvironmentState"
    },
    "displayLabel": {
      "type": "string"
    },
    "eligibilityExpiresAt": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "id": {
      "$ref": "#/$defs/EnvironmentId"
    },
    "lastChangedStreamSequence": {
      "$ref": "#/$defs/StreamSequence"
    },
    "observedState": {
      "$ref": "#/$defs/ObservedEnvironmentState"
    },
    "owner": {
      "$ref": "#/$defs/EnvironmentOwnerSummary"
    },
    "projectId": {
      "$ref": "#/$defs/ProjectId"
    },
    "releaseId": {
      "$ref": "#/$defs/ReleaseId"
    },
    "releaseVersion": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "revision": {
      "$ref": "#/$defs/Revision"
    },
    "runtimeKind": {
      "$ref": "#/$defs/RuntimeKind"
    },
    "updatedAt": {
      "$ref": "#/$defs/UtcTimestamp"
    }
  },
  "required": [
    "id",
    "displayLabel",
    "projectId",
    "owner",
    "class",
    "runtimeKind",
    "releaseId",
    "releaseVersion",
    "desiredState",
    "observedState",
    "revision",
    "eligibilityExpiresAt",
    "createdAt",
    "updatedAt",
    "lastChangedStreamSequence",
    "access"
  ],
  "title": "EnvironmentSummary",
  "type": "object"
}
