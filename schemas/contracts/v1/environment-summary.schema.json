{
  "$defs": {
    "CourseId": {
      "description": "Strongly typed UUIDv7 identifier for `CourseId`.",
      "type": "string"
    },
    "DesiredEnvironmentState": {
      "description": "Requested steady state.",
      "enum": [
        "running",
        "stopped",
        "deleted"
      ],
      "type": "string"
    },
    "DiagnosticCode": {
      "description": "Stable machine-readable diagnostic code.\n\nConsumers must treat an unknown `LW_*` code as blocking. The newtype is intentionally open so\nadditive diagnostics do not force a wire-version change.",
      "type": "string"
    },
    "EnvironmentAccessEligibilityState": {
      "description": "Access readiness projected without endpoint routes, credentials, or policy material.",
      "enum": [
        "eligible",
        "ineligible",
        "active_grant"
      ],
      "type": "string"
    },
    "EnvironmentAccessEligibilitySummary": {
      "additionalProperties": false,
      "properties": {
        "activeGrantCount": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "healthyEndpointCount": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "reasonCode": {
          "anyOf": [
            {
              "$ref": "#/$defs/DiagnosticCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "$ref": "#/$defs/EnvironmentAccessEligibilityState"
        }
      },
      "required": [
        "state",
        "healthyEndpointCount",
        "activeGrantCount"
      ],
      "type": "object"
    },
    "EnvironmentClass": {
      "description": "Environment business class retained from the v2.1 architecture.",
      "enum": [
        "experiment",
        "work"
      ],
      "type": "string"
    },
    "EnvironmentId": {
      "description": "Strongly typed UUIDv7 identifier for `EnvironmentId`.",
      "type": "string"
    },
    "EnvironmentOperationKind": {
      "description": "Explicit operation kind; restart and destructive reset are never aliases.",
      "enum": [
        "create",
        "start",
        "stop",
        "restart",
        "reset",
        "retry",
        "cancel",
        "recover",
        "expire",
        "delete",
        "cleanup",
        "freeze"
      ],
      "type": "string"
    },
    "EnvironmentOperationSnapshot": {
      "additionalProperties": false,
      "description": "Safe operation representation for Public REST and SSE consumers.",
      "properties": {
        "acceptedAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "acceptedRevision": {
          "$ref": "#/$defs/Revision"
        },
        "attempt": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "cancelEligible": {
          "type": "boolean"
        },
        "cleanupDeadlineAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtcTimestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "cleanupStartedAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtcTimestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "currentRevision": {
          "$ref": "#/$defs/Revision"
        },
        "deadlineAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "diagnosticCode": {
          "anyOf": [
            {
              "$ref": "#/$defs/DiagnosticCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "environmentId": {
          "$ref": "#/$defs/EnvironmentId"
        },
        "kind": {
          "$ref": "#/$defs/EnvironmentOperationKind"
        },
        "lastChangedStreamSequence": {
          "$ref": "#/$defs/StreamSequence"
        },
        "maxAttempts": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "operationId": {
          "$ref": "#/$defs/OperationId"
        },
        "providerPhase": {
          "anyOf": [
            {
              "$ref": "#/$defs/PublicEnvironmentOperationPhase"
            },
            {
              "type": "null"
            }
          ]
        },
        "requestId": {
          "type": "string"
        },
        "retryEligible": {
          "type": "boolean"
        },
        "startedAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtcTimestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "$ref": "#/$defs/EnvironmentOperationStatus"
        },
        "terminalAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtcTimestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "timedOutAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtcTimestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "traceId": {
          "type": "string"
        },
        "updatedAt": {
          "$ref": "#/$defs/UtcTimestamp"
        }
      },
      "required": [
        "environmentId",
        "operationId",
        "kind",
        "state",
        "acceptedRevision",
        "currentRevision",
        "acceptedAt",
        "updatedAt",
        "deadlineAt",
        "attempt",
        "maxAttempts",
        "retryEligible",
        "cancelEligible",
        "requestId",
        "traceId",
        "lastChangedStreamSequence"
      ],
      "type": "object"
    },
    "EnvironmentOperationStatus": {
      "description": "Public operation state used by REST snapshots and SSE projections.\n\nThe runtime aggregate retains its historical `OperationState`; timeout is exposed as a\ndistinct terminal fact instead of forcing clients to infer it from a generic failure code.",
      "enum": [
        "accepted",
        "running",
        "cancelling",
        "succeeded",
        "failed",
        "cancelled",
        "timed_out"
      ],
      "type": "string"
    },
    "EnvironmentOwnerRelation": {
      "description": "Actor-safe relationship to the Environment owner.",
      "enum": [
        "self_owned",
        "managed"
      ],
      "type": "string"
    },
    "EnvironmentOwnerSummary": {
      "additionalProperties": false,
      "description": "Actor-safe owner label. It deliberately carries no globally enumerable ActorId.",
      "properties": {
        "displayLabel": {
          "type": [
            "string",
            "null"
          ]
        },
        "relation": {
          "$ref": "#/$defs/EnvironmentOwnerRelation"
        }
      },
      "required": [
        "relation"
      ],
      "type": "object"
    },
    "ObservedEnvironmentState": {
      "description": "Authoritative observed lifecycle state.",
      "enum": [
        "requested",
        "validating",
        "building",
        "provisioning",
        "ready",
        "stopping",
        "stopped",
        "updating",
        "expiring",
        "deleting",
        "deleted",
        "failed"
      ],
      "type": "string"
    },
    "OperationId": {
      "description": "Strongly typed UUIDv7 identifier for `OperationId`.",
      "type": "string"
    },
    "ProjectId": {
      "description": "Strongly typed UUIDv7 identifier for `ProjectId`.",
      "type": "string"
    },
    "PublicEnvironmentOperationPhase": {
      "description": "Provider-safe progress phase. Provider names, node identities, and raw payloads stay private.",
      "enum": [
        "validating",
        "building",
        "provisioning",
        "stopping",
        "revoking_access",
        "cleaning_up",
        "finalizing"
      ],
      "type": "string"
    },
    "ReleaseId": {
      "description": "Strongly typed UUIDv7 identifier for `ReleaseId`.",
      "type": "string"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "RuntimeKind": {
      "description": "Runtime kind shared by candidates, releases, and instances.",
      "enum": [
        "container",
        "virtual_machine"
      ],
      "type": "string"
    },
    "StreamSequence": {
      "description": "Monotonic cursor in a scoped public event stream.\n\nA distinct wire type prevents an aggregate-local sequence from being accepted as a\ncourse-stream resume position.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "UtcTimestamp": {
      "description": "UTC timestamp serialized with a literal `Z` and millisecond precision.",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Minimal Environment inventory item suitable for a GCP-style resource console.",
  "properties": {
    "access": {
      "$ref": "#/$defs/EnvironmentAccessEligibilitySummary"
    },
    "class": {
      "$ref": "#/$defs/EnvironmentClass"
    },
    "courseId": {
      "$ref": "#/$defs/CourseId"
    },
    "createdAt": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "currentOperation": {
      "anyOf": [
        {
          "$ref": "#/$defs/EnvironmentOperationSnapshot"
        },
        {
          "type": "null"
        }
      ]
    },
    "desiredState": {
      "$ref": "#/$defs/DesiredEnvironmentState"
    },
    "displayLabel": {
      "type": "string"
    },
    "eligibilityExpiresAt": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "id": {
      "$ref": "#/$defs/EnvironmentId"
    },
    "lastChangedStreamSequence": {
      "$ref": "#/$defs/StreamSequence"
    },
    "observedState": {
      "$ref": "#/$defs/ObservedEnvironmentState"
    },
    "owner": {
      "$ref": "#/$defs/EnvironmentOwnerSummary"
    },
    "projectId": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProjectId"
        },
        {
          "type": "null"
        }
      ]
    },
    "releaseId": {
      "$ref": "#/$defs/ReleaseId"
    },
    "releaseVersion": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "revision": {
      "$ref": "#/$defs/Revision"
    },
    "runtimeKind": {
      "$ref": "#/$defs/RuntimeKind"
    },
    "updatedAt": {
      "$ref": "#/$defs/UtcTimestamp"
    }
  },
  "required": [
    "id",
    "displayLabel",
    "courseId",
    "owner",
    "class",
    "runtimeKind",
    "releaseId",
    "releaseVersion",
    "desiredState",
    "observedState",
    "revision",
    "eligibilityExpiresAt",
    "createdAt",
    "updatedAt",
    "lastChangedStreamSequence",
    "access"
  ],
  "title": "EnvironmentSummary",
  "type": "object"
}
