{
  "$defs": {
    "ArtifactId": {
      "description": "Strongly typed UUIDv7 identifier for `ArtifactId`.",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Immutable object-store identity without a machine-local path or credential.",
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/ArtifactId",
          "description": "Stable metadata identity resolved by the owning service."
        },
        "mediaType": {
          "description": "Registered media type.",
          "type": "string"
        },
        "objectVersion": {
          "description": "Immutable backend object version.",
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Digest",
          "description": "Exact content digest."
        },
        "sizeBytes": {
          "description": "Raw object length.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "storeBinding": {
          "description": "Explicit object-store binding from deployment configuration.",
          "type": "string"
        }
      },
      "required": [
        "artifactId",
        "storeBinding",
        "objectVersion",
        "sha256",
        "sizeBytes",
        "mediaType"
      ],
      "type": "object"
    },
    "BuildRequestId": {
      "description": "Strongly typed UUIDv7 identifier for `BuildRequestId`.",
      "type": "string"
    },
    "ImageArtifactId": {
      "description": "Strongly typed UUIDv7 identifier for `ImageArtifactId`.",
      "type": "string"
    },
    "Sha256Digest": {
      "description": "Canonical lowercase SHA-256 digest.",
      "type": "string"
    },
    "SigstoreEvidence": {
      "additionalProperties": false,
      "description": "Private Sigstore identity and transparency evidence.",
      "properties": {
        "certificateSha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "certificateSubject": {
          "type": "string"
        },
        "ctLogId": {
          "type": "string"
        },
        "fulcioIssuer": {
          "type": "string"
        },
        "rekorInclusionProofSha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "rekorLogId": {
          "type": "string"
        },
        "rekorLogIndex": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "sctSha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "signatureSha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "trustBundleSha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "verifiedAt": {
          "$ref": "#/$defs/UtcTimestamp"
        }
      },
      "required": [
        "trustBundleSha256",
        "fulcioIssuer",
        "certificateSubject",
        "certificateSha256",
        "signatureSha256",
        "rekorLogId",
        "rekorLogIndex",
        "rekorInclusionProofSha256",
        "ctLogId",
        "sctSha256",
        "verifiedAt"
      ],
      "type": "object"
    },
    "UtcTimestamp": {
      "description": "UTC timestamp serialized with a literal `Z` and millisecond precision.",
      "type": "string"
    },
    "VirtualMachineDiskFormat": {
      "description": "Supported VM base-disk encodings.",
      "enum": [
        "qcow2",
        "raw"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Complete immutable runtime artifact identity.",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "build_request_id": {
          "$ref": "#/$defs/BuildRequestId"
        },
        "digest": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/ImageArtifactId"
        },
        "immutable_tag": {
          "type": "string"
        },
        "kind": {
          "const": "container",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "repository": {
          "type": "string"
        },
        "sbom": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "signature": {
          "$ref": "#/$defs/SigstoreEvidence"
        }
      },
      "required": [
        "kind",
        "id",
        "build_request_id",
        "repository",
        "immutable_tag",
        "digest",
        "sbom",
        "provenance",
        "signature"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "base_disk": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "format": {
          "$ref": "#/$defs/VirtualMachineDiskFormat"
        },
        "id": {
          "$ref": "#/$defs/ImageArtifactId"
        },
        "kind": {
          "const": "virtual_machine",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "sbom": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "signature": {
          "$ref": "#/$defs/SigstoreEvidence"
        }
      },
      "required": [
        "kind",
        "id",
        "base_disk",
        "format",
        "sbom",
        "provenance",
        "signature"
      ],
      "type": "object"
    }
  ],
  "title": "ImageArtifact"
}
