{
  "$defs": {
    "ArtifactId": {
      "description": "Strongly typed UUIDv7 identifier for `ArtifactId`.",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Immutable object-store identity without a machine-local path or credential.",
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/ArtifactId",
          "description": "Stable metadata identity resolved by the owning service."
        },
        "mediaType": {
          "description": "Registered media type.",
          "type": "string"
        },
        "objectVersion": {
          "description": "Immutable backend object version.",
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Digest",
          "description": "Exact content digest."
        },
        "sizeBytes": {
          "description": "Raw object length.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "storeBinding": {
          "description": "Explicit object-store binding from deployment configuration.",
          "type": "string"
        }
      },
      "required": [
        "artifactId",
        "storeBinding",
        "objectVersion",
        "sha256",
        "sizeBytes",
        "mediaType"
      ],
      "type": "object"
    },
    "EndpointProtocol": {
      "description": "Supported controlled protocols.",
      "enum": [
        "http",
        "https",
        "ssh"
      ],
      "type": "string"
    },
    "EnvironmentApiVersion": {
      "enum": [
        "environment.labweaver.io/v1"
      ],
      "type": "string"
    },
    "EnvironmentClass": {
      "description": "Environment business class retained from the v2.1 architecture.",
      "enum": [
        "experiment",
        "work"
      ],
      "type": "string"
    },
    "EnvironmentDocumentKind": {
      "enum": [
        "EnvironmentSpec"
      ],
      "type": "string"
    },
    "EnvironmentEntrySpec": {
      "additionalProperties": false,
      "description": "One named service entry exposed only through the controlled access plane.",
      "properties": {
        "name": {
          "type": "string"
        },
        "protocol": {
          "$ref": "#/$defs/EndpointProtocol"
        },
        "servicePort": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "protocol",
        "servicePort"
      ],
      "type": "object"
    },
    "EnvironmentRuntimeSpec": {
      "description": "Strict runtime-specific environment shape.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "base_image_digest": {
              "type": "string"
            },
            "build_context": {
              "$ref": "#/$defs/ArtifactRef"
            },
            "kind": {
              "const": "container",
              "type": "string"
            },
            "provider_binding": {
              "type": "string"
            },
            "service_port": {
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "terminal": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TerminalSpec"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "provider_binding",
            "build_context",
            "base_image_digest",
            "service_port"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "base_disk": {
              "$ref": "#/$defs/VirtualMachineBaseDisk"
            },
            "kind": {
              "const": "virtual_machine",
              "type": "string"
            },
            "provider_binding": {
              "type": "string"
            },
            "ssh_port": {
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "storage_class_binding": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "provider_binding",
            "base_disk",
            "storage_class_binding",
            "ssh_port"
          ],
          "type": "object"
        }
      ]
    },
    "EnvironmentSecuritySpec": {
      "additionalProperties": false,
      "description": "Runtime-independent minimum security posture.",
      "properties": {
        "privilegeEscalationPolicy": {
          "$ref": "#/$defs/PrivilegeEscalationPolicy"
        },
        "publicExposurePolicy": {
          "$ref": "#/$defs/PublicExposurePolicy"
        },
        "rootFilesystemPolicy": {
          "$ref": "#/$defs/RootFilesystemPolicy"
        },
        "securityProfileBinding": {
          "type": "string"
        },
        "userPolicy": {
          "$ref": "#/$defs/RuntimeUserPolicy"
        }
      },
      "required": [
        "userPolicy",
        "rootFilesystemPolicy",
        "privilegeEscalationPolicy",
        "publicExposurePolicy",
        "securityProfileBinding"
      ],
      "type": "object"
    },
    "NetworkPolicySpec": {
      "description": "Network egress posture for a published environment.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "allow_all",
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "deny_all",
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "restricted",
              "type": "string"
            },
            "policy_binding": {
              "type": "string"
            }
          },
          "required": [
            "mode",
            "policy_binding"
          ],
          "type": "object"
        }
      ]
    },
    "PolicyId": {
      "description": "Strongly typed UUIDv7 identifier for `PolicyId`.",
      "type": "string"
    },
    "PrivilegeEscalationPolicy": {
      "enum": [
        "deny"
      ],
      "type": "string"
    },
    "PublicExposurePolicy": {
      "enum": [
        "deny"
      ],
      "type": "string"
    },
    "ResourceRequirements": {
      "additionalProperties": false,
      "description": "Bounded runtime resources expressed without Kubernetes-dependent parsing.",
      "properties": {
        "cpuMillicores": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "memoryBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "storageBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "cpuMillicores",
        "memoryBytes",
        "storageBytes"
      ],
      "type": "object"
    },
    "RetentionClass": {
      "description": "Retention classes with distinct privacy and recovery requirements.",
      "enum": [
        "course_material",
        "build_evidence",
        "run_evidence",
        "student_submission",
        "security_audit"
      ],
      "type": "string"
    },
    "RetentionDisposition": {
      "description": "Required action after retention expires.",
      "enum": [
        "delete",
        "purge_after_export",
        "retain_sanitized_receipt"
      ],
      "type": "string"
    },
    "RetentionSnapshot": {
      "additionalProperties": false,
      "description": "Frozen data-retention decision for an immutable resource.",
      "properties": {
        "class": {
          "$ref": "#/$defs/RetentionClass",
          "description": "Stable retention class."
        },
        "disposition": {
          "$ref": "#/$defs/RetentionDisposition",
          "description": "Required terminal disposition."
        },
        "policyId": {
          "$ref": "#/$defs/PolicyId",
          "description": "Policy identity."
        },
        "policyRevision": {
          "$ref": "#/$defs/Revision",
          "description": "Exact policy revision used at creation."
        },
        "retainUntil": {
          "$ref": "#/$defs/UtcTimestamp",
          "description": "Absolute retention boundary."
        }
      },
      "required": [
        "policyId",
        "policyRevision",
        "class",
        "retainUntil",
        "disposition"
      ],
      "type": "object"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "RootFilesystemPolicy": {
      "enum": [
        "read_only_required",
        "mutable_required"
      ],
      "type": "string"
    },
    "RuntimeUserPolicy": {
      "enum": [
        "non_root_required"
      ],
      "type": "string"
    },
    "Sha256Digest": {
      "description": "Canonical lowercase SHA-256 digest.",
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "TerminalSpec": {
      "additionalProperties": false,
      "description": "Bounded direct-exec terminal owned by an immutable Container release.",
      "properties": {
        "args": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "executable": {
          "type": "string"
        },
        "workingDirectory": {
          "type": "string"
        }
      },
      "required": [
        "executable",
        "workingDirectory"
      ],
      "type": "object"
    },
    "UtcTimestamp": {
      "description": "UTC timestamp serialized with a literal `Z` and millisecond precision.",
      "type": "string"
    },
    "VirtualMachineBaseDisk": {
      "additionalProperties": false,
      "description": "Deployment-owned immutable KubeVirt base-disk identity.\n\nUnlike an object-store `ArtifactRef`, this identifies a CDI source image and its imported\ndisk content. `capacity_bytes` is the reviewed PVC capacity, not a fabricated object length.",
      "properties": {
        "binding": {
          "type": "string"
        },
        "capacityBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "diskSha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "sourceRegistryDigest": {
          "type": "string"
        }
      },
      "required": [
        "binding",
        "sourceRegistryDigest",
        "diskSha256",
        "capacityBytes"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Stable EnvironmentSpec v1.",
  "properties": {
    "apiVersion": {
      "$ref": "#/$defs/EnvironmentApiVersion"
    },
    "class": {
      "$ref": "#/$defs/EnvironmentClass"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/EnvironmentEntrySpec"
      },
      "type": "array"
    },
    "kind": {
      "$ref": "#/$defs/EnvironmentDocumentKind"
    },
    "name": {
      "type": "string"
    },
    "network": {
      "$ref": "#/$defs/NetworkPolicySpec"
    },
    "resources": {
      "$ref": "#/$defs/ResourceRequirements"
    },
    "retention": {
      "$ref": "#/$defs/RetentionSnapshot"
    },
    "runtime": {
      "$ref": "#/$defs/EnvironmentRuntimeSpec"
    },
    "security": {
      "$ref": "#/$defs/EnvironmentSecuritySpec"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "name",
    "class",
    "resources",
    "network",
    "entries",
    "security",
    "runtime",
    "retention"
  ],
  "title": "EnvironmentSpec",
  "type": "object"
}
