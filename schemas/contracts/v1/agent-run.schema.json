{
  "$defs": {
    "ActorId": {
      "description": "Strongly typed UUIDv7 identifier for `ActorId`.",
      "type": "string"
    },
    "AgentAttempt": {
      "additionalProperties": false,
      "description": "One append-only attempt in an Agent track.",
      "properties": {
        "checkpoint": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "diagnosticCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "number": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "state": {
          "$ref": "#/$defs/AgentAttemptState"
        },
        "usage": {
          "$ref": "#/$defs/LlmUsage"
        },
        "usageObserved": {
          "description": "Whether a terminal provider envelope made this usage observable.",
          "type": "boolean"
        }
      },
      "required": [
        "number",
        "state",
        "usage",
        "usageObserved"
      ],
      "type": "object"
    },
    "AgentAttemptState": {
      "description": "State of one immutable Agent attempt.",
      "enum": [
        "pending",
        "running",
        "repairing",
        "awaiting_approval",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "AgentRunId": {
      "description": "Strongly typed UUIDv7 identifier for `AgentRunId`.",
      "type": "string"
    },
    "AgentRunPurpose": {
      "description": "Immutable purpose selected by Control for one Agent run.\n\nThe purpose is authoritative: callers cannot substitute an environment class, target\nenvironment, actor, or runtime through an untyped request field. Authoring creates a new\nEnvironment/Evaluation package, while WorkConfiguration targets one existing Work environment\nand produces one configuration plan.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "environmentClass": {
              "$ref": "#/$defs/EnvironmentClass"
            },
            "kind": {
              "const": "authoring",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "environmentClass"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "actorId": {
              "$ref": "#/$defs/ActorId"
            },
            "environmentId": {
              "$ref": "#/$defs/EnvironmentId"
            },
            "environmentRevision": {
              "$ref": "#/$defs/Revision"
            },
            "kind": {
              "const": "work_configuration",
              "type": "string"
            },
            "runtimeKind": {
              "$ref": "#/$defs/RuntimeKind",
              "description": "Runtime selected by the authoritative Work environment.\n\nControl resolves this value from the environment instance before dispatching the\nrun. Agent uses it as the immutable execution routing key, so a missing or altered\nruntime cannot silently select a different executor."
            }
          },
          "required": [
            "kind",
            "environmentId",
            "environmentRevision",
            "actorId",
            "runtimeKind"
          ],
          "type": "object"
        }
      ]
    },
    "AgentRunState": {
      "description": "Aggregate AgentRun state derived from both tracks.",
      "enum": [
        "requested",
        "running",
        "partially_succeeded",
        "succeeded",
        "awaiting_approval",
        "failed",
        "cancelling",
        "cancelled"
      ],
      "type": "string"
    },
    "AgentTrack": {
      "additionalProperties": false,
      "description": "Independent track and its retained attempts.",
      "properties": {
        "attempts": {
          "items": {
            "$ref": "#/$defs/AgentAttempt"
          },
          "type": "array"
        },
        "candidateId": {
          "anyOf": [
            {
              "$ref": "#/$defs/CandidateId"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "$ref": "#/$defs/AgentTrackKind"
        }
      },
      "required": [
        "kind",
        "attempts"
      ],
      "type": "object"
    },
    "AgentTrackKind": {
      "description": "Independent Agent track.",
      "enum": [
        "environment",
        "evaluation",
        "work_configuration"
      ],
      "type": "string"
    },
    "ArtifactId": {
      "description": "Strongly typed UUIDv7 identifier for `ArtifactId`.",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Immutable object-store identity without a machine-local path or credential.",
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/ArtifactId",
          "description": "Stable metadata identity resolved by the owning service."
        },
        "mediaType": {
          "description": "Registered media type.",
          "type": "string"
        },
        "objectVersion": {
          "description": "Immutable backend object version.",
          "type": "string"
        },
        "sizeBytes": {
          "description": "Raw object length.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "storeBinding": {
          "description": "Explicit object-store binding from deployment configuration.",
          "type": "string"
        }
      },
      "required": [
        "artifactId",
        "storeBinding",
        "objectVersion",
        "sizeBytes",
        "mediaType"
      ],
      "type": "object"
    },
    "CandidateId": {
      "description": "Strongly typed UUIDv7 identifier for `CandidateId`.",
      "type": "string"
    },
    "CourseId": {
      "description": "Strongly typed UUIDv7 identifier for `CourseId`.",
      "type": "string"
    },
    "EnvironmentClass": {
      "description": "Environment business class retained from the v2.1 architecture.",
      "enum": [
        "experiment",
        "work"
      ],
      "type": "string"
    },
    "EnvironmentId": {
      "description": "Strongly typed UUIDv7 identifier for `EnvironmentId`.",
      "type": "string"
    },
    "LlmUsage": {
      "additionalProperties": false,
      "description": "Frozen LLM usage for one attempt.",
      "properties": {
        "costMicrousd": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "inputTokens": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "outputTokens": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "requests": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "inputTokens",
        "outputTokens",
        "requests",
        "costMicrousd"
      ],
      "type": "object"
    },
    "PolicyId": {
      "description": "Strongly typed UUIDv7 identifier for `PolicyId`.",
      "type": "string"
    },
    "ProblemPackageId": {
      "description": "Strongly typed UUIDv7 identifier for `ProblemPackageId`.",
      "type": "string"
    },
    "ProjectId": {
      "description": "Strongly typed UUIDv7 identifier for `ProjectId`.",
      "type": "string"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "RuntimeKind": {
      "description": "Runtime kind shared by candidates, releases, and instances.",
      "enum": [
        "container",
        "virtual_machine"
      ],
      "type": "string"
    },
    "WorkConfigurationPlan": {
      "additionalProperties": false,
      "description": "Immutable generated configuration plan for one existing Work environment.",
      "properties": {
        "environmentId": {
          "$ref": "#/$defs/EnvironmentId"
        },
        "environmentRevision": {
          "$ref": "#/$defs/Revision"
        },
        "id": {
          "$ref": "#/$defs/WorkConfigurationPlanId"
        },
        "requiresRestart": {
          "type": "boolean"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "scriptArtifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "summary": {
          "type": "string"
        },
        "verificationScriptArtifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "revision",
        "scriptArtifact",
        "summary",
        "requiresRestart",
        "environmentId",
        "environmentRevision"
      ],
      "type": "object"
    },
    "WorkConfigurationPlanId": {
      "description": "Strongly typed UUIDv7 identifier for `WorkConfigurationPlanId`.",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One idempotent, auditable dual-candidate Agent run.",
  "properties": {
    "courseId": {
      "anyOf": [
        {
          "$ref": "#/$defs/CourseId"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "$ref": "#/$defs/AgentRunId"
    },
    "packageId": {
      "$ref": "#/$defs/ProblemPackageId"
    },
    "plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorkConfigurationPlan"
        },
        {
          "type": "null"
        }
      ]
    },
    "policyId": {
      "$ref": "#/$defs/PolicyId"
    },
    "policyRevision": {
      "$ref": "#/$defs/Revision"
    },
    "projectId": {
      "$ref": "#/$defs/ProjectId"
    },
    "purpose": {
      "$ref": "#/$defs/AgentRunPurpose"
    },
    "revision": {
      "$ref": "#/$defs/Revision"
    },
    "state": {
      "$ref": "#/$defs/AgentRunState"
    },
    "tracks": {
      "items": {
        "$ref": "#/$defs/AgentTrack"
      },
      "type": "array"
    }
  },
  "required": [
    "id",
    "projectId",
    "packageId",
    "policyId",
    "policyRevision",
    "purpose",
    "state",
    "revision",
    "tracks"
  ],
  "title": "AgentRun",
  "type": "object"
}
