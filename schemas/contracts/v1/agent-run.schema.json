{
  "$defs": {
    "AgentAttempt": {
      "additionalProperties": false,
      "description": "One append-only attempt in an Agent track.",
      "properties": {
        "checkpoint": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "diagnosticCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "number": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "state": {
          "$ref": "#/$defs/AgentAttemptState"
        },
        "usage": {
          "$ref": "#/$defs/LlmUsage"
        },
        "usageObserved": {
          "description": "Whether a terminal provider envelope made this usage observable.",
          "type": "boolean"
        }
      },
      "required": [
        "number",
        "state",
        "usage",
        "usageObserved"
      ],
      "type": "object"
    },
    "AgentAttemptState": {
      "description": "State of one immutable Agent attempt.",
      "enum": [
        "pending",
        "running",
        "repairing",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "AgentRunId": {
      "description": "Strongly typed UUIDv7 identifier for `AgentRunId`.",
      "type": "string"
    },
    "AgentRunState": {
      "description": "Aggregate AgentRun state derived from both tracks.",
      "enum": [
        "requested",
        "running",
        "partially_succeeded",
        "succeeded",
        "failed",
        "cancelling",
        "cancelled"
      ],
      "type": "string"
    },
    "AgentTrack": {
      "additionalProperties": false,
      "description": "Independent track and its retained attempts.",
      "properties": {
        "attempts": {
          "items": {
            "$ref": "#/$defs/AgentAttempt"
          },
          "type": "array"
        },
        "candidateId": {
          "anyOf": [
            {
              "$ref": "#/$defs/CandidateId"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "$ref": "#/$defs/AgentTrackKind"
        }
      },
      "required": [
        "kind",
        "attempts"
      ],
      "type": "object"
    },
    "AgentTrackKind": {
      "description": "Independent Agent track.",
      "enum": [
        "environment",
        "evaluation"
      ],
      "type": "string"
    },
    "ArtifactId": {
      "description": "Strongly typed UUIDv7 identifier for `ArtifactId`.",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Immutable object-store identity without a machine-local path or credential.",
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/ArtifactId",
          "description": "Stable metadata identity resolved by the owning service."
        },
        "mediaType": {
          "description": "Registered media type.",
          "type": "string"
        },
        "objectVersion": {
          "description": "Immutable backend object version.",
          "type": "string"
        },
        "sizeBytes": {
          "description": "Raw object length.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "storeBinding": {
          "description": "Explicit object-store binding from deployment configuration.",
          "type": "string"
        }
      },
      "required": [
        "artifactId",
        "storeBinding",
        "objectVersion",
        "sizeBytes",
        "mediaType"
      ],
      "type": "object"
    },
    "CandidateId": {
      "description": "Strongly typed UUIDv7 identifier for `CandidateId`.",
      "type": "string"
    },
    "CourseId": {
      "description": "Strongly typed UUIDv7 identifier for `CourseId`.",
      "type": "string"
    },
    "LlmUsage": {
      "additionalProperties": false,
      "description": "Frozen LLM usage for one attempt.",
      "properties": {
        "costMicrousd": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "inputTokens": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "outputTokens": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "requests": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "inputTokens",
        "outputTokens",
        "requests",
        "costMicrousd"
      ],
      "type": "object"
    },
    "PolicyId": {
      "description": "Strongly typed UUIDv7 identifier for `PolicyId`.",
      "type": "string"
    },
    "ProblemPackageId": {
      "description": "Strongly typed UUIDv7 identifier for `ProblemPackageId`.",
      "type": "string"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "RuntimeKind": {
      "description": "Runtime kind shared by candidates, releases, and instances.",
      "enum": [
        "container",
        "virtual_machine"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One idempotent, auditable dual-candidate Agent run.",
  "properties": {
    "courseId": {
      "$ref": "#/$defs/CourseId"
    },
    "id": {
      "$ref": "#/$defs/AgentRunId"
    },
    "packageId": {
      "$ref": "#/$defs/ProblemPackageId"
    },
    "policyId": {
      "$ref": "#/$defs/PolicyId"
    },
    "policyRevision": {
      "$ref": "#/$defs/Revision"
    },
    "requestedRuntime": {
      "$ref": "#/$defs/RuntimeKind"
    },
    "revision": {
      "$ref": "#/$defs/Revision"
    },
    "state": {
      "$ref": "#/$defs/AgentRunState"
    },
    "tracks": {
      "items": {
        "$ref": "#/$defs/AgentTrack"
      },
      "type": "array"
    }
  },
  "required": [
    "id",
    "courseId",
    "packageId",
    "policyId",
    "policyRevision",
    "requestedRuntime",
    "state",
    "revision",
    "tracks"
  ],
  "title": "AgentRun",
  "type": "object"
}
