{
  "$defs": {
    "DiagnosticCode": {
      "description": "Stable machine-readable diagnostic code.\n\nConsumers must treat an unknown `LW_*` code as blocking. The newtype is intentionally open so\nadditive diagnostics do not force a wire-version change.",
      "type": "string"
    },
    "EnvironmentId": {
      "description": "Strongly typed UUIDv7 identifier for `EnvironmentId`.",
      "type": "string"
    },
    "EnvironmentOperationKind": {
      "description": "Explicit operation kind; restart and destructive reset are never aliases.",
      "enum": [
        "create",
        "start",
        "stop",
        "restart",
        "reset",
        "retry",
        "cancel",
        "recover",
        "expire",
        "delete",
        "cleanup",
        "freeze"
      ],
      "type": "string"
    },
    "OperationId": {
      "description": "Strongly typed UUIDv7 identifier for `OperationId`.",
      "type": "string"
    },
    "OperationState": {
      "description": "Persistent operation state.",
      "enum": [
        "accepted",
        "running",
        "cancelling",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "UtcTimestamp": {
      "description": "UTC timestamp serialized with a literal `Z` and millisecond precision.",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Safe operation representation for Public REST and SSE consumers.",
  "properties": {
    "acceptedAt": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "acceptedRevision": {
      "$ref": "#/$defs/Revision"
    },
    "attempt": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "cancelEligible": {
      "type": "boolean"
    },
    "cleanupStartedAt": {
      "anyOf": [
        {
          "$ref": "#/$defs/UtcTimestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "deadlineAt": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "diagnosticCode": {
      "anyOf": [
        {
          "$ref": "#/$defs/DiagnosticCode"
        },
        {
          "type": "null"
        }
      ]
    },
    "environmentId": {
      "$ref": "#/$defs/EnvironmentId"
    },
    "kind": {
      "$ref": "#/$defs/EnvironmentOperationKind"
    },
    "maxAttempts": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "operationId": {
      "$ref": "#/$defs/OperationId"
    },
    "retryEligible": {
      "type": "boolean"
    },
    "state": {
      "$ref": "#/$defs/OperationState"
    },
    "terminalAt": {
      "anyOf": [
        {
          "$ref": "#/$defs/UtcTimestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "traceId": {
      "type": "string"
    }
  },
  "required": [
    "environmentId",
    "operationId",
    "kind",
    "state",
    "acceptedRevision",
    "acceptedAt",
    "deadlineAt",
    "attempt",
    "maxAttempts",
    "retryEligible",
    "cancelEligible",
    "traceId"
  ],
  "title": "EnvironmentOperationSnapshot",
  "type": "object"
}
