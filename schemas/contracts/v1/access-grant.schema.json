{
  "$defs": {
    "AccessGrantId": {
      "description": "Strongly typed UUIDv7 identifier for `AccessGrantId`.",
      "type": "string"
    },
    "AccessGrantState": {
      "description": "AccessGrant lifecycle.",
      "enum": [
        "requested",
        "active",
        "denied",
        "expired",
        "revoked"
      ],
      "type": "string"
    },
    "ActorId": {
      "description": "Strongly typed UUIDv7 identifier for `ActorId`.",
      "type": "string"
    },
    "CourseId": {
      "description": "Strongly typed UUIDv7 identifier for `CourseId`.",
      "type": "string"
    },
    "EndpointAction": {
      "description": "Allowed endpoint action.",
      "enum": [
        "connect"
      ],
      "type": "string"
    },
    "EndpointCapability": {
      "description": "Explicit operations supported by one endpoint revision.",
      "enum": [
        "browser_http",
        "browser_terminal",
        "ssh"
      ],
      "type": "string"
    },
    "EndpointGrant": {
      "additionalProperties": false,
      "description": "Child grant for one exact endpoint revision.",
      "properties": {
        "accessGrantId": {
          "$ref": "#/$defs/AccessGrantId"
        },
        "action": {
          "$ref": "#/$defs/EndpointAction"
        },
        "alias": {
          "type": [
            "string",
            "null"
          ]
        },
        "capabilities": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EndpointCapability"
          },
          "type": "array"
        },
        "connectUrl": {
          "description": "Same-origin, Access Service-authorized browser entry point. Present only\nfor HTTP(S) grants and derived from this immutable endpoint grant ID.",
          "type": [
            "string",
            "null"
          ]
        },
        "endpointId": {
          "$ref": "#/$defs/EndpointId"
        },
        "endpointRevision": {
          "$ref": "#/$defs/Revision"
        },
        "expiresAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "health": {
          "$ref": "#/$defs/EndpointHealth"
        },
        "id": {
          "$ref": "#/$defs/EndpointGrantId"
        },
        "protocol": {
          "$ref": "#/$defs/EndpointProtocol"
        },
        "sshGatewayHostKeyFingerprint": {
          "description": "OpenSSH SHA-256 host-key fingerprint for the public Gateway.",
          "type": [
            "string",
            "null"
          ]
        },
        "sshGatewayHostname": {
          "description": "Public OpenSSH Gateway DNS name for SSH grants. Never a runtime target.",
          "type": [
            "string",
            "null"
          ]
        },
        "sshGatewayPort": {
          "description": "Public OpenSSH Gateway listener port for SSH grants.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "terminalUrl": {
          "description": "Same-origin browser terminal WebSocket URL for this exact endpoint revision.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "accessGrantId",
        "endpointId",
        "endpointRevision",
        "protocol",
        "action",
        "health",
        "expiresAt"
      ],
      "type": "object"
    },
    "EndpointGrantId": {
      "description": "Strongly typed UUIDv7 identifier for `EndpointGrantId`.",
      "type": "string"
    },
    "EndpointHealth": {
      "description": "Endpoint health gates new AccessGrants.",
      "enum": [
        "pending",
        "healthy",
        "unhealthy",
        "removed"
      ],
      "type": "string"
    },
    "EndpointId": {
      "description": "Strongly typed UUIDv7 identifier for `EndpointId`.",
      "type": "string"
    },
    "EndpointProtocol": {
      "description": "Supported controlled protocols.",
      "enum": [
        "http",
        "https",
        "ssh"
      ],
      "type": "string"
    },
    "EnvironmentId": {
      "description": "Strongly typed UUIDv7 identifier for `EnvironmentId`.",
      "type": "string"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "UtcTimestamp": {
      "description": "UTC timestamp serialized with a literal `Z` and millisecond precision.",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Parent actor×course×environment grant.",
  "properties": {
    "actorId": {
      "$ref": "#/$defs/ActorId"
    },
    "courseId": {
      "$ref": "#/$defs/CourseId"
    },
    "endpointGrants": {
      "items": {
        "$ref": "#/$defs/EndpointGrant"
      },
      "type": "array"
    },
    "environmentId": {
      "$ref": "#/$defs/EnvironmentId"
    },
    "environmentRevision": {
      "$ref": "#/$defs/Revision"
    },
    "expiresAt": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "id": {
      "$ref": "#/$defs/AccessGrantId"
    },
    "issuedAt": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "reasonCode": {
      "type": [
        "string",
        "null"
      ]
    },
    "revision": {
      "$ref": "#/$defs/Revision"
    },
    "revokedAt": {
      "anyOf": [
        {
          "$ref": "#/$defs/UtcTimestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "$ref": "#/$defs/AccessGrantState"
    }
  },
  "required": [
    "id",
    "actorId",
    "courseId",
    "environmentId",
    "environmentRevision",
    "state",
    "revision",
    "endpointGrants",
    "issuedAt",
    "expiresAt"
  ],
  "title": "AccessGrant",
  "type": "object"
}
