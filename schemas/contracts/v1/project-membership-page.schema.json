{
  "$defs": {
    "ActorId": {
      "description": "Strongly typed UUIDv7 identifier for `ActorId`.",
      "type": "string"
    },
    "CourseId": {
      "description": "Strongly typed UUIDv7 identifier for `CourseId`.",
      "type": "string"
    },
    "MembershipState": {
      "description": "Authoritative membership state owned by Control Service.",
      "oneOf": [
        {
          "const": "active",
          "description": "Membership may authorize matching operations.",
          "type": "string"
        },
        {
          "const": "suspended",
          "description": "Membership is temporarily disabled and must deny access.",
          "type": "string"
        },
        {
          "const": "revoked",
          "description": "Membership was permanently revoked and must deny access.",
          "type": "string"
        }
      ]
    },
    "PlatformRole": {
      "description": "Base role asserted by the configured OIDC issuer.",
      "oneOf": [
        {
          "const": "teacher",
          "description": "Course teacher with an active course membership.",
          "type": "string"
        },
        {
          "const": "student",
          "description": "Course student with an active course membership.",
          "type": "string"
        },
        {
          "const": "platform_admin",
          "description": "Global operator when an operation explicitly permits administrator access.",
          "type": "string"
        }
      ]
    },
    "ProjectId": {
      "description": "Strongly typed UUIDv7 identifier for `ProjectId`.",
      "type": "string"
    },
    "ProjectMembership": {
      "additionalProperties": false,
      "description": "Project-local scope. A project may optionally be associated with teaching.",
      "properties": {
        "actorId": {
          "$ref": "#/$defs/ActorId",
          "description": "Actor scope."
        },
        "courseId": {
          "anyOf": [
            {
              "$ref": "#/$defs/CourseId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional teaching course association."
        },
        "displayName": {
          "description": "Human-readable issuer name, present on project membership views.",
          "type": [
            "string",
            "null"
          ]
        },
        "expiresAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtcTimestamp"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional hard expiry."
        },
        "objectRole": {
          "$ref": "#/$defs/ProjectObjectRole",
          "default": "viewer",
          "description": "Project action responsibilities, independent of the verified platform role."
        },
        "projectId": {
          "$ref": "#/$defs/ProjectId",
          "description": "Project scope."
        },
        "revision": {
          "$ref": "#/$defs/Revision",
          "description": "Monotonic authorization revision."
        },
        "role": {
          "$ref": "#/$defs/PlatformRole",
          "description": "Role permitted by this project."
        },
        "state": {
          "$ref": "#/$defs/MembershipState",
          "description": "Current lifecycle state."
        },
        "username": {
          "description": "Issuer username, present on project membership views when identity\nmetadata is available.  Authorization snapshots leave this unset.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "projectId",
        "actorId",
        "role",
        "state",
        "revision"
      ],
      "type": "object"
    },
    "ProjectObjectRole": {
      "description": "Responsibilities granted by Control in one project, independent of Teacher/Student identity.",
      "enum": [
        "viewer",
        "operator",
        "editor",
        "manager",
        "owner"
      ],
      "type": "string"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "UtcTimestamp": {
      "description": "UTC timestamp serialized with a literal `Z` and millisecond precision.",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/ProjectMembership"
      },
      "type": "array"
    },
    "nextCursor": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "items"
  ],
  "title": "CursorPage",
  "type": "object"
}
