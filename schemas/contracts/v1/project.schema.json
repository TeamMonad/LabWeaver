{
  "$defs": {
    "ActorId": {
      "description": "Strongly typed UUIDv7 identifier for `ActorId`.",
      "type": "string"
    },
    "CourseId": {
      "description": "Strongly typed UUIDv7 identifier for `CourseId`.",
      "type": "string"
    },
    "ProjectId": {
      "description": "Strongly typed UUIDv7 identifier for `ProjectId`.",
      "type": "string"
    },
    "ProjectState": {
      "description": "Durable lifecycle of a project. Archiving preserves independent research work.",
      "enum": [
        "active",
        "archived"
      ],
      "type": "string"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "UtcTimestamp": {
      "description": "UTC timestamp serialized with a literal `Z` and millisecond precision.",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Control-owned project aggregate and the single source of project metadata.",
  "properties": {
    "courseId": {
      "anyOf": [
        {
          "$ref": "#/$defs/CourseId"
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAt": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "$ref": "#/$defs/ProjectId"
    },
    "name": {
      "type": "string"
    },
    "ownerActorId": {
      "$ref": "#/$defs/ActorId"
    },
    "revision": {
      "$ref": "#/$defs/Revision"
    },
    "state": {
      "$ref": "#/$defs/ProjectState"
    },
    "updatedAt": {
      "$ref": "#/$defs/UtcTimestamp"
    }
  },
  "required": [
    "id",
    "ownerActorId",
    "name",
    "state",
    "revision",
    "createdAt",
    "updatedAt"
  ],
  "title": "Project",
  "type": "object"
}
