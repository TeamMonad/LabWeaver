{
  "$defs": {
    "ActorId": {
      "description": "Strongly typed UUIDv7 identifier for `ActorId`.",
      "type": "string"
    },
    "BuilderEntitlement": {
      "enum": [
        "network.host",
        "security.insecure"
      ],
      "type": "string"
    },
    "BuilderSecurityPolicy": {
      "additionalProperties": false,
      "description": "Independently configured builder range. Runtime requests cannot change these fields.",
      "properties": {
        "allowPrivilegeEscalation": {
          "type": "boolean"
        },
        "capabilities": {
          "items": {
            "$ref": "#/$defs/LinuxCapability"
          },
          "type": "array",
          "uniqueItems": true
        },
        "entitlements": {
          "items": {
            "$ref": "#/$defs/BuilderEntitlement"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "capabilities",
        "allowPrivilegeEscalation",
        "entitlements"
      ],
      "type": "object"
    },
    "CourseId": {
      "description": "Strongly typed UUIDv7 identifier for `CourseId`.",
      "type": "string"
    },
    "LinuxCapability": {
      "description": "Linux capability names from the kernel UAPI. `ALL` is never an addition.",
      "enum": [
        "CHOWN",
        "DAC_OVERRIDE",
        "DAC_READ_SEARCH",
        "FOWNER",
        "FSETID",
        "KILL",
        "SETGID",
        "SETUID",
        "SETPCAP",
        "LINUX_IMMUTABLE",
        "NET_BIND_SERVICE",
        "NET_BROADCAST",
        "NET_ADMIN",
        "NET_RAW",
        "IPC_LOCK",
        "IPC_OWNER",
        "SYS_MODULE",
        "SYS_RAWIO",
        "SYS_CHROOT",
        "SYS_PTRACE",
        "SYS_PACCT",
        "SYS_ADMIN",
        "SYS_BOOT",
        "SYS_NICE",
        "SYS_RESOURCE",
        "SYS_TIME",
        "SYS_TTY_CONFIG",
        "MKNOD",
        "LEASE",
        "AUDIT_WRITE",
        "AUDIT_CONTROL",
        "SETFCAP",
        "MAC_OVERRIDE",
        "MAC_ADMIN",
        "SYSLOG",
        "WAKE_ALARM",
        "BLOCK_SUSPEND",
        "AUDIT_READ",
        "PERFMON",
        "BPF",
        "CHECKPOINT_RESTORE"
      ],
      "type": "string"
    },
    "OperationId": {
      "description": "Strongly typed UUIDv7 identifier for `OperationId`.",
      "type": "string"
    },
    "PlatformConfigurationAppliedState": {
      "description": "Whether the current external configuration has a complete verified observation.",
      "enum": [
        "unconfigured",
        "verified",
        "unverified"
      ],
      "type": "string"
    },
    "PlatformConfigurationApply": {
      "additionalProperties": false,
      "properties": {
        "desiredRevision": {
          "$ref": "#/$defs/Revision"
        },
        "encryptedBundleSha256": {
          "type": "string"
        },
        "executorClientId": {
          "type": [
            "string",
            "null"
          ]
        },
        "failedStage": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlatformConfigurationApplyStage"
            },
            {
              "type": "null"
            }
          ]
        },
        "failureReason": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlatformConfigurationFailureReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "$ref": "#/$defs/OperationId"
        },
        "nextStep": {
          "$ref": "#/$defs/PlatformConfigurationNextStep"
        },
        "previousApplyId": {
          "anyOf": [
            {
              "$ref": "#/$defs/OperationId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Follow this link to read prior attempts after reconnecting or retrying."
        },
        "requestedAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "requestedBy": {
          "$ref": "#/$defs/ActorId"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "stage": {
          "$ref": "#/$defs/PlatformConfigurationApplyStage"
        },
        "updatedAt": {
          "$ref": "#/$defs/UtcTimestamp"
        }
      },
      "required": [
        "id",
        "revision",
        "desiredRevision",
        "encryptedBundleSha256",
        "stage",
        "nextStep",
        "requestedBy",
        "requestedAt",
        "updatedAt"
      ],
      "type": "object"
    },
    "PlatformConfigurationApplyStage": {
      "enum": [
        "requested",
        "validating",
        "applying",
        "verifying",
        "succeeded",
        "failed"
      ],
      "type": "string"
    },
    "PlatformConfigurationBundle": {
      "additionalProperties": false,
      "description": "An administrator's registration of received ciphertext, not deployment approval.",
      "properties": {
        "configurationSha256": {
          "description": "Administrator-declared binding to the immutable settings snapshot.",
          "type": "string"
        },
        "desiredRevision": {
          "$ref": "#/$defs/Revision"
        },
        "encryptedBundleSha256": {
          "description": "Computed by Control from actual uploaded ciphertext bytes.",
          "type": "string"
        },
        "encryptedBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "registeredAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "registeredAtRevision": {
          "$ref": "#/$defs/Revision"
        },
        "registeredBy": {
          "$ref": "#/$defs/ActorId"
        }
      },
      "required": [
        "registeredAtRevision",
        "desiredRevision",
        "configurationSha256",
        "encryptedBundleSha256",
        "encryptedBytes",
        "registeredBy",
        "registeredAt"
      ],
      "type": "object"
    },
    "PlatformConfigurationDesired": {
      "additionalProperties": false,
      "description": "The one managed settings document. It contains no credential values or secret locators.",
      "properties": {
        "builderPolicy": {
          "$ref": "#/$defs/BuilderSecurityPolicy"
        },
        "lifecycle": {
          "$ref": "#/$defs/PlatformLifecycleDefaults"
        },
        "runtimePolicy": {
          "$ref": "#/$defs/PlatformRuntimePolicy"
        }
      },
      "required": [
        "lifecycle",
        "runtimePolicy",
        "builderPolicy"
      ],
      "type": "object"
    },
    "PlatformConfigurationFailureReason": {
      "description": "Bounded failure categories. Executor log content is never an API payload.",
      "enum": [
        "configuration_invalid",
        "dependency_unavailable",
        "execution_failed",
        "verification_failed",
        "external_result_unknown",
        "interrupted"
      ],
      "type": "string"
    },
    "PlatformConfigurationImpact": {
      "additionalProperties": false,
      "properties": {
        "builderPolicyChanged": {
          "type": "boolean"
        },
        "lifecyclePolicyChanged": {
          "type": "boolean"
        },
        "runtimePolicyChanged": {
          "type": "boolean"
        }
      },
      "required": [
        "runtimePolicyChanged",
        "builderPolicyChanged",
        "lifecyclePolicyChanged"
      ],
      "type": "object"
    },
    "PlatformConfigurationNextStep": {
      "description": "Readable next step, without executor logs or credential content.",
      "enum": [
        "execute_approved_deployment",
        "wait_for_executor",
        "fix_configuration_and_retry",
        "reconcile_external_result",
        "none"
      ],
      "type": "string"
    },
    "PlatformConfigurationVersion": {
      "additionalProperties": false,
      "properties": {
        "configuration": {
          "$ref": "#/$defs/PlatformConfigurationDesired"
        },
        "configurationSha256": {
          "description": "SHA-256 of the canonical managed settings JSON, without a prefix.",
          "type": "string"
        },
        "createdAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "createdBy": {
          "$ref": "#/$defs/ActorId"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "revision",
        "configuration",
        "configurationSha256",
        "createdBy",
        "createdAt"
      ],
      "type": "object"
    },
    "PlatformLifecycleDefaults": {
      "additionalProperties": false,
      "properties": {
        "detailedLogRetentionSeconds": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expiryReminderSeconds": {
          "items": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "preemptionGraceSeconds": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "readOnlyRetentionSeconds": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "readOnlyRetentionSeconds",
        "detailedLogRetentionSeconds",
        "expiryReminderSeconds",
        "preemptionGraceSeconds"
      ],
      "type": "object"
    },
    "PlatformRuntimePolicy": {
      "additionalProperties": false,
      "description": "Platform allowed range. This does not replace object authorization or actual placement.",
      "properties": {
        "allowedCapabilities": {
          "items": {
            "$ref": "#/$defs/LinuxCapability"
          },
          "type": "array",
          "uniqueItems": true
        },
        "defaultContainerUid": {
          "description": "Zero means guest/container root, without host privileges.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "preauthorizations": {
          "items": {
            "$ref": "#/$defs/RuntimePreauthorization"
          },
          "type": "array"
        },
        "privilegedAllowed": {
          "type": "boolean"
        },
        "privilegedExecutionLocation": {
          "anyOf": [
            {
              "$ref": "#/$defs/PrivilegedExecutionLocation"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "defaultContainerUid",
        "allowedCapabilities",
        "preauthorizations",
        "privilegedAllowed"
      ],
      "type": "object"
    },
    "PrivilegedExecutionLocation": {
      "description": "An execution boundary declaration. The Environment consumer must prove exclusivity.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "dedicated_node_pool",
              "type": "string"
            },
            "nodeSelector": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "taintKey": {
              "type": "string"
            },
            "taintValue": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "nodeSelector",
            "taintKey",
            "taintValue"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "virtual_machine_guest",
              "type": "string"
            },
            "providerBinding": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "providerBinding"
          ],
          "type": "object"
        }
      ]
    },
    "ProjectId": {
      "description": "Strongly typed UUIDv7 identifier for `ProjectId`.",
      "type": "string"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "RuntimePreauthorization": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "items": {
            "$ref": "#/$defs/LinuxCapability"
          },
          "type": "array",
          "uniqueItems": true
        },
        "privileged": {
          "type": "boolean"
        },
        "scope": {
          "$ref": "#/$defs/RuntimePreauthorizationScope"
        }
      },
      "required": [
        "scope",
        "capabilities",
        "privileged"
      ],
      "type": "object"
    },
    "RuntimePreauthorizationScope": {
      "description": "Object scope for a runtime preauthorization, never a builder authorization.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "project",
              "type": "string"
            },
            "projectId": {
              "$ref": "#/$defs/ProjectId"
            }
          },
          "required": [
            "kind",
            "projectId"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "courseId": {
              "$ref": "#/$defs/CourseId"
            },
            "kind": {
              "const": "course",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "courseId"
          ],
          "type": "object"
        }
      ]
    },
    "UtcTimestamp": {
      "description": "UTC timestamp serialized with a literal `Z` and millisecond precision.",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Applied means last fully verified configuration. A failed apply can leave external state unknown.",
  "properties": {
    "applied": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlatformConfigurationVersion"
        },
        {
          "type": "null"
        }
      ]
    },
    "appliedAt": {
      "anyOf": [
        {
          "$ref": "#/$defs/UtcTimestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "appliedBundleSha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "appliedState": {
      "$ref": "#/$defs/PlatformConfigurationAppliedState"
    },
    "defaults": {
      "$ref": "#/$defs/PlatformConfigurationDesired",
      "default": {
        "builderPolicy": {
          "allowPrivilegeEscalation": false,
          "capabilities": [],
          "entitlements": []
        },
        "lifecycle": {
          "detailedLogRetentionSeconds": 2592000,
          "expiryReminderSeconds": [
            86400,
            3600
          ],
          "preemptionGraceSeconds": 60,
          "readOnlyRetentionSeconds": 604800
        },
        "runtimePolicy": {
          "allowedCapabilities": [],
          "defaultContainerUid": 0,
          "preauthorizations": [],
          "privilegedAllowed": false,
          "privilegedExecutionLocation": null
        }
      }
    },
    "desired": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlatformConfigurationVersion"
        },
        {
          "type": "null"
        }
      ]
    },
    "impact": {
      "$ref": "#/$defs/PlatformConfigurationImpact"
    },
    "latestApply": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlatformConfigurationApply"
        },
        {
          "type": "null"
        }
      ]
    },
    "registeredBundle": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlatformConfigurationBundle"
        },
        {
          "type": "null"
        }
      ],
      "description": "Current desired's last registered artifact. Registration alone never applies it."
    },
    "revision": {
      "description": "Aggregate fence, including apply updates. Zero is the unconfigured state.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "revision",
    "appliedState",
    "impact"
  ],
  "title": "PlatformConfigurationStatus",
  "type": "object"
}
