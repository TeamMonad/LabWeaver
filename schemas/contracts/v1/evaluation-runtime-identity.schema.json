{
  "$defs": {
    "Sha256Digest": {
      "description": "Canonical lowercase SHA-256 digest.",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Immutable build and deployment identity that must match every run using the release.",
  "properties": {
    "configurationSha256": {
      "$ref": "#/$defs/Sha256Digest",
      "description": "Effective non-secret runtime configuration identity."
    },
    "migrationCatalogSha256": {
      "$ref": "#/$defs/Sha256Digest",
      "description": "Checked-in Migration catalog identity."
    },
    "packageSha256": {
      "$ref": "#/$defs/Sha256Digest",
      "description": "Approved problem package identity."
    },
    "providerBinding": {
      "description": "Explicit runtime provider binding chosen by Control and enforced by Evaluation.",
      "type": "string"
    },
    "runnerImage": {
      "description": "Digest-pinned runner image reference.",
      "type": "string"
    },
    "runtimeArtifactSha256": {
      "$ref": "#/$defs/Sha256Digest",
      "description": "Runtime artifact identity, such as the worker binary or image manifest digest."
    },
    "sourceSha256": {
      "$ref": "#/$defs/Sha256Digest",
      "description": "Clean source tree or source bundle identity."
    }
  },
  "required": [
    "sourceSha256",
    "providerBinding",
    "packageSha256",
    "configurationSha256",
    "migrationCatalogSha256",
    "runnerImage",
    "runtimeArtifactSha256"
  ],
  "title": "EvaluationRuntimeIdentity",
  "type": "object"
}
