{
  "$defs": {
    "ActorId": {
      "description": "Strongly typed UUIDv7 identifier for `ActorId`.",
      "type": "string"
    },
    "CourseId": {
      "description": "Strongly typed UUIDv7 identifier for `CourseId`.",
      "type": "string"
    },
    "EnvironmentId": {
      "description": "Strongly typed UUIDv7 identifier for `EnvironmentId`.",
      "type": "string"
    },
    "GpuRequest": {
      "additionalProperties": false,
      "description": "A policy-catalogued GPU class. It intentionally does not expose Kubernetes resource names.",
      "properties": {
        "class": {
          "type": "string"
        },
        "count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "class",
        "count"
      ],
      "type": "object"
    },
    "ProjectId": {
      "description": "Strongly typed UUIDv7 identifier for `ProjectId`.",
      "type": "string"
    },
    "ReleaseId": {
      "description": "Strongly typed UUIDv7 identifier for `ReleaseId`.",
      "type": "string"
    },
    "ResourceRequestId": {
      "description": "Strongly typed UUIDv7 identifier for `ResourceRequestId`.",
      "type": "string"
    },
    "ResourceRequestState": {
      "description": "Request lifecycle owned by Resource Service.",
      "enum": [
        "reviewing",
        "allocating",
        "active",
        "expiring",
        "expired",
        "rejected",
        "cancelled"
      ],
      "type": "string"
    },
    "ResourceTarget": {
      "additionalProperties": false,
      "description": "Immutable identity of a Resource request's target Work environment.",
      "properties": {
        "environmentId": {
          "$ref": "#/$defs/EnvironmentId"
        },
        "releaseId": {
          "$ref": "#/$defs/ReleaseId"
        },
        "releaseSha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "releaseVersion": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "environmentId",
        "releaseId",
        "releaseVersion",
        "releaseSha256"
      ],
      "type": "object"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "Sha256Digest": {
      "description": "Canonical lowercase SHA-256 digest.",
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "UtcTimestamp": {
      "description": "UTC timestamp serialized with a literal `Z` and millisecond precision.",
      "type": "string"
    },
    "WorkloadResources": {
      "additionalProperties": false,
      "description": "Requested or approved workload resources, independent of Kubernetes quantity syntax.",
      "properties": {
        "cpuMillicores": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "gpu": {
          "anyOf": [
            {
              "$ref": "#/$defs/GpuRequest"
            },
            {
              "type": "null"
            }
          ]
        },
        "memoryBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "storageBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "cpuMillicores",
        "memoryBytes",
        "storageBytes"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "PostgreSQL-authoritative request projection without provider internals.",
  "properties": {
    "courseId": {
      "$ref": "#/$defs/CourseId"
    },
    "createdAt": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "diagnosticCode": {
      "type": [
        "string",
        "null"
      ]
    },
    "generation": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "id": {
      "$ref": "#/$defs/ResourceRequestId"
    },
    "projectId": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProjectId"
        },
        {
          "type": "null"
        }
      ]
    },
    "requestKey": {
      "type": "string"
    },
    "requestedDurationSeconds": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "requestedResources": {
      "$ref": "#/$defs/WorkloadResources"
    },
    "requesterId": {
      "$ref": "#/$defs/ActorId"
    },
    "revision": {
      "$ref": "#/$defs/Revision"
    },
    "state": {
      "$ref": "#/$defs/ResourceRequestState"
    },
    "target": {
      "$ref": "#/$defs/ResourceTarget"
    },
    "updatedAt": {
      "$ref": "#/$defs/UtcTimestamp"
    }
  },
  "required": [
    "id",
    "generation",
    "requestKey",
    "requesterId",
    "courseId",
    "target",
    "requestedResources",
    "requestedDurationSeconds",
    "state",
    "revision",
    "createdAt",
    "updatedAt"
  ],
  "title": "ResourceRequest",
  "type": "object"
}
