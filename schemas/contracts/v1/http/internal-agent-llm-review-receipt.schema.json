{
  "$defs": {
    "AgentLlmReviewState": {
      "description": "Durable lifecycle of one internal advisory LLM review.",
      "enum": [
        "queued",
        "running",
        "cancelling",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "EvidenceLocation": {
      "additionalProperties": false,
      "description": "Bounded source location cited by an advisory finding.",
      "properties": {
        "end_line": {
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "type": "string"
        },
        "start_line": {
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "start_line",
        "end_line"
      ],
      "type": "object"
    },
    "FindingResult": {
      "description": "Advisory result for one rubric criterion.",
      "oneOf": [
        {
          "const": "met",
          "description": "The criterion is met.",
          "type": "string"
        },
        {
          "const": "partial",
          "description": "The criterion is partially met.",
          "type": "string"
        },
        {
          "const": "missing",
          "description": "Required evidence or work is missing.",
          "type": "string"
        },
        {
          "const": "unclear",
          "description": "Available evidence is unclear.",
          "type": "string"
        }
      ]
    },
    "GoalAssessment": {
      "description": "Overall advisory assessment of a submitted goal.",
      "oneOf": [
        {
          "const": "met",
          "description": "The goal is fully met according to the advisory rubric.",
          "type": "string"
        },
        {
          "const": "partially_met",
          "description": "The goal is only partially met.",
          "type": "string"
        },
        {
          "const": "not_met",
          "description": "The goal is not met.",
          "type": "string"
        },
        {
          "const": "insufficient_evidence",
          "description": "Evidence is insufficient for an advisory assessment.",
          "type": "string"
        }
      ]
    },
    "GoalFinding": {
      "additionalProperties": false,
      "description": "One advisory finding with bounded evidence locations.",
      "properties": {
        "criterion": {
          "maxLength": 1024,
          "minLength": 1,
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceLocation"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array"
        },
        "result": {
          "$ref": "#/$defs/FindingResult"
        },
        "suggestion": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "criterion",
        "result",
        "evidence",
        "suggestion"
      ],
      "type": "object"
    },
    "GoalReview": {
      "additionalProperties": false,
      "description": "Advisory-only review produced by an LLM backend.\n\nThis contract deliberately has no score or verdict field. Unknown fields are rejected during\ndeserialization so an LLM cannot smuggle protected scoring data into the review channel.",
      "properties": {
        "assessment": {
          "$ref": "#/$defs/GoalAssessment"
        },
        "confidence": {
          "format": "double",
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/GoalFinding"
          },
          "maxItems": 64,
          "type": "array"
        },
        "requires_teacher_attention": {
          "type": "boolean"
        },
        "schema_version": {
          "$ref": "#/$defs/GoalReviewSchemaVersion"
        }
      },
      "required": [
        "schema_version",
        "assessment",
        "confidence",
        "findings",
        "requires_teacher_attention"
      ],
      "type": "object"
    },
    "GoalReviewSchemaVersion": {
      "enum": [
        "goal-review/v1"
      ],
      "type": "string"
    },
    "LlmUsage": {
      "additionalProperties": false,
      "description": "Frozen LLM usage for one attempt.",
      "properties": {
        "costMicrousd": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "inputTokens": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "outputTokens": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "requests": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "inputTokens",
        "outputTokens",
        "requests",
        "costMicrousd"
      ],
      "type": "object"
    },
    "TaskRunId": {
      "description": "Strongly typed UUIDv7 identifier for `TaskRunId`.",
      "type": "string"
    },
    "UtcTimestamp": {
      "description": "UTC timestamp serialized with a literal `Z` and millisecond precision.",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Agent receipt for one advisory LLM review request.",
  "properties": {
    "diagnosticCode": {
      "type": [
        "string",
        "null"
      ]
    },
    "finishedAt": {
      "anyOf": [
        {
          "$ref": "#/$defs/UtcTimestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "requestSha256": {
      "type": "string"
    },
    "review": {
      "anyOf": [
        {
          "$ref": "#/$defs/GoalReview"
        },
        {
          "type": "null"
        }
      ],
      "description": "Advisory review output. It is present only for `succeeded` receipts and has no score."
    },
    "startedAt": {
      "anyOf": [
        {
          "$ref": "#/$defs/UtcTimestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "$ref": "#/$defs/AgentLlmReviewState"
    },
    "taskRunId": {
      "$ref": "#/$defs/TaskRunId"
    },
    "usage": {
      "anyOf": [
        {
          "$ref": "#/$defs/LlmUsage"
        },
        {
          "type": "null"
        }
      ],
      "description": "Provider usage is absent when the provider did not expose a trustworthy usage envelope."
    }
  },
  "required": [
    "taskRunId",
    "requestSha256",
    "state"
  ],
  "title": "InternalAgentLlmReviewReceipt",
  "type": "object"
}
