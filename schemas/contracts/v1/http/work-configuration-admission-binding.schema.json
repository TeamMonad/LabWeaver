{
  "$defs": {
    "ActorId": {
      "description": "Strongly typed UUIDv7 identifier for `ActorId`.",
      "type": "string"
    },
    "AgentRunId": {
      "description": "Strongly typed UUIDv7 identifier for `AgentRunId`.",
      "type": "string"
    },
    "AgentRunState": {
      "description": "Aggregate AgentRun state derived from both tracks.",
      "enum": [
        "requested",
        "running",
        "partially_succeeded",
        "succeeded",
        "awaiting_approval",
        "failed",
        "cancelling",
        "cancelled"
      ],
      "type": "string"
    },
    "ArtifactId": {
      "description": "Strongly typed UUIDv7 identifier for `ArtifactId`.",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Immutable object-store identity without a machine-local path or credential.",
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/ArtifactId",
          "description": "Stable metadata identity resolved by the owning service."
        },
        "mediaType": {
          "description": "Registered media type.",
          "type": "string"
        },
        "objectVersion": {
          "description": "Immutable backend object version.",
          "type": "string"
        },
        "sizeBytes": {
          "description": "Raw object length.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "storeBinding": {
          "description": "Explicit object-store binding from deployment configuration.",
          "type": "string"
        }
      },
      "required": [
        "artifactId",
        "storeBinding",
        "objectVersion",
        "sizeBytes",
        "mediaType"
      ],
      "type": "object"
    },
    "CourseId": {
      "description": "Strongly typed UUIDv7 identifier for `CourseId`.",
      "type": "string"
    },
    "EnvironmentId": {
      "description": "Strongly typed UUIDv7 identifier for `EnvironmentId`.",
      "type": "string"
    },
    "ProjectId": {
      "description": "Strongly typed UUIDv7 identifier for `ProjectId`.",
      "type": "string"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "UtcTimestamp": {
      "description": "UTC timestamp serialized with a literal `Z` and millisecond precision.",
      "type": "string"
    },
    "WorkConfigurationPlan": {
      "additionalProperties": false,
      "description": "Immutable generated configuration plan for one existing Work environment.",
      "properties": {
        "environmentId": {
          "$ref": "#/$defs/EnvironmentId"
        },
        "environmentRevision": {
          "$ref": "#/$defs/Revision"
        },
        "id": {
          "$ref": "#/$defs/WorkConfigurationPlanId"
        },
        "requiresRestart": {
          "type": "boolean"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "scriptArtifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "summary": {
          "type": "string"
        },
        "verificationScriptArtifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "revision",
        "scriptArtifact",
        "summary",
        "requiresRestart",
        "environmentId",
        "environmentRevision"
      ],
      "type": "object"
    },
    "WorkConfigurationPlanId": {
      "description": "Strongly typed UUIDv7 identifier for `WorkConfigurationPlanId`.",
      "type": "string"
    },
    "WorkConfigurationPreauthorization": {
      "additionalProperties": false,
      "description": "Concrete per-Work grant for executing one exact immutable configuration plan.\n\nThe grant binds both script artifacts and the plan revision. It therefore cannot authorize a\nnewly generated script, a changed verification script, or a plan whose restart requirement was\naltered after approval.",
      "properties": {
        "actorId": {
          "$ref": "#/$defs/ActorId"
        },
        "environmentId": {
          "$ref": "#/$defs/EnvironmentId"
        },
        "environmentRevision": {
          "$ref": "#/$defs/Revision"
        },
        "expiresAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "id": {
          "$ref": "#/$defs/WorkConfigurationPreauthorizationId"
        },
        "planId": {
          "$ref": "#/$defs/WorkConfigurationPlanId"
        },
        "planRevision": {
          "$ref": "#/$defs/Revision"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectId"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "scriptArtifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "verificationScriptArtifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "projectId",
        "environmentId",
        "environmentRevision",
        "actorId",
        "planId",
        "planRevision",
        "scriptArtifact",
        "expiresAt",
        "revision"
      ],
      "type": "object"
    },
    "WorkConfigurationPreauthorizationId": {
      "description": "Strongly typed UUIDv7 identifier for `WorkConfigurationPreauthorizationId`.",
      "type": "string"
    },
    "WorkConfigurationRecoveryIdentity": {
      "additionalProperties": false,
      "description": "Exact persisted VM execution identity returned with a Work admission binding during recovery.",
      "properties": {
        "executionId": {
          "type": "string"
        },
        "planId": {
          "$ref": "#/$defs/WorkConfigurationPlanId"
        },
        "planRevision": {
          "$ref": "#/$defs/Revision"
        },
        "sourceIdentity": {
          "description": "Persistent VM target UID that Environment must match before issuing a certificate.",
          "type": "string"
        }
      },
      "required": [
        "executionId",
        "planId",
        "planRevision",
        "sourceIdentity"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Control-owned Work configuration admission facts returned to a trusted downstream consumer.\n\nThe optional plan and preauthorization are retained as their complete immutable contracts so the\nconsumer can enforce exact artifact and expiry bindings without reconstructing Agent state.",
  "properties": {
    "actorId": {
      "$ref": "#/$defs/ActorId"
    },
    "courseId": {
      "anyOf": [
        {
          "$ref": "#/$defs/CourseId"
        },
        {
          "type": "null"
        }
      ]
    },
    "environmentId": {
      "$ref": "#/$defs/EnvironmentId"
    },
    "environmentRevision": {
      "$ref": "#/$defs/Revision"
    },
    "plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorkConfigurationPlan"
        },
        {
          "type": "null"
        }
      ]
    },
    "preauthorization": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorkConfigurationPreauthorization"
        },
        {
          "type": "null"
        }
      ]
    },
    "projectId": {
      "$ref": "#/$defs/ProjectId"
    },
    "recovery": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorkConfigurationRecoveryIdentity"
        },
        {
          "type": "null"
        }
      ],
      "description": "Present only when the admission is resuming an existing persisted VM execution."
    },
    "runId": {
      "$ref": "#/$defs/AgentRunId"
    },
    "runRevision": {
      "$ref": "#/$defs/Revision"
    },
    "scriptSha256": {
      "description": "SHA-256 digest of the exact script bytes returned by the plan endpoint.",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/AgentRunState"
    },
    "verificationScriptSha256": {
      "description": "SHA-256 digest of the optional verification script bytes.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "runId",
    "projectId",
    "environmentId",
    "environmentRevision",
    "actorId",
    "runRevision",
    "state",
    "scriptSha256"
  ],
  "title": "WorkConfigurationAdmissionBinding",
  "type": "object"
}
