    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Revision-fenced project metadata mutation.",
  "properties": {
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "expectedRevision": {
      "$ref": "#/$defs/Revision"
    },
    "name": {
      "type": "string"
    }
  },
  "required": [
    "expectedRevision",
    "name"
  ],
  "title": "UpdateProjectRequest",
  "type": "object"
}
