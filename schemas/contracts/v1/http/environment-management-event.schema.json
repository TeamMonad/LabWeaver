{
  "$defs": {
    "AccessGrantId": {
      "description": "Strongly typed UUIDv7 identifier for `AccessGrantId`.",
      "type": "string"
    },
    "AccessGrantState": {
      "description": "AccessGrant lifecycle.",
      "enum": [
        "requested",
        "active",
        "denied",
        "expired",
        "revoked"
      ],
      "type": "string"
    },
    "CourseId": {
      "description": "Strongly typed UUIDv7 identifier for `CourseId`.",
      "type": "string"
    },
    "EnvironmentId": {
      "description": "Strongly typed UUIDv7 identifier for `EnvironmentId`.",
      "type": "string"
    },
    "EnvironmentManagementEvent": {
      "description": "Environment-management subset carried by the course event stream.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "environmentId": {
              "$ref": "#/$defs/EnvironmentId"
            },
            "kind": {
              "const": "environment_changed",
              "type": "string"
            },
            "observedState": {
              "$ref": "#/$defs/ObservedEnvironmentState"
            },
            "operationId": {
              "anyOf": [
                {
                  "$ref": "#/$defs/OperationId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "revision": {
              "$ref": "#/$defs/Revision"
            }
          },
          "required": [
            "kind",
            "environmentId",
            "revision",
            "observedState"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "environmentId": {
              "$ref": "#/$defs/EnvironmentId"
            },
            "kind": {
              "const": "operation_changed",
              "type": "string"
            },
            "operationId": {
              "$ref": "#/$defs/OperationId"
            },
            "revision": {
              "$ref": "#/$defs/Revision"
            },
            "state": {
              "$ref": "#/$defs/EnvironmentOperationStatus"
            }
          },
          "required": [
            "kind",
            "environmentId",
            "operationId",
            "revision",
            "state"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "accessGrantId": {
              "$ref": "#/$defs/AccessGrantId"
            },
            "environmentId": {
              "$ref": "#/$defs/EnvironmentId"
            },
            "kind": {
              "const": "access_grant_changed",
              "type": "string"
            },
            "revision": {
              "$ref": "#/$defs/Revision"
            },
            "state": {
              "$ref": "#/$defs/AccessGrantState"
            }
          },
          "required": [
            "kind",
            "environmentId",
            "accessGrantId",
            "revision",
            "state"
          ],
          "type": "object"
        }
      ]
    },
    "EnvironmentManagementStreamEvent": {
      "additionalProperties": false,
      "description": "Public event envelope used for course-scoped inventory synchronization.",
      "properties": {
        "courseId": {
          "$ref": "#/$defs/CourseId"
        },
        "data": {
          "$ref": "#/$defs/EnvironmentManagementEvent"
        },
        "effectiveAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "eventId": {
          "$ref": "#/$defs/EventId"
        },
        "projectId": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProjectId"
            },
            {
              "type": "null"
            }
          ]
        },
        "streamSequence": {
          "$ref": "#/$defs/StreamSequence"
        }
      },
      "required": [
        "eventId",
        "streamSequence",
        "courseId",
        "effectiveAt",
        "data"
      ],
      "type": "object"
    },
    "EnvironmentOperationStatus": {
      "description": "Public operation state used by REST snapshots and SSE projections.\n\nThe runtime aggregate retains its historical `OperationState`; timeout is exposed as a\ndistinct terminal fact instead of forcing clients to infer it from a generic failure code.",
      "enum": [
        "accepted",
        "running",
        "cancelling",
        "succeeded",
        "failed",
        "cancelled",
        "timed_out"
      ],
      "type": "string"
    },
    "EventId": {
      "description": "Strongly typed UUIDv7 identifier for `EventId`.",
      "type": "string"
    },
    "ObservedEnvironmentState": {
      "description": "Authoritative observed lifecycle state.",
      "enum": [
        "requested",
        "validating",
        "building",
        "provisioning",
        "ready",
        "stopping",
        "stopped",
        "updating",
        "expiring",
        "deleting",
        "deleted",
        "failed"
      ],
      "type": "string"
    },
    "OperationId": {
      "description": "Strongly typed UUIDv7 identifier for `OperationId`.",
      "type": "string"
    },
    "ProjectId": {
      "description": "Strongly typed UUIDv7 identifier for `ProjectId`.",
      "type": "string"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "StreamSequence": {
      "format": "uint64-decimal",
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])$",
      "type": "string"
    },
    "UtcTimestamp": {
      "description": "UTC timestamp serialized with a literal `Z` and millisecond precision.",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cursor": {
      "$ref": "#/$defs/StreamSequence"
    },
    "data": {
      "$ref": "#/$defs/EnvironmentManagementStreamEvent"
    },
    "event": {
      "type": "string"
    }
  },
  "required": [
    "cursor",
    "event",
    "data"
  ],
  "title": "SseEvent",
  "type": "object"
}
