{
  "$defs": {
    "ActorId": {
      "description": "Strongly typed UUIDv7 identifier for `ActorId`.",
      "type": "string"
    },
    "AgentLlmReviewFile": {
      "additionalProperties": false,
      "description": "One UTF-8 submission file included in a bounded internal advisory review request.",
      "properties": {
        "content": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "description": "SHA-256 of the exact UTF-8 bytes in `content`, verified by Agent before provider egress.",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "content"
      ],
      "type": "object"
    },
    "AgentLlmReviewRubric": {
      "additionalProperties": false,
      "description": "The immutable rubric object and its exact UTF-8 content for one advisory review.",
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "content": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "description": "SHA-256 of the exact UTF-8 bytes in `content`, verified by Agent before provider egress.",
          "type": "string"
        }
      },
      "required": [
        "artifact",
        "path",
        "sha256",
        "content"
      ],
      "type": "object"
    },
    "ArtifactId": {
      "description": "Strongly typed UUIDv7 identifier for `ArtifactId`.",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Immutable object-store identity without a machine-local path or credential.",
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/ArtifactId",
          "description": "Stable metadata identity resolved by the owning service."
        },
        "mediaType": {
          "description": "Registered media type.",
          "type": "string"
        },
        "objectVersion": {
          "description": "Immutable backend object version.",
          "type": "string"
        },
        "sizeBytes": {
          "description": "Raw object length.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "storeBinding": {
          "description": "Explicit object-store binding from deployment configuration.",
          "type": "string"
        }
      },
      "required": [
        "artifactId",
        "storeBinding",
        "objectVersion",
        "sizeBytes",
        "mediaType"
      ],
      "type": "object"
    },
    "BuildRequestId": {
      "description": "Strongly typed UUIDv7 identifier for `BuildRequestId`.",
      "type": "string"
    },
    "ClaudeCodeBindingV1": {
      "additionalProperties": false,
      "description": "Immutable Claude Code worker binding.\n\nProvider-specific transport and authentication remain deployment-owned Claude Code\nconfiguration. The contract binds only a sanitized profile identity, exact model, CLI version,\nworker image, effective non-secret runtime configuration hash, and per-worker admission limit.",
      "properties": {
        "claudeCodeVersion": {
          "description": "Exact Claude Code CLI version baked into the worker image.",
          "type": "string"
        },
        "maxInFlightPerWorker": {
          "description": "Maximum concurrent Claude Code child processes admitted by one worker instance.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "model": {
          "description": "Exact model identifier passed to Claude Code; moving aliases are rejected.",
          "type": "string"
        },
        "runtimeBinding": {
          "description": "Deployment-owned opaque runtime profile; never a credential or endpoint URL.",
          "type": "string"
        }
      },
      "required": [
        "runtimeBinding",
        "model",
        "claudeCodeVersion",
        "maxInFlightPerWorker"
      ],
      "type": "object"
    },
    "CourseId": {
      "description": "Strongly typed UUIDv7 identifier for `CourseId`.",
      "type": "string"
    },
    "DeniedDataClass": {
      "description": "Non-overridable content classifications at the LLM boundary.",
      "enum": [
        "secret",
        "token",
        "private_key",
        "personally_identifiable_information",
        "unallowlisted_student_submission"
      ],
      "type": "string"
    },
    "EnvironmentId": {
      "description": "Strongly typed UUIDv7 identifier for `EnvironmentId`.",
      "type": "string"
    },
    "EvaluationReleaseId": {
      "description": "Strongly typed UUIDv7 identifier for `EvaluationReleaseId`.",
      "type": "string"
    },
    "FrozenEnvironmentIdentity": {
      "additionalProperties": false,
      "description": "Frozen build and runtime identity used to reproduce collection.",
      "properties": {
        "buildRequestId": {
          "anyOf": [
            {
              "$ref": "#/$defs/BuildRequestId"
            },
            {
              "type": "null"
            }
          ]
        },
        "environmentId": {
          "$ref": "#/$defs/EnvironmentId"
        },
        "environmentRevision": {
          "$ref": "#/$defs/Revision"
        },
        "releaseId": {
          "$ref": "#/$defs/ReleaseId"
        },
        "releaseVersion": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "runtimeKind": {
          "$ref": "#/$defs/RuntimeKind"
        }
      },
      "required": [
        "environmentId",
        "environmentRevision",
        "releaseId",
        "releaseVersion",
        "runtimeKind"
      ],
      "type": "object"
    },
    "FrozenSubmissionId": {
      "description": "Strongly typed UUIDv7 identifier for `FrozenSubmissionId`.",
      "type": "string"
    },
    "LlmBudget": {
      "additionalProperties": false,
      "description": "Per-attempt bounded LLM budget.",
      "properties": {
        "maxCostMicrousd": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "maxInputTokens": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "maxOutputTokens": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "maxRequests": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "maxSchemaRepairs": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "maxTransientRetries": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "timeoutMilliseconds": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "maxInputTokens",
        "maxOutputTokens",
        "maxRequests",
        "maxCostMicrousd",
        "timeoutMilliseconds",
        "maxTransientRetries",
        "maxSchemaRepairs"
      ],
      "type": "object"
    },
    "ModelInputAuthorizationBinding": {
      "additionalProperties": false,
      "description": "Control-derived asynchronous recheck input, never accepted from a public create request.",
      "properties": {
        "actorId": {
          "$ref": "#/$defs/ActorId"
        },
        "courseId": {
          "anyOf": [
            {
              "$ref": "#/$defs/CourseId"
            },
            {
              "type": "null"
            }
          ]
        },
        "operationId": {
          "type": "string"
        },
        "policyId": {
          "$ref": "#/$defs/PolicyId"
        },
        "policyRevision": {
          "$ref": "#/$defs/Revision"
        },
        "policySha256": {
          "type": "string"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectId"
        },
        "selectionSha256": {
          "type": "string"
        },
        "sessionSha256": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/ModelInputAuthorizationSource"
        },
        "validUntil": {
          "$ref": "#/$defs/UtcTimestamp"
        }
      },
      "required": [
        "sessionSha256",
        "actorId",
        "projectId",
        "operationId",
        "validUntil",
        "source",
        "policyId",
        "policyRevision",
        "policySha256",
        "selectionSha256"
      ],
      "type": "object"
    },
    "ModelInputAuthorizationSource": {
      "description": "A freeze identifier cannot be interpreted as a material package identifier.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "problem_package",
              "type": "string"
            },
            "packageId": {
              "$ref": "#/$defs/ProblemPackageId"
            },
            "packageRevision": {
              "$ref": "#/$defs/Revision"
            }
          },
          "required": [
            "kind",
            "packageId",
            "packageRevision"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Immutable freeze identities; Evaluation and Environment releases are distinct.",
          "properties": {
            "archive": {
              "$ref": "#/$defs/ArtifactRef"
            },
            "contentSha256": {
              "type": "string"
            },
            "environment": {
              "$ref": "#/$defs/FrozenEnvironmentIdentity"
            },
            "evaluationReleaseId": {
              "$ref": "#/$defs/EvaluationReleaseId"
            },
            "evaluationReleaseRevision": {
              "$ref": "#/$defs/Revision"
            },
            "frozenSubmissionId": {
              "$ref": "#/$defs/FrozenSubmissionId"
            },
            "kind": {
              "const": "frozen_submission",
              "type": "string"
            },
            "manifestRevision": {
              "$ref": "#/$defs/Revision"
            },
            "manifestSha256": {
              "type": "string"
            },
            "parentLeaseSha256": {
              "description": "SHA of the original Evaluation worker lease; never refreshed on recovery.",
              "type": "string"
            },
            "rubric": {
              "$ref": "#/$defs/ModelInputRubricIdentity"
            },
            "rubricPermission": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ModelInputRubricPermissionRef"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Missing permission is representable for a refusal, never for model egress."
            },
            "stepId": {
              "description": "Advisory step resolved from the protected task ledger, not inferred from selected files.",
              "type": "string"
            },
            "taskRunId": {
              "$ref": "#/$defs/TaskRunId"
            }
          },
          "required": [
            "kind",
            "taskRunId",
            "stepId",
            "parentLeaseSha256",
            "frozenSubmissionId",
            "manifestRevision",
            "manifestSha256",
            "archive",
            "contentSha256",
            "evaluationReleaseId",
            "evaluationReleaseRevision",
            "environment",
            "rubric"
          ],
          "type": "object"
        }
      ]
    },
    "ModelInputRubricIdentity": {
      "additionalProperties": false,
      "description": "Control-derived asynchronous recheck input, never accepted from a public create request.",
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "packageId": {
          "$ref": "#/$defs/ProblemPackageId"
        },
        "packageRevision": {
          "$ref": "#/$defs/Revision"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "packageId",
        "packageRevision",
        "path",
        "artifact",
        "sha256"
      ],
      "type": "object"
    },
    "ModelInputRubricPermissionRef": {
      "additionalProperties": false,
      "description": "References Control's current material-project policy and the approving instructor fact.",
      "properties": {
        "approvedBy": {
          "$ref": "#/$defs/ActorId"
        },
        "approverCourseMembershipRevision": {
          "$ref": "#/$defs/Revision"
        },
        "authoringProjectId": {
          "$ref": "#/$defs/ProjectId"
        },
        "policyId": {
          "$ref": "#/$defs/PolicyId"
        },
        "policyRevision": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "authoringProjectId",
        "policyId",
        "policyRevision",
        "approvedBy",
        "approverCourseMembershipRevision"
      ],
      "type": "object"
    },
    "PolicyId": {
      "description": "Strongly typed UUIDv7 identifier for `PolicyId`.",
      "type": "string"
    },
    "ProblemPackageId": {
      "description": "Strongly typed UUIDv7 identifier for `ProblemPackageId`.",
      "type": "string"
    },
    "ProjectId": {
      "description": "Strongly typed UUIDv7 identifier for `ProjectId`.",
      "type": "string"
    },
    "ProjectLlmEgressPolicy": {
      "additionalProperties": false,
      "description": "Versioned project policy governing all LLM egress. A course is optional teaching context.",
      "properties": {
        "activatedAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "binding": {
          "$ref": "#/$defs/ClaudeCodeBindingV1"
        },
        "budget": {
          "$ref": "#/$defs/LlmBudget"
        },
        "courseId": {
          "anyOf": [
            {
              "$ref": "#/$defs/CourseId"
            },
            {
              "type": "null"
            }
          ]
        },
        "deniedDataClasses": {
          "items": {
            "$ref": "#/$defs/DeniedDataClass"
          },
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/PolicyId"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectId"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "studentContentMode": {
          "$ref": "#/$defs/StudentContentMode"
        }
      },
      "required": [
        "id",
        "projectId",
        "revision",
        "binding",
        "budget",
        "deniedDataClasses",
        "studentContentMode",
        "activatedAt"
      ],
      "type": "object"
    },
    "ReleaseId": {
      "description": "Strongly typed UUIDv7 identifier for `ReleaseId`.",
      "type": "string"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "RuntimeKind": {
      "description": "Runtime kind shared by candidates, releases, and instances.",
      "enum": [
        "container",
        "virtual_machine"
      ],
      "type": "string"
    },
    "StudentContentMode": {
      "description": "Only explicit SubmissionManifest paths may disclose student content.",
      "enum": [
        "manifest_allowlist_only"
      ],
      "type": "string"
    },
    "TaskRunId": {
      "description": "Strongly typed UUIDv7 identifier for `TaskRunId`.",
      "type": "string"
    },
    "UtcTimestamp": {
      "description": "UTC timestamp serialized with a literal `Z` and millisecond precision.",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Evaluation-to-Agent request for one bounded, advisory-only LLM review.",
  "properties": {
    "courseId": {
      "anyOf": [
        {
          "$ref": "#/$defs/CourseId"
        },
        {
          "type": "null"
        }
      ]
    },
    "deadlineAt": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/AgentLlmReviewFile"
      },
      "type": "array"
    },
    "frozenSubmissionId": {
      "$ref": "#/$defs/FrozenSubmissionId"
    },
    "inputAuthorization": {
      "$ref": "#/$defs/ModelInputAuthorizationBinding"
    },
    "policy": {
      "$ref": "#/$defs/ProjectLlmEgressPolicy"
    },
    "projectId": {
      "$ref": "#/$defs/ProjectId"
    },
    "rubric": {
      "$ref": "#/$defs/AgentLlmReviewRubric"
    },
    "submissionArtifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "taskRunId": {
      "$ref": "#/$defs/TaskRunId"
    }
  },
  "required": [
    "inputAuthorization",
    "taskRunId",
    "projectId",
    "frozenSubmissionId",
    "submissionArtifact",
    "policy",
    "files",
    "rubric",
    "deadlineAt"
  ],
  "title": "InternalAgentLlmReviewRequest",
  "type": "object"
}
