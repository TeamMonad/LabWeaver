{
  "$defs": {
    "PolicyId": {
      "description": "Strongly typed UUIDv7 identifier for `PolicyId`.",
      "type": "string"
    },
    "ProblemPackageId": {
      "description": "Strongly typed UUIDv7 identifier for `ProblemPackageId`.",
      "type": "string"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "RuntimeKind": {
      "description": "Runtime kind shared by candidates, releases, and instances.",
      "enum": [
        "container",
        "virtual_machine"
      ],
      "type": "string"
    },
    "Sha256Digest": {
      "description": "Canonical lowercase SHA-256 digest.",
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "packageId": {
      "$ref": "#/$defs/ProblemPackageId"
    },
    "packageRevision": {
      "$ref": "#/$defs/Revision"
    },
    "packageSha256": {
      "$ref": "#/$defs/Sha256Digest"
    },
    "policyId": {
      "$ref": "#/$defs/PolicyId"
    },
    "policyRevision": {
      "$ref": "#/$defs/Revision"
    },
    "requestedRuntime": {
      "$ref": "#/$defs/RuntimeKind"
    }
  },
  "required": [
    "packageId",
    "packageRevision",
    "packageSha256",
    "policyId",
    "policyRevision",
    "requestedRuntime"
