{
  "$defs": {
    "AccessGrantId": {
      "description": "Strongly typed UUIDv7 identifier for `AccessGrantId`.",
      "type": "string"
    },
    "AccessGrantSnapshot": {
      "additionalProperties": false,
      "description": "Actor-scoped AccessGrant snapshot used by Environment discovery APIs.",
      "properties": {
        "decision": {
          "$ref": "#/$defs/AuthorizationDecisionSummary"
        },
        "endpointGrants": {
          "items": {
            "$ref": "#/$defs/EndpointGrantSnapshot"
          },
          "type": "array"
        },
        "environmentId": {
          "$ref": "#/$defs/EnvironmentId"
        },
        "environmentRevision": {
          "$ref": "#/$defs/Revision"
        },
        "expiresAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "id": {
          "$ref": "#/$defs/AccessGrantId"
        },
        "issuedAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "lastChangedStreamSequence": {
          "$ref": "#/$defs/StreamSequence"
        },
        "reasonCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "revokedAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtcTimestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "$ref": "#/$defs/AccessGrantState"
        }
      },
      "required": [
        "id",
        "environmentId",
        "environmentRevision",
        "state",
        "revision",
        "endpointGrants",
        "issuedAt",
        "expiresAt",
        "decision",
        "lastChangedStreamSequence"
      ],
      "type": "object"
    },
    "AccessGrantState": {
      "description": "AccessGrant lifecycle.",
      "enum": [
        "requested",
        "active",
        "denied",
        "expired",
        "revoked"
      ],
      "type": "string"
    },
    "AuthorizationDecision": {
      "description": "Safe authorization result suitable for a console timeline.",
      "enum": [
        "allow",
        "deny",
        "terminal"
      ],
      "type": "string"
    },
    "AuthorizationDecisionSummary": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "$ref": "#/$defs/AuthorizationDecision"
        },
        "evaluatedAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "reasonCode": {
          "type": "string"
        }
      },
      "required": [
        "decision",
        "reasonCode",
        "evaluatedAt"
      ],
      "type": "object"
    },
    "EndpointGrantId": {
      "description": "Strongly typed UUIDv7 identifier for `EndpointGrantId`.",
      "type": "string"
    },
    "EndpointGrantSnapshot": {
      "additionalProperties": false,
      "description": "EndpointGrant projection without host, port, credential, or policy internals.",
      "properties": {
        "alias": {
          "type": [
            "string",
            "null"
          ]
        },
        "endpointId": {
          "$ref": "#/$defs/EndpointId"
        },
        "endpointRevision": {
          "$ref": "#/$defs/Revision"
        },
        "expiresAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "id": {
          "$ref": "#/$defs/EndpointGrantId"
        },
        "protocol": {
          "$ref": "#/$defs/EndpointProtocol"
        },
        "state": {
          "$ref": "#/$defs/EndpointGrantSnapshotState"
        }
      },
      "required": [
        "id",
        "endpointId",
        "endpointRevision",
        "protocol",
        "state",
        "expiresAt"
      ],
      "type": "object"
    },
    "EndpointGrantSnapshotState": {
      "description": "Effective endpoint grant state exposed to the current actor.",
      "enum": [
        "active",
        "expired",
        "revoked",
        "unhealthy"
      ],
      "type": "string"
    },
    "EndpointId": {
      "description": "Strongly typed UUIDv7 identifier for `EndpointId`.",
      "type": "string"
    },
    "EndpointProtocol": {
      "description": "Supported controlled protocols.",
      "enum": [
        "http",
        "https",
        "ssh"
      ],
      "type": "string"
    },
    "EnvironmentId": {
      "description": "Strongly typed UUIDv7 identifier for `EnvironmentId`.",
      "type": "string"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "StreamSequence": {
      "format": "uint64-decimal",
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])$",
      "type": "string"
    },
    "UtcTimestamp": {
      "description": "UTC timestamp serialized with a literal `Z` and millisecond precision.",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Cursor page bound to one consistent REST/SSE snapshot.",
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/AccessGrantSnapshot"
      },
      "type": "array"
    },
    "nextCursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "snapshotAt": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "snapshotSequence": {
      "$ref": "#/$defs/StreamSequence"
    }
  },
  "required": [
    "items",
    "snapshotSequence",
    "snapshotAt"
  ],
  "title": "SnapshotPage",
  "type": "object"
}
