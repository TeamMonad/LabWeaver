{
  "$defs": {
    "ArtifactId": {
      "description": "Strongly typed UUIDv7 identifier for `ArtifactId`.",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Immutable object-store identity without a machine-local path or credential.",
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/ArtifactId",
          "description": "Stable metadata identity resolved by the owning service."
        },
        "mediaType": {
          "description": "Registered media type.",
          "type": "string"
        },
        "objectVersion": {
          "description": "Immutable backend object version.",
          "type": "string"
        },
        "sizeBytes": {
          "description": "Raw object length.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "storeBinding": {
          "description": "Explicit object-store binding from deployment configuration.",
          "type": "string"
        }
      },
      "required": [
        "artifactId",
        "storeBinding",
        "objectVersion",
        "sizeBytes",
        "mediaType"
      ],
      "type": "object"
    },
    "CourseId": {
      "description": "Strongly typed UUIDv7 identifier for `CourseId`.",
      "type": "string"
    },
    "GeneratedArtifactKind": {
      "description": "Immutable output class recorded by Agent for generated objects.",
      "enum": [
        "build_context",
        "work_script",
        "verification_script"
      ],
      "type": "string"
    },
    "ProblemPackageId": {
      "description": "Strongly typed UUIDv7 identifier for `ProblemPackageId`.",
      "type": "string"
    },
    "ProjectId": {
      "description": "Strongly typed UUIDv7 identifier for `ProjectId`.",
      "type": "string"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Agent-owned immutable generated-artifact metadata returned to a trusted service caller.",
  "properties": {
    "artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "contentSha256": {
      "type": "string"
    },
    "courseId": {
      "anyOf": [
        {
          "$ref": "#/$defs/CourseId"
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "$ref": "#/$defs/GeneratedArtifactKind"
    },
    "objectKey": {
      "type": "string"
    },
    "packageId": {
      "$ref": "#/$defs/ProblemPackageId"
    },
    "packageRevision": {
      "$ref": "#/$defs/Revision"
    },
    "projectId": {
      "$ref": "#/$defs/ProjectId"
    }
  },
  "required": [
    "artifact",
    "projectId",
    "packageId",
    "packageRevision",
    "kind",
    "objectKey",
    "contentSha256"
  ],
  "title": "GeneratedArtifactRecord",
  "type": "object"
}
