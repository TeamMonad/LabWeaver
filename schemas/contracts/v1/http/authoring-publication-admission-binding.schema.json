  "properties": {
    "approvalId": {
      "$ref": "#/$defs/ApprovalId"
    },
    "approvalRevision": {
      "$ref": "#/$defs/Revision"
    },
    "courseId": {
      "anyOf": [
        {
          "$ref": "#/$defs/CourseId"
        },
        {
          "type": "null"
        }
      ]
    },
    "environmentReleaseId": {
      "$ref": "#/$defs/ReleaseId"
    },
    "environmentReleaseVersion": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "evaluationReleaseId": {
      "$ref": "#/$defs/EvaluationReleaseId"
    },
    "evaluationReleaseRevision": {
      "$ref": "#/$defs/Revision"
    },
    "projectId": {
      "$ref": "#/$defs/ProjectId"
    }
  },
  "required": [
    "approvalId",
    "approvalRevision",
    "projectId",
    "environmentReleaseId",
    "environmentReleaseVersion",
    "evaluationReleaseId",
    "evaluationReleaseRevision"
