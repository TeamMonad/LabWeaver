{
  "$defs": {
    "ActorId": {
      "description": "Strongly typed UUIDv7 identifier for `ActorId`.",
      "type": "string"
    },
    "AgentRunPurpose": {
      "description": "Immutable purpose selected by Control for one Agent run.\n\nThe purpose is authoritative: callers cannot substitute an environment class, target\nenvironment, actor, or runtime through an untyped request field. Authoring creates a new\nEnvironment/Evaluation package, while WorkConfiguration targets one existing Work environment\nand produces one configuration plan.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "environmentClass": {
              "$ref": "#/$defs/EnvironmentClass"
            },
            "kind": {
              "const": "authoring",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "environmentClass"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "actorId": {
              "$ref": "#/$defs/ActorId"
            },
            "environmentId": {
              "$ref": "#/$defs/EnvironmentId"
            },
            "environmentRevision": {
              "$ref": "#/$defs/Revision"
            },
            "kind": {
              "const": "work_configuration",
              "type": "string"
            },
            "runtimeKind": {
              "$ref": "#/$defs/RuntimeKind",
              "description": "Runtime selected by the authoritative Work environment.\n\nControl resolves this value from the environment instance before dispatching the\nrun. Agent uses it as the immutable execution routing key, so a missing or altered\nruntime cannot silently select a different executor."
            }
          },
          "required": [
            "kind",
            "environmentId",
            "environmentRevision",
            "actorId",
            "runtimeKind"
          ],
          "type": "object"
        }
      ]
    },
    "ArtifactId": {
      "description": "Strongly typed UUIDv7 identifier for `ArtifactId`.",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Immutable object-store identity without a machine-local path or credential.",
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/ArtifactId",
          "description": "Stable metadata identity resolved by the owning service."
        },
        "mediaType": {
          "description": "Registered media type.",
          "type": "string"
        },
        "objectVersion": {
          "description": "Immutable backend object version.",
          "type": "string"
        },
        "sizeBytes": {
          "description": "Raw object length.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "storeBinding": {
          "description": "Explicit object-store binding from deployment configuration.",
          "type": "string"
        }
      },
      "required": [
        "artifactId",
        "storeBinding",
        "objectVersion",
        "sizeBytes",
        "mediaType"
      ],
      "type": "object"
    },
    "ClaudeCodeBindingV1": {
      "additionalProperties": false,
      "description": "Immutable Claude Code worker binding.\n\nProvider-specific transport and authentication remain deployment-owned Claude Code\nconfiguration. The contract binds only a sanitized profile identity, exact model, CLI version,\nworker image, effective non-secret runtime configuration hash, and per-worker admission limit.",
      "properties": {
        "claudeCodeVersion": {
          "description": "Exact Claude Code CLI version baked into the worker image.",
          "type": "string"
        },
        "maxInFlightPerWorker": {
          "description": "Maximum concurrent Claude Code child processes admitted by one worker instance.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "model": {
          "description": "Exact model identifier passed to Claude Code; moving aliases are rejected.",
          "type": "string"
        },
        "runtimeBinding": {
          "description": "Deployment-owned opaque runtime profile; never a credential or endpoint URL.",
          "type": "string"
        }
      },
      "required": [
        "runtimeBinding",
        "model",
        "claudeCodeVersion",
        "maxInFlightPerWorker"
      ],
      "type": "object"
    },
    "CourseId": {
      "description": "Strongly typed UUIDv7 identifier for `CourseId`.",
      "type": "string"
    },
    "CreateAgentRunRequest": {
      "additionalProperties": false,
      "properties": {
        "courseId": {
          "anyOf": [
            {
              "$ref": "#/$defs/CourseId"
            },
            {
              "type": "null"
            }
          ]
        },
        "environmentClass": {
          "$ref": "#/$defs/EnvironmentClass"
        },
        "packageId": {
          "$ref": "#/$defs/ProblemPackageId"
        },
        "packageRevision": {
          "$ref": "#/$defs/Revision"
        },
        "policyId": {
          "$ref": "#/$defs/PolicyId"
        },
        "policyRevision": {
          "$ref": "#/$defs/Revision"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectId"
        }
      },
      "required": [
        "projectId",
        "packageId",
        "packageRevision",
        "policyId",
        "policyRevision",
        "environmentClass"
      ],
      "type": "object"
    },
    "CreateWorkConfigurationRunRequest": {
      "additionalProperties": false,
      "description": "Public request for a configuration run against one existing Resource-managed Work environment.",
      "properties": {
        "courseId": {
          "anyOf": [
            {
              "$ref": "#/$defs/CourseId"
            },
            {
              "type": "null"
            }
          ]
        },
        "environmentId": {
          "$ref": "#/$defs/EnvironmentId"
        },
        "environmentRevision": {
          "$ref": "#/$defs/Revision"
        },
        "packageId": {
          "$ref": "#/$defs/ProblemPackageId"
        },
        "packageRevision": {
          "$ref": "#/$defs/Revision"
        },
        "policyId": {
          "$ref": "#/$defs/PolicyId"
        },
        "policyRevision": {
          "$ref": "#/$defs/Revision"
        },
        "preauthorizationId": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkConfigurationPreauthorizationId"
            },
            {
              "type": "null"
            }
          ]
        },
        "preauthorizationRevision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Revision"
            },
            {
              "type": "null"
            }
          ]
        },
        "projectId": {
          "$ref": "#/$defs/ProjectId"
        }
      },
      "required": [
        "projectId",
        "packageId",
        "packageRevision",
        "policyId",
        "policyRevision",
        "environmentId",
        "environmentRevision"
      ],
      "type": "object"
    },
    "DeniedDataClass": {
      "description": "Non-overridable content classifications at the LLM boundary.",
      "enum": [
        "secret",
        "token",
        "private_key",
        "personally_identifiable_information",
        "unallowlisted_student_submission"
      ],
      "type": "string"
    },
    "EnvironmentClass": {
      "description": "Environment business class retained from the v2.1 architecture.",
      "enum": [
        "experiment",
        "work"
      ],
      "type": "string"
    },
    "EnvironmentId": {
      "description": "Strongly typed UUIDv7 identifier for `EnvironmentId`.",
      "type": "string"
    },
    "InternalAgentRunRequest": {
      "description": "Control-to-Agent command carried only over an allowlisted mTLS service identity.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "authoring",
              "type": "string"
            },
            "request": {
              "$ref": "#/$defs/CreateAgentRunRequest"
            }
          },
          "required": [
            "kind",
            "request"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "work_configuration",
              "type": "string"
            },
            "request": {
              "$ref": "#/$defs/CreateWorkConfigurationRunRequest"
            }
          },
          "required": [
            "kind",
            "request"
          ],
          "type": "object"
        }
      ]
    },
    "LlmBudget": {
      "additionalProperties": false,
      "description": "Per-attempt bounded LLM budget.",
      "properties": {
        "maxCostMicrousd": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "maxInputTokens": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "maxOutputTokens": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "maxRequests": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "maxSchemaRepairs": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "maxTransientRetries": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "timeoutMilliseconds": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "maxInputTokens",
        "maxOutputTokens",
        "maxRequests",
        "maxCostMicrousd",
        "timeoutMilliseconds",
        "maxTransientRetries",
        "maxSchemaRepairs"
      ],
      "type": "object"
    },
    "PackageFile": {
      "additionalProperties": false,
      "description": "One immutable file in a teacher ProblemPackage.",
      "properties": {
        "object": {
          "$ref": "#/$defs/ArtifactRef",
          "description": "Immutable object reference."
        },
        "path": {
          "description": "Normalized package-relative file path.",
          "type": "string"
        }
      },
      "required": [
        "path",
        "object"
      ],
      "type": "object"
    },
    "PolicyId": {
      "description": "Strongly typed UUIDv7 identifier for `PolicyId`.",
      "type": "string"
    },
    "ProblemPackage": {
      "additionalProperties": false,
      "description": "Immutable, atomically completed teacher material package.",
      "properties": {
        "completedAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "courseId": {
          "anyOf": [
            {
              "$ref": "#/$defs/CourseId"
            },
            {
              "type": "null"
            }
          ]
        },
        "files": {
          "items": {
            "$ref": "#/$defs/PackageFile"
          },
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/ProblemPackageId"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectId"
        },
        "retention": {
          "$ref": "#/$defs/RetentionSnapshot"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "id",
        "projectId",
        "revision",
        "files",
        "retention",
        "completedAt"
      ],
      "type": "object"
    },
    "ProblemPackageId": {
      "description": "Strongly typed UUIDv7 identifier for `ProblemPackageId`.",
      "type": "string"
    },
    "ProjectId": {
      "description": "Strongly typed UUIDv7 identifier for `ProjectId`.",
      "type": "string"
    },
    "ProjectLlmEgressPolicy": {
      "additionalProperties": false,
      "description": "Versioned project policy governing all LLM egress. A course is optional teaching context.",
      "properties": {
        "activatedAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "binding": {
          "$ref": "#/$defs/ClaudeCodeBindingV1"
        },
        "budget": {
          "$ref": "#/$defs/LlmBudget"
        },
        "courseId": {
          "anyOf": [
            {
              "$ref": "#/$defs/CourseId"
            },
            {
              "type": "null"
            }
          ]
        },
        "deniedDataClasses": {
          "items": {
            "$ref": "#/$defs/DeniedDataClass"
          },
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/PolicyId"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectId"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "studentContentMode": {
          "$ref": "#/$defs/StudentContentMode"
        }
      },
      "required": [
        "id",
        "projectId",
        "revision",
        "binding",
        "budget",
        "deniedDataClasses",
        "studentContentMode",
        "activatedAt"
      ],
      "type": "object"
    },
    "RetentionClass": {
      "description": "Retention classes with distinct privacy and recovery requirements.",
      "enum": [
        "course_material",
        "build_evidence",
        "run_evidence",
        "student_submission",
        "security_audit"
      ],
      "type": "string"
    },
    "RetentionDisposition": {
      "description": "Required action after retention expires.",
      "enum": [
        "delete",
        "purge_after_export",
        "retain_sanitized_receipt"
      ],
      "type": "string"
    },
    "RetentionSnapshot": {
      "additionalProperties": false,
      "description": "Frozen data-retention decision for an immutable resource.",
      "properties": {
        "class": {
          "$ref": "#/$defs/RetentionClass",
          "description": "Stable retention class."
        },
        "disposition": {
          "$ref": "#/$defs/RetentionDisposition",
          "description": "Required terminal disposition."
        },
        "policyId": {
          "$ref": "#/$defs/PolicyId",
          "description": "Policy identity."
        },
        "policyRevision": {
          "$ref": "#/$defs/Revision",
          "description": "Exact policy revision used at creation."
        },
        "retainUntil": {
          "$ref": "#/$defs/UtcTimestamp",
          "description": "Absolute retention boundary."
        }
      },
      "required": [
        "policyId",
        "policyRevision",
        "class",
        "retainUntil",
        "disposition"
      ],
      "type": "object"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "RuntimeKind": {
      "description": "Runtime kind shared by candidates, releases, and instances.",
      "enum": [
        "container",
        "virtual_machine"
      ],
      "type": "string"
    },
    "StudentContentMode": {
      "description": "Only explicit SubmissionManifest paths may disclose student content.",
      "enum": [
        "manifest_allowlist_only"
      ],
      "type": "string"
    },
    "UtcTimestamp": {
      "description": "UTC timestamp serialized with a literal `Z` and millisecond precision.",
      "type": "string"
    },
    "WorkConfigurationPlanId": {
      "description": "Strongly typed UUIDv7 identifier for `WorkConfigurationPlanId`.",
      "type": "string"
    },
    "WorkConfigurationPreauthorization": {
      "additionalProperties": false,
      "description": "Concrete per-Work grant for executing one exact immutable configuration plan.\n\nThe grant binds both script artifacts and the plan revision. It therefore cannot authorize a\nnewly generated script, a changed verification script, or a plan whose restart requirement was\naltered after approval.",
      "properties": {
        "actorId": {
          "$ref": "#/$defs/ActorId"
        },
        "environmentId": {
          "$ref": "#/$defs/EnvironmentId"
        },
        "environmentRevision": {
          "$ref": "#/$defs/Revision"
        },
        "expiresAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "id": {
          "$ref": "#/$defs/WorkConfigurationPreauthorizationId"
        },
        "planId": {
          "$ref": "#/$defs/WorkConfigurationPlanId"
        },
        "planRevision": {
          "$ref": "#/$defs/Revision"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectId"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "scriptArtifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "verificationScriptArtifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "projectId",
        "environmentId",
        "environmentRevision",
        "actorId",
        "planId",
        "planRevision",
        "scriptArtifact",
        "expiresAt",
        "revision"
      ],
      "type": "object"
    },
    "WorkConfigurationPreauthorizationId": {
      "description": "Strongly typed UUIDv7 identifier for `WorkConfigurationPreauthorizationId`.",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Control-to-Agent command carried only over an allowlisted mTLS service identity.",
  "properties": {
    "courseId": {
      "anyOf": [
        {
          "$ref": "#/$defs/CourseId"
        },
        {
          "type": "null"
        }
      ]
    },
    "objectLocators": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Internal artifact ID to opaque object-key mapping; keys never contain original paths.",
      "type": "object"
    },
    "package": {
      "$ref": "#/$defs/ProblemPackage",
      "description": "Completed Control-owned package; Agent re-reads and re-hashes every object."
    },
    "policy": {
      "$ref": "#/$defs/ProjectLlmEgressPolicy",
      "description": "Active immutable Project policy."
    },
    "preauthorization": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorkConfigurationPreauthorization"
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional concrete grant for reusing one exact approved Work configuration plan."
    },
    "projectId": {
      "$ref": "#/$defs/ProjectId",
      "description": "Authoritative Project ownership and optional teaching association."
    },
    "purpose": {
      "$ref": "#/$defs/AgentRunPurpose",
      "description": "Control-derived immutable purpose. Agent rejects a request whose purpose does not agree\nwith its typed request variant and target identities."
    },
    "request": {
      "$ref": "#/$defs/InternalAgentRunRequest",
      "description": "Public immutable request whose idempotency key remains an HTTP header."
    }
  },
  "required": [
    "projectId",
    "request",
    "purpose",
    "package",
    "objectLocators",
    "policy"
  ],
  "title": "InternalCreateAgentRunRequest",
  "type": "object"
}
