{
  "$defs": {
    "CourseId": {
      "description": "Strongly typed UUIDv7 identifier for `CourseId`.",
      "type": "string"
    },
    "ProblemPackageUploadFile": {
      "additionalProperties": false,
      "properties": {
        "mediaType": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "sizeBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sizeBytes",
        "sha256",
        "mediaType"
      ],
      "type": "object"
    },
    "ProblemPackageUploadTarget": {
      "description": "Short-lived, per-object upload authority returned only by session creation.",
      "properties": {
        "expiresAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "path": {
          "type": "string"
        },
        "requiredHeaders": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "uploadUrl": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "uploadUrl",
        "requiredHeaders",
        "expiresAt"
      ],
      "type": "object"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "Sha256Digest": {
      "description": "Canonical lowercase SHA-256 digest.",
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "UploadSessionId": {
      "description": "Strongly typed UUIDv7 identifier for `UploadSessionId`.",
      "type": "string"
    },
    "UtcTimestamp": {
      "description": "UTC timestamp serialized with a literal `Z` and millisecond precision.",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "courseId": {
      "$ref": "#/$defs/CourseId"
    },
    "expiresAt": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/ProblemPackageUploadFile"
      },
      "type": "array"
    },
    "id": {
      "$ref": "#/$defs/UploadSessionId"
    },
    "revision": {
      "$ref": "#/$defs/Revision"
    },
    "uploadTargets": {
      "items": {
        "$ref": "#/$defs/ProblemPackageUploadTarget"
      },
      "type": "array"
    }
  },
  "required": [
    "id",
    "courseId",
    "revision",
    "files",
    "uploadTargets",
    "expiresAt"
  ],
  "title": "ProblemPackageUploadSession",
  "type": "object"
}
