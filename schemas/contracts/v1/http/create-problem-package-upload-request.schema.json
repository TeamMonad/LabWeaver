{
  "$defs": {
    "ProblemPackageUploadFile": {
      "additionalProperties": false,
      "properties": {
        "mediaType": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "sizeBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sizeBytes",
        "sha256",
        "mediaType"
      ],
      "type": "object"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "Sha256Digest": {
      "description": "Canonical lowercase SHA-256 digest.",
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "files": {
      "items": {
        "$ref": "#/$defs/ProblemPackageUploadFile"
      },
      "type": "array"
    },
    "retentionPolicyRevision": {
      "$ref": "#/$defs/Revision"
    }
  },
  "required": [
    "files",
    "retentionPolicyRevision"
  ],
  "title": "CreateProblemPackageUploadRequest",
  "type": "object"
}
