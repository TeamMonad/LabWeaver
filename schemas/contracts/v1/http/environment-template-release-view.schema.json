{
  "$defs": {
    "ActorId": {
      "description": "Strongly typed UUIDv7 identifier for `ActorId`.",
      "type": "string"
    },
    "AgentRunId": {
      "description": "Strongly typed UUIDv7 identifier for `AgentRunId`.",
      "type": "string"
    },
    "ApprovalId": {
      "description": "Strongly typed UUIDv7 identifier for `ApprovalId`.",
      "type": "string"
    },
    "BuildRequestId": {
      "description": "Strongly typed UUIDv7 identifier for `BuildRequestId`.",
      "type": "string"
    },
    "CandidateApproval": {
      "additionalProperties": false,
      "description": "Human decision bound to an exact candidate and dependency identity.",
      "properties": {
        "actorId": {
          "$ref": "#/$defs/ActorId"
        },
        "candidateId": {
          "$ref": "#/$defs/CandidateId"
        },
        "candidateRevision": {
          "$ref": "#/$defs/Revision"
        },
        "decidedAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "decision": {
          "$ref": "#/$defs/CandidateDecision"
        },
        "id": {
          "$ref": "#/$defs/ApprovalId"
        },
        "policyRevision": {
          "$ref": "#/$defs/Revision"
        },
        "reason": {
          "type": "string"
        },
        "trustRevision": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "id",
        "candidateId",
        "candidateRevision",
        "policyRevision",
        "trustRevision",
        "actorId",
        "decision",
        "reason",
        "decidedAt"
      ],
      "type": "object"
    },
    "CandidateDecision": {
      "description": "Append-only candidate decision.",
      "enum": [
        "approved",
        "rejected",
        "withdrawn"
      ],
      "type": "string"
    },
    "CandidateId": {
      "description": "Strongly typed UUIDv7 identifier for `CandidateId`.",
      "type": "string"
    },
    "CourseId": {
      "description": "Strongly typed UUIDv7 identifier for `CourseId`.",
      "type": "string"
    },
    "ImageArtifact": {
      "description": "Complete immutable runtime artifact identity.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "build_request_id": {
              "$ref": "#/$defs/BuildRequestId"
            },
            "digest": {
              "type": "string"
            },
            "id": {
              "$ref": "#/$defs/ImageArtifactId"
            },
            "kind": {
              "const": "container",
              "type": "string"
            },
            "repository": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id",
            "build_request_id",
            "repository",
            "digest"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "base_disk": {
              "$ref": "#/$defs/VirtualMachineBaseDisk"
            },
            "format": {
              "$ref": "#/$defs/VirtualMachineDiskFormat"
            },
            "id": {
              "$ref": "#/$defs/ImageArtifactId"
            },
            "kind": {
              "const": "virtual_machine",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id",
            "base_disk",
            "format"
          ],
          "type": "object"
        }
      ]
    },
    "ImageArtifactId": {
      "description": "Strongly typed UUIDv7 identifier for `ImageArtifactId`.",
      "type": "string"
    },
    "PathRule": {
      "description": "Strict safe path selector shared by packages, collectors, and LLM allowlists.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "exactFile",
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "directoryTree",
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path"
          ],
          "type": "object"
        }
      ]
    },
    "ProjectId": {
      "description": "Strongly typed UUIDv7 identifier for `ProjectId`.",
      "type": "string"
    },
    "ReleaseId": {
      "description": "Strongly typed UUIDv7 identifier for `ReleaseId`.",
      "type": "string"
    },
    "ReleaseWithdrawal": {
      "additionalProperties": false,
      "description": "Append-only release withdrawal fact.",
      "properties": {
        "actorId": {
          "$ref": "#/$defs/ActorId"
        },
        "reasonCode": {
          "type": "string"
        },
        "releaseId": {
          "$ref": "#/$defs/ReleaseId"
        },
        "releaseVersion": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "withdrawnAt": {
          "$ref": "#/$defs/UtcTimestamp"
        }
      },
      "required": [
        "releaseId",
        "releaseVersion",
        "actorId",
        "reasonCode",
        "withdrawnAt"
      ],
      "type": "object"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "RuntimeKind": {
      "description": "Runtime kind shared by candidates, releases, and instances.",
      "enum": [
        "container",
        "virtual_machine"
      ],
      "type": "string"
    },
    "SubmissionApiVersion": {
      "enum": [
        "evaluation.labweaver.io/v1"
      ],
      "type": "string"
    },
    "SubmissionDocumentKind": {
      "enum": [
        "SubmissionManifest"
      ],
      "type": "string"
    },
    "SubmissionManifest": {
      "additionalProperties": false,
      "description": "Stable SubmissionManifest v1.",
      "properties": {
        "apiVersion": {
          "$ref": "#/$defs/SubmissionApiVersion"
        },
        "exclude": {
          "items": {
            "$ref": "#/$defs/PathRule"
          },
          "type": "array"
        },
        "followSymlinks": {
          "type": "boolean"
        },
        "include": {
          "items": {
            "$ref": "#/$defs/PathRule"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/SubmissionDocumentKind"
        },
        "llmReadable": {
          "items": {
            "$ref": "#/$defs/PathRule"
          },
          "type": "array"
        },
        "maxFiles": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "maxTotalBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "required": {
          "items": {
            "$ref": "#/$defs/PathRule"
          },
          "type": "array"
        },
        "source": {
          "$ref": "#/$defs/SubmissionSource"
        }
      },
      "required": [
        "apiVersion",
        "kind",
        "name",
        "source",
        "include",
        "exclude",
        "required",
        "llmReadable",
        "maxTotalBytes",
        "maxFiles",
        "followSymlinks"
      ],
      "type": "object"
    },
    "SubmissionSource": {
      "description": "Source available to a bounded Collector.",
      "enum": [
        "workspace",
        "system_facts"
      ],
      "type": "string"
    },
    "UtcTimestamp": {
      "description": "UTC timestamp serialized with a literal `Z` and millisecond precision.",
      "type": "string"
    },
    "VirtualMachineBaseDisk": {
      "additionalProperties": false,
      "description": "Deployment-owned immutable KubeVirt base-disk identity.\n\nUnlike an object-store `ArtifactRef`, this identifies a CDI source image and its imported\ndisk content. `capacity_bytes` is the reviewed PVC capacity, not a fabricated object length.",
      "properties": {
        "binding": {
          "type": "string"
        },
        "capacityBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "sourceRegistryDigest": {
          "type": "string"
        }
      },
      "required": [
        "binding",
        "sourceRegistryDigest",
        "capacityBytes"
      ],
      "type": "object"
    },
    "VirtualMachineDiskFormat": {
      "description": "Supported VM base-disk encodings.",
      "enum": [
        "qcow2",
        "raw"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Read model that keeps the immutable release separate from its append-only withdrawal fact.",
  "properties": {
    "agentRunId": {
      "$ref": "#/$defs/AgentRunId"
    },
    "approval": {
      "$ref": "#/$defs/CandidateApproval"
    },
    "artifact": {
      "$ref": "#/$defs/ImageArtifact"
    },
    "candidateId": {
      "$ref": "#/$defs/CandidateId"
    },
    "candidateRevision": {
      "$ref": "#/$defs/Revision"
    },
    "courseId": {
      "anyOf": [
        {
          "$ref": "#/$defs/CourseId"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "$ref": "#/$defs/ReleaseId"
    },
    "projectId": {
      "$ref": "#/$defs/ProjectId"
    },
    "publishedAt": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "publishedBy": {
      "$ref": "#/$defs/ActorId"
    },
    "runtimeKind": {
      "$ref": "#/$defs/RuntimeKind"
    },
    "submissionManifest": {
      "anyOf": [
        {
          "$ref": "#/$defs/SubmissionManifest"
        },
        {
          "type": "null"
        }
      ],
      "description": "Workspace submission manifest from the exact ready authoring publication, when present.\n\nWork releases and system-facts evaluations intentionally omit this projection."
    },
    "version": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "withdrawal": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReleaseWithdrawal"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "projectId",
    "version",
    "candidateId",
    "agentRunId",
    "candidateRevision",
    "runtimeKind",
    "approval",
    "artifact",
    "publishedBy",
    "publishedAt"
  ],
  "title": "EnvironmentTemplateReleaseView",
  "type": "object"
}
