{
  "$defs": {
    "ActorId": {
      "description": "Strongly typed UUIDv7 identifier for `ActorId`.",
      "type": "string"
    },
    "CourseId": {
      "description": "Strongly typed UUIDv7 identifier for `CourseId`.",
      "type": "string"
    },
    "EnvironmentId": {
      "description": "Strongly typed UUIDv7 identifier for `EnvironmentId`.",
      "type": "string"
    },
    "GpuAllocation": {
      "additionalProperties": false,
      "description": "The catalog resolution captured on an approved capacity claim.",
      "properties": {
        "allocationBinding": {
          "type": "string"
        },
        "catalogRevision": {
          "$ref": "#/$defs/Revision"
        },
        "class": {
          "type": "string"
        },
        "count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "entryId": {
          "$ref": "#/$defs/GpuCatalogEntryId",
          "description": "Exact catalog row used to resolve this allocation."
        },
        "mode": {
          "$ref": "#/$defs/GpuAllocationMode"
        },
        "providerBinding": {
          "type": "string"
        }
      },
      "required": [
        "entryId",
        "class",
        "count",
        "mode",
        "providerBinding",
        "allocationBinding",
        "catalogRevision"
      ],
      "type": "object"
    },
    "GpuAllocationMode": {
      "description": "Allocation mode selected by the Resource GPU catalog.\n\nCallers submit only a catalog class and count. The mode is resolved from the\nactive catalog entry and is never accepted as an untrusted request override.",
      "enum": [
        "exclusive",
        "container_time_slice",
        "vm_vgpu"
      ],
      "type": "string"
    },
    "GpuCatalogEntryId": {
      "description": "Strongly typed UUIDv7 identifier for `GpuCatalogEntryId`.",
      "type": "string"
    },
    "GpuRequest": {
      "additionalProperties": false,
      "description": "A policy-catalogued GPU class. It intentionally does not expose Kubernetes resource names.",
      "properties": {
        "class": {
          "type": "string"
        },
        "count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "class",
        "count"
      ],
      "type": "object"
    },
    "OperationId": {
      "description": "Strongly typed UUIDv7 identifier for `OperationId`.",
      "type": "string"
    },
    "ProjectId": {
      "description": "Strongly typed UUIDv7 identifier for `ProjectId`.",
      "type": "string"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "WorkloadResources": {
      "additionalProperties": false,
      "description": "Requested or approved workload resources, independent of Kubernetes quantity syntax.",
      "properties": {
        "cpuMillicores": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "gpu": {
          "anyOf": [
            {
              "$ref": "#/$defs/GpuRequest"
            },
            {
              "type": "null"
            }
          ]
        },
        "memoryBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "storageBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "cpuMillicores",
        "memoryBytes",
        "storageBytes"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Environment request to revalidate and activate an existing Experiment reservation.",
  "properties": {
    "approvedResources": {
      "$ref": "#/$defs/WorkloadResources"
    },
    "courseId": {
      "anyOf": [
        {
          "$ref": "#/$defs/CourseId"
        },
        {
          "type": "null"
        }
      ]
    },
    "environmentGeneration": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "environmentId": {
      "$ref": "#/$defs/EnvironmentId"
    },
    "expectedAllocation": {
      "anyOf": [
        {
          "$ref": "#/$defs/GpuAllocation"
        },
        {
          "type": "null"
        }
      ]
    },
    "gpu": {
      "anyOf": [
        {
          "$ref": "#/$defs/GpuRequest"
        },
        {
          "type": "null"
        }
      ]
    },
    "operationId": {
      "$ref": "#/$defs/OperationId"
    },
    "ownerActorId": {
      "$ref": "#/$defs/ActorId"
    },
    "projectId": {
      "$ref": "#/$defs/ProjectId"
    },
    "providerBinding": {
      "type": "string"
    },
    "traceId": {
      "type": "string"
    },
    "version": {
      "format": "uint8",
      "maximum": 255,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "version",
    "environmentId",
    "projectId",
    "ownerActorId",
    "providerBinding",
    "approvedResources",
    "operationId",
    "environmentGeneration",
    "traceId"
  ],
  "title": "ActivateEnvironmentResourceReservationRequest",
  "type": "object"
}
