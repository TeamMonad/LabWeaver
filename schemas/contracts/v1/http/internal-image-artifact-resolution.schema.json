{
  "$defs": {
    "ArtifactId": {
      "description": "Strongly typed UUIDv7 identifier for `ArtifactId`.",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Immutable object-store identity without a machine-local path or credential.",
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/ArtifactId",
          "description": "Stable metadata identity resolved by the owning service."
        },
        "mediaType": {
          "description": "Registered media type.",
          "type": "string"
        },
        "objectVersion": {
          "description": "Immutable backend object version.",
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Digest",
          "description": "Exact content digest."
        },
        "sizeBytes": {
          "description": "Raw object length.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "storeBinding": {
          "description": "Explicit object-store binding from deployment configuration.",
          "type": "string"
        }
      },
      "required": [
        "artifactId",
        "storeBinding",
        "objectVersion",
        "sha256",
        "sizeBytes",
        "mediaType"
      ],
      "type": "object"
    },
    "BuildRequestId": {
      "description": "Strongly typed UUIDv7 identifier for `BuildRequestId`.",
      "type": "string"
    },
    "ImageArtifact": {
      "description": "Complete immutable runtime artifact identity.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "build_request_id": {
              "$ref": "#/$defs/BuildRequestId"
            },
            "digest": {
              "type": "string"
            },
            "id": {
              "$ref": "#/$defs/ImageArtifactId"
            },
            "immutable_tag": {
              "type": "string"
            },
            "kind": {
              "const": "container",
              "type": "string"
            },
            "provenance": {
              "$ref": "#/$defs/ArtifactRef"
            },
            "repository": {
              "type": "string"
            },
            "sbom": {
              "$ref": "#/$defs/ArtifactRef"
            },
            "signature": {
              "$ref": "#/$defs/SigstoreEvidence"
            }
          },
          "required": [
            "kind",
            "id",
            "build_request_id",
            "repository",
            "immutable_tag",
            "digest",
            "sbom",
            "provenance",
            "signature"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "base_disk": {
              "$ref": "#/$defs/ArtifactRef"
            },
            "format": {
              "$ref": "#/$defs/VirtualMachineDiskFormat"
            },
            "id": {
              "$ref": "#/$defs/ImageArtifactId"
            },
            "kind": {
              "const": "virtual_machine",
              "type": "string"
            },
            "provenance": {
              "$ref": "#/$defs/ArtifactRef"
            },
            "sbom": {
              "$ref": "#/$defs/ArtifactRef"
            },
            "signature": {
              "$ref": "#/$defs/SigstoreEvidence"
            }
          },
          "required": [
            "kind",
            "id",
            "base_disk",
            "format",
            "sbom",
            "provenance",
            "signature"
          ],
          "type": "object"
        }
      ]
    },
    "ImageArtifactId": {
      "description": "Strongly typed UUIDv7 identifier for `ImageArtifactId`.",
      "type": "string"
    },
    "ImagePolicyEvaluation": {
      "additionalProperties": false,
      "description": "Deterministic scan and trust-policy evaluation.",
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/ImageArtifactId"
        },
        "artifactSha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "evaluatedAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "expectedCertificateSubject": {
          "type": "string"
        },
        "expectedFulcioIssuer": {
          "type": "string"
        },
        "maxEvidenceAgeMilliseconds": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "passed": {
          "type": "boolean"
        },
        "policyId": {
          "$ref": "#/$defs/PolicyId"
        },
        "policyRevision": {
          "$ref": "#/$defs/Revision"
        },
        "requireCtSct": {
          "type": "boolean"
        },
        "requireRekorInclusion": {
          "type": "boolean"
        },
        "scannerDatabaseSha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "scannerName": {
          "type": "string"
        },
        "scannerVersion": {
          "type": "string"
        },
        "trustBundleSha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "validUntil": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "vulnerabilities": {
          "$ref": "#/$defs/VulnerabilitySummary"
        }
      },
      "required": [
        "artifactId",
        "artifactSha256",
        "policyId",
        "policyRevision",
        "scannerName",
        "scannerVersion",
        "scannerDatabaseSha256",
        "vulnerabilities",
        "trustBundleSha256",
        "expectedFulcioIssuer",
        "expectedCertificateSubject",
        "requireRekorInclusion",
        "requireCtSct",
        "evaluatedAt",
        "maxEvidenceAgeMilliseconds",
        "validUntil",
        "passed"
      ],
      "type": "object"
    },
    "PolicyId": {
      "description": "Strongly typed UUIDv7 identifier for `PolicyId`.",
      "type": "string"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "Sha256Digest": {
      "description": "Canonical lowercase SHA-256 digest.",
      "type": "string"
    },
    "SigstoreEvidence": {
      "additionalProperties": false,
      "description": "Private Sigstore identity and transparency evidence.",
      "properties": {
        "certificateSha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "certificateSubject": {
          "type": "string"
        },
        "ctLogId": {
          "type": "string"
        },
        "fulcioIssuer": {
          "type": "string"
        },
        "rekorInclusionProofSha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "rekorLogId": {
          "type": "string"
        },
        "rekorLogIndex": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "sctSha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "signatureSha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "trustBundleSha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "verifiedAt": {
          "$ref": "#/$defs/UtcTimestamp"
        }
      },
      "required": [
        "trustBundleSha256",
        "fulcioIssuer",
        "certificateSubject",
        "certificateSha256",
        "signatureSha256",
        "rekorLogId",
        "rekorLogIndex",
        "rekorInclusionProofSha256",
        "ctLogId",
        "sctSha256",
        "verifiedAt"
      ],
      "type": "object"
    },
    "UtcTimestamp": {
      "description": "UTC timestamp serialized with a literal `Z` and millisecond precision.",
      "type": "string"
    },
    "VirtualMachineDiskFormat": {
      "description": "Supported VM base-disk encodings.",
      "enum": [
        "qcow2",
        "raw"
      ],
      "type": "string"
    },
    "VulnerabilitySummary": {
      "additionalProperties": false,
      "description": "Vulnerability counts by severity.",
      "properties": {
        "critical": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "high": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "low": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "medium": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "unknown": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "unknown",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Agent-owned artifact and policy evaluation resolved for Control publication.",
  "properties": {
    "artifact": {
      "$ref": "#/$defs/ImageArtifact"
    },
    "artifactId": {
      "$ref": "#/$defs/ImageArtifactId"
    },
    "policyEvaluation": {
      "$ref": "#/$defs/ImagePolicyEvaluation"
    },
    "resolutionSha256": {
      "$ref": "#/$defs/Sha256Digest"
    }
  },
  "required": [
    "artifactId",
    "artifact",
    "policyEvaluation",
    "resolutionSha256"
  ],
  "title": "InternalImageArtifactResolution",
  "type": "object"
}
