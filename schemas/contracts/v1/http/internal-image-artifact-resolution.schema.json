{
  "$defs": {
    "ArtifactId": {
      "description": "Strongly typed UUIDv7 identifier for `ArtifactId`.",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Immutable object-store identity without a machine-local path or credential.",
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/ArtifactId",
          "description": "Stable metadata identity resolved by the owning service."
        },
        "mediaType": {
          "description": "Registered media type.",
          "type": "string"
        },
        "objectVersion": {
          "description": "Immutable backend object version.",
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Digest",
          "description": "Exact content digest."
        },
        "sizeBytes": {
          "description": "Raw object length.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "storeBinding": {
          "description": "Explicit object-store binding from deployment configuration.",
          "type": "string"
        }
      },
      "required": [
        "artifactId",
        "storeBinding",
        "objectVersion",
        "sha256",
        "sizeBytes",
        "mediaType"
      ],
      "type": "object"
    },
    "BuildRequestId": {
      "description": "Strongly typed UUIDv7 identifier for `BuildRequestId`.",
      "type": "string"
    },
    "ImageArtifact": {
      "description": "Complete immutable runtime artifact identity.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "build_request_id": {
              "$ref": "#/$defs/BuildRequestId"
            },
            "digest": {
              "type": "string"
            },
            "id": {
              "$ref": "#/$defs/ImageArtifactId"
            },
            "kind": {
              "const": "container",
              "type": "string"
            },
            "repository": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id",
            "build_request_id",
            "repository",
            "digest"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "base_disk": {
              "$ref": "#/$defs/ArtifactRef"
            },
            "format": {
              "$ref": "#/$defs/VirtualMachineDiskFormat"
            },
            "id": {
              "$ref": "#/$defs/ImageArtifactId"
            },
            "kind": {
              "const": "virtual_machine",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id",
            "base_disk",
            "format"
          ],
          "type": "object"
        }
      ]
    },
    "ImageArtifactId": {
      "description": "Strongly typed UUIDv7 identifier for `ImageArtifactId`.",
      "type": "string"
    },
    "ImagePolicyEvaluation": {
      "additionalProperties": false,
      "description": "Deterministic digest-bound Trivy evaluation.",
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/ImageArtifactId"
        },
        "artifactSha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "evaluatedAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "maxEvidenceAgeMilliseconds": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "passed": {
          "type": "boolean"
        },
        "policyId": {
          "$ref": "#/$defs/PolicyId"
        },
        "policyRevision": {
          "$ref": "#/$defs/Revision"
        },
        "scannerDatabaseSha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "scannerName": {
          "type": "string"
        },
        "scannerVersion": {
          "type": "string"
        },
        "validUntil": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "vulnerabilities": {
          "$ref": "#/$defs/VulnerabilitySummary"
        }
      },
      "required": [
        "artifactId",
        "artifactSha256",
        "policyId",
        "policyRevision",
        "scannerName",
        "scannerVersion",
        "scannerDatabaseSha256",
        "vulnerabilities",
        "evaluatedAt",
        "maxEvidenceAgeMilliseconds",
        "validUntil",
        "passed"
      ],
      "type": "object"
    },
    "PolicyId": {
      "description": "Strongly typed UUIDv7 identifier for `PolicyId`.",
      "type": "string"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "Sha256Digest": {
      "description": "Canonical lowercase SHA-256 digest.",
      "type": "string"
    },
    "UtcTimestamp": {
      "description": "UTC timestamp serialized with a literal `Z` and millisecond precision.",
      "type": "string"
    },
    "VirtualMachineDiskFormat": {
      "description": "Supported VM base-disk encodings.",
      "enum": [
        "qcow2",
        "raw"
      ],
      "type": "string"
    },
    "VulnerabilitySummary": {
      "additionalProperties": false,
      "description": "Vulnerability counts by severity.",
      "properties": {
        "critical": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "high": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "low": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "medium": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "unknown": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "unknown",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Agent-owned artifact and policy evaluation resolved for Control publication.",
  "properties": {
    "artifact": {
      "$ref": "#/$defs/ImageArtifact"
    },
    "artifactId": {
      "$ref": "#/$defs/ImageArtifactId"
    },
    "policyEvaluation": {
      "$ref": "#/$defs/ImagePolicyEvaluation"
    },
    "resolutionSha256": {
      "$ref": "#/$defs/Sha256Digest"
    }
  },
  "required": [
    "artifactId",
    "artifact",
    "policyEvaluation",
    "resolutionSha256"
  ],
  "title": "InternalImageArtifactResolution",
  "type": "object"
}
