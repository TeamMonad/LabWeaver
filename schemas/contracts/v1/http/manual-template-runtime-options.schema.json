{
  "$defs": {
    "ManualTemplateProviderOption": {
      "additionalProperties": false,
      "properties": {
        "binding": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "runtimeKind": {
          "$ref": "#/$defs/RuntimeKind"
        },
        "storageClasses": {
          "items": {
            "$ref": "#/$defs/ManualTemplateStorageOption"
          },
          "type": "array"
        }
      },
      "required": [
        "binding",
        "label",
        "description",
        "runtimeKind",
        "storageClasses"
      ],
      "type": "object"
    },
    "ManualTemplateSeededDiskOption": {
      "additionalProperties": false,
      "properties": {
        "binding": {
          "type": "string"
        },
        "capacityBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "diskSha256": {
          "type": "string"
        },
        "format": {
          "$ref": "#/$defs/VirtualMachineDiskFormat"
        },
        "sourceRegistryDigest": {
          "type": "string"
        },
        "storageClassBinding": {
          "type": "string"
        }
      },
      "required": [
        "binding",
        "diskSha256",
        "capacityBytes",
        "sourceRegistryDigest",
        "format",
        "storageClassBinding"
      ],
      "type": "object"
    },
    "ManualTemplateStorageOption": {
      "additionalProperties": false,
      "properties": {
        "binding": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "maxCapacityBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "seededDisks": {
          "description": "Deployment-seeded disks take precedence over dynamic catalog entries with the same binding.",
          "items": {
            "$ref": "#/$defs/ManualTemplateSeededDiskOption"
          },
          "type": "array"
        }
      },
      "required": [
        "binding",
        "label",
        "description",
        "maxCapacityBytes",
        "seededDisks"
      ],
      "type": "object"
    },
    "RuntimeKind": {
      "description": "Runtime kind shared by candidates, releases, and instances.",
      "enum": [
        "container",
        "virtual_machine"
      ],
      "type": "string"
    },
    "VirtualMachineDiskFormat": {
      "description": "Supported VM base-disk encodings.",
      "enum": [
        "qcow2",
        "raw"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "providers": {
      "items": {
        "$ref": "#/$defs/ManualTemplateProviderOption"
      },
      "type": "array"
    }
  },
  "required": [
    "providers"
  ],
  "title": "ManualTemplateRuntimeOptions",
  "type": "object"
}
