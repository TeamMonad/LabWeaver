{
  "$defs": {
    "PlatformImageKind": {
      "description": "Reviewed platform image kinds.",
      "enum": [
        "container",
        "virtual_machine"
      ],
      "type": "string"
    },
    "VirtualMachineDiskFormat": {
      "description": "Supported VM base-disk encodings.",
      "enum": [
        "qcow2",
        "raw"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Administrator request for one OCI archive upload authority.",
  "properties": {
    "archiveBytes": {
      "description": "Exact archive size the client will upload.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "archiveMediaType": {
      "description": "Archive media type; must equal `PLATFORM_IMAGE_ARCHIVE_MEDIA_TYPE`.",
      "type": "string"
    },
    "binding": {
      "type": "string"
    },
    "capacityBytes": {
      "description": "Declared virtual-machine disk capacity in bytes; see [`valid_vm_disk_upload`].",
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "diskFormat": {
      "anyOf": [
        {
          "$ref": "#/$defs/VirtualMachineDiskFormat"
        },
        {
          "type": "null"
        }
      ],
      "description": "Declared virtual-machine disk encoding inside the archive; must agree with\n`disk_path` and `capacity_bytes` under [`valid_vm_disk_upload`]."
    },
    "diskPath": {
      "description": "Relative path of the disk inside the uploaded archive; see [`valid_vm_disk_upload`].",
      "type": [
        "string",
        "null"
      ]
    },
    "kind": {
      "$ref": "#/$defs/PlatformImageKind"
    },
    "reason": {
      "type": "string"
    },
    "targetReference": {
      "description": "Target `<registry-host>/<repository>:<tag>` the imported archive is tagged as.",
      "type": "string"
    },
    "trustRevision": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "kind",
    "binding",
    "targetReference",
    "archiveBytes",
    "archiveMediaType",
    "trustRevision",
    "reason"
  ],
  "title": "CreatePlatformImageUploadRequest",
  "type": "object"
}
