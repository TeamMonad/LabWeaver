{
  "$defs": {
    "ActorId": {
      "description": "Strongly typed UUIDv7 identifier for `ActorId`.",
      "type": "string"
    },
    "CapacityClaim": {
      "additionalProperties": false,
      "description": "Exact capacity allocation identity. Handles remain private to the provider implementation.",
      "properties": {
        "approvalId": {
          "$ref": "#/$defs/ResourceApprovalId"
        },
        "gpuAllocation": {
          "anyOf": [
            {
              "$ref": "#/$defs/GpuAllocation"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact GPU catalog resolution captured before provider side effects."
        },
        "id": {
          "$ref": "#/$defs/CapacityClaimId"
        },
        "providerBinding": {
          "type": "string"
        },
        "quotaResources": {
          "$ref": "#/$defs/WorkloadResources"
        },
        "requestId": {
          "$ref": "#/$defs/ResourceRequestId"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "state": {
          "$ref": "#/$defs/CapacityClaimState"
        },
        "workloadResources": {
          "$ref": "#/$defs/WorkloadResources"
        }
      },
      "required": [
        "id",
        "requestId",
        "approvalId",
        "providerBinding",
        "workloadResources",
        "quotaResources",
        "state",
        "revision"
      ],
      "type": "object"
    },
    "CapacityClaimId": {
      "description": "Strongly typed UUIDv7 identifier for `CapacityClaimId`.",
      "type": "string"
    },
    "CapacityClaimState": {
      "description": "Provider-owned capacity-shell lifecycle. Resource remains the authority for every transition.",
      "enum": [
        "reserved",
        "provisioning",
        "ready",
        "handed_off",
        "releasing",
        "released",
        "blocked"
      ],
      "type": "string"
    },
    "CourseId": {
      "description": "Strongly typed UUIDv7 identifier for `CourseId`.",
      "type": "string"
    },
    "EnvironmentId": {
      "description": "Strongly typed UUIDv7 identifier for `EnvironmentId`.",
      "type": "string"
    },
    "GpuAllocation": {
      "additionalProperties": false,
      "description": "The catalog resolution captured on an approved capacity claim.",
      "properties": {
        "allocationBinding": {
          "type": "string"
        },
        "catalogRevision": {
          "$ref": "#/$defs/Revision"
        },
        "class": {
          "type": "string"
        },
        "count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "entryId": {
          "$ref": "#/$defs/GpuCatalogEntryId",
          "description": "Exact catalog row used to resolve this allocation."
        },
        "mode": {
          "$ref": "#/$defs/GpuAllocationMode"
        },
        "providerBinding": {
          "type": "string"
        }
      },
      "required": [
        "entryId",
        "class",
        "count",
        "mode",
        "providerBinding",
        "allocationBinding",
        "catalogRevision"
      ],
      "type": "object"
    },
    "GpuAllocationMode": {
      "description": "Allocation mode selected by the Resource GPU catalog.\n\nCallers submit only a catalog class and count. The mode is resolved from the\nactive catalog entry and is never accepted as an untrusted request override.",
      "enum": [
        "exclusive",
        "container_time_slice",
        "vm_vgpu"
      ],
      "type": "string"
    },
    "GpuCatalogEntryId": {
      "description": "Strongly typed UUIDv7 identifier for `GpuCatalogEntryId`.",
      "type": "string"
    },
    "GpuRequest": {
      "additionalProperties": false,
      "description": "A policy-catalogued GPU class. It intentionally does not expose Kubernetes resource names.",
      "properties": {
        "class": {
          "type": "string"
        },
        "count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "class",
        "count"
      ],
      "type": "object"
    },
    "LeaseId": {
      "description": "Strongly typed UUIDv7 identifier for `LeaseId`.",
      "type": "string"
    },
    "ProjectId": {
      "description": "Strongly typed UUIDv7 identifier for `ProjectId`.",
      "type": "string"
    },
    "ReleaseId": {
      "description": "Strongly typed UUIDv7 identifier for `ReleaseId`.",
      "type": "string"
    },
    "ResourceApprovalId": {
      "description": "Strongly typed UUIDv7 identifier for `ResourceApprovalId`.",
      "type": "string"
    },
    "ResourceLease": {
      "additionalProperties": false,
      "description": "PostgreSQL-authoritative Lease projection. Its authorization is valid only while Active.",
      "properties": {
        "activeFrom": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtcTimestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "claimId": {
          "$ref": "#/$defs/CapacityClaimId"
        },
        "createdAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "expiresAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtcTimestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "$ref": "#/$defs/LeaseId"
        },
        "requestId": {
          "$ref": "#/$defs/ResourceRequestId"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "revokeReasonCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/ResourceLeaseState"
        },
        "updatedAt": {
          "$ref": "#/$defs/UtcTimestamp"
        }
      },
      "required": [
        "id",
        "requestId",
        "claimId",
        "state",
        "revision",
        "createdAt",
        "updatedAt"
      ],
      "type": "object"
    },
    "ResourceLeaseState": {
      "description": "Closed Lease state consumed by other service boundaries.",
      "enum": [
        "allocating",
        "active",
        "expiring",
        "expired",
        "revoked"
      ],
      "type": "string"
    },
    "ResourceRequest": {
      "additionalProperties": false,
      "description": "PostgreSQL-authoritative request projection without provider internals.",
      "properties": {
        "courseId": {
          "anyOf": [
            {
              "$ref": "#/$defs/CourseId"
            },
            {
              "type": "null"
            }
          ]
        },
        "createdAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "diagnosticCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "generation": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/ResourceRequestId"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectId"
        },
        "requestKey": {
          "type": "string"
        },
        "requestedDurationSeconds": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "requestedResources": {
          "$ref": "#/$defs/WorkloadResources"
        },
        "requesterId": {
          "$ref": "#/$defs/ActorId"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "state": {
          "$ref": "#/$defs/ResourceRequestState"
        },
        "target": {
          "$ref": "#/$defs/ResourceTarget"
        },
        "updatedAt": {
          "$ref": "#/$defs/UtcTimestamp"
        }
      },
      "required": [
        "id",
        "generation",
        "requestKey",
        "requesterId",
        "projectId",
        "target",
        "requestedResources",
        "requestedDurationSeconds",
        "state",
        "revision",
        "createdAt",
        "updatedAt"
      ],
      "type": "object"
    },
    "ResourceRequestId": {
      "description": "Strongly typed UUIDv7 identifier for `ResourceRequestId`.",
      "type": "string"
    },
    "ResourceRequestState": {
      "description": "Request lifecycle owned by Resource Service.",
      "enum": [
        "reviewing",
        "allocating",
        "active",
        "expiring",
        "expired",
        "rejected",
        "cancelled"
      ],
      "type": "string"
    },
    "ResourceTarget": {
      "description": "Immutable identity of a Resource request's target.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Capacity for a long-lived Environment/Work aggregate that already owns its identity.",
          "properties": {
            "environmentId": {
              "$ref": "#/$defs/EnvironmentId"
            },
            "kind": {
              "const": "environment",
              "type": "string"
            },
            "releaseId": {
              "$ref": "#/$defs/ReleaseId"
            },
            "releaseVersion": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "environmentId",
            "releaseId",
            "releaseVersion"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Capacity for a one-shot task. Resource does not create a fake Environment row.",
          "properties": {
            "kind": {
              "const": "task",
              "type": "string"
            },
            "taskRunId": {
              "$ref": "#/$defs/TaskRunId"
            }
          },
          "required": [
            "kind",
            "taskRunId"
          ],
          "type": "object"
        }
      ]
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "TaskRunId": {
      "description": "Strongly typed UUIDv7 identifier for `TaskRunId`.",
      "type": "string"
    },
    "UtcTimestamp": {
      "description": "UTC timestamp serialized with a literal `Z` and millisecond precision.",
      "type": "string"
    },
    "WorkloadResources": {
      "additionalProperties": false,
      "description": "Requested or approved workload resources, independent of Kubernetes quantity syntax.",
      "properties": {
        "cpuMillicores": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "gpu": {
          "anyOf": [
            {
              "$ref": "#/$defs/GpuRequest"
            },
            {
              "type": "null"
            }
          ]
        },
        "memoryBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "storageBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "cpuMillicores",
        "memoryBytes",
        "storageBytes"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "PostgreSQL-authoritative one-shot task resource state returned to Evaluation.",
  "properties": {
    "claim": {
      "$ref": "#/$defs/CapacityClaim"
    },
    "claimRevision": {
      "$ref": "#/$defs/Revision"
    },
    "cleanupConfirmed": {
      "type": "boolean"
    },
    "executionNamespace": {
      "description": "Namespace selected by the trusted task scheduler at handoff time.",
      "type": [
        "string",
        "null"
      ]
    },
    "lease": {
      "$ref": "#/$defs/ResourceLease"
    },
    "leaseRevision": {
      "$ref": "#/$defs/Revision"
    },
    "ownerId": {
      "$ref": "#/$defs/ActorId"
    },
    "projectId": {
      "$ref": "#/$defs/ProjectId"
    },
    "request": {
      "$ref": "#/$defs/ResourceRequest"
    },
    "taskRunId": {
      "$ref": "#/$defs/TaskRunId"
    }
  },
  "required": [
    "taskRunId",
    "projectId",
    "ownerId",
    "claimRevision",
    "leaseRevision",
    "cleanupConfirmed",
    "request",
    "claim",
    "lease"
  ],
  "title": "TaskResourceStatus",
  "type": "object"
}
