{
  "$defs": {
    "EnvironmentId": {
      "description": "Strongly typed UUIDv7 identifier for `EnvironmentId`.",
      "type": "string"
    },
    "EventId": {
      "description": "Strongly typed UUIDv7 identifier for `EventId`.",
      "type": "string"
    },
    "LeaseId": {
      "description": "Strongly typed UUIDv7 identifier for `LeaseId`.",
      "type": "string"
    },
    "ResourceRequestId": {
      "description": "Strongly typed UUIDv7 identifier for `ResourceRequestId`.",
      "type": "string"
    },
    "ResourceUsageKind": {
      "description": "Metering scope for one usage interval.\n\nCompute and retained-storage intervals are independent meters and may overlap in time.\nA known record must set non-applicable dimensions to zero so a stored interval cannot be\ninterpreted as both compute and storage usage.",
      "enum": [
        "compute",
        "storage"
      ],
      "type": "string"
    },
    "ResourceUsageQuantities": {
      "additionalProperties": false,
      "description": "Quantities captured from a provider meter. Values are integral base units.",
      "properties": {
        "cpuMillicoreSeconds": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "gpuUnitSeconds": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "memoryByteSeconds": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "storageByteSeconds": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "cpuMillicoreSeconds",
        "memoryByteSeconds",
        "storageByteSeconds",
        "gpuUnitSeconds"
      ],
      "type": "object"
    },
    "ResourceUsageTarget": {
      "description": "Durable owner of one usage interval.\n\nWork and task meters point at the Resource request and (for trusted internal\ndelivery) its Lease. Experiment meters point directly at the Environment\nreservation; Resource resolves the project, course, owner, approved\nresources, and GPU allocation from its saved authorization instead of\naccepting those fields from a meter payload.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "resource_request",
              "type": "string"
            },
            "leaseId": {
              "anyOf": [
                {
                  "$ref": "#/$defs/LeaseId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "requestId": {
              "$ref": "#/$defs/ResourceRequestId"
            }
          },
          "required": [
            "kind",
            "requestId"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "environmentId": {
              "$ref": "#/$defs/EnvironmentId"
            },
            "kind": {
              "const": "experiment_environment",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "environmentId"
          ],
          "type": "object"
        }
      ]
    },
    "UsageMeasurement": {
      "description": "Known or explicitly unknown provider measurement.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "quantities": {
              "$ref": "#/$defs/ResourceUsageQuantities"
            },
            "state": {
              "const": "known",
              "type": "string"
            }
          },
          "required": [
            "state",
            "quantities"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "reason": {
              "type": "string"
            },
            "state": {
              "const": "unknown",
              "type": "string"
            }
          },
          "required": [
            "state",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "UtcTimestamp": {
      "description": "UTC timestamp serialized with a literal `Z` and millisecond precision.",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Provider usage submitted by a trusted Resource meter or reconciler.",
  "properties": {
    "kind": {
      "$ref": "#/$defs/ResourceUsageKind"
    },
    "measuredFrom": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "measuredUntil": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "measurement": {
      "$ref": "#/$defs/UsageMeasurement"
    },
    "sourceEventId": {
      "$ref": "#/$defs/EventId"
    },
    "target": {
      "$ref": "#/$defs/ResourceUsageTarget"
    }
  },
  "required": [
    "kind",
    "target",
    "sourceEventId",
    "measuredFrom",
    "measuredUntil",
    "measurement"
  ],
  "title": "RecordResourceUsageRequest",
  "type": "object"
}
