{
  "$defs": {
    "AgentRunId": {
      "description": "Strongly typed UUIDv7 identifier for `AgentRunId`.",
      "type": "string"
    },
    "ContainerWorkExecutionState": {
      "description": "Lifecycle of one Environment-owned Work configuration execution.",
      "enum": [
        "running",
        "succeeded",
        "failed",
        "cancelling",
        "cancelled",
        "cleanup_pending",
        "cleanup_failed"
      ],
      "type": "string"
    },
    "DiagnosticCode": {
      "description": "Stable machine-readable diagnostic code.\n\nConsumers must treat an unknown `LW_*` code as blocking. The newtype is intentionally open so\nadditive diagnostics do not force a wire-version change.",
      "type": "string"
    },
    "EnvironmentId": {
      "description": "Strongly typed UUIDv7 identifier for `EnvironmentId`.",
      "type": "string"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "UtcTimestamp": {
      "description": "UTC timestamp serialized with a literal `Z` and millisecond precision.",
      "type": "string"
    },
    "WorkConfigurationPlanId": {
      "description": "Strongly typed UUIDv7 identifier for `WorkConfigurationPlanId`.",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Environment receipt for one execution with bounded execution output.",
  "properties": {
    "diagnosticCode": {
      "anyOf": [
        {
          "$ref": "#/$defs/DiagnosticCode"
        },
        {
          "type": "null"
        }
      ]
    },
    "environmentId": {
      "$ref": "#/$defs/EnvironmentId"
    },
    "environmentRevision": {
      "$ref": "#/$defs/Revision"
    },
    "executionId": {
      "type": "string"
    },
    "exitCode": {
      "format": "int32",
      "type": [
        "integer",
        "null"
      ]
    },
    "finishedAt": {
      "anyOf": [
        {
          "$ref": "#/$defs/UtcTimestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "output": {
      "type": "string"
    },
    "outputTruncated": {
      "type": "boolean"
    },
    "planId": {
      "$ref": "#/$defs/WorkConfigurationPlanId"
    },
    "planRevision": {
      "$ref": "#/$defs/Revision"
    },
    "runId": {
      "$ref": "#/$defs/AgentRunId"
    },
    "startedAt": {
      "anyOf": [
        {
          "$ref": "#/$defs/UtcTimestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "$ref": "#/$defs/ContainerWorkExecutionState"
    },
    "targetPodUid": {
      "type": "string"
    },
    "verificationExitCode": {
      "format": "int32",
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "required": [
    "executionId",
    "runId",
    "planId",
    "planRevision",
    "environmentId",
    "environmentRevision",
    "targetPodUid",
    "state",
    "output",
    "outputTruncated"
  ],
  "title": "ContainerWorkExecutionReceipt",
  "type": "object"
}
