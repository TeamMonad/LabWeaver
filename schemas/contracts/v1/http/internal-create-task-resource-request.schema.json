{
  "$defs": {
    "ActorId": {
      "description": "Strongly typed UUIDv7 identifier for `ActorId`.",
      "type": "string"
    },
    "CourseId": {
      "description": "Strongly typed UUIDv7 identifier for `CourseId`.",
      "type": "string"
    },
    "GpuRequest": {
      "additionalProperties": false,
      "description": "A policy-catalogued GPU class. It intentionally does not expose Kubernetes resource names.",
      "properties": {
        "class": {
          "type": "string"
        },
        "count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "class",
        "count"
      ],
      "type": "object"
    },
    "ProjectId": {
      "description": "Strongly typed UUIDv7 identifier for `ProjectId`.",
      "type": "string"
    },
    "TaskRunId": {
      "description": "Strongly typed UUIDv7 identifier for `TaskRunId`.",
      "type": "string"
    },
    "WorkloadResources": {
      "additionalProperties": false,
      "description": "Requested or approved workload resources, independent of Kubernetes quantity syntax.",
      "properties": {
        "cpuMillicores": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "gpu": {
          "anyOf": [
            {
              "$ref": "#/$defs/GpuRequest"
            },
            {
              "type": "null"
            }
          ]
        },
        "memoryBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "storageBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "cpuMillicores",
        "memoryBytes",
        "storageBytes"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Evaluation-owned request for a new one-shot task resource reservation.\n\nResource derives the requester and task target from this immutable command in one database\ntransaction. The route is service-authenticated and never accepts a browser delegation.",
  "properties": {
    "approvalTimeoutMilliseconds": {
      "description": "Approval wait captured once by Resource using its database clock.\nSame-attempt recovery keeps the original deadline.",
      "format": "uint64",
      "maximum": 3600000,
      "minimum": 1,
      "type": "integer"
    },
    "courseId": {
      "anyOf": [
        {
          "$ref": "#/$defs/CourseId"
        },
        {
          "type": "null"
        }
      ]
    },
    "durationSeconds": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "ownerId": {
      "$ref": "#/$defs/ActorId"
    },
    "projectId": {
      "$ref": "#/$defs/ProjectId"
    },
    "requestKey": {
      "type": "string"
    },
    "resources": {
      "$ref": "#/$defs/WorkloadResources"
    },
    "taskRunId": {
      "$ref": "#/$defs/TaskRunId"
    }
  },
  "required": [
    "taskRunId",
    "projectId",
    "ownerId",
    "requestKey",
    "resources",
    "durationSeconds",
    "approvalTimeoutMilliseconds"
  ],
  "title": "InternalCreateTaskResourceRequest",
  "type": "object"
}
