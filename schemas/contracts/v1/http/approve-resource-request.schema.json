{
  "$defs": {
    "GpuRequest": {
      "additionalProperties": false,
      "description": "A policy-catalogued GPU class. It intentionally does not expose Kubernetes resource names.",
      "properties": {
        "class": {
          "type": "string"
        },
        "count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "class",
        "count"
      ],
      "type": "object"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "WorkloadResources": {
      "additionalProperties": false,
      "description": "Requested or approved workload resources, independent of Kubernetes quantity syntax.",
      "properties": {
        "cpuMillicores": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "gpu": {
          "anyOf": [
            {
              "$ref": "#/$defs/GpuRequest"
            },
            {
              "type": "null"
            }
          ]
        },
        "memoryBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "storageBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "cpuMillicores",
        "memoryBytes",
        "storageBytes"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Administrator approval or resize decision. The selected Provider is always explicit.",
  "properties": {
    "durationSeconds": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "expectedRevision": {
      "$ref": "#/$defs/Revision"
    },
    "providerBinding": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "resources": {
      "$ref": "#/$defs/WorkloadResources"
    }
  },
  "required": [
    "expectedRevision",
    "providerBinding",
    "resources",
    "durationSeconds",
    "reason"
  ],
  "title": "ApproveResourceRequest",
  "type": "object"
}
