{
  "$defs": {
    "EnvironmentId": {
      "description": "Strongly typed UUIDv7 identifier for `EnvironmentId`.",
      "type": "string"
    },
    "GpuAllocation": {
      "additionalProperties": false,
      "description": "The catalog resolution captured on an approved capacity claim.",
      "properties": {
        "allocationBinding": {
          "type": "string"
        },
        "catalogRevision": {
          "$ref": "#/$defs/Revision"
        },
        "class": {
          "type": "string"
        },
        "count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "entryId": {
          "$ref": "#/$defs/GpuCatalogEntryId",
          "description": "Exact catalog row used to resolve this allocation."
        },
        "mode": {
          "$ref": "#/$defs/GpuAllocationMode"
        },
        "providerBinding": {
          "type": "string"
        }
      },
      "required": [
        "entryId",
        "class",
        "count",
        "mode",
        "providerBinding",
        "allocationBinding",
        "catalogRevision"
      ],
      "type": "object"
    },
    "GpuAllocationMode": {
      "description": "Allocation mode selected by the Resource GPU catalog.\n\nCallers submit only a catalog class and count. The mode is resolved from the\nactive catalog entry and is never accepted as an untrusted request override.",
      "enum": [
        "exclusive",
        "container_time_slice",
        "vm_vgpu"
      ],
      "type": "string"
    },
    "GpuCatalogEntryId": {
      "description": "Strongly typed UUIDv7 identifier for `GpuCatalogEntryId`.",
      "type": "string"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Resource-authoritative resolution returned to Environment.",
  "properties": {
    "allocation": {
      "$ref": "#/$defs/GpuAllocation"
    },
    "environmentId": {
      "$ref": "#/$defs/EnvironmentId"
    },
    "providerBinding": {
      "type": "string"
    },
    "version": {
      "format": "uint8",
      "maximum": 255,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "version",
    "environmentId",
    "providerBinding",
    "allocation"
  ],
  "title": "ResolveEnvironmentGpuAllocationResponse",
  "type": "object"
}
