{
  "$defs": {
    "ActorId": {
      "description": "Strongly typed UUIDv7 identifier for `ActorId`.",
      "type": "string"
    },
    "CourseId": {
      "description": "Strongly typed UUIDv7 identifier for `CourseId`.",
      "type": "string"
    },
    "CourseRosterImportRowResult": {
      "additionalProperties": false,
      "properties": {
        "actorId": {
          "anyOf": [
            {
              "$ref": "#/$defs/ActorId"
            },
            {
              "type": "null"
            }
          ]
        },
        "campusUsername": {
          "type": "string"
        },
        "diagnosticCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "invitationId": {
          "anyOf": [
            {
              "$ref": "#/$defs/MembershipInvitationId"
            },
            {
              "type": "null"
            }
          ]
        },
        "result": {
          "$ref": "#/$defs/CourseRosterImportRowState"
        },
        "role": {
          "anyOf": [
            {
              "$ref": "#/$defs/CourseRosterRole"
            },
            {
              "type": "null"
            }
          ]
        },
        "rowNumber": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "rowNumber",
        "campusUsername",
        "result"
      ],
      "type": "object"
    },
    "CourseRosterImportRowState": {
      "enum": [
        "imported",
        "already_member",
        "invited",
        "duplicate_in_file",
        "unknown_account",
        "invalid_role",
        "invalid_row",
        "rejected"
      ],
      "type": "string"
    },
    "CourseRosterRole": {
      "enum": [
        "participant",
        "teaching_assistant"
      ],
      "type": "string"
    },
    "MembershipInvitationId": {
      "description": "Strongly typed UUIDv7 identifier for `MembershipInvitationId`.",
      "type": "string"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "courseId": {
      "$ref": "#/$defs/CourseId"
    },
    "revision": {
      "$ref": "#/$defs/Revision"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/CourseRosterImportRowResult"
      },
      "type": "array"
    }
  },
  "required": [
    "courseId",
    "revision",
    "rows"
  ],
  "title": "CourseRosterImportResult",
  "type": "object"
}
