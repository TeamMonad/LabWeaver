          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "collector",
        "llmReadable"
      ],
      "type": "object"
    },
    "TerminalSpec": {
      "additionalProperties": false,
      "description": "Bounded direct-exec terminal owned by an immutable Container release.",
      "properties": {
        "args": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "executable": {
          "type": "string"
        },
        "workingDirectory": {
          "type": "string"
        }
      },
      "required": [
        "executable",
        "workingDirectory"
      ],
      "type": "object"
    },
    "TestGroup": {
      "additionalProperties": false,
      "description": "One deterministic program test group.",
      "properties": {
        "maxPoints": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "source",
        "maxPoints"
      ],
      "type": "object"
    },
    "UtcTimestamp": {
      "description": "UTC timestamp serialized with a literal `Z` and millisecond precision.",
      "type": "string"
    },
    "VirtualMachineBaseDisk": {
      "additionalProperties": false,
      "description": "Deployment-owned immutable KubeVirt base-disk identity.\n\nUnlike an object-store `ArtifactRef`, this identifies a CDI source image and its imported\ndisk content. `capacity_bytes` is the reviewed PVC capacity, not a fabricated object length.",
      "properties": {
        "binding": {
          "type": "string"
        },
        "capacityBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "sourceRegistryDigest": {
          "type": "string"
        }
      },
      "required": [
        "binding",
        "sourceRegistryDigest",
        "capacityBytes"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Terminal or in-progress Agent result used to rebuild Control projections after replay.",
  "properties": {
    "environmentCandidate": {
      "anyOf": [
        {
          "$ref": "#/$defs/EnvironmentCandidate"
        },
        {
          "type": "null"
        }
      ],
      "description": "Validated Environment candidate, if that track succeeded."
    },
    "evaluationCandidate": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvaluationCandidate"
        },
        {
          "type": "null"
        }
      ],
      "description": "Validated Evaluation candidate, if that track succeeded."
    },
    "run": {
      "$ref": "#/$defs/AgentRun",
      "description": "Authoritative aggregate."
    }
  },
  "required": [
    "run"
  ],
  "title": "InternalAgentRunOutcome",
  "type": "object"
}
