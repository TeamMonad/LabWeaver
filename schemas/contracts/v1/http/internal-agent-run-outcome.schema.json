{
  "$defs": {
    "AdvisoryFailurePolicy": {
      "description": "Failure behavior for an Advisory step.",
      "oneOf": [
        {
          "const": "continue_advisory",
          "description": "Preserve the advisory failure without changing deterministic results.",
          "type": "string"
        }
      ]
    },
    "AdvisoryOutputMode": {
      "description": "Supported non-scoring advisory output mode.",
      "oneOf": [
        {
          "const": "goal_assessment",
          "description": "Emit a `goal-review/v1` assessment.",
          "type": "string"
        }
      ]
    },
    "AdvisoryRunnerSpec": {
      "description": "Advisory Runner configurations, structurally separated from scoring.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Reviews allowlisted submission paths without producing a score.",
          "properties": {
            "include": {
              "description": "Submission-relative paths visible to the LLM.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "kind": {
              "const": "llm_review",
              "type": "string"
            },
            "outputMode": {
              "$ref": "#/$defs/AdvisoryOutputMode",
              "description": "Versioned advisory output shape."
            },
            "rubric": {
              "description": "Immutable advisory rubric locator.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "include",
            "rubric",
            "outputMode"
          ],
          "type": "object"
        }
      ]
    },
    "AgentAttempt": {
      "additionalProperties": false,
      "description": "One append-only attempt in an Agent track.",
      "properties": {
        "checkpoint": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "diagnosticCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "number": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "state": {
          "$ref": "#/$defs/AgentAttemptState"
        },
        "usage": {
          "$ref": "#/$defs/LlmUsage"
        },
        "usageObserved": {
          "description": "Whether a terminal provider envelope made this usage observable.",
          "type": "boolean"
        }
      },
      "required": [
        "number",
        "state",
        "usage",
        "usageObserved"
      ],
      "type": "object"
    },
    "AgentAttemptState": {
      "description": "State of one immutable Agent attempt.",
      "enum": [
        "pending",
        "running",
        "repairing",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "AgentRun": {
      "additionalProperties": false,
      "description": "One idempotent, auditable dual-candidate Agent run.",
      "properties": {
        "courseId": {
          "$ref": "#/$defs/CourseId"
        },
        "id": {
          "$ref": "#/$defs/AgentRunId"
        },
        "packageId": {
          "$ref": "#/$defs/ProblemPackageId"
        },
        "policyId": {
          "$ref": "#/$defs/PolicyId"
        },
        "policyRevision": {
          "$ref": "#/$defs/Revision"
        },
        "requestedRuntime": {
          "$ref": "#/$defs/RuntimeKind"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "state": {
          "$ref": "#/$defs/AgentRunState"
        },
        "tracks": {
          "items": {
            "$ref": "#/$defs/AgentTrack"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "courseId",
        "packageId",
        "policyId",
        "policyRevision",
        "requestedRuntime",
        "state",
        "revision",
        "tracks"
      ],
      "type": "object"
    },
    "AgentRunId": {
      "description": "Strongly typed UUIDv7 identifier for `AgentRunId`.",
      "type": "string"
    },
    "AgentRunState": {
      "description": "Aggregate AgentRun state derived from both tracks.",
      "enum": [
        "requested",
        "running",
        "partially_succeeded",
        "succeeded",
        "failed",
        "cancelling",
        "cancelled"
      ],
      "type": "string"
    },
    "AgentTrack": {
      "additionalProperties": false,
      "description": "Independent track and its retained attempts.",
      "properties": {
        "attempts": {
          "items": {
            "$ref": "#/$defs/AgentAttempt"
          },
          "type": "array"
        },
        "candidateId": {
          "anyOf": [
            {
              "$ref": "#/$defs/CandidateId"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "$ref": "#/$defs/AgentTrackKind"
        }
      },
      "required": [
        "kind",
        "attempts"
      ],
      "type": "object"
    },
    "AgentTrackKind": {
      "description": "Independent Agent track.",
      "enum": [
        "environment",
        "evaluation"
      ],
      "type": "string"
    },
    "AggregationGate": {
      "additionalProperties": false,
      "description": "Required Gate status used by deterministic aggregation.",
      "properties": {
        "requiredStatus": {
          "$ref": "#/$defs/RequiredStatus"
        },
        "step": {
          "type": "string"
        }
      },
      "required": [
        "step",
        "requiredStatus"
      ],
      "type": "object"
    },
    "AggregationKind": {
      "description": "Supported deterministic aggregation algorithm.",
      "oneOf": [
        {
          "const": "deterministic_sum",
          "description": "Checked sum of deterministic Score steps.",
          "type": "string"
        }
      ]
    },
    "AggregationSpec": {
      "additionalProperties": false,
      "description": "Pure deterministic score aggregation contract.",
      "properties": {
        "gates": {
          "items": {
            "$ref": "#/$defs/AggregationGate"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/AggregationKind"
        },
        "maxScore": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "maxScore",
        "gates"
      ],
      "type": "object"
    },
    "ArtifactId": {
      "description": "Strongly typed UUIDv7 identifier for `ArtifactId`.",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Immutable object-store identity without a machine-local path or credential.",
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/ArtifactId",
          "description": "Stable metadata identity resolved by the owning service."
        },
        "mediaType": {
          "description": "Registered media type.",
          "type": "string"
        },
        "objectVersion": {
          "description": "Immutable backend object version.",
          "type": "string"
        },
        "sizeBytes": {
          "description": "Raw object length.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "storeBinding": {
          "description": "Explicit object-store binding from deployment configuration.",
          "type": "string"
        }
      },
      "required": [
        "artifactId",
        "storeBinding",
        "objectVersion",
        "sizeBytes",
        "mediaType"
      ],
      "type": "object"
    },
    "CandidateId": {
      "description": "Strongly typed UUIDv7 identifier for `CandidateId`.",
      "type": "string"
    },
    "CheckerSpec": {
      "description": "Deterministic Checker configurations frozen for v1.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Exact byte-oriented comparison.",
          "properties": {
            "kind": {
              "const": "exact",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Whitespace-insensitive token comparison.",
          "properties": {
            "kind": {
              "const": "token",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Process exit-code comparison.",
          "properties": {
            "expected": {
              "description": "Required exit code.",
              "format": "int32",
              "type": "integer"
            },
            "kind": {
              "const": "exit_code",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "expected"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "JSON Schema document validation.",
          "properties": {
            "kind": {
              "const": "json_schema",
              "type": "string"
            },
            "schemaRef": {
              "description": "Immutable schema locator.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "schemaRef"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "System service state comparison.",
          "properties": {
            "expected": {
              "$ref": "#/$defs/ExpectedServiceState",
              "description": "Required service state."
            },
            "kind": {
              "const": "service_state",
              "type": "string"
            },
            "service": {
              "description": "Stable service name.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "service",
            "expected"
          ],
          "type": "object"
        }
      ]
    },
    "CollectorSpec": {
      "description": "Supported P0 submission collectors.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Collects an allowlisted workspace snapshot.",
          "properties": {
            "exclude": {
              "default": [],
              "description": "Excluded submission-relative paths.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "include": {
              "description": "Included submission-relative paths.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "kind": {
              "const": "workspace_snapshot",
              "type": "string"
            },
            "maxBytes": {
              "description": "Maximum collected bytes.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "include",
            "maxBytes"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Collects bounded system facts for a Linux experiment.",
          "properties": {
            "facts": {
              "description": "Named facts to collect.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "kind": {
              "const": "system_facts",
              "type": "string"
            },
            "maxBytes": {
              "description": "Maximum collected bytes.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "facts",
            "maxBytes"
          ],
          "type": "object"
        }
      ]
    },
    "CourseId": {
      "description": "Strongly typed UUIDv7 identifier for `CourseId`.",
      "type": "string"
    },
    "DeterministicRunnerSpec": {
      "description": "Deterministic Runner configurations frozen for P0 OJ and Linux evaluation.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Verifies that allowlisted submission files exist.",
          "properties": {
            "kind": {
              "const": "file_assertion",
              "type": "string"
            },
            "requiredFiles": {
              "description": "Required submission-relative files.",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "requiredFiles"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Compiles or tests a program through an approved toolchain profile.",
          "properties": {
            "input": {
              "description": "Submission-relative program input.",
              "type": "string"
            },
            "kind": {
              "const": "program",
              "type": "string"
            },
            "limits": {
              "$ref": "#/$defs/ExecutionLimits",
              "description": "Mandatory execution limits."
            },
            "phase": {
              "$ref": "#/$defs/ProgramPhase",
              "description": "Compile or test phase."
            },
            "testGroups": {
              "default": [],
              "description": "Deterministic test groups used by the test phase.",
              "items": {
                "$ref": "#/$defs/TestGroup"
              },
              "type": "array"
            },
            "toolchainProfile": {
              "description": "Explicit approved toolchain binding.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "toolchainProfile",
            "phase",
            "input",
            "limits"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Executes a read-only approved Ansible probe profile.",
          "properties": {
            "assertions": {
              "description": "Facts expected from the probe.",
              "items": {
                "$ref": "#/$defs/FactAssertion"
              },
              "type": "array"
            },
            "kind": {
              "const": "ansible_probe",
              "type": "string"
            },
            "moduleAllowlist": {
              "description": "Modules requested from the frozen P0 allowlist.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "playbookProfile": {
              "description": "Explicit approved playbook binding.",
              "type": "string"
            },
            "readOnly": {
              "description": "Must remain true in v1.",
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "playbookProfile",
            "moduleAllowlist",
            "readOnly",
            "assertions"
          ],
          "type": "object"
        }
      ]
    },
    "EndpointProtocol": {
      "description": "Supported controlled protocols.",
      "enum": [
        "http",
        "https",
        "ssh"
      ],
      "type": "string"
    },
    "EnvironmentApiVersion": {
      "enum": [
        "environment.labweaver.io/v1"
      ],
      "type": "string"
    },
    "EnvironmentCandidate": {
      "additionalProperties": false,
      "description": "Immutable validated Environment candidate.",
      "properties": {
        "createdAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "id": {
          "$ref": "#/$defs/CandidateId"
        },
        "model": {
          "type": "string"
        },
        "policyRevision": {
          "$ref": "#/$defs/Revision"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "runId": {
          "$ref": "#/$defs/AgentRunId"
        },
        "spec": {
          "$ref": "#/$defs/EnvironmentSpec"
        }
      },
      "required": [
        "id",
        "runId",
        "revision",
        "spec",
        "policyRevision",
        "model",
        "createdAt"
      ],
      "type": "object"
    },
    "EnvironmentClass": {
      "description": "Environment business class retained from the v2.1 architecture.",
      "enum": [
        "experiment",
        "work"
      ],
      "type": "string"
    },
    "EnvironmentDocumentKind": {
      "enum": [
        "EnvironmentSpec"
      ],
      "type": "string"
    },
    "EnvironmentEntrySpec": {
      "additionalProperties": false,
      "description": "One named service entry exposed only through the controlled access plane.",
      "properties": {
        "name": {
          "type": "string"
        },
        "protocol": {
          "$ref": "#/$defs/EndpointProtocol"
        },
        "servicePort": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "protocol",
        "servicePort"
      ],
      "type": "object"
    },
    "EnvironmentRuntimeSpec": {
      "description": "Strict runtime-specific environment shape.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "base_image_digest": {
              "type": "string"
            },
            "build_context": {
              "$ref": "#/$defs/ArtifactRef"
            },
            "kind": {
              "const": "container",
              "type": "string"
            },
            "provider_binding": {
              "type": "string"
            },
            "service_port": {
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "terminal": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TerminalSpec"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "provider_binding",
            "build_context",
            "base_image_digest",
            "service_port"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "base_disk": {
              "$ref": "#/$defs/VirtualMachineBaseDisk"
            },
            "kind": {
              "const": "virtual_machine",
              "type": "string"
            },
            "provider_binding": {
              "type": "string"
            },
            "ssh_port": {
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "storage_class_binding": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "provider_binding",
            "base_disk",
            "storage_class_binding",
            "ssh_port"
          ],
          "type": "object"
        }
      ]
    },
    "EnvironmentSecuritySpec": {
      "additionalProperties": false,
      "description": "Runtime-independent minimum security posture.",
      "properties": {
        "privilegeEscalationPolicy": {
          "$ref": "#/$defs/PrivilegeEscalationPolicy"
        },
        "publicExposurePolicy": {
          "$ref": "#/$defs/PublicExposurePolicy"
        },
        "rootFilesystemPolicy": {
          "$ref": "#/$defs/RootFilesystemPolicy"
        },
        "securityProfileBinding": {
          "type": "string"
        },
        "userPolicy": {
          "$ref": "#/$defs/RuntimeUserPolicy"
        }
      },
      "required": [
        "userPolicy",
        "rootFilesystemPolicy",
        "privilegeEscalationPolicy",
        "publicExposurePolicy",
        "securityProfileBinding"
      ],
      "type": "object"
    },
    "EnvironmentSpec": {
      "additionalProperties": false,
      "description": "Stable EnvironmentSpec v1.",
      "properties": {
        "apiVersion": {
          "$ref": "#/$defs/EnvironmentApiVersion"
        },
        "class": {
          "$ref": "#/$defs/EnvironmentClass"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/EnvironmentEntrySpec"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/EnvironmentDocumentKind"
        },
        "name": {
          "type": "string"
        },
        "network": {
          "$ref": "#/$defs/NetworkPolicySpec"
        },
        "resources": {
          "$ref": "#/$defs/ResourceRequirements"
        },
        "retention": {
          "$ref": "#/$defs/RetentionSnapshot"
        },
        "runtime": {
          "$ref": "#/$defs/EnvironmentRuntimeSpec"
        },
        "security": {
          "$ref": "#/$defs/EnvironmentSecuritySpec"
        }
      },
      "required": [
        "apiVersion",
        "kind",
        "name",
        "class",
        "resources",
        "network",
        "entries",
        "security",
        "runtime",
        "retention"
      ],
      "type": "object"
    },
    "EvaluationApiVersion": {
      "enum": [
        "evaluation.labweaver.io/v1"
      ],
      "type": "string"
    },
    "EvaluationBody": {
      "additionalProperties": false,
      "description": "Submission, step, aggregation, and review decomposition of an evaluation.",
      "properties": {
        "aggregation": {
          "$ref": "#/$defs/AggregationSpec"
        },
        "review": {
          "$ref": "#/$defs/ReviewPolicy"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/EvaluationStep"
          },
          "type": "array"
        },
        "submission": {
          "$ref": "#/$defs/SubmissionSpec"
        }
      },
      "required": [
        "submission",
        "steps",
        "aggregation",
        "review"
      ],
      "type": "object"
    },
    "EvaluationCandidate": {
      "additionalProperties": false,
      "description": "Immutable validated Evaluation candidate.",
      "properties": {
        "createdAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "id": {
          "$ref": "#/$defs/CandidateId"
        },
        "model": {
          "type": "string"
        },
        "policyRevision": {
          "$ref": "#/$defs/Revision"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "runId": {
          "$ref": "#/$defs/AgentRunId"
        },
        "spec": {
          "$ref": "#/$defs/EvaluationSpec"
        }
      },
      "required": [
        "id",
        "runId",
        "revision",
        "spec",
        "policyRevision",
        "model",
        "createdAt"
      ],
      "type": "object"
    },
    "EvaluationKind": {
      "enum": [
        "EvaluationSpec"
      ],
      "type": "string"
    },
    "EvaluationMetadata": {
      "additionalProperties": false,
      "description": "Stable name and version of an evaluation definition.",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "EvaluationSpec": {
      "additionalProperties": false,
      "description": "Versioned evaluation definition shared by OJ and Linux system experiments.",
      "properties": {
        "apiVersion": {
          "$ref": "#/$defs/EvaluationApiVersion"
        },
        "kind": {
          "$ref": "#/$defs/EvaluationKind"
        },
        "metadata": {
          "$ref": "#/$defs/EvaluationMetadata"
        },
        "spec": {
          "$ref": "#/$defs/EvaluationBody"
        }
      },
      "required": [
        "apiVersion",
        "kind",
        "metadata",
        "spec"
      ],
      "type": "object"
    },
    "EvaluationStep": {
      "description": "A role-specific evaluation step.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A deterministic prerequisite that can stop downstream execution.",
          "properties": {
            "checker": {
              "$ref": "#/$defs/CheckerSpec"
            },
            "dependsOn": {
              "default": [],
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "failurePolicy": {
              "$ref": "#/$defs/GateFailurePolicy"
            },
            "id": {
              "type": "string"
            },
            "role": {
              "const": "gate",
              "type": "string"
            },
            "runner": {
              "$ref": "#/$defs/DeterministicRunnerSpec"
            }
          },
          "required": [
            "role",
            "id",
            "runner",
            "checker",
            "failurePolicy"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A deterministic step that contributes to aggregation.",
          "properties": {
            "checker": {
              "$ref": "#/$defs/CheckerSpec"
            },
            "dependsOn": {
              "default": [],
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "failurePolicy": {
              "$ref": "#/$defs/ScoreFailurePolicy"
            },
            "id": {
              "type": "string"
            },
            "role": {
              "const": "score",
              "type": "string"
            },
            "runner": {
              "$ref": "#/$defs/DeterministicRunnerSpec"
            },
            "score": {
              "$ref": "#/$defs/ScoreSpec"
            }
          },
          "required": [
            "role",
            "id",
            "runner",
            "checker",
            "score",
            "failurePolicy"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A non-scoring advisory review step.",
          "properties": {
            "dependsOn": {
              "default": [],
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "failurePolicy": {
              "$ref": "#/$defs/AdvisoryFailurePolicy"
            },
            "id": {
              "type": "string"
            },
            "role": {
              "const": "advisory",
              "type": "string"
            },
            "runner": {
              "$ref": "#/$defs/AdvisoryRunnerSpec"
            }
          },
          "required": [
            "role",
            "id",
            "runner",
            "failurePolicy"
          ],
          "type": "object"
        }
      ]
    },
    "ExecutionLimits": {
      "additionalProperties": false,
      "description": "Resource and output limits for a program Runner.",
      "properties": {
        "memoryBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "outputBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "wallTimeSeconds": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "wallTimeSeconds",
        "memoryBytes",
        "outputBytes"
      ],
      "type": "object"
    },
    "ExpectedServiceState": {
      "description": "Expected state of a system service.",
      "oneOf": [
        {
          "const": "active",
          "description": "Service is active.",
          "type": "string"
        },
        {
          "const": "inactive",
          "description": "Service is inactive.",
          "type": "string"
        }
      ]
    },
    "FactAssertion": {
      "additionalProperties": false,
      "description": "Expected fact emitted by a Linux probe.",
      "properties": {
        "expected": true,
        "fact": {
          "type": "string"
        }
      },
      "required": [
        "fact",
        "expected"
      ],
      "type": "object"
    },
    "GateFailurePolicy": {
      "description": "Failure behavior for a Gate step.",
      "oneOf": [
        {
          "const": "stop",
          "description": "Stop downstream deterministic execution.",
          "type": "string"
        }
      ]
    },
    "LlmUsage": {
      "additionalProperties": false,
      "description": "Frozen LLM usage for one attempt.",
      "properties": {
        "costMicrousd": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "inputTokens": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "outputTokens": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "requests": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "inputTokens",
        "outputTokens",
        "requests",
        "costMicrousd"
      ],
      "type": "object"
    },
    "ManualReviewReason": {
      "description": "Conditions that force manual teacher review.",
      "oneOf": [
        {
          "const": "infrastructureError",
          "description": "Runner or infrastructure execution failed independently of student work.",
          "type": "string"
        },
        {
          "const": "invalidEvidence",
          "description": "Evidence is missing, malformed, or fails identity validation.",
          "type": "string"
        }
      ]
    },
    "NetworkPolicySpec": {
      "description": "Network egress posture for a published environment.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "allow_all",
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "deny_all",
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "restricted",
              "type": "string"
            },
            "policy_binding": {
              "type": "string"
            }
          },
          "required": [
            "mode",
            "policy_binding"
          ],
          "type": "object"
        }
      ]
    },
    "PolicyId": {
      "description": "Strongly typed UUIDv7 identifier for `PolicyId`.",
      "type": "string"
    },
    "PrivilegeEscalationPolicy": {
      "enum": [
        "deny"
      ],
      "type": "string"
    },
    "ProblemPackageId": {
      "description": "Strongly typed UUIDv7 identifier for `ProblemPackageId`.",
      "type": "string"
    },
    "ProgramPhase": {
      "description": "Approved program Runner phase.",
      "oneOf": [
        {
          "const": "compile",
          "description": "Compile the submitted program.",
          "type": "string"
        },
        {
          "const": "test",
          "description": "Execute deterministic test groups.",
          "type": "string"
        }
      ]
    },
    "PublicExposurePolicy": {
      "enum": [
        "deny"
      ],
      "type": "string"
    },
    "RequiredStatus": {
      "description": "Required deterministic Gate terminal status.",
      "oneOf": [
        {
          "const": "passed",
          "description": "The Gate must pass.",
          "type": "string"
        }
      ]
    },
    "ResourceRequirements": {
      "additionalProperties": false,
      "description": "Bounded runtime resources expressed without Kubernetes-dependent parsing.",
      "properties": {
        "cpuMillicores": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "memoryBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "storageBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "cpuMillicores",
        "memoryBytes",
        "storageBytes"
      ],
      "type": "object"
    },
    "RetentionClass": {
      "description": "Retention classes with distinct privacy and recovery requirements.",
      "enum": [
        "course_material",
        "build_evidence",
        "run_evidence",
        "student_submission",
        "security_audit"
      ],
      "type": "string"
    },
    "RetentionDisposition": {
      "description": "Required action after retention expires.",
      "enum": [
        "delete",
        "purge_after_export",
        "retain_sanitized_receipt"
      ],
      "type": "string"
    },
    "RetentionSnapshot": {
      "additionalProperties": false,
      "description": "Frozen data-retention decision for an immutable resource.",
      "properties": {
        "class": {
          "$ref": "#/$defs/RetentionClass",
          "description": "Stable retention class."
        },
        "disposition": {
          "$ref": "#/$defs/RetentionDisposition",
          "description": "Required terminal disposition."
        },
        "policyId": {
          "$ref": "#/$defs/PolicyId",
          "description": "Policy identity."
        },
        "policyRevision": {
          "$ref": "#/$defs/Revision",
          "description": "Exact policy revision used at creation."
        },
        "retainUntil": {
          "$ref": "#/$defs/UtcTimestamp",
          "description": "Absolute retention boundary."
        }
      },
      "required": [
        "policyId",
        "policyRevision",
        "class",
        "retainUntil",
        "disposition"
      ],
      "type": "object"
    },
    "ReviewPolicy": {
      "additionalProperties": false,
      "description": "Mandatory approval and manual-review policy.",
      "properties": {
        "forceManualWhen": {
          "items": {
            "$ref": "#/$defs/ManualReviewReason"
          },
          "type": "array"
        },
        "teacherApprovalRequiredForRelease": {
          "const": true,
          "type": "boolean"
        }
      },
      "required": [
        "teacherApprovalRequiredForRelease",
        "forceManualWhen"
      ],
      "type": "object"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "RootFilesystemPolicy": {
      "enum": [
        "read_only_required",
        "mutable_required"
      ],
      "type": "string"
    },
    "RuntimeKind": {
      "description": "Runtime kind shared by candidates, releases, and instances.",
      "enum": [
        "container",
        "virtual_machine"
      ],
      "type": "string"
    },
    "RuntimeUserPolicy": {
      "enum": [
        "non_root_required"
      ],
      "type": "string"
    },
    "ScoreFailurePolicy": {
      "description": "Failure behavior for a Score step.",
      "oneOf": [
        {
          "const": "stop",
          "description": "Stop downstream deterministic execution.",
          "type": "string"
        },
        {
          "const": "continue",
          "description": "Continue with independent steps while preserving the failure.",
          "type": "string"
        }
      ]
    },
    "ScoreSpec": {
      "additionalProperties": false,
      "description": "Maximum contribution of a deterministic Score step.",
      "properties": {
        "max": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "max"
      ],
      "type": "object"
    },
    "SubmissionSpec": {
      "additionalProperties": false,
      "description": "Submission collection boundary used before evaluation starts.",
      "properties": {
        "collector": {
          "$ref": "#/$defs/CollectorSpec"
        },
