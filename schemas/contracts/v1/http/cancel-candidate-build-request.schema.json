{
  "$defs": {
    "BuildRequestId": {
      "description": "Strongly typed UUIDv7 identifier for `BuildRequestId`.",
      "type": "string"
    },
    "InternalAgentBuildState": {
      "description": "Agent-owned durable state used as an optimistic precondition for build cancellation.",
      "enum": [
        "requested",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The state and revision the caller actually reviewed before requesting cancellation.",
  "properties": {
    "buildRequestId": {
      "$ref": "#/$defs/BuildRequestId"
    },
    "expectedRevision": {
      "$ref": "#/$defs/Revision"
    },
    "expectedState": {
      "$ref": "#/$defs/InternalAgentBuildState"
    }
  },
  "required": [
    "buildRequestId",
    "expectedState",
    "expectedRevision"
  ],
  "title": "CancelCandidateBuildRequest",
  "type": "object"
}
