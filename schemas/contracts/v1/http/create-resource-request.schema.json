{
  "$defs": {
    "CourseId": {
      "description": "Strongly typed UUIDv7 identifier for `CourseId`.",
      "type": "string"
    },
    "EnvironmentId": {
      "description": "Strongly typed UUIDv7 identifier for `EnvironmentId`.",
      "type": "string"
    },
    "GpuRequest": {
      "additionalProperties": false,
      "description": "A policy-catalogued GPU class. It intentionally does not expose Kubernetes resource names.",
      "properties": {
        "class": {
          "type": "string"
        },
        "count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "class",
        "count"
      ],
      "type": "object"
    },
    "ProjectId": {
      "description": "Strongly typed UUIDv7 identifier for `ProjectId`.",
      "type": "string"
    },
    "ReleaseId": {
      "description": "Strongly typed UUIDv7 identifier for `ReleaseId`.",
      "type": "string"
    },
    "ResourceTarget": {
      "description": "Immutable identity of a Resource request's target.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Capacity for a long-lived Environment/Work aggregate that already owns its identity.",
          "properties": {
            "environmentId": {
              "$ref": "#/$defs/EnvironmentId"
            },
            "kind": {
              "const": "environment",
              "type": "string"
            },
            "releaseId": {
              "$ref": "#/$defs/ReleaseId"
            },
            "releaseVersion": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "environmentId",
            "releaseId",
            "releaseVersion"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Capacity for a one-shot task. Resource does not create a fake Environment row.",
          "properties": {
            "kind": {
              "const": "task",
              "type": "string"
            },
            "taskRunId": {
              "$ref": "#/$defs/TaskRunId"
            }
          },
          "required": [
            "kind",
            "taskRunId"
          ],
          "type": "object"
        }
      ]
    },
    "TaskRunId": {
      "description": "Strongly typed UUIDv7 identifier for `TaskRunId`.",
      "type": "string"
    },
    "WorkloadResources": {
      "additionalProperties": false,
      "description": "Requested or approved workload resources, independent of Kubernetes quantity syntax.",
      "properties": {
        "cpuMillicores": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "gpu": {
          "anyOf": [
            {
              "$ref": "#/$defs/GpuRequest"
            },
            {
              "type": "null"
            }
          ]
        },
        "memoryBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "storageBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "cpuMillicores",
        "memoryBytes",
        "storageBytes"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Browser request for a new Project-scoped capacity reservation.",
  "properties": {
    "courseId": {
      "anyOf": [
        {
          "$ref": "#/$defs/CourseId"
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional teaching association. Independent research requests omit it."
    },
    "durationSeconds": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "projectId": {
      "$ref": "#/$defs/ProjectId",
      "description": "Required project scope. Work capacity is never allocated at an\nunscoped course-wide boundary."
    },
    "requestKey": {
      "type": "string"
    },
    "resources": {
      "$ref": "#/$defs/WorkloadResources"
    },
    "target": {
      "$ref": "#/$defs/ResourceTarget"
    }
  },
  "required": [
    "projectId",
    "requestKey",
    "target",
    "resources",
    "durationSeconds"
  ],
  "title": "CreateResourceRequest",
  "type": "object"
}
