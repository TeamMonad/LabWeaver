{
  "$defs": {
    "ActorId": {
      "description": "Strongly typed UUIDv7 identifier for `ActorId`.",
      "type": "string"
    },
    "ApprovalId": {
      "description": "Strongly typed UUIDv7 identifier for `ApprovalId`.",
      "type": "string"
    },
    "CandidateDecision": {
      "description": "Append-only candidate decision.",
      "enum": [
        "approved",
        "rejected",
        "withdrawn"
      ],
      "type": "string"
    },
    "CandidateId": {
      "description": "Strongly typed UUIDv7 identifier for `CandidateId`.",
      "type": "string"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "UtcTimestamp": {
      "description": "UTC timestamp serialized with a literal `Z` and millisecond precision.",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Human decision bound to an exact candidate and dependency identity.",
  "properties": {
    "actorId": {
      "$ref": "#/$defs/ActorId"
    },
    "candidateId": {
      "$ref": "#/$defs/CandidateId"
    },
    "candidateRevision": {
      "$ref": "#/$defs/Revision"
    },
    "decidedAt": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "decision": {
      "$ref": "#/$defs/CandidateDecision"
    },
    "id": {
      "$ref": "#/$defs/ApprovalId"
    },
    "policyRevision": {
      "$ref": "#/$defs/Revision"
    },
    "reason": {
      "type": "string"
    },
    "trustRevision": {
      "$ref": "#/$defs/Revision"
    }
  },
  "required": [
    "id",
    "candidateId",
    "candidateRevision",
    "policyRevision",
    "trustRevision",
    "actorId",
    "decision",
    "reason",
    "decidedAt"
  ],
  "title": "CandidateApproval",
  "type": "object"
}
