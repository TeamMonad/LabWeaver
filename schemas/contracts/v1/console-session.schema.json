{
  "$defs": {
    "AccessGrantId": {
      "description": "Strongly typed UUIDv7 identifier for `AccessGrantId`.",
      "type": "string"
    },
    "BffSessionId": {
      "description": "Strongly typed UUIDv7 identifier for `BffSessionId`.",
      "type": "string"
    },
    "ConsoleCapabilityId": {
      "description": "Strongly typed UUIDv7 identifier for `ConsoleCapabilityId`.",
      "type": "string"
    },
    "ConsoleKind": {
      "description": "Browser interaction transport selected by an approved environment release.",
      "enum": [
        "xterm",
        "novnc"
      ],
      "type": "string"
    },
    "ConsoleLeaseFence": {
      "additionalProperties": false,
      "description": "Resource-owned Lease identity that fences a Work console capability.",
      "properties": {
        "expiresAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "leaseId": {
          "$ref": "#/$defs/LeaseId"
        },
        "leaseRevision": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "leaseId",
        "leaseRevision",
        "expiresAt"
      ],
      "type": "object"
    },
    "ConsoleSessionId": {
      "description": "Strongly typed UUIDv7 identifier for `ConsoleSessionId`.",
      "type": "string"
    },
    "ConsoleSessionState": {
      "description": "Safe console-session lifecycle persisted by Access Service.",
      "enum": [
        "opening",
        "active",
        "terminating",
        "termination_overdue",
        "closed"
      ],
      "type": "string"
    },
    "EnvironmentId": {
      "description": "Strongly typed UUIDv7 identifier for `EnvironmentId`.",
      "type": "string"
    },
    "LeaseId": {
      "description": "Strongly typed UUIDv7 identifier for `LeaseId`.",
      "type": "string"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "UtcTimestamp": {
      "description": "UTC timestamp serialized with a literal `Z` and millisecond precision.",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Metadata-only session snapshot. It can never carry terminal bytes or credentials.",
  "properties": {
    "accessGrantId": {
      "$ref": "#/$defs/AccessGrantId"
    },
    "accessGrantRevision": {
      "$ref": "#/$defs/Revision"
    },
    "authorizationExpiresAt": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "bffSessionId": {
      "$ref": "#/$defs/BffSessionId"
    },
    "capabilityId": {
      "$ref": "#/$defs/ConsoleCapabilityId"
    },
    "closedAt": {
      "anyOf": [
        {
          "$ref": "#/$defs/UtcTimestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "diagnosticCode": {
      "type": [
        "string",
        "null"
      ]
    },
    "environmentId": {
      "$ref": "#/$defs/EnvironmentId"
    },
    "environmentRevision": {
      "$ref": "#/$defs/Revision"
    },
    "id": {
      "$ref": "#/$defs/ConsoleSessionId"
    },
    "kind": {
      "$ref": "#/$defs/ConsoleKind"
    },
    "leaseFence": {
      "anyOf": [
        {
          "$ref": "#/$defs/ConsoleLeaseFence"
        },
        {
          "type": "null"
        }
      ]
    },
    "openedAt": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "revision": {
      "$ref": "#/$defs/Revision"
    },
    "state": {
      "$ref": "#/$defs/ConsoleSessionState"
    },
    "terminateBy": {
      "anyOf": [
        {
          "$ref": "#/$defs/UtcTimestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "terminationRequestedAt": {
      "anyOf": [
        {
          "$ref": "#/$defs/UtcTimestamp"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "capabilityId",
    "kind",
    "bffSessionId",
    "accessGrantId",
    "accessGrantRevision",
    "environmentId",
    "environmentRevision",
    "revision",
    "state",
    "openedAt",
    "authorizationExpiresAt"
  ],
  "title": "ConsoleSession",
  "type": "object"
}
