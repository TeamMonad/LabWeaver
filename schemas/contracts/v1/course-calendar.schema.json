{
  "$defs": {
    "CourseCalendarState": {
      "enum": [
        "not_open",
        "open",
        "late",
        "closed"
      ],
      "type": "string"
    },
    "CourseId": {
      "description": "Strongly typed UUIDv7 identifier for `CourseId`.",
      "type": "string"
    },
    "CourseLatePolicy": {
      "description": "Submission behavior at and after the due instant.",
      "enum": [
        "hard_close",
        "allow_with_mark"
      ],
      "type": "string"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "UtcTimestamp": {
      "description": "UTC timestamp serialized with a literal `Z` and millisecond precision.",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A course's authoritative schedule and late-submission policy.",
  "properties": {
    "courseId": {
      "$ref": "#/$defs/CourseId"
    },
    "dueAt": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "latePolicy": {
      "$ref": "#/$defs/CourseLatePolicy"
    },
    "lateUntil": {
      "anyOf": [
        {
          "$ref": "#/$defs/UtcTimestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "openAt": {
      "anyOf": [
        {
          "$ref": "#/$defs/UtcTimestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "revision": {
      "$ref": "#/$defs/Revision"
    },
    "state": {
      "$ref": "#/$defs/CourseCalendarState"
    },
    "timeZone": {
      "type": "string"
    }
  },
  "required": [
    "courseId",
    "revision",
    "dueAt",
    "timeZone",
    "state",
    "latePolicy"
  ],
  "title": "CourseCalendar",
  "type": "object"
}
