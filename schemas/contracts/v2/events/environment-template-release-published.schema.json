{
  "$defs": {
    "ActorId": {
      "description": "Strongly typed UUIDv7 identifier for `ActorId`.",
      "type": "string"
    },
    "ApprovalId": {
      "description": "Strongly typed UUIDv7 identifier for `ApprovalId`.",
      "type": "string"
    },
    "ArtifactId": {
      "description": "Strongly typed UUIDv7 identifier for `ArtifactId`.",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Immutable object-store identity without a machine-local path or credential.",
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/ArtifactId",
          "description": "Stable metadata identity resolved by the owning service."
        },
        "mediaType": {
          "description": "Registered media type.",
          "type": "string"
        },
        "objectVersion": {
          "description": "Immutable backend object version.",
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Digest",
          "description": "Exact content digest."
        },
        "sizeBytes": {
          "description": "Raw object length.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "storeBinding": {
          "description": "Explicit object-store binding from deployment configuration.",
          "type": "string"
        }
      },
      "required": [
        "artifactId",
        "storeBinding",
        "objectVersion",
        "sha256",
        "sizeBytes",
        "mediaType"
      ],
      "type": "object"
    },
    "BuildRequestId": {
      "description": "Strongly typed UUIDv7 identifier for `BuildRequestId`.",
      "type": "string"
    },
    "CandidateApproval": {
      "additionalProperties": false,
      "description": "Human decision bound to an exact candidate and dependency identity.",
      "properties": {
        "actorId": {
          "$ref": "#/$defs/ActorId"
        },
        "candidateId": {
          "$ref": "#/$defs/CandidateId"
        },
        "candidateRevision": {
          "$ref": "#/$defs/Revision"
        },
        "candidateSha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "decidedAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "decision": {
          "$ref": "#/$defs/CandidateDecision"
        },
        "id": {
          "$ref": "#/$defs/ApprovalId"
        },
        "policyRevision": {
          "$ref": "#/$defs/Revision"
        },
        "reason": {
          "type": "string"
        },
        "schemaSha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "trustRevision": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "id",
        "candidateId",
        "candidateRevision",
        "candidateSha256",
        "policyRevision",
        "schemaSha256",
        "trustRevision",
        "actorId",
        "decision",
        "reason",
        "decidedAt"
      ],
      "type": "object"
    },
    "CandidateDecision": {
      "description": "Append-only candidate decision.",
      "enum": [
        "approved",
        "rejected",
        "withdrawn"
      ],
      "type": "string"
    },
    "CandidateId": {
      "description": "Strongly typed UUIDv7 identifier for `CandidateId`.",
      "type": "string"
    },
    "CourseId": {
      "description": "Strongly typed UUIDv7 identifier for `CourseId`.",
      "type": "string"
    },
    "EndpointProtocol": {
      "description": "Supported controlled protocols.",
      "enum": [
        "http",
        "https",
        "ssh"
      ],
      "type": "string"
    },
    "EnvironmentApiVersion": {
      "enum": [
        "environment.labweaver.io/v1"
      ],
      "type": "string"
    },
    "EnvironmentClass": {
      "description": "Environment business class retained from the v2.1 architecture.",
      "enum": [
        "experiment",
        "work"
      ],
      "type": "string"
    },
    "EnvironmentDocumentKind": {
      "enum": [
        "EnvironmentSpec"
      ],
      "type": "string"
    },
    "EnvironmentEntrySpec": {
      "additionalProperties": false,
      "description": "One named service entry exposed only through the controlled access plane.",
      "properties": {
        "name": {
          "type": "string"
        },
        "protocol": {
          "$ref": "#/$defs/EndpointProtocol"
        },
        "servicePort": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "protocol",
        "servicePort"
      ],
      "type": "object"
    },
    "EnvironmentRuntimeSpec": {
      "description": "Strict runtime-specific environment shape.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "base_image_digest": {
              "type": "string"
            },
            "build_context": {
              "$ref": "#/$defs/ArtifactRef"
            },
            "kind": {
              "const": "container",
              "type": "string"
            },
            "provider_binding": {
              "type": "string"
            },
            "service_port": {
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "provider_binding",
            "build_context",
            "base_image_digest",
            "service_port"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "base_disk": {
              "$ref": "#/$defs/ArtifactRef"
            },
            "kind": {
              "const": "virtual_machine",
              "type": "string"
            },
            "provider_binding": {
              "type": "string"
            },
            "ssh_port": {
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "storage_class_binding": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "provider_binding",
            "base_disk",
            "storage_class_binding",
            "ssh_port"
          ],
          "type": "object"
        }
      ]
    },
    "EnvironmentSecuritySpec": {
      "additionalProperties": false,
      "description": "Runtime-independent minimum security posture.",
      "properties": {
        "privilegeEscalationPolicy": {
          "$ref": "#/$defs/PrivilegeEscalationPolicy"
        },
        "publicExposurePolicy": {
          "$ref": "#/$defs/PublicExposurePolicy"
        },
        "rootFilesystemPolicy": {
          "$ref": "#/$defs/RootFilesystemPolicy"
        },
        "securityProfileBinding": {
          "type": "string"
        },
        "userPolicy": {
          "$ref": "#/$defs/RuntimeUserPolicy"
        }
      },
      "required": [
        "userPolicy",
        "rootFilesystemPolicy",
        "privilegeEscalationPolicy",
        "publicExposurePolicy",
        "securityProfileBinding"
      ],
      "type": "object"
    },
    "EnvironmentSpec": {
      "additionalProperties": false,
      "description": "Stable EnvironmentSpec v1.",
      "properties": {
        "apiVersion": {
          "$ref": "#/$defs/EnvironmentApiVersion"
        },
        "class": {
          "$ref": "#/$defs/EnvironmentClass"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/EnvironmentEntrySpec"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/EnvironmentDocumentKind"
        },
        "name": {
          "type": "string"
        },
        "network": {
          "$ref": "#/$defs/NetworkPolicySpec"
        },
        "resources": {
          "$ref": "#/$defs/ResourceRequirements"
        },
        "retention": {
          "$ref": "#/$defs/RetentionSnapshot"
        },
        "runtime": {
          "$ref": "#/$defs/EnvironmentRuntimeSpec"
        },
        "security": {
          "$ref": "#/$defs/EnvironmentSecuritySpec"
        }
      },
      "required": [
        "apiVersion",
        "kind",
        "name",
        "class",
        "resources",
        "network",
        "entries",
        "security",
        "runtime",
        "retention"
      ],
      "type": "object"
    },
    "EnvironmentTemplateRelease": {
      "additionalProperties": false,
      "description": "Immutable environment-first release.",
      "properties": {
        "approval": {
          "$ref": "#/$defs/CandidateApproval"
        },
        "artifact": {
          "$ref": "#/$defs/ImageArtifact"
        },
        "candidateId": {
          "$ref": "#/$defs/CandidateId"
        },
        "candidateRevision": {
          "$ref": "#/$defs/Revision"
        },
        "courseId": {
          "$ref": "#/$defs/CourseId"
        },
        "environmentSpecSha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "id": {
          "$ref": "#/$defs/ReleaseId"
        },
        "imagePolicyEvaluation": {
          "$ref": "#/$defs/ImagePolicyEvaluation"
        },
        "publishedAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "publishedBy": {
          "$ref": "#/$defs/ActorId"
        },
        "runtimeKind": {
          "$ref": "#/$defs/RuntimeKind"
        },
        "version": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "courseId",
        "version",
        "candidateId",
        "candidateRevision",
        "environmentSpecSha256",
        "runtimeKind",
        "approval",
        "artifact",
        "imagePolicyEvaluation",
        "publishedBy",
        "publishedAt"
      ],
      "type": "object"
    },
    "EventId": {
      "description": "Strongly typed UUIDv7 identifier for `EventId`.",
      "type": "string"
    },
    "ImageArtifact": {
      "description": "Complete immutable runtime artifact identity.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "build_request_id": {
              "$ref": "#/$defs/BuildRequestId"
            },
            "digest": {
              "type": "string"
            },
            "id": {
              "$ref": "#/$defs/ImageArtifactId"
            },
            "immutable_tag": {
              "type": "string"
            },
            "kind": {
              "const": "container",
              "type": "string"
            },
            "provenance": {
              "$ref": "#/$defs/ArtifactRef"
            },
            "repository": {
              "type": "string"
            },
            "sbom": {
              "$ref": "#/$defs/ArtifactRef"
            },
            "signature": {
              "$ref": "#/$defs/SigstoreEvidence"
            }
          },
          "required": [
            "kind",
            "id",
            "build_request_id",
            "repository",
            "immutable_tag",
            "digest",
            "sbom",
            "provenance",
            "signature"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "base_disk": {
              "$ref": "#/$defs/ArtifactRef"
            },
            "format": {
              "$ref": "#/$defs/VirtualMachineDiskFormat"
            },
            "id": {
              "$ref": "#/$defs/ImageArtifactId"
            },
            "kind": {
              "const": "virtual_machine",
              "type": "string"
            },
            "provenance": {
              "$ref": "#/$defs/ArtifactRef"
            },
            "sbom": {
              "$ref": "#/$defs/ArtifactRef"
            },
            "signature": {
              "$ref": "#/$defs/SigstoreEvidence"
            }
          },
          "required": [
            "kind",
            "id",
            "base_disk",
            "format",
            "sbom",
            "provenance",
            "signature"
          ],
          "type": "object"
        }
      ]
    },
    "ImageArtifactId": {
      "description": "Strongly typed UUIDv7 identifier for `ImageArtifactId`.",
      "type": "string"
    },
    "ImagePolicyEvaluation": {
      "additionalProperties": false,
      "description": "Deterministic scan and trust-policy evaluation.",
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/ImageArtifactId"
        },
        "artifactSha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "evaluatedAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "expectedCertificateSubject": {
          "type": "string"
        },
        "expectedFulcioIssuer": {
          "type": "string"
        },
        "maxEvidenceAgeMilliseconds": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "passed": {
          "type": "boolean"
        },
        "policyId": {
          "$ref": "#/$defs/PolicyId"
        },
        "policyRevision": {
          "$ref": "#/$defs/Revision"
        },
        "requireCtSct": {
          "type": "boolean"
        },
        "requireRekorInclusion": {
          "type": "boolean"
        },
        "scannerDatabaseSha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "scannerName": {
          "type": "string"
        },
        "scannerVersion": {
          "type": "string"
        },
        "trustBundleSha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "validUntil": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "vulnerabilities": {
          "$ref": "#/$defs/VulnerabilitySummary"
        }
      },
      "required": [
        "artifactId",
        "artifactSha256",
        "policyId",
        "policyRevision",
        "scannerName",
        "scannerVersion",
        "scannerDatabaseSha256",
        "vulnerabilities",
        "trustBundleSha256",
        "expectedFulcioIssuer",
        "expectedCertificateSubject",
        "requireRekorInclusion",
        "requireCtSct",
        "evaluatedAt",
        "maxEvidenceAgeMilliseconds",
        "validUntil",
        "passed"
      ],
      "type": "object"
    },
    "NetworkPolicySpec": {
      "description": "Network egress posture for a published environment.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "deny_all",
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "restricted",
              "type": "string"
            },
            "policy_binding": {
              "type": "string"
            }
          },
          "required": [
            "mode",
            "policy_binding"
          ],
          "type": "object"
        }
      ]
    },
    "PolicyId": {
      "description": "Strongly typed UUIDv7 identifier for `PolicyId`.",
      "type": "string"
    },
    "PrivilegeEscalationPolicy": {
      "enum": [
        "deny"
      ],
      "type": "string"
    },
    "PublicExposurePolicy": {
      "enum": [
        "deny"
      ],
      "type": "string"
    },
    "ReleaseId": {
      "description": "Strongly typed UUIDv7 identifier for `ReleaseId`.",
      "type": "string"
    },
    "ReleasePublishedV2": {
      "additionalProperties": false,
      "description": "Complete immutable runtime projection consumed by the Environment state owner.",
      "properties": {
        "environmentSpec": {
          "$ref": "#/$defs/EnvironmentSpec"
        },
        "projectionSha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "release": {
          "$ref": "#/$defs/EnvironmentTemplateRelease"
        }
      },
      "required": [
        "release",
        "environmentSpec",
        "projectionSha256"
      ],
      "type": "object"
    },
    "ResourceRequirements": {
      "additionalProperties": false,
      "description": "Bounded runtime resources expressed without Kubernetes-dependent parsing.",
      "properties": {
        "cpuMillicores": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "memoryBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "storageBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "cpuMillicores",
        "memoryBytes",
        "storageBytes"
      ],
      "type": "object"
    },
    "RetentionClass": {
      "description": "Retention classes with distinct privacy and recovery requirements.",
      "enum": [
        "course_material",
        "build_evidence",
        "run_evidence",
        "student_submission",
        "security_audit"
      ],
      "type": "string"
    },
    "RetentionDisposition": {
      "description": "Required action after retention expires.",
      "enum": [
        "delete",
        "purge_after_export",
        "retain_sanitized_receipt"
      ],
      "type": "string"
    },
    "RetentionSnapshot": {
      "additionalProperties": false,
      "description": "Frozen data-retention decision for an immutable resource.",
      "properties": {
        "class": {
          "$ref": "#/$defs/RetentionClass",
          "description": "Stable retention class."
        },
        "disposition": {
          "$ref": "#/$defs/RetentionDisposition",
          "description": "Required terminal disposition."
        },
        "policyId": {
          "$ref": "#/$defs/PolicyId",
          "description": "Policy identity."
        },
        "policyRevision": {
          "$ref": "#/$defs/Revision",
          "description": "Exact policy revision used at creation."
        },
        "retainUntil": {
          "$ref": "#/$defs/UtcTimestamp",
          "description": "Absolute retention boundary."
        }
      },
      "required": [
        "policyId",
        "policyRevision",
        "class",
        "retainUntil",
        "disposition"
      ],
      "type": "object"
    },
    "Revision": {
      "description": "Monotonic aggregate revision. Zero is never a persisted revision.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "RootFilesystemPolicy": {
      "enum": [
        "read_only_required",
        "mutable_required"
      ],
      "type": "string"
    },
    "RuntimeKind": {
      "description": "Runtime kind shared by candidates, releases, and instances.",
      "enum": [
        "container",
        "virtual_machine"
      ],
      "type": "string"
    },
    "RuntimeUserPolicy": {
      "enum": [
        "non_root_required"
      ],
      "type": "string"
    },
    "Sequence": {
      "description": "Aggregate-local ordering sequence. This value is not an SSE resume cursor.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "Sha256Digest": {
      "description": "Canonical lowercase SHA-256 digest.",
      "type": "string"
    },
    "SigstoreEvidence": {
      "additionalProperties": false,
      "description": "Private Sigstore identity and transparency evidence.",
      "properties": {
        "certificateSha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "certificateSubject": {
          "type": "string"
        },
        "ctLogId": {
          "type": "string"
        },
        "fulcioIssuer": {
          "type": "string"
        },
        "rekorInclusionProofSha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "rekorLogId": {
          "type": "string"
        },
        "rekorLogIndex": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "sctSha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "signatureSha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "trustBundleSha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "verifiedAt": {
          "$ref": "#/$defs/UtcTimestamp"
        }
      },
      "required": [
        "trustBundleSha256",
        "fulcioIssuer",
        "certificateSubject",
        "certificateSha256",
        "signatureSha256",
        "rekorLogId",
        "rekorLogIndex",
        "rekorInclusionProofSha256",
        "ctLogId",
        "sctSha256",
        "verifiedAt"
      ],
      "type": "object"
    },
    "UtcTimestamp": {
      "description": "UTC timestamp serialized with a literal `Z` and millisecond precision.",
      "type": "string"
    },
    "VirtualMachineDiskFormat": {
      "description": "Supported VM base-disk encodings.",
      "enum": [
        "qcow2",
        "raw"
      ],
      "type": "string"
    },
    "VulnerabilitySummary": {
      "additionalProperties": false,
      "description": "Vulnerability counts by severity.",
      "properties": {
        "critical": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "high": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "low": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "medium": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "unknown": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "unknown",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Strict CloudEvents 1.0 envelope carried as structured JSON.",
  "properties": {
    "aggregateRevision": {
      "$ref": "#/$defs/Revision"
    },
    "aggregateSequence": {
      "$ref": "#/$defs/Sequence"
    },
    "courseId": {
      "$ref": "#/$defs/CourseId"
    },
    "data": {
      "$ref": "#/$defs/ReleasePublishedV2"
    },
    "datacontenttype": {
      "type": "string"
    },
    "dataschema": {
      "type": "string"
    },
    "id": {
      "$ref": "#/$defs/EventId"
    },
    "source": {
      "type": "string"
    },
    "specversion": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "time": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "traceId": {
      "type": "string"
    },
    "type": {
      "type": "string"
    }
  },
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "subject",
    "time",
    "datacontenttype",
    "dataschema",
    "courseId",
    "aggregateRevision",
    "aggregateSequence",
    "traceId",
    "data"
  ],
  "title": "CloudEvent",
  "type": "object"
}
