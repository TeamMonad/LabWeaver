{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labweaver.invalid/schemas/infrastructure/local-hostpath-stack-overlay.v1.schema.json",
  "title": "LabWeaver Docker Desktop Local Hostpath Stack Overlay",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "deploy.labweaver.io/v1" },
    "kind": { "const": "LocalHostpathStackOverlay" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "profile"],
      "properties": {
        "name": { "const": "docker-desktop-local-hostpath" },
        "profile": { "const": "local-hostpath" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "releaseEligible", "writePolicy", "namespaces", "storage", "dependencies", "teardown"],
      "properties": {
        "mode": { "const": "local-hostpath" },
        "releaseEligible": { "const": false },
        "writePolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["apply", "delete"],
          "properties": {
            "apply": { "const": false },
            "delete": { "const": false }
          }
        },
        "namespaces": {
          "type": "object",
          "additionalProperties": false,
          "required": ["data", "identity", "build", "harbor", "system", "evaluation", "runtimePrefix"],
          "properties": {
            "data": { "const": "labweaver-local-data" },
            "identity": { "const": "labweaver-local-identity" },
            "build": { "const": "labweaver-local-build" },
            "harbor": { "const": "labweaver-local-harbor" },
            "system": { "const": "labweaver-local-system" },
            "evaluation": { "const": "labweaver-local-evaluation" },
            "runtimePrefix": { "const": "labweaver-local-env-" }
          }
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provisioner", "defaultAccessMode", "formalSharedProvisioner", "formalAccessMode"],
          "properties": {
            "provisioner": { "const": "hostpath" },
            "defaultAccessMode": { "const": "ReadWriteOnce" },
            "formalSharedProvisioner": { "const": "nfs-rwx" },
            "formalAccessMode": { "const": "ReadWriteMany" }
          }
        },
        "dependencies": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "namespaceRef", "owner", "installMode"],
            "properties": {
              "name": { "enum": ["postgresql", "nats", "minio", "keycloak", "harbor", "buildkit", "labweaver"] },
              "namespaceRef": { "enum": ["data", "identity", "build", "harbor", "system", "evaluation"] },
              "owner": { "enum": ["ansible", "helm"] },
              "installMode": { "const": "render-only" }
            }
          }
        },
        "teardown": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "order", "selectors"],
          "properties": {
            "mode": { "const": "plan-only" },
            "order": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "selectors": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
